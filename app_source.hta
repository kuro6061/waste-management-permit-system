                var html = "<table class='data-table' style='table-layout:fixed;width:100%;'><tr><th style='width:30%;'>事業者名</th><th style='width:40%;'>住所</th><th style='width:15%;'>電話番号</th><th style='width:15%;'>操作</th></tr>";
                var count = 0;
                while (!rs.EOF) {
                    count++;
                    var id = rs.Fields("事業者ID").Value;
                    html += "<tr>";
                    html += "<td>" + escapeHtml(rs.Fields("事業者名").Value || "") + "</td>";
                    html += "<td>" + escapeHtml((rs.Fields("都道府県").Value || "") + (rs.Fields("市区町村町名番地").Value || "")) + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("電話番号").Value || "") + "</td>";
                    html += "<td><button class='btn btn-primary btn-md' onclick='loadBusinessDetail(" + id + ")'>詳細</button></td>";
                    html += "</tr>";
                    rs.MoveNext();
                }
                rs.Close();
                html += "</table>";
                html = buildResultCountHtml(count, keyword) + html;
                hideLoading();
                document.getElementById("searchResults").innerHTML = html;
            } catch (e) { hideLoading(); document.getElementById("searchResults").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        // ===== 許可検索 =====
        function searchPermit() {
            // 検索実行時に詳細フィルターを閉じる
            var advPanel = document.getElementById("advancedFilters");
            if (advPanel && advPanel.style.display !== "none") {
                advPanel.style.display = "none";
                updateFilterBadge();
            }
            var keyword = document.getElementById("searchPermitKeyword").value;
            var categoryId = document.getElementById("searchPermitCategory").value;
            var expiry = document.getElementById("searchPermitExpiry").value;
            var status = document.getElementById("searchPermitStatus").value;
            var excellentOnly = document.getElementById("searchPermitExcellent").checked;

            // 検索基準日の取得
            var asOfDateValue = document.getElementById("searchPermitAsOfDateValue").value;
            var asOfDateSql = "";
            var asOfDateDisplay = "";
            var today = new Date();
            var todayStr = today.getFullYear() + "/" + padZero2(today.getMonth() + 1) + "/" + padZero2(today.getDate());
            if (asOfDateValue) {
                // yyyy/mm/dd形式をAccess用の#yyyy/mm/dd#形式に変換
                asOfDateSql = "#" + asOfDateValue + " 23:59:59#";
                asOfDateDisplay = asOfDateValue;
            } else {
                // 未設定の場合は今日
                asOfDateSql = "#" + todayStr + " 23:59:59#";
                asOfDateDisplay = todayStr;
            }
            var isToday = (asOfDateDisplay === todayStr);

            // チェックされた品目を取得
            var checkboxes = document.getElementsByClassName("permitItemCheckbox");
            var selectedItemIds = [];
            for (var i = 0; i < checkboxes.length; i++) {
                if (checkboxes[i].checked) {
                    selectedItemIds.push(checkboxes[i].value);
                }
            }
            // AND/OR モード取得
            var itemModeRadios = document.getElementsByName("searchPermitItemMode");
            var itemMode = "OR";
            for (var i = 0; i < itemModeRadios.length; i++) {
                if (itemModeRadios[i].checked) {
                    itemMode = itemModeRadios[i].value;
                    break;
                }
            }

            if (!conn) { document.getElementById("searchPermitResults").innerHTML = "<p>データベースに接続されていません</p>"; return; }
            showLoading();
            try {
                var sql = buildSearchPermitQuery({
                    keyword: keyword,
                    categoryId: categoryId,
                    expiry: expiry,
                    status: status,
                    excellentOnly: excellentOnly,
                    selectedItemIds: selectedItemIds,
                    itemMode: itemMode,
                    asOfDateSql: asOfDateSql
                });
                var rs = conn.Execute(sql);
                var html = "<table class='data-table'><tr><th>状態</th><th>事業者名</th><th>許可区分</th><th>許可年月日</th><th>許可有効年月日</th><th>許可番号</th><th>操作</th></tr>";
                var count = 0;
                var csvRows = [];
                // 検索基準日を比較用に取得
                while (!rs.EOF) {
                    count++;
                    var bizId = rs.Fields("事業者ID").Value;
                    var abolishDate = rs.Fields("廃止日文字列").Value || "";
                    var cancelDate = rs.Fields("取消日文字列").Value || "";
                    var validDateStr = rs.Fields("有効期限").Value || "";
                    var excellent = rs.Fields("優良認定").Value;

                    // 状態判定（yyyy/mm/dd文字列で比較 — ADODBのDate型変換を避ける）
                    var isExpired = validDateStr && validDateStr < asOfDateDisplay;
                    var statusText = statusBadge('active', '有効');
                    var rowCls = "";
                    if (cancelDate) {
                        statusText = statusBadge('cancelled', '取消');
                        rowCls = " class='bg-row-error'";
                    } else if (abolishDate) {
                        statusText = statusBadge('abolished', '廃止');
                        rowCls = " class='bg-row-inactive'";
                    } else if (isExpired) {
                        statusText = "<span class='badge-expiry expired'>期限切れ</span>";
                        rowCls = " class='bg-row-warn'";
                    }

                    html += "<tr" + rowCls + ">";
                    html += "<td>" + statusText + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("事業者名").Value || "") + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("許可区分名").Value || "") + (excellent ? " <span class='excellent-star' title='優良認定'>★</span>" : "") + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("許可日").Value || "") + "</td>";
                    html += "<td>" + escapeHtml(validDateStr) + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("許可番号").Value || "") + "</td>";
                    html += "<td><button class='btn btn-primary btn-md' onclick='loadBusinessDetail(" + bizId + ")'>詳細</button></td>";
                    html += "</tr>";
                    var statusPlain = cancelDate ? "取消" : (abolishDate ? "廃止" : (isExpired ? "期限切れ" : "有効"));
                    csvRows.push([statusPlain, rs.Fields("事業者名").Value || "", rs.Fields("許可区分名").Value || "", rs.Fields("許可日").Value || "", rs.Fields("有効期限").Value || "", rs.Fields("許可番号").Value || "", excellent ? "○" : ""]);
                    rs.MoveNext();
                }
                rs.Close();
                html += "</table>";
                var datePrefix = isToday
                    ? asOfDateDisplay + " (今日) 時点の検索結果: "
                    : asOfDateDisplay + " 時点の検索結果: ";
                var headerHtml = buildResultCountHtml(count, keyword, { prefix: datePrefix });
                if (count > 0) {
                    html += "<div style='margin-top:10px;'><button class='btn btn-success' style='padding:8px 20px;' onclick='exportSearchPermitCsv()'>📄 CSV出力</button></div>";
                }
                window._lastSearchPermitCsv = csvRows;
                html = headerHtml + html;
                hideLoading();
                document.getElementById("searchPermitResults").innerHTML = html;
            } catch (e) { hideLoading(); document.getElementById("searchPermitResults").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        // 許可検索結果をCSV出力
        function exportSearchPermitCsv() {
            if (!window._lastSearchPermitCsv || window._lastSearchPermitCsv.length === 0) {
                showToast("出力するデータがありません", "error");
                return;
            }
            var now = new Date();
            var ts = now.getFullYear() + ("0" + (now.getMonth()+1)).slice(-2) + ("0" + now.getDate()).slice(-2) + "_" + ("0" + now.getHours()).slice(-2) + ("0" + now.getMinutes()).slice(-2);
            exportToCsv("許可検索結果_" + ts + ".csv",
                ["状態", "事業者名", "許可区分", "許可日", "有効期限", "許可番号", "優良認定"],
                window._lastSearchPermitCsv);
        }

        function exportToCsv(filename, headers, rows) {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                var shell = new ActiveXObject("WScript.Shell");
                var desktop = shell.SpecialFolders("Desktop");
                var filePath = desktop + "\\" + filename;
                var file = fso.CreateTextFile(filePath, true);
                file.WriteLine(csvEscapeRow(headers));
                for (var i = 0; i < rows.length; i++) {
                    file.WriteLine(csvEscapeRow(rows[i]));
                }
                file.Close();
                showToast("CSVを保存しました: " + filePath, "success", 5000);
            } catch (e) {
                showToast("CSV出力エラー: " + e.message, "error", 5000);
            }
        }

        function csvEscapeRow(arr) {
            var parts = [];
            for (var j = 0; j < arr.length; j++) {
                var val = (arr[j] === null || arr[j] === undefined) ? "" : String(arr[j]);
                if (val.indexOf(",") >= 0 || val.indexOf('"') >= 0 || val.indexOf("\n") >= 0) {
                    val = '"' + val.replace(/"/g, '""') + '"';
                }
                parts.push(val);
            }
            return parts.join(",");
        }

        // ===== 施設検索 =====
        function searchFacility() {
            // 検索実行時に詳細フィルターを閉じる
            var advPanel = document.getElementById("facilityAdvancedFilters");
            if (advPanel && advPanel.style.display !== "none") {
                advPanel.style.display = "none";
                updateFacilityFilterBadge();
            }
            var keyword = document.getElementById("searchFacilityKeyword").value;
            var typeId = document.getElementById("searchFacilityType").value;
            var statusFilter = document.getElementById("searchFacilityStatus").value;
            var includeAbolished = (statusFilter === "" || statusFilter === "abolished");
            var methodId = document.getElementById("searchFacilityMethod") ? document.getElementById("searchFacilityMethod").value : "";
            var permitTargetId = document.getElementById("searchFacilityPermitTarget") ? document.getElementById("searchFacilityPermitTarget").value : "";
            var minCapEl = document.getElementById("searchFacilityMinCapacity");
            var minCapacity = (minCapEl && minCapEl.value) ? parseFloat(minCapEl.value) : null;
            var excludeSelf = document.getElementById("searchFacilityExcludeSelf") ? document.getElementById("searchFacilityExcludeSelf").checked : false;
            // 品目フィルター: チェックされた品目IDを収集
            var itemIds = [];
            var itemCheckboxes = document.querySelectorAll("#searchFacilityItemCheckboxes input[type='checkbox']:checked");
            for (var ci = 0; ci < itemCheckboxes.length; ci++) {
                itemIds.push(parseInt(itemCheckboxes[ci].value));
            }
            var itemMatchMode = "or";
            var modeRadios = document.getElementsByName("facItemMode");
            for (var ri = 0; ri < modeRadios.length; ri++) {
                if (modeRadios[ri].checked) { itemMatchMode = modeRadios[ri].value; break; }
            }
            var hasAnyFilter = keyword || typeId || methodId || permitTargetId || minCapacity || excludeSelf || itemIds.length > 0;
            if (!hasAnyFilter) { showToast("検索条件を指定してください", "error"); return; }
            if (!conn) { document.getElementById("searchFacilityResults").innerHTML = "<p>データベースに接続されていません</p>"; return; }
            showLoading();
            try {
                var sql = buildSearchFacilityQuery(keyword, typeId, includeAbolished, statusFilter, {
                    processingMethodId: methodId || null,
                    minDayCapacity: minCapacity,
                    permitTargetId: permitTargetId || null,
                    excludeSelf: excludeSelf,
                    itemIds: itemIds.length > 0 ? itemIds : null,
                    itemMatchMode: itemMatchMode
                });
                var rs = conn.Execute(sql);
                var html = "<table class='data-table'><tr><th>状態</th><th>事業者名</th><th>施設種別</th><th>処理方法</th><th>設置場所</th><th>許可番号</th><th>操作</th></tr>";
                var count = 0;
                while (!rs.EOF) {
                    count++;
                    var bizId = rs.Fields("事業者ID").Value;
                    var abolished = rs.Fields("廃止年月日").Value;
                    var methodNameVal = "";
                    try { methodNameVal = rs.Fields("処理方法名").Value || ""; } catch(e4) {}
                    html += "<tr" + (abolished ? " class='bg-row-inactive tc-muted'" : "") + ">";
                    html += "<td>" + (abolished ? statusBadge('abolished', '廃止') : statusBadge('active', '稼働中')) + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("事業者名").Value || "") + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("施設種別名").Value || "") + "</td>";
                    html += "<td>" + escapeHtml(methodNameVal) + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("設置場所").Value || "") + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("許可番号").Value || "") + "</td>";
                    html += "<td><button class='btn btn-primary btn-md' onclick='loadBusinessDetail(" + bizId + ")'>詳細</button></td>";
                    html += "</tr>";
                    rs.MoveNext();
                }
                rs.Close();
                html += "</table>";
                html = buildResultCountHtml(count, keyword) + html;
                hideLoading();
                document.getElementById("searchFacilityResults").innerHTML = html;
            } catch (e) { hideLoading(); document.getElementById("searchFacilityResults").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

