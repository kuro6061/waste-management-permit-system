        // ===== 事業者詳細 =====
        function getBusinessTabCounts(businessId) {
            var counts = { permits: 0, facilities: 0, vehicles: 0, officers: 0 };
            if (!conn) return counts;
            var rs;
            // 許可: 現行バージョン数（有効終了日時 IS NULLで各論理IDの最新1件）
            try {
                rs = conn.Execute(buildActivePermitCountQuery(businessId));
                counts.permits = rs.Fields("cnt").Value || 0; rs.Close();
            } catch (e) { /* ignore */ }
            // 施設: 現在有効な施設
            try {
                rs = conn.Execute(buildActiveFacilityCountQuery(businessId));
                counts.facilities = rs.Fields("cnt").Value || 0; rs.Close();
            } catch (e) { /* ignore */ }
            // 車両: 全件（タブ表示と一致）
            try {
                rs = conn.Execute(buildVehicleCountQuery(businessId));
                counts.vehicles = rs.Fields("cnt").Value || 0; rs.Close();
            } catch (e) { /* ignore */ }
            // 役員: 全件（タブ表示と一致）
            try {
                rs = conn.Execute(buildOfficerCountQuery(businessId));
                counts.officers = rs.Fields("cnt").Value || 0; rs.Close();
            } catch (e) { /* ignore */ }
            return counts;
        }

        function loadBusinessDetail(id) {
            currentDetailBusinessId = id;
            showPage("detail");
            if (!conn) { document.getElementById("businessDetail").innerHTML = "<p>データベースに接続されていません</p>"; return; }
            showLoading();
            try {
                var rs = conn.Execute(buildLoadBusinessDetailQuery(id));
                if (rs.EOF) { hideLoading(); document.getElementById("businessDetail").innerHTML = "<p>事業者が見つかりません</p>"; return; }
                var bizName = escapeHtml(rs.Fields("事業者名").Value || "");
                var bizInfo = "";
                bizInfo += "<div class='detail-row'><div class='detail-label'>事業者ID</div><div class='detail-value'>" + rs.Fields("事業者ID").Value + "</div></div>";
                bizInfo += "<div class='detail-row'><div class='detail-label'>郵便番号</div><div class='detail-value'>" + escapeHtml(rs.Fields("郵便番号").Value || "") + "</div></div>";
                bizInfo += "<div class='detail-row'><div class='detail-label'>都道府県</div><div class='detail-value'>" + escapeHtml(rs.Fields("都道府県").Value || "") + "</div></div>";
                bizInfo += "<div class='detail-row'><div class='detail-label'>住所</div><div class='detail-value'>" + escapeHtml(rs.Fields("市区町村町名番地").Value || "") + "</div></div>";
                bizInfo += "<div class='detail-row'><div class='detail-label'>電話番号</div><div class='detail-value'>" + escapeHtml(rs.Fields("電話番号").Value || "") + "</div></div>";
                bizInfo += "<div style='margin-top:16px;display:flex;align-items:center;'>";
                bizInfo += "<button class='btn btn-secondary' onclick='openBusinessForm(" + id + ")'>編集</button>";
                bizInfo += "<button class='btn btn-danger btn-sm' style='margin-left:auto;' onclick='deleteBusiness(" + id + ")'>削除</button></div>";
                rs.Close();
                var tabCounts = getBusinessTabCounts(id);
                var html = "<h2 style='margin-bottom:16px;'>" + bizName + "</h2>";
                html += "<div class='tab-container'><div class='tab-buttons'>";
                html += "<button class='tab-btn active' onclick='showTab(\"info\", this)'>基本情報</button>";
                html += "<button class='tab-btn' onclick='showTab(\"permits\", this)'>業 <span class='tab-badge'>" + tabCounts.permits + "</span></button>";
                html += "<button class='tab-btn' onclick='showTab(\"facilities\", this)'>施設 <span class='tab-badge'>" + tabCounts.facilities + "</span></button>";
                html += "<button class='tab-btn' onclick='showTab(\"vehicles\", this)'>車両 <span class='tab-badge'>" + tabCounts.vehicles + "</span></button>";
                html += "<button class='tab-btn' onclick='showTab(\"officers\", this)'>役員 <span class='tab-badge'>" + tabCounts.officers + "</span></button></div>";
                html += "<div id='tab-info' class='tab-pane' style='display:block;'>" + bizInfo + "</div>";
                html += "<div id='tab-permits' class='tab-pane' style='display:none;'>" + loadPermitsForBusiness(id) + "</div>";
                html += "<div id='tab-facilities' class='tab-pane' style='display:none;'>" + loadFacilitiesForBusiness(id) + "</div>";
                html += "<div id='tab-vehicles' class='tab-pane' style='display:none;'>" + loadVehiclesForBusiness(id) + "</div>";
                html += "<div id='tab-officers' class='tab-pane' style='display:none;'>" + loadOfficersForBusiness(id) + "</div></div>";
                hideLoading();
                document.getElementById("businessDetail").innerHTML = html;
            } catch (e) { hideLoading(); document.getElementById("businessDetail").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        // ===== 事業者入力フォーム =====
        function openBusinessForm(id) {
            formDirty = false;
            showPage("business-form");
            document.getElementById("businessFormMessage").innerHTML = "";
            loadBusinessTypes();

            if (id > 0) {
                // 編集モード
                document.getElementById("businessFormTitle").innerText = "事業者編集";
                document.getElementById("businessFormSubtitle").innerText = "Edit Business";
                document.getElementById("editBusinessId").value = id;
                loadBusinessForEdit(id);
                document.getElementById("businessDangerZone").style.display = "";
            } else {
                // 新規登録モード
                document.getElementById("businessFormTitle").innerText = "事業者登録";
                document.getElementById("businessFormSubtitle").innerText = "Business Registration";
                document.getElementById("editBusinessId").value = "0";
                clearBusinessForm();
                document.getElementById("businessDangerZone").style.display = "none";
            }
        }

        function loadBusinessTypes() {
            var select = document.getElementById("inputBusinessType");
            select.innerHTML = "<option value=''>-- 選択してください --</option>";
            if (!conn) return;
            try {
                var rs = conn.Execute(buildMasterListQuery("マスター_事業者区分", "事業者区分ID", "事業者区分名"));
                while (!rs.EOF) {
                    var opt = document.createElement("option");
                    opt.value = rs.Fields("事業者区分ID").Value;
                    opt.text = rs.Fields("事業者区分名").Value || "";
                    select.appendChild(opt);
                    rs.MoveNext();
                }
                rs.Close();
            } catch (e) { /* マスターがない場合は無視 */ }
        }

        function loadBusinessForEdit(id) {
            if (!conn) return;
            try {
                var rs = conn.Execute(buildLoadBusinessDetailQuery(id));
                if (!rs.EOF) {
                    document.getElementById("inputBusinessName").value = rs.Fields("事業者名").Value || "";
                    document.getElementById("inputBusinessType").value = rs.Fields("事業者区分").Value || "";
                    document.getElementById("inputZipCode").value = rs.Fields("郵便番号").Value || "";
                    document.getElementById("inputPrefecture").value = rs.Fields("都道府県").Value || "";
                    document.getElementById("inputAddress").value = rs.Fields("市区町村町名番地").Value || "";
                    document.getElementById("inputPhone").value = rs.Fields("電話番号").Value || "";
                }
                rs.Close();
            } catch (e) {
                showFormMessage("データの読み込みに失敗しました: " + e.message, true);
            }
        }

        function clearBusinessForm() {
            document.getElementById("inputBusinessName").value = "";
            document.getElementById("inputBusinessType").value = "";
            document.getElementById("inputZipCode").value = "";
            document.getElementById("inputPrefecture").value = "";
            document.getElementById("inputAddress").value = "";
            document.getElementById("inputPhone").value = "";
        }

        function saveBusiness() {
            var name = document.getElementById("inputBusinessName").value.trim();
            if (!name) {
                showFormMessage("事業者名を入力してください", true);
                return;
            }
            if (!conn) {
                showFormMessage("データベースに接続されていません", true);
                return;
            }

            var id = parseInt(document.getElementById("editBusinessId").value);
            var businessType = document.getElementById("inputBusinessType").value;
            var zipCode = normalizeToHankaku(document.getElementById("inputZipCode").value);
            var pref = document.getElementById("inputPrefecture").value;
            var address = normalizeToHankaku(document.getElementById("inputAddress").value);
            var phone = normalizeToHankaku(document.getElementById("inputPhone").value);

            try {
                var sql = buildSaveBusinessQuery({
                    id: id, name: name, businessType: businessType,
                    zipCode: zipCode, pref: pref, address: address, phone: phone
                });
                conn.Execute(sql);
                formDirty = false;
                showToast(id > 0 ? "更新しました" : "登録しました", "success");
                if (id > 0) {
                    // 既存事業者の編集 → 事業者詳細に遷移
                    loadBusinessDetail(id);
                } else {
                    // 新規登録 → 新しい事業者IDを取得して詳細に遷移
                    var idRs = conn.Execute(buildGetMaxBusinessIdQuery());
                    var newId = idRs.Fields("newId").Value;
                    idRs.Close();
                    loadBusinessDetail(newId);
                }
            } catch (e) {
                showFormMessage("保存に失敗しました: " + e.message, true);
            }
        }

        function deleteBusiness(id) {
            showConfirmDialog("事業者削除", "この事業者を削除しますか？\n関連する許可・施設・車両・役員データもすべて削除されます。\n\nこの操作は取り消せません。", {
                okText: "削除", okClass: "btn-danger",
                onOk: function() {
                    showConfirmDialog("最終確認", "本当に削除してよろしいですか？", {
                        okText: "削除する", okClass: "btn-danger",
                        onOk: function() {
                            if (!conn) { showToast("データベースに接続されていません", "error"); return; }
                            try {
                                var queries = buildDeleteBusinessQueries(id);
                                for (var qi = 0; qi < queries.length; qi++) {
                                    conn.Execute(queries[qi]);
                                }
                                showToast("削除しました", "info");
                                loadBusinessList();
                            } catch (e) {
                                showToast("削除に失敗しました: " + e.message, "error", 5000);
                            }
                        }
                    });
                }
            });
        }

        function deleteBusinessFromEdit() {
            var id = parseInt(document.getElementById("editBusinessId").value);
            if (!id) return;
            deleteBusiness(id);
        }

        function cancelBusinessForm() {
            goBack();
        }

        function showFormMessage(msg, isError) {
            var elem = document.getElementById("businessFormMessage");
            elem.innerHTML = "<div class='message " + (isError ? "error" : "success") + "'>" + escapeHtml(msg) + "</div>";
        }

        function getCurrentPage() {
            var pages = document.getElementsByClassName("page");
            for (var i = 0; i < pages.length; i++) {
                if (pages[i].className.indexOf("active") >= 0) {
                    return pages[i].id.replace("page-", "");
                }
            }
            return "home";
        }

        // ===== 許可・施設・車両タブ =====
        function loadPermitsForBusiness(businessId) {
            try {
                // 品目マスターを先に読み込み
                var itemNames = {};
                var irs = conn.Execute(buildMasterListQuery("マスター_品目", "品目ID", "品目名", "表示順"));
                while (!irs.EOF) {
                    itemNames[irs.Fields("品目ID").Value] = irs.Fields("品目名").Value;
                    irs.MoveNext();
                }
                irs.Close();

                var sql = buildLoadPermitsQuery(businessId);
                var rs = conn.Execute(sql);

                var seenLogicalIds = {};
                var permits = [];
                while (!rs.EOF) {
                    var logicalId = rs.Fields("許可論理ID").Value;
                    if (!seenLogicalIds[logicalId]) {
                        seenLogicalIds[logicalId] = true;
                        var cancelDateStr = rs.Fields("取消日文字列").Value || "";
                        var abolishDateStr = rs.Fields("廃止日文字列").Value || "";
                        permits.push({
                            permitId: rs.Fields("許可ID").Value,
                            logicalId: logicalId || "",
                            catId: rs.Fields("許可区分ID").Value,
                            permitNo: rs.Fields("許可番号").Value || "",
                            catName: rs.Fields("許可区分名").Value || "",
                            permitDate: rs.Fields("許可日文字列").Value || "",
                            validDate: rs.Fields("有効期限文字列").Value || "",
                            excellent: rs.Fields("優良認定").Value ? true : false,
                            isCanceled: cancelDateStr !== "",
                            isAbolished: abolishDateStr !== ""
                        });
                    }
                    rs.MoveNext();
                }
                rs.Close();

                var today = new Date();
                today.setHours(0, 0, 0, 0);
                var thirtyDaysLater = new Date(today.getTime() + 30 * 24 * 60 * 60 * 1000);

                var html = "<button class='btn-add' onclick='openPermitForm(" + businessId + ")'>+ 許可追加</button>";
                if (permits.length === 0) {
                    return html + "<p class='text-note'>許可の登録はまだありません。</p>";
                }

                for (var i = 0; i < permits.length; i++) {
                    var p = permits[i];
                    // ステータス判定
                    var statusHtml = "";
                    var cardCls = "facility-card";
                    if (p.isCanceled) {
                        statusHtml = statusBadge('cancelled', '取消');
                        cardCls += " abolished";
                    } else if (p.isAbolished) {
                        statusHtml = statusBadge('abolished', '廃止');
                        cardCls += " abolished";
                    } else if (p.validDate) {
                        var parts = p.validDate.split("/");
                        var vd = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
                        if (vd < today) {
                            statusHtml = "<span class='badge-expiry expired'>期限切れ</span>";
                        } else if (vd <= thirtyDaysLater) {
                            statusHtml = "<span class='badge-expiry soon'>期限間近</span>";
                        } else {
                            statusHtml = statusBadge('active', '有効');
                        }
                    } else {
                        statusHtml = statusBadge('active', '有効');
                    }

                    html += "<div class='" + cardCls + "' onclick='editPermitFromList(" + p.permitId + ", " + p.logicalId + ", " + businessId + ")'>";
                    // ヘッダー行: ステータス + 許可区分名 + 優良バッジ + 許可番号 + 詳細ボタン
                    html += "<div class='facility-card-header'>";
                    html += statusHtml;
                    html += "<span class='facility-card-title'>" + escapeHtml(p.catName) + "</span>";
                    if (p.excellent) html += "<span class='badge badge-blue'>&#9733; 優良</span>";
                    html += "<span class='facility-card-sub'>" + escapeHtml(p.permitNo) + "</span>";
                    html += "<button class='btn btn-primary btn-sm' style='margin-left:auto;' onclick='event.stopPropagation(); editPermitFromList(" + p.permitId + ", " + p.logicalId + ", " + businessId + ")'>詳細</button>";
                    html += "</div>";

                    // 基本情報行
                    html += "<div style='display:flex;flex-wrap:wrap;font-size:0.85em;color:#666;margin-bottom:4px;'>";
                    html += "<span style='margin-right:16px;'>許可日: " + escapeHtml(p.permitDate) + "</span>";
                    if (p.validDate) {
                        var vdStyle = "";
                        if (p.validDate && !p.isCanceled && !p.isAbolished) {
                            var vdParts = p.validDate.split("/");
                            var vdObj = new Date(parseInt(vdParts[0], 10), parseInt(vdParts[1], 10) - 1, parseInt(vdParts[2], 10));
                            if (vdObj < today) vdStyle = "color:#ff3b30;font-weight:600;";
                            else if (vdObj <= thirtyDaysLater) vdStyle = "color:#e65100;font-weight:600;";
                        }
                        html += "<span style='" + vdStyle + "'>有効期限: " + escapeHtml(p.validDate) + "</span>";
                    }
                    html += "</div>";

                    // 許可品目
                    try {
                        var prs = conn.Execute(buildLoadPermitItemsQuery(p.permitId));
                        var handlingItems = [];
                        var transferItems = [];
                        while (!prs.EOF) {
                            var itemId = prs.Fields("品目ID").Value;
                            var handling = prs.Fields("取り扱いフラグ").Value;
                            var transfer = prs.Fields("積替保管フラグ").Value;
                            var iName = itemNames[itemId] || ("品目" + itemId);
                            if (transfer) transferItems.push(iName);
                            else if (handling) handlingItems.push(iName);
                            prs.MoveNext();
                        }
                        prs.Close();
                        if (handlingItems.length > 0 || transferItems.length > 0) {
                            html += "<div class='facility-card-col-label'>取扱品目</div>";
                            html += "<div style='display:flex;flex-wrap:wrap;'>";
                            for (var hi = 0; hi < handlingItems.length; hi++) {
                                html += "<span class='item-badge handling' style='margin:0 4px 4px 0;'>" + escapeHtml(handlingItems[hi]) + " 〇</span>";
                            }
                            for (var ti = 0; ti < transferItems.length; ti++) {
                                html += "<span class='item-badge transfer' style='margin:0 4px 4px 0;'>" + escapeHtml(transferItems[ti]) + " ◎</span>";
                            }
                            html += "</div>";
                        }
                    } catch (pe) {}

                    html += "</div>";
                }
                return html;
            } catch (e) { return "<p>エラー [許可一覧]: " + e.message + "</p>"; }
        }

        // モーダルダイアログ関連
        var modalCallback = null;
        function showModal(title, message, okBtnText, callback) {
            document.getElementById("modalTitle").innerText = title;
            document.getElementById("modalMessage").innerText = message;
            document.getElementById("modalInput").value = "";
            document.getElementById("modalOkBtn").innerText = okBtnText || "OK";
            document.getElementById("modalOverlay").style.display = "block";
            modalCallback = callback;
            document.getElementById("modalInput").focus();
        }
        function modalOk() {
            var value = document.getElementById("modalInput").value;
            document.getElementById("modalOverlay").style.display = "none";
            if (modalCallback) modalCallback(value);
        }
        function modalCancel() {
            document.getElementById("modalOverlay").style.display = "none";
            modalCallback = null;
        }

        // 詳細画面からの廃止（日付入力対応）
        function abolishPermitFromDetail() {
            var dateStr = document.getElementById("detail-abolish-date").value;
            if (!dateStr) { showToast("廃止日を選択してください", "error"); return; }
            var reason = document.getElementById("detail-abolish-reason").value || "";
            showConfirmDialog("許可廃止", "この許可を廃止しますか？\n廃止日: " + dateStr, {
                okText: "廃止する", okClass: "btn-warning",
                onOk: function() {
                    try {
                        conn.Execute(buildAbolishPermitQuery(currentDetailPermitId, dateStr, reason));
                        showToast("廃止しました", "info");
                        showPermitDetail(currentDetailPermitId, currentDetailLogicalId, currentDetailBusinessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        // 詳細画面からの取消（日付入力対応）
        function cancelPermitFromDetail() {
            var dateStr = document.getElementById("detail-cancel-date").value;
            if (!dateStr) { showToast("取消日を選択してください", "error"); return; }
            var reason = document.getElementById("detail-cancel-reason").value || "";
            showConfirmDialog("許可取消", "この許可を取消しますか？\n取消日: " + dateStr, {
                okText: "取消する", okClass: "btn-danger",
                onOk: function() {
                    try {
                        conn.Execute(buildCancelPermitQuery(currentDetailPermitId, dateStr, reason));
                        showToast("取消しました", "info");
                        showPermitDetail(currentDetailPermitId, currentDetailLogicalId, currentDetailBusinessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        // 詳細画面からの復活
        function restorePermitFromDetail() {
            showConfirmDialog("許可復活", "この許可を復活しますか？\n（廃止日・取消日と理由がクリアされます）", {
                okText: "復活する", okClass: "btn-success",
                onOk: function() {
                    try {
                        // 同じ論理IDで既にアクティブなバージョンがあるか確認
                        var chkRs = conn.Execute(buildCheckActiveVersionExistsQuery("許可", "許可論理ID", currentDetailLogicalId, currentDetailPermitId, "許可ID"));
                        var activeCnt = chkRs.Fields("cnt").Value;
                        chkRs.Close();
                        if (activeCnt > 0) {
                            showToast("同じ論理IDで既にアクティブな許可があるため復活できません", "error", 5000);
                            return;
                        }
                        conn.Execute(buildRestorePermitQuery(currentDetailPermitId));
                        showToast("復活しました", "success");
                        showPermitDetail(currentDetailPermitId, currentDetailLogicalId, currentDetailBusinessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        // 許可品目一覧を全画面表示（統合版）
        var currentItemsPermitId = 0;
        var currentItemsBusinessId = 0;
        var currentItemsContext = "detail"; // "detail" or "history"
        var currentPermitHistoryLogicalId = 0;
        var currentPermitHistoryBusinessId = 0;

        function showPermitItemsView(permitId, businessId, fromContext) {
            currentItemsPermitId = permitId;
            currentItemsBusinessId = businessId;
            currentItemsContext = fromContext || "detail";
            try {
                var allItems = [];
                var rs = conn.Execute(buildMasterListQuery("マスター_品目", "品目ID", "品目名", "表示順"));
                while (!rs.EOF) {
                    allItems.push({ id: rs.Fields("品目ID").Value, name: rs.Fields("品目名").Value });
                    rs.MoveNext();
                }
                rs.Close();

                var permitItems = {};
                rs = conn.Execute(buildLoadPermitItemsQuery(permitId));
                while (!rs.EOF) {
                    permitItems[rs.Fields("品目ID").Value] = {
                        handling: rs.Fields("取り扱いフラグ").Value,
                        transfer: rs.Fields("積替保管フラグ").Value
                    };
                    rs.MoveNext();
                }
                rs.Close();

                var titleSuffix = (fromContext === "history") ? "（履歴）" : "";
                var html = "<h4>許可ID " + permitId + " の取扱品目" + titleSuffix + "</h4>";
                html += "<p class='text-note' style='margin-bottom:10px;'>×: なし / 〇: 取り扱い / ◎: 積替保管（クリックで切替）</p>";
                html += "<div style='overflow-x:auto;'>";
                html += "<table class='data-table' style='table-layout:fixed;'>";
                html += "<tr>";
                for (var i = 0; i < allItems.length; i++) {
                    var name = allItems[i].name;
                    var vertical = "";
                    for (var j = 0; j < name.length; j++) {
                        vertical += name.charAt(j) + "<br>";
                    }
                    html += "<th style='text-align:center;padding:5px 3px;font-size:0.75em;line-height:1.1;width:28px;vertical-align:top;'>" + vertical + "</th>";
                }
                html += "</tr><tr>";
                for (var i = 0; i < allItems.length; i++) {
                    var item = allItems[i];
                    var pi = permitItems[item.id] || { handling: false, transfer: false };
                    var mark;
                    if (pi.transfer) {
                        mark = "<span class='mark-transfer' style='font-size:1.3em;'>◎</span>";
                    } else if (pi.handling) {
                        mark = "<span class='mark-handling' style='font-size:1.3em;'>〇</span>";
                    } else {
                        mark = "<span class='mark-none' style='font-size:1.1em;'>×</span>";
                    }
                    html += "<td style='text-align:center;cursor:pointer;padding:10px 3px;' onclick='cyclePermitItemFullscreen(" + permitId + ", " + item.id + ")'>" + mark + "</td>";
                }
                html += "</tr></table></div>";
                html += "<button class='btn btn-secondary' style='margin-top:15px;' onclick='closePermitItemsView()'>戻る</button>";
                document.getElementById("tab-permits").innerHTML = html;
            } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
        }

        // 後方互換ラッパー
        function showPermitItems(permitId, businessId) { showPermitItemsView(permitId, businessId, "detail"); }
        function showPermitItemsFromHistory(permitId, logicalId, businessId) {
            currentPermitHistoryLogicalId = logicalId;
            currentPermitHistoryBusinessId = businessId;
            showPermitItemsView(permitId, businessId, "history");
        }

        function cyclePermitItemFullscreen(permitId, itemId) {
            try {
                var queries = buildPermitItemQueries(permitId, itemId);
                var rs = conn.Execute(queries.select);
                if (rs.EOF) {
                    rs.Close();
                    conn.Execute(queries.insert);
                } else {
                    var recId = rs.Fields("許可品目ID").Value;
                    var handling = rs.Fields("取り扱いフラグ").Value;
                    var transfer = rs.Fields("積替保管フラグ").Value;
                    rs.Close();
                    if (transfer) {
                        conn.Execute(queries.remove(recId));
                    } else if (handling) {
                        conn.Execute(queries.toTransfer(recId));
                    }
                }
                showPermitItemsView(permitId, currentItemsBusinessId, currentItemsContext);
            } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
        }

        function closePermitItemsView() {
            if (currentItemsContext === "history") {
                showPermitHistory(currentPermitHistoryLogicalId, currentPermitHistoryBusinessId);
            } else {
                showPermitDetail(currentDetailPermitId, currentDetailLogicalId, currentDetailBusinessId);
            }
        }

        // 許可追加フォーム
        var currentPermitBusinessId = 0;
        var newPermitPendingItems = {}; // 新規許可作成時の品目一時保持 {itemId: "handling"|"transfer"}

        function openPermitForm(businessId) {
            currentPermitBusinessId = businessId;
            newPermitPendingItems = {};
            // 許可区分マスターを取得
            var catOptions = "<option value=''>選択してください</option>";
            try {
                var rs = conn.Execute(buildMasterListQuery("マスター_許可区分", "許可区分ID", "許可区分名"));
                while (!rs.EOF) {
                    catOptions += "<option value='" + rs.Fields("許可区分ID").Value + "'>" + escapeHtml(rs.Fields("許可区分名").Value) + "</option>";
                    rs.MoveNext();
                }
                rs.Close();
            } catch (e) {}

            var html = buildStepNav([
                {label: "業一覧", onclick: "refreshPermitsTab(" + businessId + ")"},
                {label: "業追加"}
            ], 1);
            html += "<div class='form-card'>";
            html += "<h2>業追加</h2>";
            html += "<div class='form-group'><label>許可区分 <span class='badge-required'>必須</span></label>";
            html += "<select id='pCategory' onchange='onNewPermitCategoryChange()'>" + catOptions + "</select></div>";
            html += "<div class='form-group'><label>許可番号 <span class='badge-required'>必須</span></label>";
            html += "<input type='text' id='pNumber' placeholder='例: 01234567890' oninput='this.value=normalizeToHankaku(this.value)'>";
            html += "<span class='auto-label'>※ 半角数字11桁（例: 01234567890）</span></div>";
            html += "<div class='form-row'>";
            html += "<div class='form-group'><label>許可年月日 <span class='badge-required'>必須</span></label><div class='datepicker-wrapper'><input type='text' id='pDate' class='datepicker-input' onclick='openDatePicker(\"pDate\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
            html += "<div class='form-group'><label>許可有効年月日 <span class='badge-required'>必須</span></label><div class='datepicker-wrapper'><input type='text' id='pValidDate' class='datepicker-input' onclick='openDatePicker(\"pValidDate\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
            html += "</div>";
            html += "<div class='form-group'><label for='pExcellent' style='display:inline-block;cursor:pointer;'><span class='toggle-switch'><input type='checkbox' id='pExcellent'><span class='toggle-slider'></span></span> 優良認定</label></div>";
            html += "</div>";
            // 品目セクション（許可区分選択後に表示）
            html += "<div class='form-card' style='margin-top:16px;'>";
            html += "<h2>取扱品目</h2>";
            html += "<div id='newPermitItemsGrid'><p class='auto-label'>許可区分を選択すると品目が表示されます</p></div>";
            html += "</div>";
            // ボタン
            html += "<div class='form-buttons' style='margin-top:16px;'>";
            html += "<button class='btn btn-primary' onclick='savePermit()'>保存</button>";
            html += "<button class='btn btn-secondary' onclick='cancelPermitForm()'>キャンセル</button>";
            html += "</div>";
            document.getElementById("tab-permits").innerHTML = html;
        }

        function onNewPermitCategoryChange() {
            var catId = document.getElementById("pCategory").value;
            newPermitPendingItems = {};
            if (!catId) {
                document.getElementById("newPermitItemsGrid").innerHTML = "<p class='auto-label'>許可区分を選択すると品目が表示されます</p>";
                return;
            }
            renderNewPermitItemsGrid(parseInt(catId));
        }

        function renderNewPermitItemsGrid(categoryId) {
            try {
                var isSpecial = isSpecialWasteCategory(categoryId);
                var itemFilter = isSpecial ? " WHERE 品目ID >= " + ITEM_SPECIAL_THRESHOLD : " WHERE 品目ID < " + ITEM_SPECIAL_THRESHOLD;
                if (!categoryId) itemFilter = "";

                var allItems = [];
                var rs = conn.Execute("SELECT 品目ID, 品目名 FROM マスター_品目" + itemFilter + " ORDER BY 表示順");
                while (!rs.EOF) {
                    allItems.push({id: rs.Fields("品目ID").Value, name: rs.Fields("品目名").Value});
                    rs.MoveNext();
                }
                rs.Close();

                var colsPerRow = 10;
                var totalItems = allItems.length;
                var rows = Math.ceil(totalItems / colsPerRow);
                var html = "";
                for (var r = 0; r < rows; r++) {
                    var start = r * colsPerRow;
                    var end = Math.min(start + colsPerRow, totalItems);
                    var colCount = end - start;
                    html += "<table style='border-collapse:collapse;width:100%;table-layout:fixed;" + (r > 0 ? "margin-top:-1px;" : "") + "'><tr>";
                    for (var i = start; i < end; i++) {
                        html += "<th class='item-edit-th-hz bg-table-header'>" + escapeHtml(allItems[i].name) + "</th>";
                    }
                    for (var pad = colCount; pad < colsPerRow; pad++) {
                        html += "<th style='border:1px solid transparent;background:transparent;'></th>";
                    }
                    html += "</tr><tr>";
                    for (var i = start; i < end; i++) {
                        var state = newPermitPendingItems[allItems[i].id] || "";
                        var mark;
                        if (state === "transfer") {
                            mark = "<span class='mark-transfer' style='font-size:1.3em;'>◎</span>";
                        } else if (state === "handling") {
                            mark = "<span class='mark-handling' style='font-size:1.3em;'>〇</span>";
                        } else {
                            mark = "<span class='mark-none'>×</span>";
                        }
                        html += "<td class='item-edit-td-hz' onclick='cycleNewPermitItem(" + allItems[i].id + ")'>" + mark + "</td>";
                    }
                    for (var pad = colCount; pad < colsPerRow; pad++) {
                        html += "<td style='border:1px solid transparent;'></td>";
                    }
                    html += "</tr></table>";
                }
                html += "<p class='auto-label' style='margin-top:5px;'>〇=取扱 ◎=積替保管 ×=なし（クリックで切替）</p>";
                document.getElementById("newPermitItemsGrid").innerHTML = html;
            } catch (e) {
                document.getElementById("newPermitItemsGrid").innerHTML = "<p>品目読み込みエラー: " + e.message + "</p>";
            }
        }

        function cycleNewPermitItem(itemId) {
            var current = newPermitPendingItems[itemId] || "";
            if (current === "") {
                newPermitPendingItems[itemId] = "handling";
            } else if (current === "handling") {
                newPermitPendingItems[itemId] = "transfer";
            } else {
                delete newPermitPendingItems[itemId];
            }
            var catId = document.getElementById("pCategory").value;
            renderNewPermitItemsGrid(parseInt(catId));
        }

        // 許可を保存（品目も一括保存）
        function savePermit() {
            var catId = document.getElementById("pCategory").value;
            var number = normalizePermitNumber(document.getElementById("pNumber").value);
            var pDate = document.getElementById("pDate").value.trim();
            var validDate = document.getElementById("pValidDate").value.trim();
            var excellent = document.getElementById("pExcellent").checked;

            if (!catId || !number || !pDate || !validDate) {
                showToast("許可区分、許可番号、許可年月日、許可有効年月日は必須です", "error");
                return;
            }

            try {
                // トランザクションで論理ID採番+INSERT+品目INSERT を排他的に実行
                conn.BeginTrans();
                var newLogicalId, newPermitId;
                try {
                    var maxRs = conn.Execute(buildGetNextLogicalIdQuery("許可", "許可論理ID"));
                    newLogicalId = (maxRs.Fields("maxId").Value || 0) + 1;
                    maxRs.Close();

                    var todayStr = buildDateStr();

                    var sql = buildSavePermitQuery({
                        logicalId: newLogicalId, businessId: currentPermitBusinessId,
                        categoryId: catId, number: number,
                        permitDate: pDate, validDate: validDate,
                        excellent: excellent, todayStr: todayStr
                    });
                    conn.Execute(sql);
                    // ID取得もトランザクション内で実行
                    var newPermitRs = conn.Execute(buildGetMaxIdQuery("許可", "許可ID", "許可論理ID", newLogicalId));
                    newPermitId = newPermitRs.Fields("newId").Value;
                    newPermitRs.Close();

                    // 品目を一括保存
                    var itemCount = 0;
                    for (var itemId in newPermitPendingItems) {
                        if (newPermitPendingItems.hasOwnProperty(itemId)) {
                            var state = newPermitPendingItems[itemId];
                            var handling = (state === "handling" || state === "transfer");
                            var transfer = (state === "transfer");
                            conn.Execute(buildInsertPermitItemQuery(newPermitId, parseInt(itemId), handling, transfer));
                            itemCount++;
                        }
                    }

                    conn.CommitTrans();
                } catch (txErr) {
                    conn.RollbackTrans();
                    throw txErr;
                }
                newPermitPendingItems = {};
                var msg = "保存しました";
                if (itemCount > 0) msg += "（品目 " + itemCount + " 件）";
                showToast(msg, "success");
                showPermitEditForm(newPermitId, newLogicalId, currentPermitBusinessId, "edit");
            } catch (e) { showToast("保存エラー: " + e.message, "error", 5000); }
        }

        // 許可フォームをキャンセル
        function cancelPermitForm() {
            document.getElementById("tab-permits").innerHTML = loadPermitsForBusiness(currentPermitBusinessId);
        }

        // ===== タイムライン共通ユーティリティ =====
        function dateStrToDays(s) {
            if (!s) return NaN;
            var parts = s.split("/");
            return Math.floor(Date.UTC(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10)) / 86400000);
        }
        function daysToDateStr(days) {
            var d = new Date(days * 86400000);
            return d.getUTCFullYear() + "/" + ("0" + (d.getUTCMonth() + 1)).slice(-2) + "/" + ("0" + d.getUTCDate()).slice(-2);
        }
        function todayDateStr() {
            var d = new Date();
            return d.getFullYear() + "/" + ("0" + (d.getMonth() + 1)).slice(-2) + "/" + ("0" + d.getDate()).slice(-2);
        }

        // ===== 境界日ピッカー =====
        var _bpYear = 0, _bpMonth = 0;
        var _bpMinDays = 0, _bpMaxDays = 0;
        var _bpCurrentDateStr = "";
        var _bpSaveCallback = null;
        var _bpAnchorEl = null;

        function openBoundaryPicker(anchorEl, currentDateStr, minDays, maxDays, saveCallback) {
            closeBoundaryPicker();
            _bpAnchorEl = anchorEl;
            _bpCurrentDateStr = currentDateStr;
            _bpMinDays = minDays;
            _bpMaxDays = maxDays;
            _bpSaveCallback = saveCallback;

            var parts = currentDateStr.split("/");
            _bpYear = parseInt(parts[0], 10);
            _bpMonth = parseInt(parts[1], 10) - 1;

            var popup = document.createElement("div");
            popup.id = "boundary-picker-popup";
            popup.className = "boundary-picker-popup";
            renderBoundaryPicker(popup);
            anchorEl.appendChild(popup);
        }

        function closeBoundaryPicker() {
            var old = document.getElementById("boundary-picker-popup");
            if (old && old.parentNode) old.parentNode.removeChild(old);
            _bpSaveCallback = null;
            _bpAnchorEl = null;
        }

        function renderBoundaryPicker(popup) {
            if (!popup) popup = document.getElementById("boundary-picker-popup");
            if (!popup) return;

            var html = "<table style='width:100%;border-collapse:collapse;'><tr>";
            html += "<td style='text-align:left;'><button onclick='bpPrev();event.stopPropagation();' class='cal-nav-btn' style='padding:2px 8px;'>&lt;</button></td>";
            html += "<td class='bp-month-title'>" + _bpYear + "年 " + (_bpMonth + 1) + "月</td>";
            html += "<td style='text-align:right;'><button onclick='bpNext();event.stopPropagation();' class='cal-nav-btn' style='padding:2px 8px;'>&gt;</button></td>";
            html += "</tr></table>";

            html += "<table style='width:100%;border-collapse:collapse;margin-top:5px;'>";
            var dows = ["日","月","火","水","木","金","土"];
            html += "<tr>";
            for (var d = 0; d < 7; d++) {
                var dowCls = d === 0 ? "tc-sun" : (d === 6 ? "tc-sat" : "tc-muted");
                html += "<td class='" + dowCls + "' style='text-align:center;font-size:11px;padding:3px;'>" + dows[d] + "</td>";
            }
            html += "</tr>";

            var firstDay = new Date(_bpYear, _bpMonth, 1).getDay();
            var daysInMonth = new Date(_bpYear, _bpMonth + 1, 0).getDate();
            var today = new Date();
            var todayStr = today.getFullYear() + "/" + padZero2(today.getMonth() + 1) + "/" + padZero2(today.getDate());
            var cellCount = 0;
            html += "<tr>";
            for (var i = 0; i < firstDay; i++) { html += "<td></td>"; cellCount++; }
            for (var day = 1; day <= daysInMonth; day++) {
                var dateStr = _bpYear + "/" + padZero2(_bpMonth + 1) + "/" + padZero2(day);
                var dayNum = dateStrToDays(dateStr);
                var inRange = (dayNum >= _bpMinDays && dayNum <= _bpMaxDays);
                var isSelected = (dateStr === _bpCurrentDateStr);
                var isToday = (dateStr === todayStr);

                var cls = "bp-day";
                if (!inRange) cls += " disabled";
                if (isSelected) cls += " selected";
                if (isToday) cls += " today";

                var dow = (firstDay + day - 1) % 7;
                var dowCls = "";
                if (dow === 0) dowCls = " tc-sun";
                if (dow === 6) dowCls = " tc-sat";

                if (inRange) {
                    html += "<td class='" + cls + dowCls + "' onclick='bpSelect(\"" + dateStr + "\");event.stopPropagation();'>" + day + "</td>";
                } else {
                    html += "<td class='" + cls + dowCls + "'>" + day + "</td>";
                }
                cellCount++;
                if (cellCount % 7 === 0 && day < daysInMonth) html += "</tr><tr>";
            }
            while (cellCount % 7 !== 0) { html += "<td></td>"; cellCount++; }
            html += "</tr></table>";

            html += "<div style='text-align:center;margin-top:8px;'>";
            html += "<button onclick='closeBoundaryPicker();event.stopPropagation();' class='btn-close-sm'>閉じる</button>";
            html += "</div>";

            popup.innerHTML = html;
        }

        function bpPrev() { _bpMonth--; if (_bpMonth < 0) { _bpMonth = 11; _bpYear--; } renderBoundaryPicker(); }
        function bpNext() { _bpMonth++; if (_bpMonth > 11) { _bpMonth = 0; _bpYear++; } renderBoundaryPicker(); }

        function bpSelect(dateStr) {
            if (_bpSaveCallback) {
                _bpSaveCallback(dateStr);
            }
            closeBoundaryPicker();
        }

        // ===== タイムラインバー生成（許可・施設共通） =====
        function buildTimelineBars(disp, todayDays, minDays, totalSpan, getLabel, getId, getStatus) {
            var html = "<div class='timeline-bar-area' style='position:relative;'>";
            for (var i = 0; i < disp.length; i++) {
                var v = disp[i];
                var sD = dateStrToDays(v.startDateStr);
                var eD = v.endDateStr ? dateStrToDays(v.endDateStr) : todayDays;
                var leftPct = ((sD - minDays) / totalSpan * 100);
                var widthPct = ((eD - sD) / totalSpan * 100);
                if (widthPct < 0.5) widthPct = 0.5;

                var cls = "timeline-bar " + getStatus(v);
                html += "<div class='" + cls + "' style='left:" + leftPct.toFixed(2) + "%;width:" + widthPct.toFixed(2) + "%;' ";
                html += "title='" + getId(v) + "&#10;" + v.startDateStr + " ～ " + (v.endDateStr || "現在") + "'>";
                html += "<span style='font-size:10px;'>" + escapeHtml(getLabel(v)) + "</span>";
                html += "</div>";

                // イベントマーカー（バー上部）
                var evtColor = getStatus(v) === "active" ? "#4CAF50" : getStatus(v) === "cancelled" ? "#ef5350" : getStatus(v) === "abolished" ? "#9e9e9e" : "#2d5a87";
                html += "<div style='position:absolute; top:-20px; left:" + leftPct.toFixed(2) + "%; font-size:9px; color:" + evtColor + "; font-weight:bold;'>&#x25BC; " + escapeHtml(getLabel(v)) + "</div>";
            }

            // 空白期間ラベル
            for (var i = 0; i < disp.length - 1; i++) {
                var prevEnd = disp[i].endDateStr;
                if (prevEnd) {
                    var gapStart = dateStrToDays(prevEnd);
                    var gapEnd = dateStrToDays(disp[i+1].startDateStr);
                    if (gapEnd > gapStart + 1) {
                        var gapLeft = ((gapStart - minDays) / totalSpan * 100);
                        var gapWidth = ((gapEnd - gapStart) / totalSpan * 100);
                        html += "<div style='position:absolute; top:14px; left:" + gapLeft.toFixed(2) + "%; width:" + gapWidth.toFixed(2) + "%; text-align:center; font-size:9px; color:#e53935; font-weight:bold;'>空白</div>";
                    }
                }
            }

            // 「現在」マーカー
            var todayPct = ((todayDays - minDays) / totalSpan * 100);
            if (todayPct > 0 && todayPct <= 100) {
                html += "<div style='position:absolute; top:-22px; left:" + todayPct.toFixed(2) + "%; font-size:9px; color:#ff3b30; font-weight:bold; text-align:center; margin-left:-10px;'>現在<br>&#x25BC;</div>";
                html += "<div style='position:absolute; top:0; left:" + todayPct.toFixed(2) + "%; width:2px; height:48px; background:#ff3b30; z-index:10;'></div>";
            }

            return html;
        }

        // ===== 許可タイムラインHTML生成 =====
        function buildPermitTimelineHtml(versions, logicalId, businessId) {
            var disp = versions.slice(); // ASC順（古い→新しい）
            var today = todayDateStr();
            var todayDays = dateStrToDays(today);

            var minDays = dateStrToDays(disp[0].startDateStr);
            var maxDays = todayDays;
            for (var i = 0; i < disp.length; i++) {
                var ed = disp[i].endDateStr ? dateStrToDays(disp[i].endDateStr) : todayDays;
                if (ed > maxDays) maxDays = ed;
            }
            var totalSpan = maxDays - minDays;
            if (totalSpan <= 0) totalSpan = 1;

            var html = "<div class='timeline-section'>";
            html += "<h4>有効期間タイムライン <span class='timeline-hint'>（境界の日付をクリックして変更）</span></h4>";

            // バー描画（イベント種別ラベル）
            html += buildTimelineBars(disp, todayDays, minDays, totalSpan,
                function(v) {
                    var idx = -1;
                    for (var j = 0; j < disp.length; j++) { if (disp[j] === v) { idx = j; break; } }
                    if (idx === 0) return "新規";
                    if (v.isExpiredNew) return "失効新規";
                    if (v.isChange) return "変更";
                    // フラグがない旧データ: 前版との間に空白があれば失効新規
                    if (idx > 0) {
                        var prevEnd = disp[idx-1].endDateStr;
                        if (prevEnd && dateStrToDays(v.startDateStr) > dateStrToDays(prevEnd) + 1) return "失効新規";
                    }
                    return "更新";
                },
                function(v) { return "許可ID:" + v.permitId; },
                function(v) {
                    if (v.cancelDateStr) return "cancelled";
                    if (v.abolishDateStr) return "abolished";
                    if (!v.endDateStr) return "active";
                    return "expired";
                }
            );

            // 境界マーカー（バーエリア内に配置）
            for (var i = 0; i < disp.length - 1; i++) {
                var older = disp[i];
                var newer = disp[i + 1];
                var boundaryStr = newer.startDateStr;
                var boundaryDays = dateStrToDays(boundaryStr);
                var bPct = ((boundaryDays - minDays) / totalSpan * 100);

                var bMin = dateStrToDays(older.startDateStr) + 1;
                var bMax = newer.endDateStr ? dateStrToDays(newer.endDateStr) - 1 : todayDays;
                var canEdit = (bMin <= bMax);

                html += "<div class='timeline-boundary' style='left:" + bPct.toFixed(2) + "%;' ";
                if (canEdit) {
                    html += "onclick='openPermitBoundaryPicker(this, \"" + boundaryStr + "\", " + bMin + ", " + bMax + ", " + older.permitId + ", " + newer.permitId + ", " + logicalId + ", " + businessId + ");event.stopPropagation();'";
                }
                html += ">";
                html += "<div class='boundary-line'></div>";
                html += "<div class='boundary-label'>" + boundaryStr + "</div>";
                html += "</div>";
            }

            html += "</div>"; // timeline-bar-area

            // 日付ラベル
            html += "<div class='timeline-dates'>";
            html += "<span>" + disp[0].startDateStr + "</span>";
            html += "<span>" + (disp[disp.length - 1].endDateStr || today) + "</span>";
            html += "</div>";

            html += "</div>"; // timeline-section
            return html;
        }

        function openPermitBoundaryPicker(el, dateStr, minDays, maxDays, olderId, newerId, logicalId, businessId) {
            openBoundaryPicker(el, dateStr, minDays, maxDays, function(newDateStr) {
                try {
                    conn.BeginTrans();
                    try {
                        conn.Execute(buildUpdateBoundaryDateQuery("許可", "許可ID", olderId, "有効終了日時", newDateStr));
                        conn.Execute(buildUpdateBoundaryDateQuery("許可", "許可ID", newerId, "有効開始日時", newDateStr));
                        conn.CommitTrans();
                    } catch (txErr) {
                        conn.RollbackTrans();
                        throw txErr;
                    }
                    // コンテキストに応じて更新
                    var inlineContent = document.getElementById("permit-history-content");
                    if (inlineContent) {
                        loadPermitHistoryInline(logicalId, businessId);
                    } else {
                        showPermitHistory(logicalId, businessId);
                    }
                } catch (e) { showToast("境界日の更新エラー: " + e.message, "error", 5000); }
            });
        }

        // 許可履歴表示（タブ内で表示）
        function showPermitHistory(logicalId, businessId) {
            try {
                currentPermitHistoryLogicalId = logicalId;
                currentPermitHistoryBusinessId = businessId;
                var rs = conn.Execute(buildLoadPermitHistoryQuery(logicalId));

                // バージョンデータ収集（ASC順：古い順、下が新しい）
                var versions = [];
                while (!rs.EOF) {
                    versions.push({
                        permitId: rs.Fields("許可ID").Value,
                        permitNumber: rs.Fields("許可番号").Value || "",
                        categoryName: rs.Fields("許可区分名").Value || "",
                        permitDateStr: rs.Fields("許可日文字列").Value || "",
                        validDateStr: rs.Fields("許可有効期限文字列").Value || "",
                        startDateStr: rs.Fields("有効開始文字列").Value || "",
                        endDateStr: rs.Fields("有効終了文字列").Value || "",
                        cancelDateStr: rs.Fields("取消日文字列").Value || "",
                        abolishDateStr: rs.Fields("廃止日文字列").Value || "",
                        isChange: rs.Fields("変更許可フラグ").Value ? true : false,
                        isExpiredNew: rs.Fields("失効新規フラグ").Value ? true : false
                    });
                    rs.MoveNext();
                }
                rs.Close();

                var html = "<h4>許可論理ID: " + logicalId + " の履歴</h4>";

                // タイムライン表示（全バージョンに有効開始日時がある場合のみ）
                var allHaveStartDate = versions.length >= 2;
                for (var ci = 0; ci < versions.length; ci++) {
                    if (!versions[ci].startDateStr) { allHaveStartDate = false; break; }
                }
                if (allHaveStartDate) {
                    html += buildPermitTimelineHtml(versions, logicalId, businessId);
                } else if (versions.length >= 2) {
                    html += "<p class='timeline-warn'>※ 有効開始日時が未設定のレコードがあるため、タイムラインを表示できません。設定画面の「データメンテナンス」から一括補完してください。</p>";
                }

                // テーブル表示
                html += "<table class='data-table'><tr><th>許可ID</th><th>許可番号</th><th>許可区分</th><th>許可年月日</th><th>許可有効年月日</th><th>状態</th><th>操作</th></tr>";
                for (var vi = 0; vi < versions.length; vi++) {
                    var v = versions[vi];
                    var hasEndDate = (v.endDateStr !== "" && v.endDateStr !== null);

                    var status = statusBadge('active', '有効');
                    if (v.cancelDateStr) {
                        status = statusBadge('cancelled', '取消(' + v.cancelDateStr + ')');
                    } else if (v.abolishDateStr) {
                        status = statusBadge('abolished', '廃止(' + v.abolishDateStr + ')');
                    } else if (hasEndDate) {
                        status = statusBadge('lapsed', '失効');
                    }

                    html += "<tr" + (hasEndDate ? " class='bg-row-inactive'" : "") + ">";
                    html += "<td>" + v.permitId + "</td>";
                    html += "<td>" + escapeHtml(v.permitNumber) + "</td>";
                    html += "<td>" + escapeHtml(v.categoryName) + "</td>";
                    html += "<td>" + escapeHtml(v.permitDateStr) + "</td>";
                    html += "<td>" + (v.validDateStr ? escapeHtml(v.validDateStr) : "-") + "</td>";
                    html += "<td>" + status + "</td>";
                    html += "<td>";
                    html += "<button class='btn btn-primary btn-sm' onclick='editPermitHistory(" + v.permitId + ", " + logicalId + ", " + businessId + ")'>編集</button>";
                    html += "</td>";
                    html += "</tr>";
                }
                html += "</table>";
                html += "<div style='margin-top:10px;'>";
                html += "<button class='btn btn-primary' style='margin-right:5px;' onclick='showPermitRenewalForm(" + logicalId + ", " + businessId + ")'>更新</button>";
                html += "<button class='btn btn-warning' style='margin-right:5px;' onclick='showPermitChangeForm(" + logicalId + ", " + businessId + ")'>変更</button>";
                html += "<button class='btn btn-secondary' onclick='refreshPermitsTab(" + businessId + ")'>一覧に戻る</button>";
                html += "</div>";
                document.getElementById("tab-permits").innerHTML = html;
            } catch (e) { document.getElementById("tab-permits").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        // 許可一覧から詳細画面を開く
        function editPermitFromList(permitId, logicalId, businessId) {
            showPermitDetail(permitId, logicalId, businessId);
        }

        // ===== 許可詳細ビュー（読み取り専用） =====
        var currentDetailPermitId = 0;
        var currentDetailLogicalId = 0;
        var currentDetailBusinessId = 0;
        var permitHistorySectionLoaded = false;

        function showPermitDetail(permitId, logicalId, businessId) {
            currentDetailPermitId = permitId;
            currentDetailLogicalId = logicalId;
            currentDetailBusinessId = businessId;
            permitHistorySectionLoaded = false;
            try {
                // 許可データを取得
                var rs = conn.Execute(buildLoadPermitForEditQuery(permitId));
                if (rs.EOF) { showToast("業が見つかりません", "error"); rs.Close(); return; }
                var permitNumber = rs.Fields("許可番号").Value || "";
                var categoryId = rs.Fields("許可区分ID").Value || "";
                var permitDate = rs.Fields("許可年月日文字列").Value || "";
                var validDate = rs.Fields("許可有効年月日文字列").Value || "";
                var excellent = rs.Fields("優良認定").Value;
                var startDate = rs.Fields("有効開始文字列").Value || "";
                var endDate = rs.Fields("有効終了文字列").Value || "";
                var cancelDate = rs.Fields("取消日文字列").Value || "";
                var cancelReason = rs.Fields("取消理由").Value || "";
                var abolishDate = rs.Fields("廃止日文字列").Value || "";
                var abolishReason = rs.Fields("廃止理由").Value || "";
                rs.Close();

                // 許可区分名を取得
                var catName = "";
                try {
                    var catRs = conn.Execute(buildMasterNameQuery("マスター_許可区分", "許可区分ID", "許可区分名", categoryId));
                    if (!catRs.EOF) catName = catRs.Fields("許可区分名").Value || "";
                    catRs.Close();
                } catch (e2) {}

                // ステータス判定
                var statusHtml = "";
                var isCancelled = (cancelDate !== "");
                var isAbolished = (abolishDate !== "");
                var isExpired = false;
                var isExpiring = false;
                if (isCancelled) {
                    statusHtml = statusBadge('cancelled', '取消', true);
                } else if (isAbolished) {
                    statusHtml = statusBadge('abolished', '廃止', true);
                } else if (validDate) {
                    var today = new Date(); today.setHours(0,0,0,0);
                    var parts = validDate.split("/");
                    var vd = new Date(parseInt(parts[0],10), parseInt(parts[1],10)-1, parseInt(parts[2],10));
                    var thirtyDays = new Date(today.getTime() + 30*24*60*60*1000);
                    if (vd < today) {
                        statusHtml = "<span class='badge-expiry expired badge-status-lg'>期限切れ</span>";
                        isExpired = true;
                    } else if (vd <= thirtyDays) {
                        statusHtml = "<span class='badge-expiry soon badge-status-lg'>期限間近</span>";
                        isExpiring = true;
                    } else {
                        statusHtml = "<span class='badge-expiry valid badge-status-lg'>有効</span>";
                    }
                } else {
                    statusHtml = "<span class='badge-expiry valid badge-status-lg'>有効</span>";
                }

                var isActive = !isCancelled && !isAbolished && !isExpired;

                var html = "";
                // ステップナビ
                html += buildStepNav([
                    {label: "許可一覧", onclick: "refreshPermitsTab(" + businessId + ")"},
                    {label: "許可詳細"}
                ], 1);

                html += "<div class='permit-detail'>";

                // --- B2ヘッダー ---
                html += "<div class='b2-header'>";
                html += "<div class='b2-title'>" + escapeHtml(catName) + "</div>";
                html += "<div class='b2-location'>" + escapeHtml(permitNumber) + "</div>";
                html += "<div class='b2-badges'>";
                if (isCancelled) {
                    html += "<span class='b2-pill b2-pill-red'>取消</span>";
                } else if (isAbolished) {
                    html += "<span class='b2-pill b2-pill-gray'>廃止</span>";
                } else if (isExpired) {
                    html += "<span class='b2-pill b2-pill-gray'>期限切れ</span>";
                } else if (isExpiring) {
                    html += "<span class='b2-pill b2-pill-amber'>期限間近</span>";
                } else {
                    html += "<span class='b2-pill b2-pill-green'>有効</span>";
                }
                if (excellent) {
                    html += "<span class='b2-pill b2-pill-blue'>&#9733; 優良</span>";
                }
                html += "</div></div>";

                // --- 基本情報 ---
                html += "<div class='b2-group-title'>基本情報</div>";
                html += "<div class='b2-group'>";
                html += "<div class='b2-row'><div class='b2-row-label'>許可区分</div><div class='b2-row-value'>" + escapeHtml(catName) + "</div></div>";
                if (permitNumber) html += "<div class='b2-row'><div class='b2-row-label'>許可番号</div><div class='b2-row-value'>" + escapeHtml(permitNumber) + "</div></div>";
                if (permitDate) html += "<div class='b2-row'><div class='b2-row-label'>許可年月日</div><div class='b2-row-value'>" + escapeHtml(permitDate) + "</div></div>";
                if (validDate) html += "<div class='b2-row'><div class='b2-row-label'>許可有効年月日</div><div class='b2-row-value'>" + escapeHtml(validDate) + "</div></div>";
                if (excellent) html += "<div class='b2-row'><div class='b2-row-label'>優良認定</div><div class='b2-row-value' style='color:#ff9500;'>&#9733; あり</div></div>";
                html += "</div>";

                // --- 取扱品目 ---
                html += "<div class='b2-group-title'>取扱品目</div>";
                html += "<div id='permit-detail-items' class='b2-group' style='padding:12px 16px;'>読み込み中...</div>";

                // --- 更新/変更/失効新規アクション（カード型ボタン） ---
                if (!isCancelled && !isAbolished) {
                    html += "<div style='margin-top:16px; display:flex;'>";
                    if (isExpired) {
                        // 期限切れ: 更新+失効新規を有効化、変更をグレーアウト
                        html += "<div class='action-card action-card-blue' onclick='showPermitRenewalForm(" + logicalId + ", " + businessId + ")'>";
                        html += "<div class='action-card-icon'>&#x21BB;</div>";
                        html += "<div class='action-card-label'>更新</div>";
                        html += "<div class='action-card-desc'>有効期限を延長</div></div>";
                        html += "<div class='action-card action-card-disabled' style='margin-left:8px;'>";
                        html += "<div class='action-card-icon'>&#x270E;</div>";
                        html += "<div class='action-card-label'>変更</div>";
                        html += "<div class='action-card-desc'>法14条の2</div></div>";
                        html += "<div class='action-card action-card-orange' style='margin-left:8px;' onclick='showPermitExpiredNewForm(" + logicalId + ", " + businessId + ")'>";
                        html += "<div class='action-card-icon'>&#x2795;</div>";
                        html += "<div class='action-card-label'>失効新規</div>";
                        html += "<div class='action-card-desc'>新たに許可を取得</div></div>";
                    } else {
                        // 有効: 更新+変更を有効化、失効新規をグレーアウト
                        html += "<div class='action-card action-card-blue' onclick='showPermitRenewalForm(" + logicalId + ", " + businessId + ")'>";
                        html += "<div class='action-card-icon'>&#x21BB;</div>";
                        html += "<div class='action-card-label'>更新</div>";
                        html += "<div class='action-card-desc'>有効期限を延長</div></div>";
                        html += "<div class='action-card action-card-amber' style='margin-left:8px;' onclick='showPermitChangeForm(" + logicalId + ", " + businessId + ")'>";
                        html += "<div class='action-card-icon'>&#x270E;</div>";
                        html += "<div class='action-card-label'>変更</div>";
                        html += "<div class='action-card-desc'>法14条の2</div></div>";
                        html += "<div class='action-card action-card-disabled' style='margin-left:8px;'>";
                        html += "<div class='action-card-icon'>&#x2795;</div>";
                        html += "<div class='action-card-label'>失効新規</div>";
                        html += "<div class='action-card-desc'>新たに許可を取得</div></div>";
                    }
                    html += "</div>";
                }

                // --- ステータス（廃止・取消時） ---
                if (isCancelled) {
                    html += "<div class='b2-group-title' style='margin-top:24px; color:#86868b;'>ステータス</div>";
                    html += "<div class='b2-group'>";
                    html += "<div class='b2-row'><div class='b2-row-label'>状態</div><div class='b2-row-value'><span class='b2-pill b2-pill-red'>取消</span></div></div>";
                    html += "<div class='b2-row'><div class='b2-row-label'>取消日</div><div class='b2-row-value' style='color:#ff3b30;'>" + escapeHtml(cancelDate) + "</div></div>";
                    if (cancelReason) html += "<div class='b2-row'><div class='b2-row-label'>取消理由</div><div class='b2-row-value'>" + escapeHtml(cancelReason) + "</div></div>";
                    html += "<div class='b2-restore-row' onclick='restorePermitFromDetail()'>復活する</div>";
                    html += "</div>";
                }
                if (isAbolished) {
                    html += "<div class='b2-group-title' style='margin-top:24px; color:#86868b;'>ステータス</div>";
                    html += "<div class='b2-group'>";
                    html += "<div class='b2-row'><div class='b2-row-label'>状態</div><div class='b2-row-value'><span class='b2-pill b2-pill-gray'>廃止</span></div></div>";
                    html += "<div class='b2-row'><div class='b2-row-label'>廃止日</div><div class='b2-row-value' style='color:#ff3b30;'>" + escapeHtml(abolishDate) + "</div></div>";
                    if (abolishReason) html += "<div class='b2-row'><div class='b2-row-label'>廃止理由</div><div class='b2-row-value'>" + escapeHtml(abolishReason) + "</div></div>";
                    html += "<div class='b2-restore-row' onclick='restorePermitFromDetail()'>復活する</div>";
                    html += "</div>";
                }
                // --- 状態変更（有効時のみ） ---
                if (!isCancelled && !isAbolished) {
                    html += "<div class='b2-group-title' style='margin-top:24px; color:#86868b;'>状態変更</div>";
                    html += "<div class='b2-group'>";
                    // 廃止: 横並びコンパクト配置
                    html += "<div style='padding:12px 16px; border-bottom:1px solid rgba(0,0,0,0.06);'>";
                    html += "<div style='font-size:0.9em; font-weight:500; color:#ff3b30; margin-bottom:8px;'>この許可を廃止する</div>";
                    html += "<div style='display:flex; align-items:flex-start;'>";
                    html += "<div style='margin-right:16px;'><div style='font-size:0.75em; color:#86868b; margin-bottom:2px;'>廃止日</div><div class='datepicker-wrapper'><input type='text' style='width:130px; padding:6px 10px; border:1px solid rgba(0,0,0,0.1); border-radius:8px; font-size:0.85em; text-align:center;' id='detail-abolish-date' placeholder='yyyy/mm/dd' onblur='normalizeDateInput(this)'><button class='cal-trigger-btn' onclick='openDatePicker(\"detail-abolish-date\")' tabindex='-1'>Cal</button></div></div>";
                    html += "<div style='flex:1; margin-right:16px;'><div style='font-size:0.75em; color:#86868b; margin-bottom:2px;'>廃止理由</div><input type='text' id='detail-abolish-reason' style='width:100%; padding:6px 10px; border:1px solid rgba(0,0,0,0.1); border-radius:8px; font-size:0.85em;' placeholder='理由を入力'></div>";
                    html += "<div style='padding-top:16px;'><button class='b2-abolish-btn' style='margin-left:0;' onclick='abolishPermitFromDetail()'>廃止</button></div>";
                    html += "</div></div>";
                    // 取消: 横並びコンパクト配置
                    html += "<div style='padding:12px 16px;'>";
                    html += "<div style='font-size:0.9em; font-weight:500; color:#c62828; margin-bottom:8px;'>この許可を取消する</div>";
                    html += "<div style='display:flex; align-items:flex-start;'>";
                    html += "<div style='margin-right:16px;'><div style='font-size:0.75em; color:#86868b; margin-bottom:2px;'>取消日</div><div class='datepicker-wrapper'><input type='text' style='width:130px; padding:6px 10px; border:1px solid rgba(0,0,0,0.1); border-radius:8px; font-size:0.85em; text-align:center;' id='detail-cancel-date' placeholder='yyyy/mm/dd' onblur='normalizeDateInput(this)'><button class='cal-trigger-btn' onclick='openDatePicker(\"detail-cancel-date\")' tabindex='-1'>Cal</button></div></div>";
                    html += "<div style='flex:1; margin-right:16px;'><div style='font-size:0.75em; color:#86868b; margin-bottom:2px;'>取消理由</div><input type='text' id='detail-cancel-reason' style='width:100%; padding:6px 10px; border:1px solid rgba(0,0,0,0.1); border-radius:8px; font-size:0.85em;' placeholder='理由を入力'></div>";
                    html += "<div style='padding-top:16px;'><button class='b2-abolish-btn' style='margin-left:0; background:#c62828;' onclick='cancelPermitFromDetail()'>取消</button></div>";
                    html += "</div></div>";
                    html += "</div>";
                }

                // --- 履歴（常に表示・縦タイムライン） ---
                html += "<div class='b2-group-title' style='margin-top:24px;'>履歴</div>";
                html += "<div id='permit-history-content'>読み込み中...</div>";

                html += "</div>"; // .permit-detail

                document.getElementById("tab-permits").innerHTML = html;
                loadPermitItemsInline(permitId, "permit-detail-items", true, categoryId);
                loadPermitHistoryVtl(currentDetailLogicalId, currentDetailBusinessId);
            } catch (e) { document.getElementById("tab-permits").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        // 許可履歴を縦タイムラインで表示（B2デザイン）
        function loadPermitHistoryVtl(logicalId, businessId) {
            try {
                currentPermitHistoryLogicalId = logicalId;
                currentPermitHistoryBusinessId = businessId;
                var rs = conn.Execute(buildLoadPermitHistoryQuery(logicalId));
                var versions = [];
                while (!rs.EOF) {
                    versions.push({
                        permitId: rs.Fields("許可ID").Value,
                        permitNumber: rs.Fields("許可番号").Value || "",
                        categoryName: rs.Fields("許可区分名").Value || "",
                        permitDateStr: rs.Fields("許可日文字列").Value || "",
                        validDateStr: rs.Fields("許可有効期限文字列").Value || "",
                        startDateStr: rs.Fields("有効開始文字列").Value || "",
                        endDateStr: rs.Fields("有効終了文字列").Value || "",
                        cancelDateStr: rs.Fields("取消日文字列").Value || "",
                        abolishDateStr: rs.Fields("廃止日文字列").Value || "",
                        isChange: rs.Fields("変更許可フラグ").Value ? true : false,
                        isExpiredNew: rs.Fields("失効新規フラグ").Value ? true : false
                    });
                    rs.MoveNext();
                }
                rs.Close();

                if (versions.length === 0) {
                    document.getElementById("permit-history-content").innerHTML = "<p class='auto-label'>履歴なし</p>";
                    return;
                }

                // タイムラインバー（2件以上で表示）
                var html = "";
                var allHaveStartDate = versions.length >= 2;
                for (var ci = 0; ci < versions.length; ci++) {
                    if (!versions[ci].startDateStr) { allHaveStartDate = false; break; }
                }
                if (allHaveStartDate) {
                    html += buildPermitTimelineHtml(versions, logicalId, businessId);
                }

                // VTL (versions は ASC → 表示は DESC)
                html += "<div class='vtl'><div class='vtl-line'></div>";
                for (var i = versions.length - 1; i >= 0; i--) {
                    var v = versions[i];
                    var vNum = i + 1;
                    var hasEnd = (v.endDateStr !== "" && v.endDateStr !== null);
                    var isCancelled = (v.cancelDateStr !== "" && v.cancelDateStr !== null);
                    var isAbolished = (v.abolishDateStr !== "" && v.abolishDateStr !== null);

                    var dotClass = "expired";
                    if (isCancelled) dotClass = "cancelled";
                    else if (isAbolished) dotClass = "abolished";
                    else if (!hasEnd) dotClass = "active";

                    var dateRange = v.startDateStr ? v.startDateStr : v.permitDateStr;
                    dateRange += " ～ ";
                    if (isCancelled) dateRange += "取消(" + v.cancelDateStr + ")";
                    else if (isAbolished) dateRange += "廃止(" + v.abolishDateStr + ")";
                    else if (hasEnd) dateRange += v.endDateStr;
                    else dateRange += "現在";

                    var pillHtml = "";
                    if (isCancelled) pillHtml = " <span class='b2-pill b2-pill-red' style='margin-left:8px;'>取消</span>";
                    else if (isAbolished) pillHtml = " <span class='b2-pill b2-pill-gray' style='margin-left:8px;'>廃止</span>";
                    else if (!hasEnd) pillHtml = " <span class='b2-pill b2-pill-green' style='margin-left:8px;'>有効</span>";

                    // 変更内容（前バージョンとの差分）
                    var changeHtml = "";
                    if (i === 0) {
                        changeHtml = "<div class='vtl-change'>" + escapeHtml(v.categoryName) + " / " + escapeHtml(v.permitNumber) + "</div>";
                    } else {
                        var prev = versions[i - 1];
                        if (v.permitNumber !== prev.permitNumber) {
                            changeHtml += "<div class='vtl-change'>許可番号: <span class='vtl-change-old'>" + escapeHtml(prev.permitNumber) + "</span> → <span class='vtl-change-new'>" + escapeHtml(v.permitNumber) + "</span></div>";
                        }
                        if (v.validDateStr !== prev.validDateStr) {
                            changeHtml += "<div class='vtl-change'>有効期限: <span class='vtl-change-old'>" + escapeHtml(prev.validDateStr || "なし") + "</span> → <span class='vtl-change-new'>" + escapeHtml(v.validDateStr || "なし") + "</span></div>";
                        }
                        if (v.categoryName !== prev.categoryName) {
                            changeHtml += "<div class='vtl-change'>許可区分: <span class='vtl-change-old'>" + escapeHtml(prev.categoryName) + "</span> → <span class='vtl-change-new'>" + escapeHtml(v.categoryName) + "</span></div>";
                        }
                        if (isCancelled) {
                            changeHtml += "<div class='vtl-change'>取消日: <span style='color:#c62828;font-weight:500;'>" + v.cancelDateStr + "</span></div>";
                        }
                        if (isAbolished) {
                            changeHtml += "<div class='vtl-change'>廃止日: <span style='color:#c62828;font-weight:500;'>" + v.abolishDateStr + "</span></div>";
                        }
                        // 変更バージョン: 変更事由発生日（有効開始日時）を表示
                        if (v.isChange && v.startDateStr) {
                            changeHtml += "<div class='vtl-change'>変更事由発生日: " + escapeHtml(v.startDateStr) + "</div>";
                        }
                        if (!changeHtml) {
                            changeHtml = "<div class='vtl-change'>許可更新</div>";
                        }
                    }

                    var label = "v" + vNum;
                    if (i === 0) label += " — 新規登録";
                    else if (isCancelled) label += " — 取消";
                    else if (isAbolished) label += " — 廃止";
                    else if (v.isExpiredNew) label += " — 失効新規";
                    else if (v.isChange) label += " — 変更";
                    else label += " — 更新";

                    html += "<div class='vtl-item'>";
                    html += "<div class='vtl-dot " + dotClass + "'></div>";
                    html += "<div class='vtl-actions'>";
                    html += "<a href='#' class='vtl-edit' onclick='editPermitHistory(" + v.permitId + ", " + logicalId + ", " + businessId + "); return false;'>修正</a>";
                    html += "<a href='#' class='vtl-delete' onclick='deletePermitVersion(" + v.permitId + ", " + logicalId + ", " + businessId + "); return false;'>削除</a>";
                    html += "</div>";
                    html += "<div class='vtl-date'>" + dateRange + pillHtml + "</div>";
                    html += "<div class='vtl-content'>" + label + "</div>";
                    html += changeHtml;
                    html += "</div>";
                }
                html += "</div>";
                document.getElementById("permit-history-content").innerHTML = html;
            } catch (e) {
                document.getElementById("permit-history-content").innerHTML = "<p>エラー: " + e.message + "</p>";
            }
        }

        // 許可バージョン単体削除
        function deletePermitVersion(permitId, logicalId, businessId) {
            showConfirmDialog("履歴削除", "この履歴バージョンを削除しますか？\n関連する許可品目も削除されます。", {
                okText: "削除する", okClass: "btn-danger",
                onOk: function() {
                    try {
                        conn.BeginTrans();
                        try {
                            var queries = buildDeletePermitHistoryQueries(permitId);
                            for (var q = 0; q < queries.length; q++) {
                                conn.Execute(queries[q]);
                            }
                            conn.CommitTrans();
                        } catch (txErr) {
                            conn.RollbackTrans();
                            throw txErr;
                        }
                        showToast("削除しました", "info");
                        loadPermitHistoryVtl(logicalId, businessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        function togglePermitHistorySection() {
            var section = document.getElementById("permit-history-section");
            var label = document.getElementById("permit-history-toggle-label");
            if (section.style.display === "none") {
                section.style.display = "block";
                label.innerHTML = "履歴 &#9650;";
                if (!permitHistorySectionLoaded) {
                    permitHistorySectionLoaded = true;
                    loadPermitHistoryInline(currentDetailLogicalId, currentDetailBusinessId);
                }
            } else {
                section.style.display = "none";
                label.innerHTML = "履歴 &#9660;";
            }
        }

        function loadPermitHistoryInline(logicalId, businessId) {
            try {
                currentPermitHistoryLogicalId = logicalId;
                currentPermitHistoryBusinessId = businessId;
                var rs = conn.Execute(buildLoadPermitHistoryQuery(logicalId));
                var versions = [];
                while (!rs.EOF) {
                    versions.push({
                        permitId: rs.Fields("許可ID").Value,
                        permitNumber: rs.Fields("許可番号").Value || "",
                        categoryName: rs.Fields("許可区分名").Value || "",
                        permitDateStr: rs.Fields("許可日文字列").Value || "",
                        validDateStr: rs.Fields("許可有効期限文字列").Value || "",
                        startDateStr: rs.Fields("有効開始文字列").Value || "",
                        endDateStr: rs.Fields("有効終了文字列").Value || "",
                        cancelDateStr: rs.Fields("取消日文字列").Value || "",
                        abolishDateStr: rs.Fields("廃止日文字列").Value || "",
                        isChange: rs.Fields("変更許可フラグ").Value ? true : false,
                        isExpiredNew: rs.Fields("失効新規フラグ").Value ? true : false
                    });
                    rs.MoveNext();
                }
                rs.Close();

                var html = "";
                // タイムライン表示
                var allHaveStartDate = versions.length >= 2;
                for (var ci = 0; ci < versions.length; ci++) {
                    if (!versions[ci].startDateStr) { allHaveStartDate = false; break; }
                }
                if (allHaveStartDate) {
                    html += buildPermitTimelineHtml(versions, logicalId, businessId);
                }

                // 履歴テーブル（現在バージョンに星マーク、チェックボックス付き）
                html += "<table class='data-table'><tr><th style='width:30px;'><input type='checkbox' onclick='toggleAllHistoryCheckboxes(this)' title='全選択/解除'></th><th style='width:30px;'></th><th>許可区分</th><th>許可番号</th><th>許可年月日</th><th>許可有効年月日</th></tr>";
                for (var vi = 0; vi < versions.length; vi++) {
                    var v = versions[vi];
                    var hasEndDate = (v.endDateStr !== "" && v.endDateStr !== null);
                    var isCurrent = !hasEndDate && !v.cancelDateStr && !v.abolishDateStr;
                    html += "<tr" + (hasEndDate ? " class='bg-row-inactive'" : "") + ">";
                    html += "<td style='text-align:center;'><input type='checkbox' class='history-cb' value='" + v.permitId + "'></td>";
                    html += "<td style='text-align:center;'>" + (isCurrent ? "<span class='primary-star active' title='現在のバージョン'>&#9733;</span>" : "") + "</td>";
                    html += "<td>" + escapeHtml(v.categoryName) + "</td>";
                    html += "<td>" + escapeHtml(v.permitNumber) + "</td>";
                    html += "<td>" + escapeHtml(v.permitDateStr) + "</td>";
                    html += "<td>" + (v.validDateStr ? escapeHtml(v.validDateStr) : "-") + "</td>";
                    html += "</tr>";
                }
                html += "</table>";
                html += "<div style='display:flex;justify-content:flex-end;margin-top:12px;'>";
                html += "<button class='btn btn-primary btn-sm' onclick='editSelectedHistory()' style='margin-right:8px;'>編集</button>";
                html += "<button class='btn btn-danger btn-sm' onclick='deleteSelectedHistory()'>削除</button>";
                html += "</div>";
                document.getElementById("permit-history-content").innerHTML = html;
            } catch (e) {
                document.getElementById("permit-history-content").innerHTML = "<p>エラー: " + e.message + "</p>";
            }
        }

        // 履歴チェックボックス: 全選択/解除
        function toggleAllHistoryCheckboxes(master) {
            var cbs = document.querySelectorAll('.history-cb');
            for (var i = 0; i < cbs.length; i++) { cbs[i].checked = master.checked; }
        }

        // 選択された履歴IDを取得
        function getSelectedHistoryIds() {
            var cbs = document.querySelectorAll('.history-cb:checked');
            var ids = [];
            for (var i = 0; i < cbs.length; i++) { ids.push(parseInt(cbs[i].value, 10)); }
            return ids;
        }

        // 選択した履歴を編集（1件のみ）
        function editSelectedHistory() {
            var ids = getSelectedHistoryIds();
            if (ids.length === 0) { showToast("編集する履歴を選択してください", "error"); return; }
            if (ids.length > 1) { showToast("編集は1件ずつ選択してください", "error"); return; }
            editPermitHistory(ids[0], currentPermitHistoryLogicalId, currentPermitHistoryBusinessId);
        }

        // 選択した履歴を削除
        function deleteSelectedHistory() {
            var ids = getSelectedHistoryIds();
            if (ids.length === 0) { showToast("削除する履歴を選択してください", "error"); return; }
            showConfirmDialog("履歴削除", ids.length + "件の履歴を削除しますか？\n関連する許可品目も削除されます。\nこの操作は取り消せません。", {
                okText: "削除する", okClass: "btn-danger",
                onOk: function() {
                    try {
                        conn.BeginTrans();
                        try {
                            for (var i = 0; i < ids.length; i++) {
                                var queries = buildDeletePermitHistoryQueries(ids[i]);
                                for (var q = 0; q < queries.length; q++) {
                                    conn.Execute(queries[q]);
                                }
                            }
                            conn.CommitTrans();
                        } catch (txErr) {
                            conn.RollbackTrans();
                            throw txErr;
                        }
                        showToast(ids.length + "件の履歴を削除しました", "info");
                        loadPermitHistoryInline(currentPermitHistoryLogicalId, currentPermitHistoryBusinessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        // 許可更新フォームを表示（許可年月日・許可有効年月日を入力させる）
        // 許可更新フォーム（全フィールド編集可能 → 保存時に旧版CLOSE+新版INSERT）
        function showPermitRenewalForm(logicalId, businessId) {
            try {
                var rs = conn.Execute(buildLoadLatestVersionQuery("許可", "許可論理ID", logicalId));
                if (rs.EOF) { showToast("元データが見つかりません", "error"); rs.Close(); return; }
                var latestPermitId = rs.Fields("許可ID").Value;
                rs.Close();
                showPermitEditForm(latestPermitId, logicalId, businessId, "renewal");
            } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
        }

        // 許可変更フォーム（法14条の2、全フィールド編集可能）
        function showPermitChangeForm(logicalId, businessId) {
            try {
                var rs = conn.Execute(buildLoadLatestVersionQuery("許可", "許可論理ID", logicalId));
                if (rs.EOF) { showToast("元データが見つかりません", "error"); rs.Close(); return; }
                var latestPermitId = rs.Fields("許可ID").Value;
                rs.Close();
                showPermitEditForm(latestPermitId, logicalId, businessId, "change");
            } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
        }

        // 失効新規フォーム（失効後に新規許可を取得）
        function showPermitExpiredNewForm(logicalId, businessId) {
            try {
                var rs = conn.Execute(buildLoadLatestVersionQuery("許可", "許可論理ID", logicalId));
                if (rs.EOF) { showToast("元データが見つかりません", "error"); rs.Close(); return; }
                var latestPermitId = rs.Fields("許可ID").Value;
                rs.Close();
                showPermitEditForm(latestPermitId, logicalId, businessId, "expiredNew");
            } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
        }

        // 更新時の有効年月日は自動計算（優良認定→+7年、通常→+5年）

        function refreshPermitsTab(businessId) {
            document.getElementById("tab-permits").innerHTML = loadPermitsForBusiness(businessId);
        }

        // 許可編集（修正/更新/変更 共用）
        var editingPermitId = 0;
        var editingPermitLogicalId = 0;
        var editingPermitBusinessId = 0;
        var editingPermitCategoryId = 0;
        var editingPermitMode = "edit"; // "edit"=修正, "renewal"=更新, "change"=変更, "expiredNew"=失効新規
        var editingPermitPrevValidDate = ""; // 失効新規用: 旧許可の有効年月日
        var editingPermitOriginalItems = null; // 変更モード用: 元の品目状態スナップショット

        // 許可編集フォーム共通
        // mode: "edit"=修正(UPDATE), "renewal"=更新(CLOSE+INSERT), "change"=変更(CLOSE+INSERT,有効期限引継), "expiredNew"=失効新規(INSERT)
        function showPermitEditForm(permitId, logicalId, businessId, mode) {
            editingPermitId = permitId;
            editingPermitLogicalId = logicalId;
            editingPermitBusinessId = businessId;
            editingPermitCategoryId = 0;
            editingPermitMode = mode || "edit";
            try {
                var categories = [];
                var rs = conn.Execute(buildMasterListQuery("マスター_許可区分", "許可区分ID", "許可区分名"));
                while (!rs.EOF) {
                    categories.push({ id: rs.Fields("許可区分ID").Value, name: rs.Fields("許可区分名").Value });
                    rs.MoveNext();
                }
                rs.Close();

                rs = conn.Execute(buildLoadPermitForEditQuery(permitId));
                if (rs.EOF) { showToast("許可が見つかりません", "error"); rs.Close(); return; }

                var permitNumber = rs.Fields("許可番号").Value || "";
                var categoryId = rs.Fields("許可区分ID").Value || "";
                editingPermitCategoryId = categoryId;
                var permitDate = rs.Fields("許可年月日文字列").Value || "";
                var validDate = rs.Fields("許可有効年月日文字列").Value || "";
                var startDate = rs.Fields("有効開始文字列").Value || "";
                var endDate = rs.Fields("有効終了文字列").Value || "";
                var excellent = rs.Fields("優良認定").Value;
                rs.Close();

                var isRenewal = (editingPermitMode === "renewal");
                var isChange = (editingPermitMode === "change");
                var isExpiredNew = (editingPermitMode === "expiredNew");
                var modeLabel = isRenewal ? "更新" : isChange ? "変更" : isExpiredNew ? "失効新規" : "修正";
                editingPermitPrevValidDate = validDate;

                // 変更モード: 元の品目状態をスナップショット保存
                editingPermitOriginalItems = null;
                if (isChange) {
                    editingPermitOriginalItems = [];
                    var itemRs = conn.Execute(buildLoadPermitItemsFlagsQuery(permitId));
                    while (!itemRs.EOF) {
                        editingPermitOriginalItems.push({
                            itemId: itemRs.Fields("品目ID").Value,
                            handling: itemRs.Fields("取り扱いフラグ").Value ? true : false,
                            transfer: itemRs.Fields("積替保管フラグ").Value ? true : false
                        });
                        itemRs.MoveNext();
                    }
                    itemRs.Close();
                }

                // 更新モード: 有効期限自動算出
                var autoValidDate = "";
                var prevValidDateStr = validDate;
                if ((isRenewal || isExpiredNew) && validDate) {
                    var renewalYears = excellent ? 7 : 5;
                    var pvd = new Date(validDate);
                    var newY = pvd.getFullYear() + renewalYears;
                    var newM = pvd.getMonth() + 1;
                    var newD = pvd.getDate();
                    var maxDay = new Date(newY, newM, 0).getDate();
                    if (newD > maxDay) newD = maxDay;
                    autoValidDate = newY + "/" + (newM < 10 ? "0" + newM : newM) + "/" + (newD < 10 ? "0" + newD : newD);
                }

                // ステップナビ
                var html = buildStepNav([
                    {label: "許可一覧", onclick: "refreshPermitsTab(" + businessId + ")"},
                    {label: "許可詳細", onclick: "showPermitDetail(" + permitId + ", " + logicalId + ", " + businessId + ")"},
                    {label: modeLabel}
                ], 2);

                html += "<div class='form-card'>";
                if (isRenewal) {
                    html += "<h2>許可の更新</h2>";
                    html += "<p class='text-desc' style='margin-bottom:15px;'>更新を保存すると新しいバージョンが作成され、現在のデータは履歴に残ります。</p>";
                } else if (isChange) {
                    html += "<h2>許可の変更（法14条の2）</h2>";
                    html += "<p class='text-desc' style='margin-bottom:15px;'>品目追加等による事業範囲の変更。変更を保存すると新しいバージョンが作成されます。</p>";
                } else if (isExpiredNew) {
                    html += "<h2>失効新規</h2>";
                    html += "<p class='text-desc' style='margin-bottom:15px;'>失効した許可に対し、新たに許可を取得します。新しいバージョンが作成されます。</p>";
                } else {
                    html += "<h2>許可履歴の修正（許可ID: " + permitId + "）</h2>";
                }

                html += "<div class='form-group'><label>許可番号 <span class='badge-required'>必須</span></label><input type='text' id='edit-permit-number' value='" + escapeHtml(permitNumber) + "' oninput='this.value=normalizeToHankaku(this.value)'><span class='auto-label'>※ 半角数字11桁（例: 01234567890）</span></div>";
                html += "<div class='form-group'><label>許可区分 <span class='badge-required'>必須</span></label><select id='edit-permit-category'>";
                for (var i = 0; i < categories.length; i++) {
                    var sel = (categories[i].id == categoryId) ? " selected" : "";
                    html += "<option value='" + categories[i].id + "'" + sel + ">" + escapeHtml(categories[i].name) + "</option>";
                }
                html += "</select></div>";
                html += "<div class='form-row'>";
                if (isChange) {
                    // 変更モード: 許可年月日・許可有効年月日は従前引き継ぎ（グレーアウト）
                    html += "<div class='form-group'><label>許可年月日 <span class='auto-label'>（従前引き継ぎ）</span></label><input type='text' id='edit-permit-date' value='" + escapeHtml(permitDate) + "' readonly class='readonly-input'></div>";
                    html += "<div class='form-group'><label>許可有効年月日 <span class='auto-label'>（従前引き継ぎ）</span></label><input type='text' id='edit-permit-valid' value='" + escapeHtml(validDate) + "' readonly class='readonly-input'></div>";
                } else {
                    html += "<div class='form-group'><label>許可年月日 <span class='badge-required'>必須</span></label><div class='datepicker-wrapper'><input type='text' id='edit-permit-date' class='datepicker-input' value='" + (isRenewal || isExpiredNew ? "" : escapeHtml(permitDate)) + "' onclick='openDatePicker(\"edit-permit-date\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
                    html += "<div class='form-group'><label>許可有効年月日 <span class='badge-required'>必須</span></label><div class='datepicker-wrapper'><input type='text' id='edit-permit-valid' class='datepicker-input' value='" + escapeHtml(validDate) + "' onclick='openDatePicker(\"edit-permit-valid\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
                }
                html += "</div>";

                // 更新モード: 前回値の参照表示
                if (isRenewal) {
                    html += "<div class='prev-row' style='margin-bottom:12px;'>";
                    html += "<span class='auto-label'>従前の許可年月日: " + escapeHtml(permitDate) + " ／ 許可有効年月日: " + escapeHtml(validDate) + "</span>";
                    html += "</div>";
                }

                // 変更モード: 変更許可の決裁日
                if (isChange) {
                    html += "<div class='form-group'><label>変更許可の決裁日 <span class='badge-required'>必須</span></label>";
                    html += "<p class='text-desc' style='margin-bottom:4px;font-size:0.8em;'>変更が決裁された日付を入力してください。この日付から新しい許可内容が適用されます。</p>";
                    html += "<div class='datepicker-wrapper'><input type='text' id='edit-permit-change-event-date' class='datepicker-input' onclick='openDatePicker(\"edit-permit-change-event-date\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
                }

                // 有効期間の表示・管理者オーバーライド（全モード共通）
                html += "<div class='form-row prev-row'>";
                html += "<div class='form-group'><label>有効開始日時 <span class='auto-label'>（自動設定）</span></label><input type='text' id='edit-permit-start' value='" + escapeHtml(startDate) + "' readonly class='readonly-input'></div>";
                html += "<div class='form-group'><label>有効終了日時 <span class='auto-label'>（自動設定）</span></label><input type='text' id='edit-permit-end' value='" + escapeHtml(endDate) + "' readonly class='readonly-input'><span class='auto-label'>※ 空欄 = 現在有効</span></div>";
                html += "</div>";
                html += "<div style='margin-bottom:10px;'><a href='#' onclick='togglePermitBoundaryAdmin(); return false;' class='admin-link'>[管理者] 有効開始/終了を手動編集</a></div>";
                html += "<div id='permit-boundary-admin' style='display:none;'>";
                html += "<div class='form-row'>";
                html += "<div class='form-group'><label>有効開始日時（手動）</label><div class='datepicker-wrapper'><input type='text' id='edit-permit-start-admin' class='datepicker-input' value='" + escapeHtml(startDate) + "' onclick='openDatePicker(\"edit-permit-start-admin\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
                html += "<div class='form-group'><label>有効終了日時（手動）</label><div class='datepicker-wrapper'><input type='text' id='edit-permit-end-admin' class='datepicker-input' value='" + escapeHtml(endDate) + "' onclick='openDatePicker(\"edit-permit-end-admin\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
                html += "</div></div>";

                html += "<div class='form-group'><label for='edit-permit-excellent' style='display:inline-block;cursor:pointer;'><span class='toggle-switch'><input type='checkbox' id='edit-permit-excellent'" + (excellent ? " checked" : "") + " onchange='onExcellentToggle()'><span class='toggle-slider'></span></span> 優良認定</label>";
                if (isRenewal || isExpiredNew) {
                    html += "<span class='auto-label' id='excellent-hint' style='margin-left:8px;'>" + (excellent ? "許可有効年月日 +7年" : "許可有効年月日 +5年") + "</span>";
                }
                html += "</div>";
                html += "</div>";

                // 取扱品目セクション（更新モードでは非表示: 品目は前版からコピーで自動引き継ぎ）
                if (!isRenewal) {
                    html += "<div class='form-card' style='margin-top:15px;'>";
                    html += "<h2>取扱品目</h2>";
                    html += "<div id='permit-edit-items'>読み込み中...</div>";
                    html += "</div>";
                }

                // 保存・キャンセルボタン
                var saveLabel = isRenewal ? "更新を保存" : isChange ? "変更を保存" : "保存";
                html += "<div class='form-buttons' style='margin-top:15px;'>";
                html += "<button class='btn btn-success' onclick='savePermitEdit()'>" + saveLabel + "</button>";
                html += "<button class='btn btn-secondary' onclick='showPermitDetail(" + permitId + ", " + logicalId + ", " + businessId + ")'>キャンセル</button>";
                html += "</div>";

                document.getElementById("tab-permits").innerHTML = html;
                if (!isRenewal) {
                    loadPermitItemsInline(permitId, "permit-edit-items", false, categoryId);
                }

                // 更新モード: 有効年月日を自動セット
                if (isRenewal && autoValidDate) {
                    document.getElementById("edit-permit-valid").value = autoValidDate;
                }
            } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
        }

        // 後方互換ラッパー
        function editPermitHistory(permitId, logicalId, businessId) {
            showPermitEditForm(permitId, logicalId, businessId, "edit");
        }

        // 優良認定トグル切替時: 更新・失効新規モードで許可有効年月日を再計算
        function onExcellentToggle() {
            var cb = document.getElementById("edit-permit-excellent");
            if (!cb) return;
            var years = cb.checked ? 7 : 5;
            var hint = document.getElementById("excellent-hint");
            if (hint) hint.innerText = "許可有効年月日 +" + years + "年";
            // 更新・失効新規モード: 従前の許可有効年月日から再計算
            if (editingPermitPrevValidDate) {
                var pvd = new Date(editingPermitPrevValidDate);
                if (!isNaN(pvd.getTime())) {
                    var newY = pvd.getFullYear() + years;
                    var newM = pvd.getMonth() + 1;
                    var newD = pvd.getDate();
                    var maxDay = new Date(newY, newM, 0).getDate();
                    if (newD > maxDay) newD = maxDay;
                    var newValid = newY + "/" + (newM < 10 ? "0" + newM : newM) + "/" + (newD < 10 ? "0" + newD : newD);
                    var validEl = document.getElementById("edit-permit-valid");
                    if (validEl && !validEl.readOnly) validEl.value = newValid;
                }
            }
        }

        // 管理者向け境界日手動編集のトグル
        function togglePermitBoundaryAdmin() {
            var el = document.getElementById("permit-boundary-admin");
            el.style.display = el.style.display === "none" ? "block" : "none";
        }

        // 許可編集の保存（修正/更新/変更 共用）
        function savePermitEdit() {
            try {
                var permitNumber = normalizePermitNumber(document.getElementById("edit-permit-number").value);
                var categoryId = document.getElementById("edit-permit-category").value;
                var permitDate = document.getElementById("edit-permit-date").value;
                var validDate = document.getElementById("edit-permit-valid").value;
                var excellent = document.getElementById("edit-permit-excellent").checked;

                // 必須フィールドチェック
                var missing = [];
                if (!permitNumber) missing.push("許可番号");
                if (!categoryId) missing.push("許可区分");
                if (!permitDate) missing.push("許可年月日");
                if (!validDate) missing.push("許可有効年月日");
                if (missing.length > 0) {
                    showToast("以下の必須項目が未入力です:\n・" + missing.join("\n・"), "error");
                    return;
                }

                var todayStr = buildDateStr();

                if (editingPermitMode === "renewal" || editingPermitMode === "change" || editingPermitMode === "expiredNew") {
                    // 更新/変更/失効新規モード: 旧版CLOSE + 新版INSERT
                    var boundaryDate = permitDate;

                    // 変更モード: 変更の事由が発生した日を境界日として使用
                    if (editingPermitMode === "change") {
                        var changeEventDate = document.getElementById("edit-permit-change-event-date").value;
                        if (!changeEventDate) {
                            showToast("「変更の事由が発生した日」は必須です", "error");
                            return;
                        }
                        boundaryDate = changeEventDate;
                    }

                    // 日付順序バリデーション: 新許可年月日が旧版有効期限より前でないかチェック
                    if (editingPermitMode !== "expiredNew" && editingPermitPrevValidDate && permitDate > editingPermitPrevValidDate) {
                        if (!confirm("新しい許可年月日(" + permitDate + ")が旧版の許可有効年月日(" + editingPermitPrevValidDate + ")より後です。\nタイムラインに空白期間が生じますが、続行しますか？")) {
                            return;
                        }
                    }

                    // 旧版クローズ日の決定（lifecycle spec方式）
                    // 更新・変更: 新許可年月日（または決裁日）の前日
                    // 失効新規: 旧許可有効年月日（タイムライン上で空白期間を残す）
                    var closeDate = boundaryDate;
                    if (editingPermitMode === "expiredNew" && editingPermitPrevValidDate) {
                        closeDate = editingPermitPrevValidDate;
                    }

                    // トランザクション開始
                    conn.BeginTrans();
                    try {
                        // 旧版クローズ（lifecycle spec方式: boundaryDateの前日で閉じる）
                        if (editingPermitMode === "expiredNew") {
                            // 失効新規: 旧許可有効年月日でそのまま閉じる
                            conn.Execute(buildClosePermitVersionQuery(editingPermitLogicalId, closeDate));
                        } else {
                            // 更新・変更: 新許可年月日の前日で閉じる
                            conn.Execute(buildCloseOldPermitVersionsQuery(editingPermitLogicalId, boundaryDate));
                        }

                        // 新版INSERT
                        var insertData = {
                            logicalId: editingPermitLogicalId,
                            businessId: editingPermitBusinessId,
                            categoryId: categoryId,
                            number: permitNumber,
                            permitDate: permitDate,
                            validDate: validDate,
                            excellent: excellent,
                            todayStr: todayStr,
                            endDate: validDate  // 業許可: 有効終了日 = 許可有効年月日
                        };
                        // 変更モード: 有効開始日時を変更事由発生日にする + 変更許可フラグ
                        if (editingPermitMode === "change") {
                            insertData.startDate = changeEventDate;
                            insertData.isChange = true;
                        }
                        // 失効新規モード: フラグをセット
                        if (editingPermitMode === "expiredNew") {
                            insertData.isExpiredNew = true;
                        }
                        // 管理者オーバーライド（全モード共通）
                        var adminPanel = document.getElementById("permit-boundary-admin");
                        if (adminPanel && adminPanel.style.display !== "none") {
                            var adminStart = document.getElementById("edit-permit-start-admin").value;
                            var adminEnd = document.getElementById("edit-permit-end-admin").value;
                            if (adminStart) insertData.startDate = adminStart;
                            if (adminEnd) insertData.endDate = adminEnd;
                        }
                        conn.Execute(buildSavePermitQuery(insertData));

                        // 新版ID取得
                        var newRs = conn.Execute(buildGetMaxIdQuery("許可", "許可ID", "許可論理ID", editingPermitLogicalId));
                        var newId = newRs.Fields("newId").Value;
                        newRs.Close();

                        // 品目コピー（インライン編集は旧版に直接反映済みなのでコピーで引き継がれる）
                        conn.Execute(buildCopyPermitItemsQuery(editingPermitId, newId));

                        // 変更モード: 旧版の品目を元に戻す（インライン編集で変更された品目は新版にのみ反映すべき）
                        if (editingPermitMode === "change" && editingPermitOriginalItems) {
                            conn.Execute(buildDeleteAllPermitItemsQuery(editingPermitId));
                            for (var oi = 0; oi < editingPermitOriginalItems.length; oi++) {
                                var orig = editingPermitOriginalItems[oi];
                                conn.Execute(buildInsertPermitItemQuery(editingPermitId, orig.itemId, orig.handling, orig.transfer));
                            }
                        }

                        conn.CommitTrans();
                    } catch (txErr) {
                        conn.RollbackTrans();
                        throw txErr;
                    }

                    var msg = editingPermitMode === "renewal" ? "更新しました（新バージョン作成）" : editingPermitMode === "expiredNew" ? "失効新規を作成しました（新バージョン作成）" : "変更を保存しました（新バージョン作成）";
                    showToast(msg, "success");
                    showPermitDetail(newId, editingPermitLogicalId, editingPermitBusinessId);
                } else {
                    // 修正モード: 直接UPDATE
                    var startDate = permitDate;
                    var endDate = "";

                    // 管理者オーバーライド
                    var adminPanel = document.getElementById("permit-boundary-admin");
                    if (adminPanel && adminPanel.style.display !== "none") {
                        var adminStart = document.getElementById("edit-permit-start-admin").value;
                        var adminEnd = document.getElementById("edit-permit-end-admin").value;
                        if (adminStart) startDate = adminStart;
                        endDate = adminEnd;
                    }

                    var updateData = {
                        permitId: editingPermitId,
                        permitNumber: permitNumber,
                        categoryId: categoryId,
                        permitDate: permitDate,
                        validDate: validDate,
                        startDate: startDate,
                        excellent: excellent
                    };

                    if (adminPanel && adminPanel.style.display !== "none") {
                        updateData.endDate = endDate;
                    }

                    conn.Execute(buildUpdatePermitHistoryQuery(updateData));
                    showToast("保存しました", "success");
                    showPermitDetail(editingPermitId, editingPermitLogicalId, editingPermitBusinessId);
                }
            } catch (e) { showToast("保存エラー: " + e.message, "error", 5000); }
        }

        // 後方互換
        function savePermitHistoryEdit() { savePermitEdit(); }

        function cancelPermitHistoryEdit() {
            showPermitDetail(editingPermitId, editingPermitLogicalId, editingPermitBusinessId);
        }

        // 許可区分→廃棄物種類区分のキャッシュ（データ駆動の特管判定）
        var _wasteTypeMap = null;  // { 許可区分ID: 廃棄物種類区分ID }
        function loadWasteTypeMap() {
            _wasteTypeMap = {};
            var rs = conn.Execute(buildWasteTypeMapQuery());
            while (!rs.EOF) {
                _wasteTypeMap[rs.Fields("許可区分ID").Value] = rs.Fields("廃棄物種類区分ID").Value;
                rs.MoveNext();
            }
            rs.Close();
        }
        function isSpecialWasteCategory(categoryId) {
            if (!_wasteTypeMap) loadWasteTypeMap();
            return _wasteTypeMap[categoryId] === WASTE_TYPE_SPECIAL;
        }

        // 許可品目をインライン表示（共通関数）readOnly=trueでクリック無効
        // categoryId: 許可区分ID — マスター_許可区分.廃棄物種類区分IDで特管判定
        function loadPermitItemsInline(permitId, targetId, readOnly, categoryId) {
            try {
                // 許可区分に応じて品目をフィルタ（特管=ID>=threshold, 普通=ID<threshold）
                var isSpecial = isSpecialWasteCategory(categoryId);
                var itemFilter = isSpecial ? " WHERE 品目ID >= " + ITEM_SPECIAL_THRESHOLD : " WHERE 品目ID < " + ITEM_SPECIAL_THRESHOLD;
                if (!categoryId) itemFilter = ""; // categoryId未指定時は全品目

                var allItems = [];
                var rs = conn.Execute("SELECT 品目ID, 品目名 FROM マスター_品目" + itemFilter + " ORDER BY 表示順");
                while (!rs.EOF) {
                    allItems.push({id: rs.Fields("品目ID").Value, name: rs.Fields("品目名").Value});
                    rs.MoveNext();
                }
                rs.Close();

                var permitItems = {};
                rs = conn.Execute(buildLoadPermitItemsFlagsQuery(permitId));
                while (!rs.EOF) {
                    permitItems[rs.Fields("品目ID").Value] = {
                        handling: rs.Fields("取り扱いフラグ").Value,
                        transfer: rs.Fields("積替保管フラグ").Value
                    };
                    rs.MoveNext();
                }
                rs.Close();

                var html;
                if (readOnly) {
                    // B案: 折り返しグリッド（全品目、CSSクラスで色を管理）
                    html = "<div style='display:flex;flex-wrap:wrap;'>";
                    for (var i = 0; i < allItems.length; i++) {
                        var pi = permitItems[allItems[i].id] || {handling: false, transfer: false};
                        var badgeCls, mark;
                        if (pi.transfer) {
                            badgeCls = "item-badge transfer";
                            mark = "◎";
                        } else if (pi.handling) {
                            badgeCls = "item-badge handling";
                            mark = "〇";
                        } else {
                            badgeCls = "item-badge none";
                            mark = "×";
                        }
                        html += "<span class='" + badgeCls + "'>";
                        html += escapeHtml(allItems[i].name) + " " + mark + "</span>";
                    }
                    html += "</div>";
                    html += "<p class='auto-label' style='margin-top:5px;'>〇=取扱 ◎=積替保管 ×=なし</p>";
                } else {
                    // 編集用: 2段固定グリッド + 横書きヘッダ（10列/段）
                    var colsPerRow = 10;
                    var totalItems = allItems.length;
                    var rows = Math.ceil(totalItems / colsPerRow);
                    html = "";
                    for (var r = 0; r < rows; r++) {
                        var start = r * colsPerRow;
                        var end = Math.min(start + colsPerRow, totalItems);
                        var colCount = end - start;
                        html += "<table style='border-collapse:collapse;width:100%;table-layout:fixed;" + (r > 0 ? "margin-top:-1px;" : "") + "'><tr>";
                        for (var i = start; i < end; i++) {
                            html += "<th class='item-edit-th-hz bg-table-header'>" + escapeHtml(allItems[i].name) + "</th>";
                        }
                        // 端数列を透明で埋める
                        for (var pad = colCount; pad < colsPerRow; pad++) {
                            html += "<th style='border:1px solid transparent;background:transparent;'></th>";
                        }
                        html += "</tr><tr>";
                        for (var i = start; i < end; i++) {
                            var pi = permitItems[allItems[i].id] || {handling: false, transfer: false};
                            var mark;
                            if (pi.transfer) {
                                mark = "<span class='mark-transfer' style='font-size:1.3em;'>◎</span>";
                            } else if (pi.handling) {
                                mark = "<span class='mark-handling' style='font-size:1.3em;'>〇</span>";
                            } else {
                                mark = "<span class='mark-none'>×</span>";
                            }
                            html += "<td class='item-edit-td-hz' onclick='cyclePermitItemInline(" + permitId + ", " + allItems[i].id + ", \"" + targetId + "\")'>" + mark + "</td>";
                        }
                        for (var pad = colCount; pad < colsPerRow; pad++) {
                            html += "<td style='border:1px solid transparent;'></td>";
                        }
                        html += "</tr></table>";
                    }
                    html += "<p class='auto-label' style='margin-top:5px;'>〇=取扱 ◎=積替保管 ×=なし（クリックで切替）</p>";
                }
                document.getElementById(targetId).innerHTML = html;
            } catch (e) {
                document.getElementById(targetId).innerHTML = "<p>品目読み込みエラー: " + e.message + "</p>";
            }
        }

        function loadPermitItemsInEdit(permitId) {
            loadPermitItemsInline(permitId, "permit-edit-items", false, editingPermitCategoryId);
        }

        function cyclePermitItemInline(permitId, itemId, targetId) {
            try {
                var queries = buildPermitItemQueries(permitId, itemId);
                var rs = conn.Execute(queries.select);
                if (rs.EOF) {
                    rs.Close();
                    conn.Execute(queries.insert);
                } else {
                    var recId = rs.Fields("許可品目ID").Value;
                    var handling = rs.Fields("取り扱いフラグ").Value;
                    var transfer = rs.Fields("積替保管フラグ").Value;
                    rs.Close();
                    if (transfer) {
                        conn.Execute(queries.remove(recId));
                    } else if (handling) {
                        conn.Execute(queries.toTransfer(recId));
                    }
                }
                loadPermitItemsInline(permitId, targetId, false, editingPermitCategoryId);
            } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
        }

        function loadFacilitiesForBusiness(businessId, includeAbolished) {
            var _step = "";
            try {
                // 処理能力単位マスターを先に取得
                var hourUnits = {};
                var dayUnits = {};
                _step = "マスター_時間処理能力単位";
                var urs = conn.Execute(buildMasterAllQuery("マスター_時間処理能力単位"));
                while (!urs.EOF) { hourUnits[urs.Fields(0).Value] = urs.Fields(1).Value; urs.MoveNext(); }
                urs.Close();
                _step = "マスター_日処理能力単位";
                urs = conn.Execute(buildMasterAllQuery("マスター_日処理能力単位"));
                while (!urs.EOF) { dayUnits[urs.Fields(0).Value] = urs.Fields(1).Value; urs.MoveNext(); }
                urs.Close();

                _step = "施設一覧クエリ";
                var rs = conn.Execute(buildLoadFacilitiesForBusinessQuery(businessId, includeAbolished));
                var html = "<button class='btn-add' onclick='openFacilityForm(" + businessId + ")'>+ 施設追加</button>";
                html += "<label style='display:inline-block;cursor:pointer;margin-left:16px;color:inherit;white-space:nowrap;font-size:0.9em;vertical-align:middle;' for='facilityIncludeAbolished'><span class='toggle-switch'><input type='checkbox' id='facilityIncludeAbolished'" + (includeAbolished ? " checked" : "") + " onchange='refreshFacilitiesTab(" + businessId + ", this.checked)'><span class='toggle-slider'></span></span> 廃止済みを含む</label>";
                if (rs.EOF) {
                    rs.Close();
                    return html + "<p class='text-note'>施設の登録はまだありません。</p>";
                }
                while (!rs.EOF) {
                    var facilityId = rs.Fields("施設ID").Value;
                    var logicalId = rs.Fields("施設論理ID").Value || "";
                    var typeId = rs.Fields("施設種別ID").Value || 0;
                    var abolished = rs.Fields("廃止年月日").Value;
                    var typeName = rs.Fields("施設種別名").Value || "";
                    var location = rs.Fields("設置場所").Value || "";

                    html += "<div class='facility-card" + (abolished ? " abolished" : "") + "' onclick='editFacilityFromList(" + facilityId + ", " + logicalId + ", " + businessId + ")'>";
                    html += "<div class='facility-card-header'>";
                    html += abolished ? statusBadge('abolished', '廃止') : statusBadge('operating', '稼働中');
                    html += "<span class='facility-card-title'>" + escapeHtml(typeName) + "</span>";
                    // 種別固有バッジ
                    if (typeId === FACILITY_TYPE_PROCESSING) {
                        var method = rs.Fields("処理方法名").Value || "";
                        if (method) html += "<span class='badge badge-blue'>" + escapeHtml(method) + "</span>";
                    } else if (typeId === FACILITY_TYPE_LANDFILL) {
                        var mgmt = rs.Fields("管理区分名").Value || "";
                        if (mgmt) html += "<span class='badge badge-orange'>" + escapeHtml(mgmt) + "</span>";
                    }
                    html += "<span class='facility-card-sub'>" + escapeHtml(location) + "</span>";
                    html += "<button class='btn btn-primary btn-sm' style='margin-left:auto;' onclick='event.stopPropagation(); editFacilityFromList(" + facilityId + ", " + logicalId + ", " + businessId + ")'>詳細</button>";
                    html += "</div>";

                    // 処理能力 or 種別固有サマリー
                    if (typeId === FACILITY_TYPE_LANDFILL) {
                        var cap = rs.Fields("容量m3").Value;
                        var area = rs.Fields("面積m2").Value;
                        var sizeStr = "";
                        if (cap) sizeStr += Number(cap).toLocaleString() + " ㎥";
                        if (cap && area) sizeStr += " / ";
                        if (area) sizeStr += Number(area).toLocaleString() + " ㎡";
                        if (sizeStr) {
                            html += "<div class='facility-card-col-label'>規模</div>";
                            html += "<div style='font-size:0.85em;color:#555;margin-bottom:4px;'>" + sizeStr + "</div>";
                        }
                    }

                    // 処理能力を取得（品目ごと）
                    try {
                        _step = "処理能力(施設ID=" + facilityId + ")";
                        var crs = conn.Execute(buildLoadProcessingCapacityQuery(facilityId));
                        var capItems = [];
                        while (!crs.EOF) {
                            capItems.push({
                                name: crs.Fields("品目名").Value || "",
                                hourCap: crs.Fields("時間処理能力").Value,
                                hourUnitId: crs.Fields("時間処理能力単位ID").Value,
                                dayCap: crs.Fields("日処理能力").Value,
                                dayUnitId: crs.Fields("日処理能力単位ID").Value
                            });
                            crs.MoveNext();
                        }
                        crs.Close();
                        if (capItems.length > 0) {
                            html += "<div class='facility-card-col-label'>品目 / 処理能力</div>";
                            html += "<table class='capacity-table'>";
                            for (var ci = 0; ci < capItems.length; ci++) {
                                var c = capItems[ci];
                                var hStr = c.hourCap ? c.hourCap + " " + (hourUnits[c.hourUnitId] || "") : "-";
                                var dStr = c.dayCap ? c.dayCap + " " + (dayUnits[c.dayUnitId] || "") : "-";
                                html += "<tr><td class='cap-name'>" + escapeHtml(c.name) + "</td>";
                                html += "<td class='cap-value'>" + hStr + "</td>";
                                html += "<td class='cap-value'>" + dStr + "</td></tr>";
                            }
                            html += "</table>";
                        }
                    } catch (ce) {}

                    html += "</div>";
                    rs.MoveNext();
                }
                rs.Close();
                return html;
            } catch (e) { return "<p>エラー [" + _step + "]: " + e.message + "</p>"; }
        }

        // 施設を廃止する
        function abolishFacility(facilityId, businessId) {
            showConfirmDialog("施設廃止", "この施設を廃止しますか？\n（有効終了日時が設定されます）", {
                okText: "廃止する", okClass: "btn-warning",
                onOk: function() {
                    try {
                        var dateStr = buildDateStr();
                        conn.Execute(buildAbolishFacilityQuery(facilityId, dateStr));
                        showToast("施設を廃止しました", "info");
                        document.getElementById("tab-facilities").innerHTML = loadFacilitiesForBusiness(businessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        // 施設詳細画面からの廃止（日付入力対応）
        function abolishFacilityFromDetail() {
            var dateStr = document.getElementById("detail-fac-abolish-date").value;
            if (!dateStr) { showToast("廃止日を選択してください", "error"); return; }
            var confirmDateEl = document.getElementById("detail-fac-abolish-confirm");
            var confirmDate = confirmDateEl ? confirmDateEl.value : "";
            var msg = "この施設を廃止しますか？\n廃止日: " + dateStr;
            if (confirmDate) msg += "\n廃止確認日: " + confirmDate;
            showConfirmDialog("施設廃止", msg, {
                okText: "廃止する", okClass: "btn-warning",
                onOk: function() {
                    try {
                        conn.Execute(buildAbolishFacilityQuery(currentDetailFacilityId, dateStr, confirmDate || undefined));
                        showToast("施設を廃止しました", "info");
                        showFacilityDetail(currentDetailFacilityId, currentDetailFacilityLogicalId, currentDetailFacilityBusinessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        // 施設詳細画面からの復活
        function restoreFacilityFromDetail() {
            showConfirmDialog("施設復活", "この施設を復活しますか？\n（廃止日がクリアされます）", {
                okText: "復活する", okClass: "btn-success",
                onOk: function() {
                    try {
                        // 同じ論理IDで既にアクティブなバージョンがあるか確認
                        var chkRs = conn.Execute(buildCheckActiveVersionExistsQuery("施設", "施設論理ID", currentDetailFacilityLogicalId, currentDetailFacilityId, "施設ID"));
                        var activeCnt = chkRs.Fields("cnt").Value;
                        chkRs.Close();
                        if (activeCnt > 0) {
                            showToast("同じ論理IDで既にアクティブな施設があるため復活できません", "error", 5000);
                            return;
                        }
                        conn.Execute(buildRestoreFacilityQuery(currentDetailFacilityId));
                        showToast("復活しました", "success");
                        showFacilityDetail(currentDetailFacilityId, currentDetailFacilityLogicalId, currentDetailFacilityBusinessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        // 施設詳細画面からの削除（全履歴を完全削除）
        function deleteFacilityFromDetail() {
            showConfirmDialog("施設削除", "この施設を完全に削除しますか？\n関連する処理能力データと全ての履歴も削除されます。\n\nこの操作は取り消せません。", {
                okText: "削除", okClass: "btn-danger",
                onOk: function() {
                    showConfirmDialog("最終確認", "本当に削除してよろしいですか？", {
                        okText: "削除する", okClass: "btn-danger",
                        onOk: function() {
                            try {
                                conn.BeginTrans();
                                try {
                                    var queries = buildDeleteFacilityQueries(currentDetailFacilityLogicalId);
                                    for (var i = 0; i < queries.length; i++) {
                                        conn.Execute(queries[i]);
                                    }
                                    conn.CommitTrans();
                                } catch (txErr) {
                                    conn.RollbackTrans();
                                    throw txErr;
                                }
                                showToast("施設を削除しました", "info");
                                document.getElementById("tab-facilities").innerHTML = loadFacilitiesForBusiness(currentDetailFacilityBusinessId);
                            } catch (e) { showToast("削除に失敗しました: " + e.message, "error", 5000); }
                        }
                    });
                }
            });
        }

        // 処理能力一覧を表示（施設ID = 物理IDで管理）
        var currentCapacityFacilityId = 0;
        var currentCapacityBusinessId = 0;
        function showProcessingCapacity(facilityId, businessId) {
            currentCapacityFacilityId = facilityId;
            currentCapacityBusinessId = businessId;
            try {
                // 単位マスターを取得
                var hourUnits = {};
                var dayUnits = {};
                var rs = conn.Execute(buildMasterAllQuery("マスター_時間処理能力単位"));
                while (!rs.EOF) {
                    hourUnits[rs.Fields(0).Value] = rs.Fields(1).Value;
                    rs.MoveNext();
                }
                rs.Close();
                rs = conn.Execute(buildMasterAllQuery("マスター_日処理能力単位"));
                while (!rs.EOF) {
                    dayUnits[rs.Fields(0).Value] = rs.Fields(1).Value;
                    rs.MoveNext();
                }
                rs.Close();

                // 処理能力を取得（施設IDで検索）
                rs = conn.Execute(buildLoadProcessingCapacityQuery(facilityId));

                var html = buildStepNav([
                    {label: "施設一覧", onclick: "closeCapacityView()"},
                    {label: "処理能力管理"}
                ], 1);
                html += "<button class='btn-add' onclick='openCapacityForm()'>+ 品目追加</button>";
                html += "<table class='data-table'><tr><th>品目</th><th>時間処理能力</th><th>日処理能力</th><th>稼働時間</th><th>特記事項</th><th>操作</th></tr>";

                while (!rs.EOF) {
                    var capId = rs.Fields("処理能力ID").Value;
                    var itemName = rs.Fields("品目名").Value || "";
                    var hourCap = rs.Fields("時間処理能力").Value;
                    var hourUnitId = rs.Fields("時間処理能力単位ID").Value;
                    var dayCap = rs.Fields("日処理能力").Value;
                    var dayUnitId = rs.Fields("日処理能力単位ID").Value;
                    var hours = rs.Fields("稼働時間").Value;
                    var note = rs.Fields("特記事項").Value || "";

                    var hourStr = hourCap ? hourCap + " " + (hourUnits[hourUnitId] || "") : "-";
                    var dayStr = dayCap ? dayCap + " " + (dayUnits[dayUnitId] || "") : "-";

                    html += "<tr><td>" + escapeHtml(itemName) + "</td>";
                    html += "<td>" + hourStr + "</td>";
                    html += "<td>" + dayStr + "</td>";
                    html += "<td>" + (hours || "-") + "</td>";
                    html += "<td>" + escapeHtml(note) + "</td>";
                    html += "<td>";
                    html += "<button class='btn btn-primary btn-sm' onclick='editCapacity(" + capId + ")'>編集</button>";
                    html += "<button class='btn btn-danger btn-sm' onclick='deleteCapacity(" + capId + ")'>削除</button>";
                    html += "</td></tr>";
                    rs.MoveNext();
                }
                rs.Close();
                html += "</table>";

                document.getElementById("tab-facilities").innerHTML = html;
            } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
        }

        function closeCapacityView() {
            document.getElementById("tab-facilities").innerHTML = loadFacilitiesForBusiness(currentCapacityBusinessId);
        }

        // 処理能力追加フォーム
        function openCapacityForm(editId) {
            var itemOptions = "<option value=''>-- 品目を選択 --</option>";
            var hourUnitOptions = "";
            try {
                var rs = conn.Execute(buildMasterListQuery("マスター_品目", "品目ID", "品目名", "表示順"));
                while (!rs.EOF) {
                    var iid = rs.Fields("品目ID").Value;
                    var iname = escapeHtml(rs.Fields("品目名").Value);
                    itemOptions += "<option value='" + iid + "'>" + iname + "</option>";
                    rs.MoveNext();
                }
                rs.Close();
                rs = conn.Execute(buildMasterAllQuery("マスター_時間処理能力単位"));
                while (!rs.EOF) {
                    hourUnitOptions += "<option value='" + rs.Fields(0).Value + "'>" + escapeHtml(rs.Fields(1).Value) + "</option>";
                    rs.MoveNext();
                }
                rs.Close();
            } catch (e) { showToast("品目データの読み込みに失敗: " + e.message, "error", 5000); }

            // 編集モードの場合、既存データを取得
            var isEdit = editId ? true : false;
            var editData = { itemId: "", hourCap: "", hourUnit: 1, dayCap: "", dayUnit: 1, hours: "", note: "" };
            if (isEdit) {
                try {
                    var rs = conn.Execute(buildGetProcessingCapacityByIdQuery(editId));
                    if (!rs.EOF) {
                        editData.itemId = rs.Fields("品目ID").Value || "";
                        editData.hourCap = rs.Fields("時間処理能力").Value || "";
                        editData.hourUnit = rs.Fields("時間処理能力単位ID").Value || 1;
                        editData.dayCap = rs.Fields("日処理能力").Value || "";
                        editData.dayUnit = rs.Fields("日処理能力単位ID").Value || 1;
                        editData.hours = rs.Fields("稼働時間").Value || "";
                        editData.note = rs.Fields("特記事項").Value || "";
                    }
                    rs.Close();
                } catch (e) {}
            }

            var html = "<div class='form-card'>";
            html += "<h2>" + (isEdit ? "処理能力編集" : "処理能力追加") + "</h2>";
            html += "<input type='hidden' id='capEditId' value='" + (editId || "") + "'>";
            html += "<div class='form-row'>";
            html += "<div class='form-group'><label>品目 <span class='badge-required'>必須</span></label>";
            html += "<select id='capItemSelect'>" + itemOptions + "</select></div>";
            html += "<div class='form-group'><label>単位</label>";
            html += "<select id='capHourUnit'>" + hourUnitOptions + "</select></div>";
            html += "</div>";
            html += "<div class='form-row'>";
            html += "<div class='form-group'><label>時間処理能力 <span class='badge-optional'>任意</span></label>";
            html += "<input type='number' id='capHourCap' style='width:120px;' step='any' min='0' value='" + editData.hourCap + "'></div>";
            html += "<div class='form-group'><label>日処理能力 <span class='badge-optional'>任意</span></label>";
            html += "<input type='number' id='capDayCap' style='width:120px;' step='any' min='0' value='" + editData.dayCap + "'></div>";
            html += "</div>";
            html += "<div class='form-group'><label>稼働時間（時間/日） <span class='badge-optional'>任意</span></label>";
            html += "<input type='number' id='capHours' style='width:100px;' step='any' min='0' max='24' value='" + editData.hours + "'></div>";
            html += "<div class='form-group'><label>特記事項 <span class='badge-optional'>任意</span></label>";
            html += "<textarea id='capNote' rows='2'>" + escapeHtml(editData.note) + "</textarea></div>";
            html += "<div class='form-buttons'>";
            html += "<button class='btn btn-primary' onclick='saveCapacity()'>保存</button>";
            html += "<button class='btn btn-secondary' onclick='showProcessingCapacity(" + currentCapacityFacilityId + ", " + currentCapacityBusinessId + ")'>キャンセル</button>";
            html += "</div></div>";

            document.getElementById("tab-facilities").innerHTML = html;

            // 選択状態を設定
            if (editData.itemId) {
                document.getElementById("capItemSelect").value = editData.itemId;
            }
            document.getElementById("capHourUnit").value = editData.hourUnit;
        }

        function editCapacity(capId) {
            openCapacityForm(capId);
        }

        function saveCapacity() {
            var editId = document.getElementById("capEditId").value;
            var itemId = document.getElementById("capItemSelect").value;
            var hourCap = document.getElementById("capHourCap").value;
            var hourUnit = document.getElementById("capHourUnit").value;
            var dayCap = document.getElementById("capDayCap").value;
            var dayUnit = hourUnit;
            var hours = document.getElementById("capHours").value;
            var note = document.getElementById("capNote").value;

            if (!itemId) { showToast("品目を選択してください", "error"); return; }
            if (!hourCap && !dayCap) { showToast("時間処理能力または日処理能力のいずれかを入力してください", "error"); return; }

            try {
                var sql = buildSaveCapacityQuery({
                    editId: editId,
                    facilityId: currentCapacityFacilityId,
                    itemId: itemId,
                    hourCap: hourCap,
                    hourUnit: hourUnit,
                    dayCap: dayCap,
                    dayUnit: dayUnit,
                    hours: hours,
                    note: note
                });
                conn.Execute(sql);
                showProcessingCapacity(currentCapacityFacilityId, currentCapacityBusinessId);
            } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
        }

        function deleteCapacity(capId) {
            showConfirmDialog("処理能力削除", "この処理能力を削除しますか？", {
                okText: "削除する", okClass: "btn-danger",
                onOk: function() {
                    try {
                        conn.Execute(buildDeleteCapacityQuery(capId));
                        showProcessingCapacity(currentCapacityFacilityId, currentCapacityBusinessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        // 施設追加フォーム
        var currentFacilityBusinessId = 0;
        var newFacilityPendingCapacities = []; // 新規施設作成時の処理能力一時保持
        var facilityFormItemOptions = "";      // 品目マスター（フォーム用キャッシュ）
        var facilityFormHourUnitOptions = "";  // 時間処理能力単位マスター（フォーム用キャッシュ）
        function openFacilityForm(businessId) {
            currentFacilityBusinessId = businessId;
            newFacilityPendingCapacities = [];
            // 施設種別マスターを取得
            var typeOptions = "<option value=''>選択してください</option>";
            try {
                var rs = conn.Execute(buildMasterListQuery("マスター_施設種別", "施設種別ID", "施設種別名"));
                while (!rs.EOF) {
                    typeOptions += "<option value='" + rs.Fields("施設種別ID").Value + "'>" + escapeHtml(rs.Fields("施設種別名").Value) + "</option>";
                    rs.MoveNext();
                }
                rs.Close();
            } catch (e) {}

            // 品目マスター（処理能力用）
            facilityFormItemOptions = "<option value=''>-- 品目を選択 --</option>";
            try {
                var rsItems = conn.Execute(buildMasterListQuery("マスター_品目", "品目ID", "品目名", "表示順"));
                while (!rsItems.EOF) {
                    facilityFormItemOptions += "<option value='" + rsItems.Fields("品目ID").Value + "'>" + escapeHtml(rsItems.Fields("品目名").Value) + "</option>";
                    rsItems.MoveNext();
                }
                rsItems.Close();
            } catch (e) {}

            // 時間処理能力単位マスター
            facilityFormHourUnitOptions = "";
            try {
                var rsUnits = conn.Execute(buildMasterAllQuery("マスター_時間処理能力単位"));
                while (!rsUnits.EOF) {
                    facilityFormHourUnitOptions += "<option value='" + rsUnits.Fields(0).Value + "'>" + escapeHtml(rsUnits.Fields(1).Value) + "</option>";
                    rsUnits.MoveNext();
                }
                rsUnits.Close();
            } catch (e) {}

            // 管理区分マスターを取得
            var mgmtOptions = "<option value=''>選択してください</option>";
            try {
                var rs2 = conn.Execute(buildMasterListQuery("マスター_管理区分", "管理区分ID", "管理区分名"));
                while (!rs2.EOF) {
                    mgmtOptions += "<option value='" + rs2.Fields("管理区分ID").Value + "'>" + escapeHtml(rs2.Fields("管理区分名").Value) + "</option>";
                    rs2.MoveNext();
                }
                rs2.Close();
            } catch (e) {}

            // 処理方法マスターを取得
            var methodOptions = "<option value=''>選択してください</option>";
            try {
                var rs3 = conn.Execute(buildMasterListQuery("マスター_処理方法", "処理方法ID", "処理方法名"));
                while (!rs3.EOF) {
                    methodOptions += "<option value='" + rs3.Fields("処理方法ID").Value + "'>" + escapeHtml(rs3.Fields("処理方法名").Value) + "</option>";
                    rs3.MoveNext();
                }
                rs3.Close();
            } catch (e) {}

            // 設置形態区分マスターを取得
            var setupFormOptions = "<option value=''>選択してください</option>";
            try {
                var rs4 = conn.Execute(buildMasterListQuery("マスター_設置形態区分", "設置形態区分ID", "設置形態区分名"));
                while (!rs4.EOF) {
                    setupFormOptions += "<option value='" + rs4.Fields("設置形態区分ID").Value + "'>" + escapeHtml(rs4.Fields("設置形態区分名").Value) + "</option>";
                    rs4.MoveNext();
                }
                rs4.Close();
            } catch (e) {}

            // 許可対象区分マスターを取得
            var permitTargetOptions = "<option value=''>選択してください</option>";
            try {
                var rs5 = conn.Execute(buildMasterListQuery("マスター_許可対象区分", "許可対象区分ID", "許可対象区分名"));
                while (!rs5.EOF) {
                    permitTargetOptions += "<option value='" + rs5.Fields("許可対象区分ID").Value + "'>" + escapeHtml(rs5.Fields("許可対象区分名").Value) + "</option>";
                    rs5.MoveNext();
                }
                rs5.Close();
            } catch (e) {}

            var html = buildStepNav([
                {label: "施設一覧", onclick: "refreshFacilitiesTab(" + businessId + ")"},
                {label: "施設追加"}
            ], 1);
            html += "<div class='form-card'>";
            html += "<h2>施設追加</h2>";
            html += "<div class='form-group'><label>施設種別 <span class='badge-required'>必須</span></label>";
            html += "<select id='fType' onchange='toggleFacilityTypeFields()'>" + typeOptions + "</select></div>";
            html += "<div class='form-group'><label>設置場所 <span class='badge-required'>必須</span></label>";
            html += "<input type='text' id='fLocation' placeholder='住所を入力'></div>";
            html += "<div class='form-group'><label>許可番号 <span id='fPermitNo-badge' class='badge-optional'>任意</span></label>";
            html += "<input type='text' id='fPermitNo' oninput='this.value=normalizeToHankaku(this.value)'></div>";
            html += "<div class='form-row'>";
            html += "<div class='form-group'><label>許可年月日 <span class='badge-optional'>任意</span></label><div class='datepicker-wrapper'><input type='text' id='fPermitDate' class='datepicker-input' onclick='openDatePicker(\"fPermitDate\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
            html += "<div class='form-group'><label>設置年月日 <span class='badge-optional'>任意</span></label><div class='datepicker-wrapper'><input type='text' id='fSetupDate' class='datepicker-input' onclick='openDatePicker(\"fSetupDate\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
            html += "</div>";
            // 最終処分場用フィールド（typeId=2）
            html += "<div id='landfill-fields' style='display:none;'>";
            html += "<div class='form-group'><label>管理区分 <span class='badge-optional'>任意</span></label>";
            html += "<select id='fMgmtType' style='width:200px;'>" + mgmtOptions + "</select></div>";
            html += "<div class='form-row'>";
            html += "<div class='form-group'><label>容量(㎥) <span class='badge-optional'>任意</span></label>";
            html += "<input type='text' id='fCapacity' style='width:150px;' placeholder='数値' oninput='this.value=normalizeToHankaku(this.value)'></div>";
            html += "<div class='form-group'><label>面積(㎡) <span class='badge-optional'>任意</span></label>";
            html += "<input type='text' id='fArea' style='width:150px;' placeholder='数値' oninput='this.value=normalizeToHankaku(this.value)'></div>";
            html += "</div>";
            html += "<div class='form-group'><label>埋立終了年月日 <span class='badge-optional'>任意</span></label><div class='datepicker-wrapper'><input type='text' id='fLandfillEnd' class='datepicker-input' onclick='openDatePicker(\"fLandfillEnd\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
            html += "</div>";
            // 積替保管施設用フィールド（typeId=3）
            html += "<div id='storage-fields' style='display:none;'>";
            html += "<div class='b2-group-title' style='margin-top:16px;'>保管施設情報 <span class='badge-optional'>任意</span></div>";
            html += "<div class='form-row'>";
            html += "<div class='form-group'><label>保管面積(㎡)</label><input type='number' id='fStorageArea' step='any' min='0' placeholder='数値'></div>";
            html += "<div class='form-group'><label>保管量上限(㎥)</label><input type='number' id='fStorageCap' step='any' min='0' placeholder='数値'></div>";
            html += "<div class='form-group'><label>保管高さ(m)</label><input type='number' id='fStorageHeight' step='any' min='0' placeholder='数値'></div>";
            html += "</div></div>";
            // 中間処理施設用フィールド（typeId=1）
            html += "<div id='processing-fields' style='display:none;'>";
            html += "<div class='form-group'><label>処理方法 <span class='badge-optional'>任意</span></label>";
            html += "<select id='fMethod' style='width:200px;'>" + methodOptions + "</select></div>";
            html += "<div class='form-group'><label>設置形態 <span class='badge-optional'>任意</span></label>";
            html += "<select id='fSetupForm' style='width:200px;'>" + setupFormOptions + "</select></div>";
            html += "<div class='form-group'><label>許可対象区分 <span class='badge-optional'>任意</span></label>";
            html += "<select id='fPermitTarget' style='width:200px;' onchange='updateNewFacPermitNoBadge()'>" + permitTargetOptions + "</select></div>";
            // 処理能力インラインテーブル（施設詳細と同じ方式）
            html += "<div style='display:flex; align-items:center; margin-top:16px;'><div class='b2-group-title' style='margin:0;'>処理能力 <span class='badge-optional'>任意</span></div>";
            html += "<button class='btn btn-primary btn-sm' style='margin-left:auto;' onclick='addPendingCapacityRow()'>+ 追加</button></div>";
            html += "<div id='newFacilityCapacityList'><p class='auto-label'>処理能力の登録なし</p></div>";
            html += "</div>";
            html += "<input type='hidden' id='fBusinessId' value='" + businessId + "'>";
            html += "<div class='form-buttons'>";
            html += "<button class='btn btn-primary' onclick='saveFacility()'>保存</button>";
            html += "<button class='btn btn-secondary' onclick='cancelFacilityForm()'>キャンセル</button>";
            html += "</div>";
            html += "</div>";
            document.getElementById("tab-facilities").innerHTML = html;
        }

        // 施設種別に応じて追加フィールドの表示を切り替え
        function toggleFacilityTypeFields(editPrefix) {
            var prefix = editPrefix || '';
            var typeEl = document.getElementById(prefix ? prefix + '-fac-type' : 'fType');
            var typeId = typeEl ? parseInt(typeEl.value) : 0;
            var landfillEl = document.getElementById(prefix ? prefix + '-landfill-fields' : 'landfill-fields');
            var processingEl = document.getElementById(prefix ? prefix + '-processing-fields' : 'processing-fields');
            var storageEl = document.getElementById(prefix ? prefix + '-storage-fields' : 'storage-fields');
            if (landfillEl) landfillEl.style.display = (typeId === FACILITY_TYPE_LANDFILL) ? '' : 'none';
            if (processingEl) processingEl.style.display = (typeId === FACILITY_TYPE_PROCESSING) ? '' : 'none';
            if (storageEl) storageEl.style.display = (typeId === FACILITY_TYPE_STORAGE) ? '' : 'none';
        }

        // 許可対象区分の変更時に許可番号バッジを必須/任意に切り替え
        function updatePermitNoBadge() {
            var el = document.getElementById("edit-fac-permit-target");
            var badge = document.getElementById("edit-fac-permit-no-badge");
            if (!el || !badge) return;
            var isTarget = !el.value || parseInt(el.value) === 1;
            badge.className = isTarget ? "badge-required" : "badge-optional";
            badge.innerText = isTarget ? "必須" : "任意";
        }

        // 施設追加フォーム: 許可対象区分の変更時に許可番号バッジを切り替え
        function updateNewFacPermitNoBadge() {
            var el = document.getElementById("fPermitTarget");
            var badge = document.getElementById("fPermitNo-badge");
            if (!el || !badge) return;
            var isTarget = !el.value || parseInt(el.value) === 1;
            badge.className = isTarget ? "badge-required" : "badge-optional";
            badge.innerText = isTarget ? "必須" : "任意";
        }

        // 施設追加: インラインテーブル行追加（施設詳細と同じ方式）
        function addPendingCapacityRow() {
            newFacilityPendingCapacities.push({
                itemId: "", hourCap: "", dayCap: "", hourUnitId: 1, dayUnitId: 1
            });
            renderPendingCapacityTable();
        }

        function removePendingCapacity(index) {
            // 削除前にテーブルの入力値を保存
            readPendingCapacityTable();
            newFacilityPendingCapacities.splice(index, 1);
            renderPendingCapacityTable();
        }

        // テーブルのinput/select値をメモリに読み込み
        function readPendingCapacityTable() {
            var tbl = document.getElementById("pending-cap-tbl");
            if (!tbl) return;
            var rows = tbl.getElementsByTagName("tr");
            for (var i = 1; i < rows.length; i++) { // skip header
                var idx = i - 1;
                if (idx >= newFacilityPendingCapacities.length) break;
                var inputs = rows[i].getElementsByTagName("input");
                var selects = rows[i].getElementsByTagName("select");
                if (selects.length > 0) newFacilityPendingCapacities[idx].itemId = selects[0].value;
                if (inputs.length > 0) newFacilityPendingCapacities[idx].hourCap = inputs[0].value;
                if (inputs.length > 1) newFacilityPendingCapacities[idx].dayCap = inputs[1].value;
                if (selects.length > 1) newFacilityPendingCapacities[idx].dayUnitId = parseInt(selects[1].value) || 1;
            }
        }

        function renderPendingCapacityTable() {
            var el = document.getElementById("newFacilityCapacityList");
            if (!el) return;
            if (newFacilityPendingCapacities.length === 0) {
                el.innerHTML = "<p class='auto-label'>処理能力の登録なし</p>";
                return;
            }
            var html = "<table class='data-table' id='pending-cap-tbl' style='margin-top:8px;'><tr>";
            html += "<th>品目</th><th>時間処理能力</th><th>日処理能力</th><th>単位</th><th style='width:40px;'></th>";
            html += "</tr>";
            for (var i = 0; i < newFacilityPendingCapacities.length; i++) {
                var c = newFacilityPendingCapacities[i];
                html += "<tr>";
                html += "<td><select style='width:100%;'>" + facilityFormItemOptions.replace("value='" + c.itemId + "'", "value='" + c.itemId + "' selected") + "</select></td>";
                html += "<td><input class='inline-input' type='text' value='" + (c.hourCap || "") + "' style='width:60px;text-align:right;' oninput='this.value=normalizeToHankaku(this.value)'></td>";
                html += "<td><input class='inline-input' type='text' value='" + (c.dayCap || "") + "' style='width:60px;text-align:right;' oninput='this.value=normalizeToHankaku(this.value)'></td>";
                html += "<td><select>" + facilityFormHourUnitOptions.replace("value='" + c.dayUnitId + "'", "value='" + c.dayUnitId + "' selected") + "</select></td>";
                html += "<td><button class='btn-delete-row' title='削除' onclick='removePendingCapacity(" + i + ")'>&#10005;</button></td>";
                html += "</tr>";
            }
            html += "</table>";
            el.innerHTML = html;
        }

        // 施設を保存
        function saveFacility() {
            var typeId = document.getElementById("fType").value;
            var location = normalizeToHankaku(document.getElementById("fLocation").value);
            var permitNo = normalizePermitNumber(document.getElementById("fPermitNo").value);
            var permitDate = document.getElementById("fPermitDate").value.trim();
            var setupDate = document.getElementById("fSetupDate").value.trim();

            var missing = [];
            if (!typeId) missing.push("施設種別");
            if (!location) missing.push("設置場所");
            // 許可対象施設の場合のみ許可番号を必須とする
            var permitTargetEl = document.getElementById("fPermitTarget");
            var isPermitTarget = !permitTargetEl || !permitTargetEl.value || parseInt(permitTargetEl.value) === 1;
            if (isPermitTarget && !permitNo) missing.push("施設許可番号");
            if (missing.length > 0) {
                showToast("以下の必須項目が未入力です:\n・" + missing.join("\n・"), "error");
                return;
            }

            // hiddenフィールドからbusinessIdを取得（グローバル変数の上書き問題を回避）
            var bizIdEl = document.getElementById("fBusinessId");
            var savingBusinessId = bizIdEl ? parseInt(bizIdEl.value) : currentFacilityBusinessId;

            try {
                // トランザクションで論理ID採番+INSERT を排他的に実行
                conn.BeginTrans();
                try {
                    var maxRs = conn.Execute(buildGetNextLogicalIdQuery("施設", "施設論理ID"));
                    var newLogicalId = (maxRs.Fields("maxId").Value || 0) + 1;
                    maxRs.Close();

                    var todayStr = buildDateStr();
                    var data = {
                        logicalId: newLogicalId, businessId: savingBusinessId,
                        typeId: typeId, location: location, permitNo: permitNo,
                        permitDate: permitDate, setupDate: setupDate, todayStr: todayStr
                    };

                // 施設種別に応じた追加フィールド
                if (parseInt(typeId) === FACILITY_TYPE_LANDFILL) {
                    var mgmtEl = document.getElementById("fMgmtType");
                    var capEl = document.getElementById("fCapacity");
                    var areaEl = document.getElementById("fArea");
                    var landfillEndEl = document.getElementById("fLandfillEnd");
                    if (mgmtEl && mgmtEl.value) data.managementTypeId = parseInt(mgmtEl.value);
                    if (capEl && capEl.value) data.capacityM3 = parseInt(capEl.value);
                    if (areaEl && areaEl.value) data.areaM2 = parseInt(areaEl.value);
                    if (landfillEndEl && landfillEndEl.value) data.landfillEndDate = landfillEndEl.value;
                } else if (parseInt(typeId) === FACILITY_TYPE_PROCESSING) {
                    var methodEl = document.getElementById("fMethod");
                    if (methodEl && methodEl.value) data.processingMethodId = parseInt(methodEl.value);
                    var setupFormEl = document.getElementById("fSetupForm");
                    if (setupFormEl && setupFormEl.value) data.setupFormId = parseInt(setupFormEl.value);
                    var permitTargetEl = document.getElementById("fPermitTarget");
                    if (permitTargetEl && permitTargetEl.value) data.permitTargetId = parseInt(permitTargetEl.value);
                }
                // 保管施設情報（積替保管施設のみ）
                if (parseInt(typeId) === FACILITY_TYPE_STORAGE) {
                    var storageAreaEl = document.getElementById("fStorageArea");
                    var storageCapEl = document.getElementById("fStorageCap");
                    var storageHeightEl = document.getElementById("fStorageHeight");
                    if (storageAreaEl && storageAreaEl.value) data.storageAreaM2 = parseFloat(storageAreaEl.value);
                    if (storageCapEl && storageCapEl.value) data.storageCapM3 = parseFloat(storageCapEl.value);
                    if (storageHeightEl && storageHeightEl.value) data.storageHeightM = parseFloat(storageHeightEl.value);
                }

                var sql = buildSaveFacilityQuery(data);
                conn.Execute(sql);

                    // 処理能力をインライン追加（中間処理施設の場合）
                    readPendingCapacityTable(); // テーブルの入力値を読み込み
                    var capCount = 0;
                    // 品目が選択されている行のみ保存
                    var validCaps = [];
                    for (var vi = 0; vi < newFacilityPendingCapacities.length; vi++) {
                        if (newFacilityPendingCapacities[vi].itemId) validCaps.push(newFacilityPendingCapacities[vi]);
                    }
                    if (parseInt(typeId) === FACILITY_TYPE_PROCESSING && validCaps.length > 0) {
                        var newFacRs = conn.Execute(buildGetMaxIdQuery("施設", "施設ID", "施設論理ID", newLogicalId));
                        var newFacIdInTx = newFacRs.Fields("newId").Value;
                        newFacRs.Close();
                        for (var ci = 0; ci < validCaps.length; ci++) {
                            var cap = validCaps[ci];
                            var capSql = buildSaveCapacityQuery({
                                facilityId: newFacIdInTx,
                                itemId: cap.itemId,
                                hourCap: cap.hourCap || "",
                                hourUnit: cap.dayUnitId || 1,
                                dayCap: cap.dayCap || "",
                                dayUnit: cap.dayUnitId || 1,
                                hours: "", note: ""
                            });
                            conn.Execute(capSql);
                            capCount++;
                        }
                    }

                    conn.CommitTrans();
                } catch (txErr) {
                    conn.RollbackTrans();
                    throw txErr;
                }
                // 新しい施設IDを取得して詳細画面へ遷移
                var newFacRs = conn.Execute(buildGetMaxIdQuery("施設", "施設ID", "施設論理ID", newLogicalId));
                var newFacId = newFacRs.Fields("newId").Value;
                newFacRs.Close();
                var toastMsg = capCount > 0
                    ? "保存しました（処理能力" + capCount + "件を登録）"
                    : "保存しました";
                showToast(toastMsg, "success");
                showFacilityDetail(newFacId, newLogicalId, savingBusinessId);
            } catch (e) { showToast("保存エラー: " + e.message, "error", 5000); }
        }

        // 施設フォームをキャンセル
        function cancelFacilityForm() {
            document.getElementById("tab-facilities").innerHTML = loadFacilitiesForBusiness(currentFacilityBusinessId);
        }

        // 施設詳細表示（B2 Apple HIG Grouped Detail）
        var currentDetailFacilityId = 0;
        var currentDetailFacilityLogicalId = 0;
        var currentDetailFacilityBusinessId = 0;

        // 施設一覧から詳細画面を開く
        function editFacilityFromList(facilityId, logicalId, businessId) {
            showFacilityDetail(facilityId, logicalId, businessId);
        }

        function showFacilityDetail(facilityId, logicalId, businessId) {
            currentDetailFacilityId = facilityId;
            currentDetailFacilityLogicalId = logicalId;
            currentDetailFacilityBusinessId = businessId;
            try {
                var rs = conn.Execute(buildLoadFacilityForEditQuery(facilityId));
                if (rs.EOF) { showToast("施設が見つかりません", "error"); rs.Close(); return; }
                var typeId = rs.Fields("施設種別ID").Value || "";
                var location = rs.Fields("設置場所").Value || "";
                var permitNo = rs.Fields("許可番号").Value || "";
                var permitDate = rs.Fields("許可年月日文字列").Value || "";
                var setupDate = rs.Fields("設置年月日文字列").Value || "";
                var startDate = rs.Fields("有効開始文字列").Value || "";
                var endDate = rs.Fields("有効終了文字列").Value || "";
                var abolishDate = rs.Fields("廃止日文字列").Value || "";
                var suspendDate = rs.Fields("休止日文字列").Value || "";
                var resumeDate = rs.Fields("再開日文字列").Value || "";
                var cancelDate = rs.Fields("取消日文字列").Value || "";
                var cancelReason = rs.Fields("取消理由").Value || "";
                var abolishConfirmDate = rs.Fields("廃止確認日文字列").Value || "";
                var managementTypeId = rs.Fields("管理区分ID").Value || "";
                var capacityM3 = rs.Fields("容量m3").Value || "";
                var areaM2 = rs.Fields("面積m2").Value || "";
                var landfillEndDate = rs.Fields("埋立終了日文字列").Value || "";
                var processingMethodId = rs.Fields("処理方法ID").Value || "";
                var setupFormId = rs.Fields("設置形態区分ID").Value || "";
                var permitTargetId = rs.Fields("許可対象区分ID").Value || "";
                var storageAreaM2 = rs.Fields("保管施設面積m2").Value || "";
                var storageCapM3 = rs.Fields("保管量上限m3").Value || "";
                var storageHeightM = rs.Fields("保管高さm").Value || "";
                rs.Close();

                // 施設種別名を取得
                var typeName = "";
                try {
                    var typeRs = conn.Execute(buildMasterNameQuery("マスター_施設種別", "施設種別ID", "施設種別名", typeId));
                    if (!typeRs.EOF) typeName = typeRs.Fields("施設種別名").Value || "";
                    typeRs.Close();
                } catch (e2) {}

                // 種別ごとのマスター名を取得
                var mgmtName = "", methodName = "", setupFormName = "", permitTargetName = "";
                try {
                    if (managementTypeId) { var r = conn.Execute(buildMasterNameQuery("マスター_管理区分", "管理区分ID", "管理区分名", managementTypeId)); if (!r.EOF) mgmtName = r.Fields(0).Value || ""; r.Close(); }
                    if (processingMethodId) { var r = conn.Execute(buildMasterNameQuery("マスター_処理方法", "処理方法ID", "処理方法名", processingMethodId)); if (!r.EOF) methodName = r.Fields(0).Value || ""; r.Close(); }
                    if (setupFormId) { var r = conn.Execute(buildMasterNameQuery("マスター_設置形態区分", "設置形態区分ID", "設置形態区分名", setupFormId)); if (!r.EOF) setupFormName = r.Fields(0).Value || ""; r.Close(); }
                    if (permitTargetId) { var r = conn.Execute(buildMasterNameQuery("マスター_許可対象区分", "許可対象区分ID", "許可対象区分名", permitTargetId)); if (!r.EOF) permitTargetName = r.Fields(0).Value || ""; r.Close(); }
                } catch (e3) {}

                // ステータス判定
                var isAbolished = (abolishDate !== "");
                var isCancelled = (cancelDate !== "");
                var isSuspended = (suspendDate !== "" && !resumeDate);
                var isActive = !isAbolished && !isCancelled && !endDate;

                var html = "";
                // ステップナビ
                html += buildStepNav([
                    {label: "施設一覧", onclick: "refreshFacilitiesTab(" + businessId + ")"},
                    {label: "施設詳細"}
                ], 1);

                html += "<div class='permit-detail'>";

                // --- B2ヘッダー ---
                var titleSuffix = "";
                if (parseInt(typeId) === FACILITY_TYPE_PROCESSING && methodName) {
                    titleSuffix = "（" + escapeHtml(methodName) + "）";
                }
                html += "<div class='b2-header'>";
                html += "<div class='b2-title'>" + escapeHtml(typeName) + titleSuffix + "</div>";
                html += "<div class='b2-location'>" + escapeHtml(location) + "</div>";
                html += "<div class='b2-badges'>";
                if (isCancelled) {
                    html += "<span class='b2-pill b2-pill-red'>取消</span>";
                } else if (isAbolished) {
                    html += "<span class='b2-pill b2-pill-gray'>廃止</span>";
                } else if (isSuspended) {
                    html += "<span class='b2-pill b2-pill-amber'>休止</span>";
                } else if (endDate) {
                    html += "<span class='b2-pill b2-pill-gray'>失効</span>";
                } else {
                    html += "<span class='b2-pill b2-pill-green'>有効</span>";
                }
                if (parseInt(typeId) === FACILITY_TYPE_PROCESSING && setupFormName) {
                    html += "<span class='b2-pill b2-pill-blue'>" + escapeHtml(setupFormName) + "</span>";
                } else if (parseInt(typeId) === FACILITY_TYPE_LANDFILL && mgmtName) {
                    html += "<span class='b2-pill b2-pill-orange'>" + escapeHtml(mgmtName) + "</span>";
                }
                html += "</div></div>";

                // --- 基本情報 ---
                html += "<div class='b2-group-title'>基本情報</div>";
                html += "<div class='b2-group'>";
                if (permitNo) html += "<div class='b2-row'><div class='b2-row-label'>許可番号</div><div class='b2-row-value'>" + escapeHtml(permitNo) + "</div></div>";
                if (permitDate) html += "<div class='b2-row'><div class='b2-row-label'>許可年月日</div><div class='b2-row-value'>" + escapeHtml(permitDate) + "</div></div>";
                if (setupDate) html += "<div class='b2-row'><div class='b2-row-label'>設置年月日</div><div class='b2-row-value'>" + escapeHtml(setupDate) + "</div></div>";
                if (parseInt(typeId) === FACILITY_TYPE_PROCESSING && permitTargetName) {
                    html += "<div class='b2-row'><div class='b2-row-label'>許可対象</div><div class='b2-row-value'>" + escapeHtml(permitTargetName) + "</div></div>";
                }
                html += "</div>";

                // --- 最終処分場情報 ---
                if (parseInt(typeId) === FACILITY_TYPE_LANDFILL) {
                    html += "<div class='b2-group-title'>処分場情報</div>";
                    html += "<div class='b2-group'>";
                    if (capacityM3) html += "<div class='b2-row'><div class='b2-row-label'>容量</div><div class='b2-row-value'>" + Number(capacityM3).toLocaleString() + " &#13221;</div></div>";
                    if (areaM2) html += "<div class='b2-row'><div class='b2-row-label'>面積</div><div class='b2-row-value'>" + Number(areaM2).toLocaleString() + " &#13217;</div></div>";
                    if (landfillEndDate) html += "<div class='b2-row'><div class='b2-row-label'>埋立終了日</div><div class='b2-row-value'>" + escapeHtml(landfillEndDate) + "</div></div>";
                    html += "</div>";
                }

                // --- 保管施設情報（積替保管施設のみ） ---
                if (parseInt(typeId) === FACILITY_TYPE_STORAGE && (storageAreaM2 || storageCapM3 || storageHeightM)) {
                    html += "<div class='b2-group-title'>保管施設情報</div>";
                    html += "<div class='b2-group'>";
                    if (storageAreaM2) html += "<div class='b2-row'><div class='b2-row-label'>保管面積</div><div class='b2-row-value'>" + Number(storageAreaM2).toLocaleString() + " &#13217;</div></div>";
                    if (storageCapM3) html += "<div class='b2-row'><div class='b2-row-label'>保管量上限</div><div class='b2-row-value'>" + Number(storageCapM3).toLocaleString() + " &#13221;</div></div>";
                    if (storageHeightM) html += "<div class='b2-row'><div class='b2-row-label'>保管高さ</div><div class='b2-row-value'>" + storageHeightM + " m</div></div>";
                    html += "</div>";
                }

                // --- 品目 / 処理能力 ---
                html += "<div class='b2-group-title'>品目 / 処理能力</div>";
                html += "<div id='facility-detail-capacity' class='b2-group'>読み込み中...</div>";

                // --- 変更アクション（有効な場合のみ） ---
                if (isActive) {
                    html += "<div style='margin-top:16px; display:flex;'>";
                    html += "<div class='action-card action-card-blue' onclick='showFacilityRenewalForm(" + logicalId + ", " + businessId + ")'>";
                    html += "<div class='action-card-icon'>&#128260;</div>";
                    html += "<div class='action-card-label'>変更（新版作成）</div>";
                    html += "<div class='action-card-desc'>施設情報を更新し、履歴を残す</div>";
                    html += "</div>";
                    html += "</div>";
                }

                // --- 休止・再開情報 ---
                if (isSuspended || resumeDate) {
                    html += "<div class='b2-group-title'>休止・再開</div>";
                    html += "<div class='b2-group'>";
                    if (resumeDate) {
                        html += "<div class='b2-row'><div class='b2-row-label'>再開日</div><div class='b2-row-value' style='color:#34c759;'>" + escapeHtml(resumeDate) + "</div></div>";
                        html += "<div class='b2-row'><div class='b2-row-label'>休止期間</div><div class='b2-row-value'>" + escapeHtml(suspendDate) + " ～ " + escapeHtml(resumeDate) + "</div></div>";
                    } else {
                        html += "<div class='b2-row'><div class='b2-row-label'>状態</div><div class='b2-row-value'><span class='b2-pill b2-pill-amber'>休止</span></div></div>";
                        html += "<div class='b2-row'><div class='b2-row-label'>休止日</div><div class='b2-row-value' style='color:#e65100;'>" + escapeHtml(suspendDate) + "</div></div>";
                    }
                    html += "</div>";
                }

                // --- ステータス（廃止・取消時） ---
                if (isAbolished) {
                    html += "<div class='b2-group-title' style='margin-top:24px; color:#86868b;'>ステータス</div>";
                    html += "<div class='b2-group'>";
                    html += "<div class='b2-row'><div class='b2-row-label'>状態</div><div class='b2-row-value'><span class='b2-pill b2-pill-gray'>廃止</span></div></div>";
                    html += "<div class='b2-row'><div class='b2-row-label'>廃止日</div><div class='b2-row-value' style='color:#ff3b30;'>" + escapeHtml(abolishDate) + "</div></div>";
                    if (abolishConfirmDate) html += "<div class='b2-row'><div class='b2-row-label'>廃止確認日</div><div class='b2-row-value'>" + escapeHtml(abolishConfirmDate) + "</div></div>";
                    html += "<div class='b2-restore-row' onclick='restoreFacilityFromDetail()'>復活する</div>";
                    html += "</div>";
                }
                if (isCancelled) {
                    html += "<div class='b2-group-title' style='margin-top:24px; color:#86868b;'>ステータス</div>";
                    html += "<div class='b2-group'>";
                    html += "<div class='b2-row'><div class='b2-row-label'>状態</div><div class='b2-row-value'><span class='b2-pill b2-pill-red'>取消</span></div></div>";
                    html += "<div class='b2-row'><div class='b2-row-label'>取消日</div><div class='b2-row-value' style='color:#ff3b30;'>" + escapeHtml(cancelDate) + "</div></div>";
                    if (cancelReason) html += "<div class='b2-row'><div class='b2-row-label'>取消理由</div><div class='b2-row-value'>" + escapeHtml(cancelReason) + "</div></div>";
                    html += "<div class='b2-restore-row' onclick='restoreFacilityFromDetail()'>復活する</div>";
                    html += "</div>";
                }


                // --- 状態変更（有効時のみ） ---
                if (isActive) {
                    html += "<div class='b2-group-title' style='margin-top:24px; color:#86868b;'>状態変更</div>";
                    html += "<div class='b2-group'>";
                    // 休止: 横並びコンパクト配置（理由欄追加）
                    html += "<div style='padding:12px 16px; border-bottom:1px solid rgba(0,0,0,0.06);'>";
                    html += "<div style='font-size:0.9em; font-weight:500; color:#e65100; margin-bottom:8px;'>この施設を休止する</div>";
                    html += "<div style='display:flex; align-items:flex-start;'>";
                    html += "<div style='margin-right:16px;'><div style='font-size:0.75em; color:#86868b; margin-bottom:2px;'>休止日</div><div class='datepicker-wrapper'><input type='text' style='width:130px; padding:6px 10px; border:1px solid rgba(0,0,0,0.1); border-radius:8px; font-size:0.85em; text-align:center;' id='detail-fac-suspend-date' placeholder='yyyy/mm/dd' onblur='normalizeDateInput(this)'><button class='cal-trigger-btn' onclick='openDatePicker(\"detail-fac-suspend-date\")' tabindex='-1'>Cal</button></div></div>";
                    html += "<div style='flex:1; margin-right:16px;'><div style='font-size:0.75em; color:#86868b; margin-bottom:2px;'>休止理由</div><input type='text' id='detail-fac-suspend-reason' style='width:100%; padding:6px 10px; border:1px solid rgba(0,0,0,0.1); border-radius:8px; font-size:0.85em;' placeholder='理由を入力'></div>";
                    html += "<div style='padding-top:16px;'><button class='b2-abolish-btn' style='margin-left:0; background:#e65100;' onclick='suspendFacilityFromDetail()'>休止</button></div>";
                    html += "</div></div>";
                    // 廃止: 横並びコンパクト配置（理由欄追加）
                    html += "<div style='padding:12px 16px; border-bottom:1px solid rgba(0,0,0,0.06);'>";
                    html += "<div style='font-size:0.9em; font-weight:500; color:#ff3b30; margin-bottom:8px;'>この施設を廃止する</div>";
                    html += "<div style='display:flex; align-items:flex-start;'>";
                    html += "<div style='margin-right:16px;'><div style='font-size:0.75em; color:#86868b; margin-bottom:2px;'>廃止日</div><div class='datepicker-wrapper'><input type='text' style='width:130px; padding:6px 10px; border:1px solid rgba(0,0,0,0.1); border-radius:8px; font-size:0.85em; text-align:center;' id='detail-fac-abolish-date' placeholder='yyyy/mm/dd' onblur='normalizeDateInput(this)'><button class='cal-trigger-btn' onclick='openDatePicker(\"detail-fac-abolish-date\")' tabindex='-1'>Cal</button></div></div>";
                    if (parseInt(typeId) === FACILITY_TYPE_LANDFILL) {
                        html += "<div style='margin-right:16px;'><div style='font-size:0.75em; color:#86868b; margin-bottom:2px;'>廃止確認日</div><div class='datepicker-wrapper'><input type='text' style='width:130px; padding:6px 10px; border:1px solid rgba(0,0,0,0.1); border-radius:8px; font-size:0.85em; text-align:center;' id='detail-fac-abolish-confirm' placeholder='yyyy/mm/dd' onblur='normalizeDateInput(this)'><button class='cal-trigger-btn' onclick='openDatePicker(\"detail-fac-abolish-confirm\")' tabindex='-1'>Cal</button></div></div>";
                    }
                    html += "<div style='flex:1; margin-right:16px;'><div style='font-size:0.75em; color:#86868b; margin-bottom:2px;'>廃止理由</div><input type='text' id='detail-fac-abolish-reason' style='width:100%; padding:6px 10px; border:1px solid rgba(0,0,0,0.1); border-radius:8px; font-size:0.85em;' placeholder='理由を入力'></div>";
                    html += "<div style='padding-top:16px;'><button class='b2-abolish-btn' style='margin-left:0;' onclick='abolishFacilityFromDetail()'>廃止</button></div>";
                    html += "</div></div>";
                    // 取消: 横並びコンパクト配置
                    html += "<div style='padding:12px 16px; border-bottom:1px solid rgba(0,0,0,0.06);'>";
                    html += "<div style='font-size:0.9em; font-weight:500; color:#c62828; margin-bottom:8px;'>この施設の許可を取消する</div>";
                    html += "<div style='display:flex; align-items:flex-start;'>";
                    html += "<div style='margin-right:16px;'><div style='font-size:0.75em; color:#86868b; margin-bottom:2px;'>取消日</div><div class='datepicker-wrapper'><input type='text' style='width:130px; padding:6px 10px; border:1px solid rgba(0,0,0,0.1); border-radius:8px; font-size:0.85em; text-align:center;' id='detail-fac-cancel-date' placeholder='yyyy/mm/dd' onblur='normalizeDateInput(this)'><button class='cal-trigger-btn' onclick='openDatePicker(\"detail-fac-cancel-date\")' tabindex='-1'>Cal</button></div></div>";
                    html += "<div style='flex:1; margin-right:16px;'><div style='font-size:0.75em; color:#86868b; margin-bottom:2px;'>取消理由</div><input type='text' id='detail-fac-cancel-reason' style='width:100%; padding:6px 10px; border:1px solid rgba(0,0,0,0.1); border-radius:8px; font-size:0.85em;' placeholder='理由を入力'></div>";
                    html += "<div style='padding-top:16px;'><button class='b2-abolish-btn' style='margin-left:0; background:#c62828;' onclick='cancelFacilityFromDetail()'>取消</button></div>";
                    html += "</div></div>";
                    html += "<div class='b2-destructive-row' onclick='deleteFacilityFromDetail()'>";
                    html += "この施設を削除する";
                    html += "<div class='b2-destructive-sub'>処理能力データと全ての履歴も削除されます</div>";
                    html += "</div>";
                    html += "</div>";
                }
                // 休止中は「再開する」だけ表示
                if (isSuspended) {
                    html += "<div class='b2-group-title' style='margin-top:24px; color:#86868b;'>状態変更</div>";
                    html += "<div class='b2-group'>";
                    html += "<div class='b2-restore-row' style='color:#34c759;' onclick='resumeFacilityFromDetail()'>再開する</div>";
                    html += "</div>";
                }

                // --- 履歴（常に表示・縦タイムライン） ---
                html += "<div class='b2-group-title' style='margin-top:24px;'>履歴</div>";
                html += "<div id='facility-history-content'>読み込み中...</div>";

                html += "</div>"; // .permit-detail

                document.getElementById("tab-facilities").innerHTML = html;
                loadFacilityCapacityB2(facilityId, "facility-detail-capacity");
                loadFacilityHistoryVtl(logicalId, businessId);
            } catch (e) { document.getElementById("tab-facilities").innerHTML = "<p>エラー [施設詳細]: " + e.message + "</p>"; }
        }

        function loadFacilityCapacityInline(facilityId, targetId) {
            try {
                var hourUnits = {};
                var dayUnits = {};
                var rs = conn.Execute(buildMasterAllQuery("マスター_時間処理能力単位"));
                while (!rs.EOF) { hourUnits[rs.Fields(0).Value] = rs.Fields(1).Value; rs.MoveNext(); }
                rs.Close();
                rs = conn.Execute(buildMasterAllQuery("マスター_日処理能力単位"));
                while (!rs.EOF) { dayUnits[rs.Fields(0).Value] = rs.Fields(1).Value; rs.MoveNext(); }
                rs.Close();

                rs = conn.Execute(buildLoadProcessingCapacityQuery(facilityId));
                var items = [];
                while (!rs.EOF) {
                    var hourCap = rs.Fields("時間処理能力").Value;
                    var hourUnitId = rs.Fields("時間処理能力単位ID").Value;
                    var dayCap = rs.Fields("日処理能力").Value;
                    var dayUnitId = rs.Fields("日処理能力単位ID").Value;
                    var hours = rs.Fields("稼働時間").Value;
                    items.push({
                        name: rs.Fields("品目名").Value || "",
                        hourStr: hourCap ? hourCap + " " + (hourUnits[hourUnitId] || "") : "",
                        dayStr: dayCap ? dayCap + " " + (dayUnits[dayUnitId] || "") : "",
                        hours: hours || "",
                        note: rs.Fields("特記事項").Value || ""
                    });
                    rs.MoveNext();
                }
                rs.Close();

                var html = "";
                if (items.length === 0) {
                    html = "<p class='auto-label'>処理能力の登録なし</p>";
                } else {
                    html = "<table class='data-table'><tr><th>品目</th><th>時間処理能力</th><th>日処理能力</th><th>稼働時間</th><th>特記事項</th></tr>";
                    for (var i = 0; i < items.length; i++) {
                        html += "<tr><td>" + escapeHtml(items[i].name) + "</td>";
                        html += "<td>" + (items[i].hourStr || "-") + "</td>";
                        html += "<td>" + (items[i].dayStr || "-") + "</td>";
                        html += "<td>" + (items[i].hours || "-") + "</td>";
                        html += "<td>" + escapeHtml(items[i].note || "-") + "</td></tr>";
                    }
                    html += "</table>";
                }
                document.getElementById(targetId).innerHTML = html;
            } catch (e) { document.getElementById(targetId).innerHTML = "<p class='auto-label'>処理能力の読み込みエラー</p>"; }
        }

        // 施設詳細のB2形式処理能力表示
        function loadFacilityCapacityB2(facilityId, targetId) {
            try {
                var hourUnits = {};
                var dayUnits = {};
                var rs = conn.Execute(buildMasterAllQuery("マスター_時間処理能力単位"));
                while (!rs.EOF) { hourUnits[rs.Fields(0).Value] = rs.Fields(1).Value; rs.MoveNext(); }
                rs.Close();
                rs = conn.Execute(buildMasterAllQuery("マスター_日処理能力単位"));
                while (!rs.EOF) { dayUnits[rs.Fields(0).Value] = rs.Fields(1).Value; rs.MoveNext(); }
                rs.Close();

                rs = conn.Execute(buildLoadProcessingCapacityQuery(facilityId));
                var items = [];
                while (!rs.EOF) {
                    items.push({
                        name: rs.Fields("品目名").Value || "",
                        hourCap: rs.Fields("時間処理能力").Value,
                        hourUnitId: rs.Fields("時間処理能力単位ID").Value,
                        dayCap: rs.Fields("日処理能力").Value,
                        dayUnitId: rs.Fields("日処理能力単位ID").Value,
                        hours: rs.Fields("稼働時間").Value || ""
                    });
                    rs.MoveNext();
                }
                rs.Close();

                var html = "";
                if (items.length === 0) {
                    html = "<div class='b2-row'><div class='b2-row-label' style='flex:1;text-align:center;color:#86868b;'>処理能力の登録なし</div></div>";
                } else {
                    for (var i = 0; i < items.length; i++) {
                        html += "<div class='b2-cap-row'>";
                        html += "<div class='b2-cap-name'>" + escapeHtml(items[i].name) + "</div>";
                        html += "<div class='b2-cap-vals'>";
                        if (items[i].hourCap) html += "<div><span class='b2-cap-unit'>時間 </span><span class='b2-cap-num'>" + items[i].hourCap + " " + (hourUnits[items[i].hourUnitId] || "") + "</span></div>";
                        if (items[i].dayCap) html += "<div><span class='b2-cap-unit'>日 </span><span class='b2-cap-num'>" + items[i].dayCap + " " + (dayUnits[items[i].dayUnitId] || "") + "</span></div>";
                        if (items[i].hours) html += "<div class='b2-cap-hours'>" + items[i].hours + "h</div>";
                        html += "</div></div>";
                    }
                }
                document.getElementById(targetId).innerHTML = html;
            } catch (e) { document.getElementById(targetId).innerHTML = "<div class='b2-row'><div class='b2-row-label' style='flex:1;text-align:center;color:#86868b;'>処理能力の読み込みエラー</div></div>"; }
        }

        // 施設履歴を縦タイムラインで表示
        function loadFacilityHistoryVtl(logicalId, businessId) {
            try {
                var rs = conn.Execute(buildLoadFacilityHistoryQuery(logicalId));
                var versions = [];
                while (!rs.EOF) {
                    versions.push({
                        facilityId: rs.Fields("施設ID").Value,
                        typeName: rs.Fields("施設種別名").Value || "",
                        location: rs.Fields("設置場所").Value || "",
                        startDateStr: rs.Fields("有効開始文字列").Value || "",
                        endDateStr: rs.Fields("有効終了文字列").Value || "",
                        abolishDateStr: rs.Fields("廃止日文字列").Value || ""
                    });
                    rs.MoveNext();
                }
                rs.Close();

                if (versions.length === 0) {
                    document.getElementById("facility-history-content").innerHTML = "<p class='auto-label'>履歴なし</p>";
                    return;
                }

                // versions は ASC (古い順) → 表示は DESC (新しい順)
                var html = "<div class='vtl'><div class='vtl-line'></div>";
                for (var i = versions.length - 1; i >= 0; i--) {
                    var v = versions[i];
                    var vNum = i + 1;
                    var isLatest = (i === versions.length - 1);
                    var hasEnd = (v.endDateStr !== "" && v.endDateStr !== null);
                    var isAbol = (v.abolishDateStr !== "" && v.abolishDateStr !== null);

                    // ドットの状態
                    var dotClass = "expired";
                    if (isAbol) dotClass = "abolished";
                    else if (!hasEnd) dotClass = "active";

                    // 日付範囲
                    var dateRange = v.startDateStr + " ～ ";
                    if (isAbol) dateRange += "廃止(" + v.abolishDateStr + ")";
                    else if (hasEnd) dateRange += v.endDateStr;
                    else dateRange += "現在";

                    // ピル
                    var pillHtml = "";
                    if (isAbol) pillHtml = " <span class='b2-pill b2-pill-gray' style='margin-left:8px;'>廃止</span>";
                    else if (!hasEnd) pillHtml = " <span class='b2-pill b2-pill-green' style='margin-left:8px;'>有効</span>";

                    // 変更内容（前のバージョンとの差分）
                    var changeHtml = "";
                    if (i === 0) {
                        changeHtml = "<div class='vtl-change'>許可番号 " + escapeHtml(v.typeName) + " / " + escapeHtml(v.location) + "</div>";
                    } else {
                        var prev = versions[i - 1];
                        if (v.location !== prev.location) {
                            changeHtml += "<div class='vtl-change'>設置場所: <span class='vtl-change-old'>" + escapeHtml(prev.location) + "</span> → <span class='vtl-change-new'>" + escapeHtml(v.location) + "</span></div>";
                        }
                        if (v.typeName !== prev.typeName) {
                            changeHtml += "<div class='vtl-change'>施設種別: <span class='vtl-change-old'>" + escapeHtml(prev.typeName) + "</span> → <span class='vtl-change-new'>" + escapeHtml(v.typeName) + "</span></div>";
                        }
                        if (isAbol) {
                            changeHtml += "<div class='vtl-change'>廃止日: <span style='color:#c62828;font-weight:500;'>" + v.abolishDateStr + "</span></div>";
                        }
                        if (!changeHtml) {
                            changeHtml = "<div class='vtl-change'>許可更新</div>";
                        }
                    }

                    // ラベル
                    var label = "v" + vNum;
                    if (i === 0) label += " — 新規登録";
                    else if (isAbol) label += " — 廃止";
                    else label += " — 更新";

                    html += "<div class='vtl-item'>";
                    html += "<div class='vtl-dot " + dotClass + "'></div>";
                    html += "<div class='vtl-actions'>";
                    html += "<a href='#' class='vtl-edit' onclick='editFacilityHistory(" + v.facilityId + ", " + logicalId + ", " + businessId + "); return false;'>修正</a>";
                    html += "<a href='#' class='vtl-delete' onclick='deleteFacilityVersion(" + v.facilityId + ", " + logicalId + ", " + businessId + "); return false;'>削除</a>";
                    html += "</div>";
                    html += "<div class='vtl-date'>" + dateRange + pillHtml + "</div>";
                    html += "<div class='vtl-content'>" + label + "</div>";
                    html += changeHtml;
                    html += "</div>";
                }
                html += "</div>";
                document.getElementById("facility-history-content").innerHTML = html;
            } catch (e) { document.getElementById("facility-history-content").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        // 施設の休止
        function suspendFacilityFromDetail() {
            var dateStr = document.getElementById("detail-fac-suspend-date").value;
            if (!dateStr) { showToast("休止日を入力してください", "error"); return; }
            var reasonEl = document.getElementById("detail-fac-suspend-reason");
            var reason = reasonEl ? reasonEl.value : "";
            if (!confirm("この施設を休止しますか？")) return;
            try {
                conn.BeginTrans();
                try {
                    conn.Execute(buildSuspendFacilityQuery(currentDetailFacilityId, dateStr, reason || undefined));
                    conn.Execute(buildInsertSuspensionHistoryQuery(currentDetailFacilityId, dateStr, reason || undefined));
                    conn.CommitTrans();
                } catch (txErr) {
                    conn.RollbackTrans();
                    throw txErr;
                }
                showToast("施設を休止しました");
                showFacilityDetail(currentDetailFacilityId, currentDetailFacilityLogicalId, currentDetailFacilityBusinessId);
            } catch (e) { showToast("休止エラー: " + e.message, "error", 5000); }
        }

        // 施設の取消（G7: 取消理由対応）
        function cancelFacilityFromDetail() {
            var dateStr = document.getElementById("detail-fac-cancel-date").value;
            if (!dateStr) { showToast("取消日を入力してください", "error"); return; }
            var reason = document.getElementById("detail-fac-cancel-reason").value || "";
            showConfirmDialog("施設取消", "この施設の許可を取消しますか？\nこの操作は行政処分による取消です。\n取消日: " + dateStr + (reason ? "\n取消理由: " + reason : ""), {
                okText: "取消する", okClass: "btn-danger",
                onOk: function() {
                    try {
                        conn.Execute(buildCancelFacilityQuery(currentDetailFacilityId, dateStr, reason || undefined));
                        showToast("施設の許可を取消しました");
                        showFacilityDetail(currentDetailFacilityId, currentDetailFacilityLogicalId, currentDetailFacilityBusinessId);
                    } catch (e) { showToast("取消エラー: " + e.message, "error", 5000); }
                }
            });
        }

        // 施設の再開（休止解除）
        function resumeFacilityFromDetail() {
            if (!confirm("この施設を再開しますか？")) return;
            try {
                var todayStr = buildDateStr();
                conn.BeginTrans();
                try {
                    conn.Execute(buildResumeFacilityQuery(currentDetailFacilityId, todayStr));
                    // 休止履歴にも再開日を記録（2段階方式: MAX ID取得→更新）
                    var histRs = conn.Execute(buildGetLatestSuspensionHistoryIdQuery(currentDetailFacilityId));
                    var histId = histRs.Fields("maxId").Value;
                    histRs.Close();
                    if (histId) {
                        conn.Execute(buildUpdateSuspensionHistoryResumeByIdQuery(histId, todayStr));
                    }
                    conn.CommitTrans();
                } catch (txErr) {
                    conn.RollbackTrans();
                    throw txErr;
                }
                showToast("施設を再開しました");
                showFacilityDetail(currentDetailFacilityId, currentDetailFacilityLogicalId, currentDetailFacilityBusinessId);
            } catch (e) { showToast("再開エラー: " + e.message, "error", 5000); }
        }

        // 施設バージョンの個別削除
        function deleteFacilityVersion(facilityId, logicalId, businessId) {
            if (!confirm("この履歴バージョン（施設ID: " + facilityId + "）を削除しますか？\n関連する処理能力データも削除されます。")) return;
            try {
                conn.BeginTrans();
                try {
                    var delQueries = buildDeleteFacilityVersionQueries(facilityId);
                    for (var di = 0; di < delQueries.length; di++) { conn.Execute(delQueries[di]); }
                    conn.CommitTrans();
                } catch (txErr) {
                    conn.RollbackTrans();
                    throw txErr;
                }
                showToast("履歴バージョンを削除しました");
                // 残りのバージョンがあるか確認
                var rs = conn.Execute(buildCountFacilityVersionsQuery(logicalId));
                var cnt = rs.Fields("cnt").Value;
                rs.Close();
                if (cnt > 0) {
                    // 最新バージョンの施設IDを取得して詳細を表示
                    var latestRs = conn.Execute(buildLoadLatestVersionQuery("施設", "施設論理ID", logicalId));
                    var latestId = latestRs.Fields("施設ID").Value;
                    latestRs.Close();
                    showFacilityDetail(latestId, logicalId, businessId);
                } else {
                    refreshFacilitiesTab(businessId);
                }
            } catch (e) { showToast("削除エラー: " + e.message, "error", 5000); }
        }

        // 施設編集画面の処理能力インライン編集テーブル
        var editCapacityItemOptions = null; // キャッシュ
        var editCapacityHourUnits = null;
        var editCapacityDayUnits = null;

        function getCapacityMasters() {
            if (editCapacityItemOptions) return;
            editCapacityItemOptions = [];
            var rs = conn.Execute(buildMasterListQuery("マスター_品目", "品目ID", "品目名", "表示順"));
            while (!rs.EOF) {
                editCapacityItemOptions.push({id: rs.Fields("品目ID").Value, name: rs.Fields("品目名").Value});
                rs.MoveNext();
            }
            rs.Close();
            editCapacityHourUnits = [];
            rs = conn.Execute(buildMasterAllQuery("マスター_時間処理能力単位", "時間処理能力単位ID"));
            while (!rs.EOF) { editCapacityHourUnits.push({id: rs.Fields(0).Value, name: rs.Fields(1).Value}); rs.MoveNext(); }
            rs.Close();
            editCapacityDayUnits = [];
            rs = conn.Execute(buildMasterAllQuery("マスター_日処理能力単位", "日処理能力単位ID"));
            while (!rs.EOF) { editCapacityDayUnits.push({id: rs.Fields(0).Value, name: rs.Fields(1).Value}); rs.MoveNext(); }
            rs.Close();
        }

        function buildItemSelectHtml(selectedId) {
            var h = "<select class='inline-select' style='width:160px;'>";
            h += "<option value=''>選択</option>";
            for (var i = 0; i < editCapacityItemOptions.length; i++) {
                var sel = (editCapacityItemOptions[i].id == selectedId) ? " selected" : "";
                h += "<option value='" + editCapacityItemOptions[i].id + "'" + sel + ">" + escapeHtml(editCapacityItemOptions[i].name) + "</option>";
            }
            return h + "</select>";
        }

        function buildUnitSelectHtml(units, selectedId) {
            var h = "<select class='inline-select'>";
            for (var i = 0; i < units.length; i++) {
                var sel = (units[i].id == selectedId) ? " selected" : "";
                h += "<option value='" + units[i].id + "'" + sel + ">" + escapeHtml(units[i].name) + "</option>";
            }
            return h + "</select>";
        }

        function loadEditCapacityTable(facilityId) {
            try {
                getCapacityMasters();
                var rs = conn.Execute(buildLoadProcessingCapacityQuery(facilityId));
                var html = "<table class='data-table' id='cap-edit-tbl'>";
                html += "<tr><th>品目</th><th>時間処理能力</th><th>日処理能力</th><th>単位</th><th style='width:40px;'></th></tr>";
                var rowIdx = 0;
                while (!rs.EOF) {
                    var capId = rs.Fields("処理能力ID").Value;
                    var itemId = rs.Fields("品目ID").Value;
                    var hourCap = rs.Fields("時間処理能力").Value || "";
                    var hourUnitId = rs.Fields("時間処理能力単位ID").Value || 1;
                    var dayCap = rs.Fields("日処理能力").Value || "";
                    var dayUnitId = rs.Fields("日処理能力単位ID").Value || 1;
                    html += "<tr id='cap-row-" + rowIdx + "' data-cap-id='" + capId + "'>";
                    html += "<td>" + buildItemSelectHtml(itemId) + "</td>";
                    html += "<td><input class='inline-input' type='text' value='" + hourCap + "' style='width:60px;text-align:right;' oninput='this.value=normalizeToHankaku(this.value)'></td>";
                    html += "<td><input class='inline-input' type='text' value='" + dayCap + "' style='width:60px;text-align:right;' oninput='this.value=normalizeToHankaku(this.value)'></td>";
                    html += "<td>" + buildUnitSelectHtml(editCapacityDayUnits, dayUnitId) + "</td>";
                    html += "<td><button class='btn-delete-row' title='削除' onclick='deleteCapacityRow(this, " + capId + ", " + facilityId + ")'>&#10005;</button></td>";
                    html += "</tr>";
                    rowIdx++;
                    rs.MoveNext();
                }
                rs.Close();
                html += "</table>";
                if (rowIdx === 0) {
                    html = "<p class='auto-label'>処理能力の登録なし</p>" + html;
                }
                document.getElementById("edit-capacity-table").innerHTML = html;
            } catch (e) {
                document.getElementById("edit-capacity-table").innerHTML = "<p class='auto-label'>処理能力の読み込みエラー: " + e.message + "</p>";
            }
        }

        function addCapacityRow(facilityId) {
            try {
                getCapacityMasters();
                // 既存行の編集内容を先に保存（追加時にデータが消える問題を修正）
                saveAllCapacityRows(facilityId);
                // 新規行をDBに挿入（品目未選択、能力0）
                conn.Execute(buildInsertCapacityInlineQuery(facilityId, {
                    itemId: editCapacityItemOptions[0].id, hourCap: null, hourUnitId: 1,
                    dayCap: null, dayUnitId: 1
                }));
                loadEditCapacityTable(facilityId);
            } catch (e) { showToast("追加エラー: " + e.message, "error", 5000); }
        }

        function deleteCapacityRow(btn, capId, facilityId) {
            try {
                conn.Execute(buildDeleteCapacityQuery(capId));
                loadEditCapacityTable(facilityId);
            } catch (e) { showToast("削除エラー: " + e.message, "error", 5000); }
        }

        function saveAllCapacityRows(facilityId) {
            try {
                var tbl = document.getElementById("cap-edit-tbl");
                if (!tbl) return;
                var rows = tbl.rows;
                for (var i = 1; i < rows.length; i++) {
                    var capId = rows[i].getAttribute("data-cap-id");
                    if (!capId) continue;
                    var cells = rows[i].cells;
                    var itemId = cells[0].getElementsByTagName("select")[0].value;
                    var hourCap = cells[1].getElementsByTagName("input")[0].value.trim();
                    var dayCap = cells[2].getElementsByTagName("input")[0].value.trim();
                    var unitId = cells[3].getElementsByTagName("select")[0].value;
                    if (!itemId) continue;
                    conn.Execute(buildUpdateCapacityInlineQuery(capId, {
                        itemId: itemId, hourCap: hourCap, hourUnitId: unitId,
                        dayCap: dayCap, dayUnitId: unitId
                    }));
                }
            } catch (e) { showToast("処理能力保存エラー: " + e.message, "error", 5000); }
        }

        // 処理能力を旧版から新版にコピー
        function copyCapacityToNewVersion(oldFacilityId, newFacilityId) {
            try {
                var rs = conn.Execute(buildLoadProcessingCapacityQuery(oldFacilityId));
                while (!rs.EOF) {
                    var itemId = rs.Fields("品目ID").Value;
                    var hourCap = rs.Fields("時間処理能力").Value;
                    var hourUnitId = rs.Fields("時間処理能力単位ID").Value || 1;
                    var dayCap = rs.Fields("日処理能力").Value;
                    var dayUnitId = rs.Fields("日処理能力単位ID").Value || 1;
                    conn.Execute(buildInsertCapacityInlineQuery(newFacilityId, {
                        itemId: itemId, hourCap: hourCap, hourUnitId: hourUnitId,
                        dayCap: dayCap, dayUnitId: dayUnitId
                    }));
                    rs.MoveNext();
                }
                rs.Close();
            } catch (e) { /* コピー失敗は致命的でないのでスキップ */ }
        }

        // インラインテーブルの内容を新施設IDに直接INSERT（変更モード用）
        function insertCapacityFromInlineTable(newFacilityId) {
            try {
                var tbl = document.getElementById("cap-edit-tbl");
                if (!tbl) return;
                var rows = tbl.rows;
                for (var i = 1; i < rows.length; i++) {
                    var cells = rows[i].cells;
                    var itemId = cells[0].getElementsByTagName("select")[0].value;
                    if (!itemId) continue;
                    var hourCap = cells[1].getElementsByTagName("input")[0].value.trim();
                    var dayCap = cells[2].getElementsByTagName("input")[0].value.trim();
                    var unitId = cells[3].getElementsByTagName("select")[0].value;
                    conn.Execute(buildInsertCapacityInlineQuery(newFacilityId, {
                        itemId: itemId, hourCap: hourCap, hourUnitId: unitId,
                        dayCap: dayCap, dayUnitId: unitId
                    }));
                }
            } catch (e) { showToast("処理能力コピーエラー: " + e.message, "error", 5000); }
        }

        function toggleFacilityHistorySection() {
            var section = document.getElementById("facility-history-section");
            var label = document.getElementById("facility-history-toggle-label");
            if (section.style.display === "none") {
                section.style.display = "block";
                label.innerHTML = "履歴 &#9650;";
                if (!facilityHistorySectionLoaded) {
                    facilityHistorySectionLoaded = true;
                    loadFacilityHistoryInline(currentDetailFacilityLogicalId, currentDetailFacilityBusinessId);
                }
            } else {
                section.style.display = "none";
                label.innerHTML = "履歴 &#9660;";
            }
        }

        function loadFacilityHistoryInline(logicalId, businessId) {
            try {
                var rs = conn.Execute(buildLoadFacilityHistoryQuery(logicalId));
                var versions = [];
                while (!rs.EOF) {
                    versions.push({
                        facilityId: rs.Fields("施設ID").Value,
                        typeName: rs.Fields("施設種別名").Value || "",
                        location: rs.Fields("設置場所").Value || "",
                        startDateStr: rs.Fields("有効開始文字列").Value || "",
                        endDateStr: rs.Fields("有効終了文字列").Value || "",
                        abolishDateStr: rs.Fields("廃止日文字列").Value || ""
                    });
                    rs.MoveNext();
                }
                rs.Close();

                var html = "";
                // タイムライン表示
                var allHaveStartDate = versions.length >= 2;
                for (var ci = 0; ci < versions.length; ci++) {
                    if (!versions[ci].startDateStr) { allHaveStartDate = false; break; }
                }
                if (allHaveStartDate) {
                    html += buildFacilityTimelineHtml(versions, logicalId, businessId);
                }

                // 履歴テーブル
                html += "<table class='data-table'><tr><th>状態</th><th>施設種別</th><th>設置場所</th><th>有効開始</th><th>有効終了</th><th>操作</th></tr>";
                for (var vi = 0; vi < versions.length; vi++) {
                    var v = versions[vi];
                    var hasEndDate = (v.endDateStr !== "" && v.endDateStr !== null);
                    var status = hasEndDate ? statusBadge('lapsed', '失効') : statusBadge('active', '有効');
                    if (v.abolishDateStr) status = statusBadge('abolished', '廃止(' + v.abolishDateStr + ')');
                    html += "<tr" + (hasEndDate ? " class='bg-row-inactive'" : "") + ">";
                    html += "<td>" + status + "</td>";
                    html += "<td>" + escapeHtml(v.typeName) + "</td>";
                    html += "<td>" + escapeHtml(v.location) + "</td>";
                    html += "<td>" + escapeHtml(v.startDateStr) + "</td>";
                    html += "<td>" + (hasEndDate ? escapeHtml(v.endDateStr) : "-") + "</td>";
                    html += "<td><button class='btn btn-primary btn-sm' onclick='showFacilityDetail(" + v.facilityId + ", " + logicalId + ", " + businessId + ")'>詳細</button></td></tr>";
                }
                html += "</table>";
                document.getElementById("facility-history-content").innerHTML = html;
            } catch (e) { document.getElementById("facility-history-content").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        // 施設履歴表示（タブ内）- 旧フルページ版（履歴タブから直接開く場合）
        var currentHistoryLogicalId = 0;
        var currentHistoryBusinessId = 0;

        // ===== 施設タイムラインHTML生成 =====
        function buildFacilityTimelineHtml(versions, logicalId, businessId) {
            var disp = versions.slice(); // ASC順（古い→新しい）
            var today = todayDateStr();
            var todayDays = dateStrToDays(today);

            var minDays = dateStrToDays(disp[0].startDateStr);
            var maxDays = todayDays;
            for (var i = 0; i < disp.length; i++) {
                var ed = disp[i].endDateStr ? dateStrToDays(disp[i].endDateStr) : todayDays;
                if (ed > maxDays) maxDays = ed;
            }
            var totalSpan = maxDays - minDays;
            if (totalSpan <= 0) totalSpan = 1;

            var html = "<div class='timeline-section'>";
            html += "<h4>有効期間タイムライン <span class='timeline-hint'>（境界の日付をクリックして変更）</span></h4>";

            html += buildTimelineBars(disp, todayDays, minDays, totalSpan,
                function(v) {
                    var idx = -1;
                    for (var j = 0; j < disp.length; j++) { if (disp[j] === v) { idx = j; break; } }
                    if (idx === 0) return "新規";
                    if (v.isChange) return "変更";
                    return "更新";
                },
                function(v) { return "施設ID:" + v.facilityId; },
                function(v) {
                    if (v.abolishDateStr) return "abolished";
                    if (!v.endDateStr) return "active";
                    return "expired";
                }
            );

            // 境界マーカー
            for (var i = 0; i < disp.length - 1; i++) {
                var older = disp[i];
                var newer = disp[i + 1];
                var boundaryStr = newer.startDateStr;
                var boundaryDays = dateStrToDays(boundaryStr);
                var bPct = ((boundaryDays - minDays) / totalSpan * 100);

                var bMin = dateStrToDays(older.startDateStr) + 1;
                var bMax = newer.endDateStr ? dateStrToDays(newer.endDateStr) - 1 : todayDays;
                var canEdit = (bMin <= bMax);

                html += "<div class='timeline-boundary' style='left:" + bPct.toFixed(2) + "%;' ";
                if (canEdit) {
                    html += "onclick='openFacilityBoundaryPicker(this, \"" + boundaryStr + "\", " + bMin + ", " + bMax + ", " + older.facilityId + ", " + newer.facilityId + ", " + logicalId + ", " + businessId + ");event.stopPropagation();'";
                }
                html += ">";
                html += "<div class='boundary-line'></div>";
                html += "<div class='boundary-label'>" + boundaryStr + "</div>";
                html += "</div>";
            }

            html += "</div>"; // timeline-bar-area

            html += "<div class='timeline-dates'>";
            html += "<span>" + disp[0].startDateStr + "</span>";
            html += "<span>" + (disp[disp.length - 1].endDateStr || today) + "</span>";
            html += "</div>";

            html += "</div>"; // timeline-section
            return html;
        }

        function openFacilityBoundaryPicker(el, dateStr, minDays, maxDays, olderId, newerId, logicalId, businessId) {
            openBoundaryPicker(el, dateStr, minDays, maxDays, function(newDateStr) {
                try {
                    conn.Execute(buildUpdateBoundaryDateQuery("施設", "施設ID", olderId, "有効終了日時", newDateStr));
                    conn.Execute(buildUpdateBoundaryDateQuery("施設", "施設ID", newerId, "有効開始日時", newDateStr));
                    showFacilityHistoryInTab(logicalId, businessId);
                } catch (e) { showToast("境界日の更新エラー: " + e.message, "error", 5000); }
            });
        }

        function showFacilityHistoryInTab(logicalId, businessId) {
            currentHistoryLogicalId = logicalId;
            currentHistoryBusinessId = businessId;
            try {
                var rs = conn.Execute(buildLoadFacilityHistoryQuery(logicalId));

                // バージョンデータ収集（ASC順：古い順、下が新しい）
                var versions = [];
                while (!rs.EOF) {
                    versions.push({
                        facilityId: rs.Fields("施設ID").Value,
                        typeName: rs.Fields("施設種別名").Value || "",
                        location: rs.Fields("設置場所").Value || "",
                        startDateStr: rs.Fields("有効開始文字列").Value || "",
                        endDateStr: rs.Fields("有効終了文字列").Value || "",
                        abolishDateStr: (rs.Fields("廃止日文字列").Value || "")
                    });
                    rs.MoveNext();
                }
                rs.Close();

                // 最新バージョンのIDを取得（詳細に戻る用）
                var latestFacilityId = versions.length > 0 ? versions[versions.length - 1].facilityId : 0;

                // ステップナビ
                var html = buildStepNav([
                    {label: "施設一覧", onclick: "refreshFacilitiesTab(" + businessId + ")"},
                    {label: "施設詳細", onclick: "showFacilityDetail(" + latestFacilityId + ", " + logicalId + ", " + businessId + ")"},
                    {label: "履歴"}
                ], 2);

                html += "<h4 class='tc'>施設論理ID: " + logicalId + " の履歴</h4>";

                // タイムライン表示（全バージョンに有効開始日時がある場合のみ）
                var allHaveStartDate = versions.length >= 2;
                for (var ci = 0; ci < versions.length; ci++) {
                    if (!versions[ci].startDateStr) { allHaveStartDate = false; break; }
                }
                if (allHaveStartDate) {
                    html += buildFacilityTimelineHtml(versions, logicalId, businessId);
                } else if (versions.length >= 2) {
                    html += "<p class='timeline-warn'>※ 有効開始日時が未設定のレコードがあるため、タイムラインを表示できません。設定画面の「データメンテナンス」から一括補完してください。</p>";
                }

                html += "<table class='data-table'><tr><th>状態</th><th>施設種別</th><th>設置場所</th><th>有効開始</th><th>有効終了</th><th>操作</th></tr>";
                for (var vi = 0; vi < versions.length; vi++) {
                    var v = versions[vi];
                    var hasEndDate = (v.endDateStr !== "" && v.endDateStr !== null);
                    var status = hasEndDate ? statusBadge('lapsed', '失効') : statusBadge('active', '有効');
                    if (v.abolishDateStr) {
                        status = statusBadge('abolished', '廃止(' + v.abolishDateStr + ')');
                    }
                    html += "<tr" + (hasEndDate ? " class='bg-row-inactive'" : "") + ">";
                    html += "<td>" + status + "</td>";
                    html += "<td>" + escapeHtml(v.typeName) + "</td>";
                    html += "<td>" + escapeHtml(v.location) + "</td>";
                    html += "<td>" + escapeHtml(v.startDateStr) + "</td>";
                    html += "<td>" + (hasEndDate ? escapeHtml(v.endDateStr) : "-") + "</td>";
                    html += "<td><button class='btn btn-primary btn-sm' onclick='editFacilityHistory(" + v.facilityId + ", " + logicalId + ", " + businessId + ")'>修正</button></td></tr>";
                }
                html += "</table>";
                html += "<div style='margin-top:10px;'>";
                html += "<button class='btn btn-primary' style='margin-right:5px;' onclick='showFacilityRenewalForm(" + logicalId + ", " + businessId + ")'>変更</button>";
                html += "<button class='btn btn-secondary' onclick='showFacilityDetail(" + latestFacilityId + ", " + logicalId + ", " + businessId + ")'>詳細に戻る</button>";
                html += "</div>";
                document.getElementById("tab-facilities").innerHTML = html;
            } catch (e) { document.getElementById("tab-facilities").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        // 履歴から処理能力を表示（戻り先を履歴画面にする）
        function showProcessingCapacityFromHistory(facilityId, businessId) {
            currentCapacityFacilityId = facilityId;
            currentCapacityBusinessId = businessId;
            try {
                // 単位マスターを取得
                var hourUnits = {};
                var dayUnits = {};
                var rs = conn.Execute(buildMasterAllQuery("マスター_時間処理能力単位"));
                while (!rs.EOF) {
                    hourUnits[rs.Fields(0).Value] = rs.Fields(1).Value;
                    rs.MoveNext();
                }
                rs.Close();
                rs = conn.Execute(buildMasterAllQuery("マスター_日処理能力単位"));
                while (!rs.EOF) {
                    dayUnits[rs.Fields(0).Value] = rs.Fields(1).Value;
                    rs.MoveNext();
                }
                rs.Close();

                // 処理能力を取得（施設IDで検索）
                rs = conn.Execute(buildLoadProcessingCapacityQuery(facilityId));

                var html = "<h4>施設ID " + facilityId + " の処理能力（履歴レコード）</h4>";
                html += "<button class='btn-add' onclick='openCapacityForm()'>+ 品目追加</button>";
                html += "<button class='btn btn-secondary' style='margin-bottom:10px;margin-left:10px;' onclick='showFacilityHistoryInTab(" + currentHistoryLogicalId + ", " + businessId + ")'>履歴に戻る</button>";
                html += "<table class='data-table'><tr><th>品目</th><th>時間処理能力</th><th>日処理能力</th><th>稼働時間</th><th>特記事項</th><th>操作</th></tr>";

                while (!rs.EOF) {
                    var capId = rs.Fields("処理能力ID").Value;
                    var itemName = rs.Fields("品目名").Value || "";
                    var hourCap = rs.Fields("時間処理能力").Value;
                    var hourUnitId = rs.Fields("時間処理能力単位ID").Value;
                    var dayCap = rs.Fields("日処理能力").Value;
                    var dayUnitId = rs.Fields("日処理能力単位ID").Value;
                    var hours = rs.Fields("稼働時間").Value;
                    var note = rs.Fields("特記事項").Value || "";

                    var hourStr = hourCap ? hourCap + " " + (hourUnits[hourUnitId] || "") : "-";
                    var dayStr = dayCap ? dayCap + " " + (dayUnits[dayUnitId] || "") : "-";

                    html += "<tr><td>" + escapeHtml(itemName) + "</td>";
                    html += "<td>" + hourStr + "</td>";
                    html += "<td>" + dayStr + "</td>";
                    html += "<td>" + (hours || "-") + "</td>";
                    html += "<td>" + escapeHtml(note) + "</td>";
                    html += "<td>";
                    html += "<button class='btn btn-primary btn-sm' onclick='editCapacity(" + capId + ")'>編集</button>";
                    html += "<button class='btn btn-danger btn-sm' onclick='deleteCapacity(" + capId + ")'>削除</button>";
                    html += "</td></tr>";
                    rs.MoveNext();
                }
                rs.Close();
                html += "</table>";

                document.getElementById("tab-facilities").innerHTML = html;
            } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
        }

        // 施設履歴編集
        var editingFacilityId = 0;
        var editingFacilityLogicalId = 0;
        var editingFacilityBusinessId = 0;
        var editingFacilityMode = "edit"; // "edit"=修正(UPDATE), "renewal"=変更(CLOSE+INSERT)

        // 施設編集フォーム共通（修正/変更共用）
        // mode: "edit"=修正, "renewal"=変更
        function showFacilityEditForm(facilityId, logicalId, businessId, mode) {
            editingFacilityId = facilityId;
            editingFacilityLogicalId = logicalId;
            editingFacilityBusinessId = businessId;
            editingFacilityMode = mode || "edit";
            try {
                var types = [];
                var rs = conn.Execute(buildMasterListQuery("マスター_施設種別", "施設種別ID", "施設種別名"));
                while (!rs.EOF) {
                    types.push({id: rs.Fields("施設種別ID").Value, name: rs.Fields("施設種別名").Value});
                    rs.MoveNext();
                }
                rs.Close();

                // 管理区分マスター
                var mgmtTypes = [];
                var rs2 = conn.Execute(buildMasterListQuery("マスター_管理区分", "管理区分ID", "管理区分名"));
                while (!rs2.EOF) {
                    mgmtTypes.push({id: rs2.Fields("管理区分ID").Value, name: rs2.Fields("管理区分名").Value});
                    rs2.MoveNext();
                }
                rs2.Close();

                // 処理方法マスター
                var methods = [];
                var rs3 = conn.Execute(buildMasterListQuery("マスター_処理方法", "処理方法ID", "処理方法名"));
                while (!rs3.EOF) {
                    methods.push({id: rs3.Fields("処理方法ID").Value, name: rs3.Fields("処理方法名").Value});
                    rs3.MoveNext();
                }
                rs3.Close();

                // 設置形態区分マスター
                var setupForms = [];
                var rs4 = conn.Execute(buildMasterListQuery("マスター_設置形態区分", "設置形態区分ID", "設置形態区分名"));
                while (!rs4.EOF) {
                    setupForms.push({id: rs4.Fields("設置形態区分ID").Value, name: rs4.Fields("設置形態区分名").Value});
                    rs4.MoveNext();
                }
                rs4.Close();

                // 許可対象区分マスター
                var permitTargets = [];
                var rs5 = conn.Execute(buildMasterListQuery("マスター_許可対象区分", "許可対象区分ID", "許可対象区分名"));
                while (!rs5.EOF) {
                    permitTargets.push({id: rs5.Fields("許可対象区分ID").Value, name: rs5.Fields("許可対象区分名").Value});
                    rs5.MoveNext();
                }
                rs5.Close();

                rs = conn.Execute(buildLoadFacilityForEditQuery(facilityId));
                if (rs.EOF) { showToast("施設が見つかりません", "error"); rs.Close(); return; }
                var typeId = rs.Fields("施設種別ID").Value || "";
                var location = rs.Fields("設置場所").Value || "";
                var permitNo = rs.Fields("許可番号").Value || "";
                var permitDate = rs.Fields("許可年月日文字列").Value || "";
                var setupDate = rs.Fields("設置年月日文字列").Value || "";
                var startDate = rs.Fields("有効開始文字列").Value || "";
                var endDate = rs.Fields("有効終了文字列").Value || "";
                var abolishDate = rs.Fields("廃止日文字列").Value || "";
                var managementTypeId = rs.Fields("管理区分ID").Value || "";
                var capacityM3 = rs.Fields("容量m3").Value || "";
                var areaM2 = rs.Fields("面積m2").Value || "";
                var landfillEndDate = rs.Fields("埋立終了日文字列").Value || "";
                var processingMethodId = rs.Fields("処理方法ID").Value || "";
                var setupFormId = rs.Fields("設置形態区分ID").Value || "";
                var permitTargetId = rs.Fields("許可対象区分ID").Value || "";
                var storageAreaM2 = rs.Fields("保管施設面積m2").Value || "";
                var storageCapM3 = rs.Fields("保管量上限m3").Value || "";
                var storageHeightM = rs.Fields("保管高さm").Value || "";
                rs.Close();

                var isRenewal = (editingFacilityMode === "renewal");
                var modeLabel = isRenewal ? "変更" : "修正";

                // ステップナビ
                var html = buildStepNav([
                    {label: "施設一覧", onclick: "refreshFacilitiesTab(" + businessId + ")"},
                    {label: "施設詳細", onclick: "showFacilityDetail(" + facilityId + ", " + logicalId + ", " + businessId + ")"},
                    {label: modeLabel}
                ], 2);

                html += "<div class='form-card'>";
                if (isRenewal) {
                    html += "<h2>施設の変更</h2>";
                    html += "<p class='text-desc' style='margin-bottom:15px;'>変更を保存すると新しいバージョンが作成され、現在のデータは履歴に残ります。</p>";
                } else {
                    html += "<h2>施設履歴の修正（施設ID: " + facilityId + "）</h2>";
                }
                html += "<div class='form-group'><label>施設種別 <span class='badge-required'>必須</span></label><select id='edit-fac-type' onchange='toggleFacilityTypeFields(\"edit\")'>";
                for (var i = 0; i < types.length; i++) {
                    var sel = (types[i].id == typeId) ? " selected" : "";
                    html += "<option value='" + types[i].id + "'" + sel + ">" + escapeHtml(types[i].name) + "</option>";
                }
                html += "</select></div>";
                html += "<div class='form-group'><label>設置場所 <span class='badge-required'>必須</span></label><input type='text' id='edit-fac-location' value='" + escapeHtml(location) + "'></div>";
                var permitNoBadgeClass = (parseInt(permitTargetId) === 1 || !permitTargetId) ? "badge-required" : "badge-optional";
                var permitNoBadgeText = permitNoBadgeClass === "badge-required" ? "必須" : "任意";
                html += "<div class='form-group'><label>許可番号 <span id='edit-fac-permit-no-badge' class='" + permitNoBadgeClass + "'>" + permitNoBadgeText + "</span></label><input type='text' id='edit-fac-permit-no' value='" + escapeHtml(permitNo) + "' oninput='this.value=normalizeToHankaku(this.value)'></div>";
                html += "<div class='form-row'>";
                html += "<div class='form-group'><label>許可年月日 <span class='badge-optional'>任意</span></label><div class='datepicker-wrapper'><input type='text' id='edit-fac-permit-date' class='datepicker-input' value='" + escapeHtml(permitDate) + "' onclick='openDatePicker(\"edit-fac-permit-date\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
                html += "<div class='form-group'><label>設置年月日 <span class='badge-optional'>任意</span></label><div class='datepicker-wrapper'><input type='text' id='edit-fac-setup-date' class='datepicker-input' value='" + escapeHtml(setupDate) + "' onclick='openDatePicker(\"edit-fac-setup-date\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
                html += "</div>";
                // 最終処分場用フィールド（typeId=2）
                html += "<div id='edit-landfill-fields' style='display:" + (parseInt(typeId) === FACILITY_TYPE_LANDFILL ? "" : "none") + ";'>";
                html += "<div class='form-group'><label>管理区分 <span class='badge-optional'>任意</span></label><select id='edit-fac-mgmt-type' style='width:200px;'><option value=''>選択してください</option>";
                for (var m = 0; m < mgmtTypes.length; m++) {
                    var mSel = (mgmtTypes[m].id == managementTypeId) ? " selected" : "";
                    html += "<option value='" + mgmtTypes[m].id + "'" + mSel + ">" + escapeHtml(mgmtTypes[m].name) + "</option>";
                }
                html += "</select></div>";
                html += "<div class='form-row'>";
                html += "<div class='form-group'><label>容量(㎥) <span class='badge-optional'>任意</span></label><input type='text' id='edit-fac-capacity' style='width:150px;' value='" + capacityM3 + "' oninput='this.value=normalizeToHankaku(this.value)'></div>";
                html += "<div class='form-group'><label>面積(㎡) <span class='badge-optional'>任意</span></label><input type='text' id='edit-fac-area' style='width:150px;' value='" + areaM2 + "' oninput='this.value=normalizeToHankaku(this.value)'></div>";
                html += "</div>";
                html += "<div class='form-group'><label>埋立終了年月日 <span class='badge-optional'>任意</span></label><div class='datepicker-wrapper'><input type='text' id='edit-fac-landfill-end' class='datepicker-input' value='" + escapeHtml(landfillEndDate) + "' onclick='openDatePicker(\"edit-fac-landfill-end\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
                html += "</div>";
                // 中間処理施設用フィールド（typeId=1）
                html += "<div id='edit-processing-fields' style='display:" + (parseInt(typeId) === FACILITY_TYPE_PROCESSING ? "" : "none") + ";'>";
                html += "<div class='form-group'><label>処理方法 <span class='badge-optional'>任意</span></label><select id='edit-fac-method' style='width:200px;'><option value=''>選択してください</option>";
                for (var p = 0; p < methods.length; p++) {
                    var pSel = (methods[p].id == processingMethodId) ? " selected" : "";
                    html += "<option value='" + methods[p].id + "'" + pSel + ">" + escapeHtml(methods[p].name) + "</option>";
                }
                html += "</select></div>";
                html += "<div class='form-group'><label>設置形態 <span class='badge-optional'>任意</span></label><select id='edit-fac-setup-form' style='width:200px;'><option value=''>選択してください</option>";
                for (var sf = 0; sf < setupForms.length; sf++) {
                    var sfSel = (setupForms[sf].id == setupFormId) ? " selected" : "";
                    html += "<option value='" + setupForms[sf].id + "'" + sfSel + ">" + escapeHtml(setupForms[sf].name) + "</option>";
                }
                html += "</select></div>";
                html += "<div class='form-group'><label>許可対象区分 <span class='badge-optional'>任意</span></label><select id='edit-fac-permit-target' style='width:200px;' onchange='updatePermitNoBadge()'><option value=''>選択してください</option>";
                for (var pt = 0; pt < permitTargets.length; pt++) {
                    var ptSel = (permitTargets[pt].id == permitTargetId) ? " selected" : "";
                    html += "<option value='" + permitTargets[pt].id + "'" + ptSel + ">" + escapeHtml(permitTargets[pt].name) + "</option>";
                }
                html += "</select></div>";
                html += "</div>";

                // 保管施設情報（積替保管施設のみ）
                var editStorageDisplay = (parseInt(typeId) === FACILITY_TYPE_STORAGE) ? "block" : "none";
                html += "<div id='edit-storage-fields' style='display:" + editStorageDisplay + ";'>";
                html += "<div class='b2-group-title' style='margin-top:16px;'>保管施設情報 <span class='badge-optional'>任意</span></div>";
                html += "<div class='form-row'>";
                html += "<div class='form-group'><label>保管面積(㎡)</label><input type='number' id='edit-fac-storage-area' step='any' min='0' value='" + storageAreaM2 + "'></div>";
                html += "<div class='form-group'><label>保管量上限(㎥)</label><input type='number' id='edit-fac-storage-cap' step='any' min='0' value='" + storageCapM3 + "'></div>";
                html += "<div class='form-group'><label>保管高さ(m)</label><input type='number' id='edit-fac-storage-height' step='any' min='0' value='" + storageHeightM + "'></div>";
                html += "</div></div>";

                // 有効期間の表示・管理者オーバーライド（全モード共通）
                html += "<div class='form-row prev-row'>";
                html += "<div class='form-group'><label>有効開始日時 <span class='auto-label'>（自動設定）</span></label><input type='text' id='edit-fac-start' value='" + escapeHtml(startDate) + "' readonly class='readonly-input'></div>";
                html += "<div class='form-group'><label>有効終了日時 <span class='auto-label'>（自動設定）</span></label><input type='text' id='edit-fac-end' value='" + escapeHtml(endDate) + "' readonly class='readonly-input'><span class='auto-label'>※ 空欄 = 現在有効</span></div>";
                html += "</div>";
                html += "<div style='margin-bottom:10px;'><a href='#' onclick='toggleFacilityBoundaryAdmin(); return false;' class='admin-link'>[管理者] 有効開始/終了を手動編集</a></div>";
                html += "<div id='facility-boundary-admin' style='display:none;'>";
                html += "<div class='form-row'>";
                html += "<div class='form-group'><label>有効開始日時（手動）</label><div class='datepicker-wrapper'><input type='text' id='edit-fac-start-admin' class='datepicker-input' value='" + escapeHtml(startDate) + "' onclick='openDatePicker(\"edit-fac-start-admin\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
                html += "<div class='form-group'><label>有効終了日時（手動）</label><div class='datepicker-wrapper'><input type='text' id='edit-fac-end-admin' class='datepicker-input' value='" + escapeHtml(endDate) + "' onclick='openDatePicker(\"edit-fac-end-admin\")' onblur='normalizeDateInput(this)' placeholder='yyyy/mm/dd'></div></div>";
                html += "</div></div>";

                // 処理能力インラインテーブル（施設編集フォーム内）
                html += "<div class='section-divider'>";
                html += "<div style='display:flex;align-items:center;margin-bottom:12px;'>";
                html += "<span class='section-heading' style='margin:0;'>品目 / 処理能力</span>";
                html += "<button class='btn btn-primary btn-sm' style='margin-left:auto;' onclick='addCapacityRow(" + facilityId + ")'>+ 追加</button>";
                html += "</div>";
                html += "<div id='edit-capacity-table'>読み込み中...</div>";
                html += "</div>";

                html += "<div class='form-buttons'>";
                html += "<button class='btn btn-success' onclick='saveFacilityEdit()'>" + (isRenewal ? "変更を保存" : "保存") + "</button>";
                html += "<button class='btn btn-secondary' onclick='showFacilityDetail(" + facilityId + ", " + logicalId + ", " + businessId + ")'>キャンセル</button>";
                html += "</div></div>";

                document.getElementById("tab-facilities").innerHTML = html;
                loadEditCapacityTable(facilityId);
            } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
        }

        // 後方互換ラッパー
        function editFacilityHistory(facilityId, logicalId, businessId) {
            showFacilityEditForm(facilityId, logicalId, businessId, "edit");
        }

        // 管理者向け境界日手動編集のトグル（施設）
        function toggleFacilityBoundaryAdmin() {
            var el = document.getElementById("facility-boundary-admin");
            el.style.display = el.style.display === "none" ? "block" : "none";
        }

        // 施設編集の保存（修正/変更共用）
        function saveFacilityEdit() {
            try {
                var typeId = document.getElementById("edit-fac-type").value;
                var location = normalizeToHankaku(document.getElementById("edit-fac-location").value);
                var permitNo = normalizePermitNumber(document.getElementById("edit-fac-permit-no").value);
                var permitDate = document.getElementById("edit-fac-permit-date").value;
                var setupDate = document.getElementById("edit-fac-setup-date").value;

                // 必須フィールドチェック
                var missing = [];
                if (!typeId) missing.push("施設種別");
                if (!location) missing.push("設置場所");
                // 許可対象施設の場合のみ許可番号を必須とする
                var permitTargetEl = document.getElementById("edit-fac-permit-target");
                var isPermitTarget = !permitTargetEl || !permitTargetEl.value || parseInt(permitTargetEl.value) === 1;
                if (isPermitTarget && !permitNo) missing.push("施設許可番号");
                if (missing.length > 0) {
                    showToast("以下の必須項目が未入力です:\n・" + missing.join("\n・"), "error");
                    return;
                }

                // 施設種別に応じた追加フィールドを収集
                var extraData = {};
                if (parseInt(typeId) === FACILITY_TYPE_LANDFILL) {
                    var mgmtEl = document.getElementById("edit-fac-mgmt-type");
                    var capEl = document.getElementById("edit-fac-capacity");
                    var areaEl = document.getElementById("edit-fac-area");
                    var landfillEndEl = document.getElementById("edit-fac-landfill-end");
                    extraData.managementTypeId = (mgmtEl && mgmtEl.value) ? parseInt(mgmtEl.value) : 0;
                    extraData.capacityM3 = (capEl && capEl.value) ? parseInt(capEl.value) : 0;
                    extraData.areaM2 = (areaEl && areaEl.value) ? parseInt(areaEl.value) : 0;
                    extraData.landfillEndDate = (landfillEndEl && landfillEndEl.value) ? landfillEndEl.value : "";
                } else if (parseInt(typeId) === FACILITY_TYPE_PROCESSING) {
                    var methodEl = document.getElementById("edit-fac-method");
                    extraData.processingMethodId = (methodEl && methodEl.value) ? parseInt(methodEl.value) : 0;
                    var setupFormEl = document.getElementById("edit-fac-setup-form");
                    extraData.setupFormId = (setupFormEl && setupFormEl.value) ? parseInt(setupFormEl.value) : 0;
                    var permitTargetEl = document.getElementById("edit-fac-permit-target");
                    extraData.permitTargetId = (permitTargetEl && permitTargetEl.value) ? parseInt(permitTargetEl.value) : 0;
                }
                // 保管施設情報（積替保管施設のみ）
                if (parseInt(typeId) === FACILITY_TYPE_STORAGE) {
                    var storageAreaEl = document.getElementById("edit-fac-storage-area");
                    var storageCapEl = document.getElementById("edit-fac-storage-cap");
                    var storageHeightEl = document.getElementById("edit-fac-storage-height");
                    extraData.storageAreaM2 = (storageAreaEl && storageAreaEl.value) ? parseFloat(storageAreaEl.value) : 0;
                    extraData.storageCapM3 = (storageCapEl && storageCapEl.value) ? parseFloat(storageCapEl.value) : 0;
                    extraData.storageHeightM = (storageHeightEl && storageHeightEl.value) ? parseFloat(storageHeightEl.value) : 0;
                }

                var todayStr = buildDateStr();

                if (editingFacilityMode === "renewal") {
                    // 変更モード: 旧版CLOSE + 新版INSERT
                    var boundaryDate = permitDate || todayStr;

                    // トランザクション開始
                    conn.BeginTrans();
                    try {
                        conn.Execute(buildCloseOldVersionByIdQuery("施設", "施設ID", editingFacilityId, todayStr, boundaryDate));

                        var insertData = {
                            logicalId: editingFacilityLogicalId,
                            businessId: editingFacilityBusinessId,
                            typeId: typeId,
                            location: location,
                            permitNo: permitNo,
                            permitDate: permitDate || "",
                            setupDate: setupDate || "",
                            todayStr: todayStr
                        };
                        // 追加フィールドをマージ
                        for (var k in extraData) { insertData[k] = extraData[k]; }
                        // 管理者オーバーライド
                        var facAdminPanel = document.getElementById("facility-boundary-admin");
                        if (facAdminPanel && facAdminPanel.style.display !== "none") {
                            var facAdminStart = document.getElementById("edit-fac-start-admin").value;
                            var facAdminEnd = document.getElementById("edit-fac-end-admin").value;
                            if (facAdminStart) insertData.startDate = facAdminStart;
                            if (facAdminEnd) insertData.endDate = facAdminEnd;
                        }
                        conn.Execute(buildSaveFacilityQuery(insertData));

                        // 新バージョンIDを取得
                        var newRs = conn.Execute(buildGetMaxIdQuery("施設", "施設ID", "施設論理ID", editingFacilityLogicalId));
                        var newId = newRs.Fields("newId").Value;
                        newRs.Close();

                        // インラインテーブルの編集内容を新版に直接挿入
                        insertCapacityFromInlineTable(newId);

                        conn.CommitTrans();
                    } catch (txErr) {
                        conn.RollbackTrans();
                        throw txErr;
                    }

                    showToast("変更を保存しました（新バージョン作成）", "success");
                    showFacilityDetail(newId, editingFacilityLogicalId, editingFacilityBusinessId);
                } else {
                    // 修正モード: 直接UPDATE
                    var updateData = {
                        facilityId: editingFacilityId,
                        typeId: typeId,
                        location: location,
                        permitNo: permitNo,
                        permitDate: permitDate,
                        setupDate: setupDate
                    };
                    for (var k2 in extraData) { updateData[k2] = extraData[k2]; }

                    // 許可年月日がある場合は有効開始日時を自動同期
                    if (permitDate) {
                        updateData.startDate = permitDate;
                    }

                    // 管理者オーバーライド
                    var adminPanel = document.getElementById("facility-boundary-admin");
                    if (adminPanel && adminPanel.style.display !== "none") {
                        var adminStart = document.getElementById("edit-fac-start-admin").value;
                        var adminEnd = document.getElementById("edit-fac-end-admin").value;
                        if (adminStart) updateData.startDate = adminStart;
                        updateData.endDate = adminEnd;
                    }

                    conn.Execute(buildUpdateFacilityHistoryQuery(updateData));
                    saveAllCapacityRows(editingFacilityId);
                    showToast("保存しました", "success");
                    showFacilityDetail(editingFacilityId, editingFacilityLogicalId, editingFacilityBusinessId);
                }
            } catch (e) { showToast("保存エラー: " + e.message, "error", 5000); }
        }

        // 後方互換
        function saveFacilityHistoryEdit() { saveFacilityEdit(); }

        // 施設変更フォームを表示（全フィールド編集可能 → 保存時に旧版CLOSE+新版INSERT）
        function showFacilityRenewalForm(logicalId, businessId) {
            try {
                var rs = conn.Execute(buildLoadLatestVersionQuery("施設", "施設論理ID", logicalId));
                if (rs.EOF) { showToast("元データが見つかりません", "error"); rs.Close(); return; }
                var latestFacId = rs.Fields("施設ID").Value;
                rs.Close();
                showFacilityEditForm(latestFacId, logicalId, businessId, "renewal");
            } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
        }

        function refreshFacilitiesTab(businessId, includeAbolished) {
            document.getElementById("tab-facilities").innerHTML = loadFacilitiesForBusiness(businessId, includeAbolished);
        }

        function refreshVehiclesTab(businessId) {
            document.getElementById("tab-vehicles").innerHTML = loadVehiclesForBusiness(businessId);
        }
        function refreshOfficersTab(businessId) {
            document.getElementById("tab-officers").innerHTML = loadOfficersForBusiness(businessId);
        }

        function loadVehiclesForBusiness(businessId) {
            try {
                var rs = conn.Execute(buildLoadVehiclesForBusinessQuery(businessId));
                var html = "<button class='btn-add' onclick='openVehicleForm(0, " + businessId + ")'>+ 車両追加</button>";
                if (rs.EOF) {
                    rs.Close();
                    return html + "<p class='text-note'>車両の登録はまだありません。</p>";
                }
                html += "<table class='data-table'><tr><th>状態</th><th>登録番号</th><th style='text-align:center;width:50px;'>普通</th><th style='text-align:center;width:50px;'>特管</th><th>操作</th></tr>";
                while (!rs.EOF) {
                    var vehicleId = rs.Fields("車両ID").Value;
                    var regNum = (rs.Fields("登録番号1").Value || "") + " " + (rs.Fields("登録番号2").Value || "") + " " + (rs.Fields("登録番号3").Value || "") + " " + (rs.Fields("登録番号4").Value || "");
                    var isScrapped = rs.Fields("廃車フラグ").Value;
                    var isNormal = rs.Fields("普通フラグ").Value ? true : false;
                    var isSpecial = rs.Fields("特管フラグ").Value ? true : false;
                    var statusText = isScrapped ? statusBadge('scrapped', '廃車') : statusBadge('operating', '稼働中');
                    html += "<tr" + (isScrapped ? " class='bg-row-inactive'" : "") + ">";
                    html += "<td>" + statusText + "</td>";
                    html += "<td>" + escapeHtml(regNum.trim()) + "</td>";
                    // 普通/特管チェックボックス（クリックで切替）
                    if (!isScrapped) {
                        html += "<td style='text-align:center;'><input type='checkbox'" + (isNormal ? " checked" : "") + " onchange='toggleVehicleFlag(" + vehicleId + ", \"普通フラグ\", this.checked, " + rs.Fields("事業者ID").Value + ")' style='width:18px;height:18px;cursor:pointer;'></td>";
                        html += "<td style='text-align:center;'><input type='checkbox'" + (isSpecial ? " checked" : "") + " onchange='toggleVehicleFlag(" + vehicleId + ", \"特管フラグ\", this.checked, " + rs.Fields("事業者ID").Value + ")' style='width:18px;height:18px;cursor:pointer;'></td>";
                    } else {
                        html += "<td style='text-align:center;'><input type='checkbox'" + (isNormal ? " checked" : "") + " disabled style='width:18px;height:18px;'></td>";
                        html += "<td style='text-align:center;'><input type='checkbox'" + (isSpecial ? " checked" : "") + " disabled style='width:18px;height:18px;'></td>";
                    }
                    html += "<td>";
                    html += "<button class='btn btn-primary btn-sm' onclick='openVehicleForm(" + vehicleId + ", " + businessId + ")'>編集</button>";
                    if (!isScrapped) {
                        html += "<button class='btn btn-danger btn-sm' onclick='scrapVehicle(" + vehicleId + ", " + businessId + ")'>廃車にする</button>";
                    } else {
                        html += "<button class='btn btn-secondary btn-sm' onclick='restoreVehicle(" + vehicleId + ", " + businessId + ")'>復活</button>";
                    }
                    html += "<button class='btn btn-secondary btn-sm' onclick='deleteVehicle(" + vehicleId + ", " + businessId + ")'>削除</button>";
                    html += "</td></tr>";
                    rs.MoveNext();
                }
                rs.Close();
                return html + "</table>";
            } catch (e) { return "<p>エラー [車両一覧]: " + e.message + "</p>"; }
        }

        // 車両を廃車にする
        function scrapVehicle(vehicleId, businessId) {
            showConfirmDialog("車両廃車", "この車両を廃車にしますか？", {
                okText: "廃車にする", okClass: "btn-warning",
                onOk: function() {
                    try {
                        conn.Execute(buildScrapVehicleQuery(vehicleId));
                        showToast("廃車にしました", "info");
                        document.getElementById("tab-vehicles").innerHTML = loadVehiclesForBusiness(businessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        // 車両を復活させる
        function restoreVehicle(vehicleId, businessId) {
            showConfirmDialog("車両復活", "この車両を稼働中に戻しますか？", {
                okText: "稼働中に戻す", okClass: "btn-success",
                onOk: function() {
                    try {
                        conn.Execute(buildRestoreVehicleQuery(vehicleId));
                        showToast("稼働中に戻しました", "success");
                        document.getElementById("tab-vehicles").innerHTML = loadVehiclesForBusiness(businessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        // 車両を削除
        function deleteVehicle(vehicleId, businessId) {
            showConfirmDialog("車両削除", "この車両を削除しますか？\nこの操作は取り消せません。", {
                okText: "削除する", okClass: "btn-danger",
                onOk: function() {
                    try {
                        conn.Execute(buildDeleteVehicleQuery(vehicleId));
                        showToast("車両を削除しました", "info");
                        document.getElementById("tab-vehicles").innerHTML = loadVehiclesForBusiness(businessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        // 車両の普通/特管フラグをトグル
        function toggleVehicleFlag(vehicleId, flagName, newValue, businessId) {
            try {
                conn.Execute(buildUpdateVehicleFlagQuery(vehicleId, flagName, newValue));
                document.getElementById("tab-vehicles").innerHTML = loadVehiclesForBusiness(businessId);
            } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
        }

        // 車両追加・編集フォームを開く
        var currentVehicleBusinessId = 0;
        var currentVehicleEditId = 0;
        function openVehicleForm(vehicleId, businessId) {
            currentVehicleBusinessId = businessId;
            currentVehicleEditId = vehicleId || 0;
            var isEdit = currentVehicleEditId > 0;
            var r1 = "", r2 = "", r3 = "", r4 = "";
            var normalFlag = false, specialFlag = false;
            if (isEdit) {
                try {
                    var rs = conn.Execute(buildGetVehicleByIdQuery(vehicleId));
                    if (!rs.EOF) {
                        r1 = rs.Fields("登録番号1").Value || "";
                        r2 = rs.Fields("登録番号2").Value || "";
                        r3 = rs.Fields("登録番号3").Value || "";
                        r4 = rs.Fields("登録番号4").Value || "";
                        normalFlag = rs.Fields("普通フラグ").Value ? true : false;
                        specialFlag = rs.Fields("特管フラグ").Value ? true : false;
                    }
                    rs.Close();
                } catch (e) { showToast("読み込みエラー: " + e.message, "error"); return; }
            }
            var title = isEdit ? "車両編集" : "車両追加";
            var html = buildStepNav([
                {label: "車両一覧", onclick: "cancelVehicleForm()"},
                {label: title}
            ], 1);
            html += "<div class='form-panel'>";
            html += "<h4>" + title + "</h4>";
            var reqBadge = " <span class='badge-required'>必須</span>";
            html += "<div class='form-group'><label>登録番号1（地名）" + reqBadge + "</label><input type='text' id='vReg1' style='width:100px;' maxlength='4' placeholder='品川' value='" + escapeHtml(r1) + "'></div>";
            html += "<div class='form-group'><label>登録番号2（分類番号）" + reqBadge + "</label><input type='text' id='vReg2' style='width:100px;' maxlength='3' placeholder='500' value='" + escapeHtml(r2) + "'></div>";
            html += "<div class='form-group'><label>登録番号3（ひらがな）" + reqBadge + "</label><input type='text' id='vReg3' style='width:60px;' maxlength='1' placeholder='あ' value='" + escapeHtml(r3) + "'></div>";
            html += "<div class='form-group'><label>登録番号4（一連指定番号）" + reqBadge + "</label><input type='text' id='vReg4' style='width:100px;' maxlength='4' placeholder='1234' value='" + escapeHtml(r4) + "'></div>";
            html += "<div class='form-group'><label>許可種別</label>";
            html += "<div style='display:flex;align-items:center;'>";
            html += "<label style='font-weight:normal;margin-right:16px;display:flex;align-items:center;'><input type='checkbox' id='vNormalFlag'" + (normalFlag ? " checked" : "") + " style='margin-right:4px;'> 普通</label>";
            html += "<label style='font-weight:normal;display:flex;align-items:center;'><input type='checkbox' id='vSpecialFlag'" + (specialFlag ? " checked" : "") + " style='margin-right:4px;'> 特管</label>";
            html += "</div></div>";
            html += "<button class='btn btn-primary' onclick='saveVehicle()'>保存</button> ";
            html += "<button class='btn btn-secondary' onclick='cancelVehicleForm()'>キャンセル</button>";
            html += "</div>";
            document.getElementById("tab-vehicles").innerHTML = html;
        }

        // 車両を保存
        function saveVehicle() {
            var reg1 = document.getElementById("vReg1").value.trim();
            var reg2 = document.getElementById("vReg2").value.trim();
            var reg3 = document.getElementById("vReg3").value.trim();
            var reg4 = document.getElementById("vReg4").value.trim();
            var missing = [];
            if (!reg1) missing.push("登録番号1（地名）");
            if (!reg2) missing.push("登録番号2（分類番号）");
            if (!reg3) missing.push("登録番号3（ひらがな）");
            if (!reg4) missing.push("登録番号4（一連指定番号）");
            if (missing.length > 0) {
                showToast("以下の必須項目が未入力です:\n・" + missing.join("\n・"), "error");
                return;
            }
            try {
                var sql = buildSaveVehicleQuery({
                    id: currentVehicleEditId,
                    businessId: currentVehicleBusinessId,
                    reg1: reg1, reg2: reg2, reg3: reg3, reg4: reg4,
                    normalFlag: document.getElementById("vNormalFlag").checked,
                    specialFlag: document.getElementById("vSpecialFlag").checked
                });
                conn.Execute(sql);
                showToast(currentVehicleEditId > 0 ? "車両を更新しました" : "車両を登録しました", "success");
                document.getElementById("tab-vehicles").innerHTML = loadVehiclesForBusiness(currentVehicleBusinessId);
            } catch (e) { showToast("保存エラー: " + e.message, "error", 5000); }
        }

        // 車両フォームをキャンセル
        function cancelVehicleForm() {
            document.getElementById("tab-vehicles").innerHTML = loadVehiclesForBusiness(currentVehicleBusinessId);
        }

        // ===== 役員タブ =====
        var currentOfficerBusinessId = 0;

        function loadOfficersForBusiness(businessId) {
            currentOfficerBusinessId = businessId;
            try {
                var rs = conn.Execute(buildLoadOfficersForBusinessQuery(businessId));

                var html = "<button class='btn-add' onclick='openOfficerForm(0)'>+ 役員追加</button>";
                if (rs.EOF) {
                    rs.Close();
                    return html + "<p class='text-note'>役員の登録はまだありません。</p>";
                }
                html += "<p class='text-note' style='margin:8px 0;'><span class='primary-star active'>&#9733;</span> = 代表者</p>";
                html += "<table class='data-table'><tr><th>状態</th><th>役職名</th><th>氏名</th><th>操作</th></tr>";

                while (!rs.EOF) {
                    var officerId = rs.Fields("役員ID").Value;
                    var position = rs.Fields("役職名").Value || "";
                    var lastName = rs.Fields("姓").Value || "";
                    var firstName = rs.Fields("名").Value || "";
                    var isRetired = rs.Fields("退任フラグ").Value;
                    var isPrimary = rs.Fields("代表者フラグ").Value;

                    var statusHtml = isRetired ? statusBadge('retired', '退任') : statusBadge('serving', '現任');
                    var starHtml = isPrimary ? "<span class='primary-star active' title='代表者'>&#9733;</span>" : "";
                    var nameHtml = starHtml + escapeHtml(lastName) + " " + escapeHtml(firstName);

                    html += "<tr" + (isRetired ? " class='bg-row-inactive'" : "") + "><td>" + statusHtml + "</td>";
                    html += "<td>" + escapeHtml(position) + "</td>";
                    html += "<td>" + nameHtml + "</td>";
                    html += "<td>";
                    if (!isRetired) {
                        var starBtn = isPrimary
                            ? "<button class='btn btn-warning btn-sm' onclick='togglePrimaryOfficer(" + officerId + ", true)' title='代表者を解除'>&#9733;</button>"
                            : "<button class='btn btn-secondary btn-sm' onclick='togglePrimaryOfficer(" + officerId + ", false)' title='代表者に指定'>&#9734;</button>";
                        html += starBtn;
                    }
                    html += "<button class='btn btn-primary btn-sm' onclick='openOfficerForm(" + officerId + ")'>編集</button>";
                    if (!isRetired) {
                        html += "<button class='btn btn-secondary btn-sm' onclick='retireOfficer(" + officerId + ")'>退任</button>";
                    } else {
                        html += "<button class='btn btn-success btn-sm' onclick='reinstateOfficer(" + officerId + ")'>復帰</button>";
                    }
                    html += "<button class='btn btn-danger btn-sm' onclick='deleteOfficer(" + officerId + ")'>削除</button>";
                    html += "</td></tr>";
                    rs.MoveNext();
                }
                rs.Close();
                return html + "</table>";
            } catch (e) { return "<p>エラー [役員一覧]: " + e.message + "</p>"; }
        }

        function retireOfficer(officerId) {
            showConfirmDialog("役員退任", "この役員を退任にしますか？", {
                okText: "退任にする", okClass: "btn-warning",
                onOk: function() {
                    try {
                        conn.Execute(buildRetireOfficerQuery(officerId));
                        showToast("退任にしました", "info");
                        document.getElementById("tab-officers").innerHTML = loadOfficersForBusiness(currentOfficerBusinessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        function reinstateOfficer(officerId) {
            showConfirmDialog("役員復任", "この役員を現任に戻しますか？", {
                okText: "現任に戻す", okClass: "btn-success",
                onOk: function() {
                    try {
                        conn.Execute(buildReinstateOfficerQuery(officerId));
                        showToast("現任に戻しました", "success");
                        document.getElementById("tab-officers").innerHTML = loadOfficersForBusiness(currentOfficerBusinessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        function deleteOfficer(officerId) {
            showConfirmDialog("役員削除", "この役員を削除しますか？\n（この操作は取り消せません）", {
                okText: "削除する", okClass: "btn-danger",
                onOk: function() {
                    try {
                        conn.Execute(buildDeleteOfficerQuery(officerId));
                        showToast("役員を削除しました", "info");
                        document.getElementById("tab-officers").innerHTML = loadOfficersForBusiness(currentOfficerBusinessId);
                    } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
                }
            });
        }

        function togglePrimaryOfficer(officerId, isCurrentlyPrimary) {
            try {
                if (isCurrentlyPrimary) {
                    conn.Execute(buildClearPrimaryOfficerQuery(officerId));
                } else {
                    var queries = buildSetPrimaryOfficerQueries(officerId, currentOfficerBusinessId);
                    for (var i = 0; i < queries.length; i++) { conn.Execute(queries[i]); }
                }
                document.getElementById("tab-officers").innerHTML = loadOfficersForBusiness(currentOfficerBusinessId);
            } catch (e) { showToast("エラー: " + e.message, "error", 5000); }
        }

        function openOfficerForm(officerId) {
            var isEdit = officerId > 0;
            var editData = { position: "", lastName: "", firstName: "" };

            if (isEdit) {
                try {
                    var rs = conn.Execute(buildLoadOfficerForEditQuery(officerId));
                    if (!rs.EOF) {
                        editData.position = rs.Fields("役職名").Value || "";
                        editData.lastName = rs.Fields("姓").Value || "";
                        editData.firstName = rs.Fields("名").Value || "";
                    }
                    rs.Close();
                } catch (e) {}
            }

            // 役職マスターから取得（フォールバック: ハードコード配列）
            var positions = [];
            try {
                var posRs = conn.Execute(buildMasterListQuery("マスター_役職", "役職ID", "役職名"));
                while (!posRs.EOF) { positions.push(posRs.Fields("役職名").Value); posRs.MoveNext(); }
                posRs.Close();
            } catch (e) { positions = OFFICER_POSITIONS; }
            if (positions.length === 0) positions = OFFICER_POSITIONS;
            var posOptions = "<option value=''>選択してください</option>";
            for (var i = 0; i < positions.length; i++) {
                var sel = (editData.position === positions[i]) ? " selected" : "";
                posOptions += "<option value='" + positions[i] + "'" + sel + ">" + positions[i] + "</option>";
            }

            var html = buildStepNav([
                {label: "役員一覧", onclick: "cancelOfficerForm()"},
                {label: isEdit ? "役員編集" : "役員追加"}
            ], 1);
            html += "<div class='form-panel' style='max-width:400px;margin:0 auto;'>";
            html += "<h4>" + (isEdit ? "役員編集" : "役員追加") + "</h4>";
            html += "<input type='hidden' id='offEditId' value='" + officerId + "'>";
            html += "<div class='form-group'><label>役職名 <span class='badge-required'>必須</span></label>";
            html += "<select id='offPosition' style='width:200px;'>" + posOptions + "</select></div>";
            html += "<div class='form-group'><label>姓 <span class='badge-required'>必須</span></label>";
            html += "<input type='text' id='offLastName' style='width:150px;' value='" + escapeHtml(editData.lastName) + "'></div>";
            html += "<div class='form-group'><label>名 <span class='badge-required'>必須</span></label>";
            html += "<input type='text' id='offFirstName' style='width:150px;' value='" + escapeHtml(editData.firstName) + "'></div>";
            html += "<button class='btn btn-primary' onclick='saveOfficer()'>保存</button> ";
            html += "<button class='btn btn-secondary' onclick='cancelOfficerForm()'>キャンセル</button>";
            html += "</div>";

            document.getElementById("tab-officers").innerHTML = html;
        }

        function saveOfficer() {
            var editId = document.getElementById("offEditId").value;
            var position = document.getElementById("offPosition").value;
            var lastName = document.getElementById("offLastName").value.trim();
            var firstName = document.getElementById("offFirstName").value.trim();

            var missing = [];
            if (!position) missing.push("役職名");
            if (!lastName) missing.push("姓");
            if (!firstName) missing.push("名");
            if (missing.length > 0) {
                showToast("以下の必須項目が未入力です:\n・" + missing.join("\n・"), "error");
                return;
            }

            try {
                var sql = buildSaveOfficerQuery({
                    id: (editId && editId !== "0") ? parseInt(editId) : 0,
                    businessId: currentOfficerBusinessId,
                    position: position, lastName: lastName, firstName: firstName
                });
                conn.Execute(sql);
                showToast(editId && editId !== "0" ? "役員を更新しました" : "役員を登録しました", "success");
                document.getElementById("tab-officers").innerHTML = loadOfficersForBusiness(currentOfficerBusinessId);
            } catch (e) { showToast("保存エラー: " + e.message, "error", 5000); }
        }

        function cancelOfficerForm() {
            document.getElementById("tab-officers").innerHTML = loadOfficersForBusiness(currentOfficerBusinessId);
        }

        function showTab(tabId, btn) {
            // 全てのタブコンテンツを非表示
            var tabIds = ["tab-info", "tab-permits", "tab-facilities", "tab-vehicles", "tab-officers"];
            for (var i = 0; i < tabIds.length; i++) {
                var tab = document.getElementById(tabIds[i]);
                if (tab) tab.style.display = "none";
            }
            // タブ切替時に一覧に戻す（編集・検索画面をリセット）
            if (currentDetailBusinessId) {
                if (tabId === "permits") refreshPermitsTab(currentDetailBusinessId);
                if (tabId === "facilities") refreshFacilitiesTab(currentDetailBusinessId);
                if (tabId === "vehicles") refreshVehiclesTab(currentDetailBusinessId);
                if (tabId === "officers") refreshOfficersTab(currentDetailBusinessId);
            }
            // 選択されたタブを表示
            document.getElementById("tab-" + tabId).style.display = "block";
            // ボタンのスタイルを更新
            var btns = document.getElementsByClassName("tab-btn");
            for (var i = 0; i < btns.length; i++) btns[i].className = "tab-btn";
            btn.className = "tab-btn active";
        }

        // ===== 施設一覧 =====
        function loadFacilityList() {
            showPage("facility");
            if (!conn) { document.getElementById("facilityList").innerHTML = "<p>データベースに接続されていません</p>"; return; }
            try {
                // 有効終了日時がNULLのレコードのみ表示（現在有効なレコード）
                // Format関数で日付を文字列に変換（ADODBの日付型をJSで扱うため）
                var sql = "SELECT 施設.施設ID, 施設.施設論理ID, 施設.設置場所, 施設.許可番号, ";
                sql += "Format(施設.許可年月日, 'yyyy/mm/dd') AS 許可日文字列, ";
                sql += "Format(施設.有効開始日時, 'yyyy/mm/dd') AS 有効開始文字列, ";
                sql += "事業者.事業者名, マスター_施設種別.施設種別名 ";
                sql += "FROM (施設 LEFT JOIN 事業者 ON 施設.事業者ID = 事業者.事業者ID) ";
                sql += "LEFT JOIN マスター_施設種別 ON 施設.施設種別ID = マスター_施設種別.施設種別ID ";
                sql += "WHERE 施設.有効終了日時 IS NULL ";
                sql += "ORDER BY 施設.施設論理ID, 施設.施設ID";
                var rs = conn.Execute(sql);
                var html = "<p class='stats-heading' style='margin-bottom:10px;'>※ 有効終了日時がNULLの現在有効なレコードのみ表示</p>";
                html += "<table class='data-table'><tr><th>論理ID</th><th>施設種別</th><th>事業者名</th><th>設置場所</th><th>許可番号</th><th>有効開始</th><th>操作</th></tr>";
                while (!rs.EOF) {
                    var logicalId = rs.Fields("施設論理ID").Value || "";
                    var facilityId = rs.Fields("施設ID").Value || "";
                    html += "<tr>";
                    html += "<td>" + logicalId + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("施設種別名").Value || "") + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("事業者名").Value || "") + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("設置場所").Value || "") + "</td>";
                    html += "<td>" + (rs.Fields("許可番号").Value || "") + "</td>";
                    html += "<td>" + (rs.Fields("有効開始文字列").Value || "") + "</td>";
                    html += "<td><button class='btn btn-primary btn-md' onclick='showFacilityHistory(" + logicalId + ")'>履歴</button></td>";
                    html += "</tr>";
                    rs.MoveNext();
                }
                rs.Close();
                html += "</table>";
                document.getElementById("facilityList").innerHTML = html;
            } catch (e) { document.getElementById("facilityList").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        // 施設履歴表示
        function showFacilityHistory(logicalId) {
            if (!conn) { showToast("データベースに接続されていません", "error"); return; }
            try {
                var rs = conn.Execute(buildLoadFacilityHistoryQuery(logicalId));
                var html = "<h3>施設論理ID: " + logicalId + " の履歴</h3>";
                html += "<table class='data-table'><tr><th>状態</th><th>施設種別</th><th>設置場所</th><th>有効開始</th><th>有効終了</th></tr>";
                while (!rs.EOF) {
                    var endDateStr = rs.Fields("有効終了文字列").Value || "";
                    var hasEndDate = (endDateStr !== "" && endDateStr !== null);
                    var status = hasEndDate ? statusBadge('lapsed', '失効') : statusBadge('active', '有効');
                    html += "<tr" + (hasEndDate ? " class='bg-row-inactive'" : "") + ">";
                    html += "<td>" + status + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("施設種別名").Value || "") + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("設置場所").Value || "") + "</td>";
                    html += "<td>" + (rs.Fields("有効開始文字列").Value || "") + "</td>";
                    html += "<td>" + (hasEndDate ? escapeHtml(endDateStr) : "-") + "</td>";
                    html += "</tr>";
                    rs.MoveNext();
                }
                rs.Close();
                html += "</table>";
                html += "<button class='btn btn-secondary' style='margin-top:15px;' onclick='loadFacilityList()'>一覧に戻る</button>";
                document.getElementById("facilityList").innerHTML = html;
            } catch (e) { document.getElementById("facilityList").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        // ===== 統計 =====
        function loadStatistics() {
            log("loadStatistics: start");
            showLoading();
            try {
                showPage("statistics");
            } catch(ep) { log("loadStatistics: showPage error - " + ep.message); hideLoading(); return; }
            log("loadStatistics: showPage done");

            var content = document.getElementById("statisticsContent");
            if (!content) { log("loadStatistics: content not found"); return; }
            if (!conn) { log("loadStatistics: no conn"); content.innerHTML = "<p>DBに接続されていません</p>"; return; }
            log("loadStatistics: conn OK");

            var html = "";
            var bc = "-", pc = "-", fc = "-", ec = "-";
            var statsQueries = buildStatisticsQueries();

            log("loadStatistics: query1 start");
            try {
                var rs1 = conn.Execute(statsQueries.businessCount);
                bc = rs1.Fields("cnt").Value; rs1.Close();
                log("loadStatistics: query1 OK - " + bc);
            } catch(e1) { bc = "E1"; log("loadStatistics: query1 error - " + e1.message); }

            log("loadStatistics: query2 start");
            try {
                var rs2 = conn.Execute(statsQueries.permitCount);
                pc = rs2.Fields("cnt").Value; rs2.Close();
                log("loadStatistics: query2 OK - " + pc);
            } catch(e2) { pc = "E2"; log("loadStatistics: query2 error - " + e2.message); }

            log("loadStatistics: query3 start");
            try {
                var rs3 = conn.Execute(statsQueries.facilityCount);
                fc = rs3.Fields("cnt").Value; rs3.Close();
                log("loadStatistics: query3 OK - " + fc);
            } catch(e3) { fc = "E3"; log("loadStatistics: query3 error - " + e3.message); }

            log("loadStatistics: query4 start");
            try {
                var rs4 = conn.Execute(statsQueries.expiringCount);
                ec = rs4.Fields("cnt").Value; rs4.Close();
                log("loadStatistics: query4 OK - " + ec);
            } catch(e4) { ec = "E4"; log("loadStatistics: query4 error - " + e4.message); }

            log("loadStatistics: building html");
            html += "<div class='dashboard-grid'>";
            html += "<div class='dash-card'><div class='dash-card-label'>事業者数</div><div class='dash-card-value'>" + bc + "</div></div>";
            html += "<div class='dash-card' style='cursor:pointer;' onclick='showPermitTrend()'><div class='dash-card-label'>業数推移</div><div class='dash-card-value'>" + pc + "</div></div>";
            html += "<div class='dash-card'><div class='dash-card-label'>施設数</div><div class='dash-card-value'>" + fc + "</div></div>";
            html += "<div class='dash-card dash-card-warn' style='cursor:pointer;' onclick='showExpiringPermits()'><div class='dash-card-label'>期限切れ間近</div><div class='dash-card-value'>" + ec + "</div></div>";
            html += "</div>";
            html += "<div style='margin-top:12px;'><div class='dash-card' style='cursor:pointer;display:inline-block;padding:14px 24px;' onclick='showCapacityStats()'><div class='dash-card-label'>処理能力集計</div><div style='font-size:0.9em;margin-top:4px;opacity:0.6;'>施設種別・品目別</div></div></div>";
            hideLoading();
            log("loadStatistics: setting innerHTML");
            try {
                content.innerHTML = html;
                log("loadStatistics: innerHTML set OK");
            } catch(ehtml) {
                log("loadStatistics: innerHTML error - " + ehtml.message);
            }
            log("loadStatistics: done");
        }

        // 許可数推移グラフ（許可区分ごと）
        function showPermitTrend() {
            log("showPermitTrend: start");
            if (!conn) { document.getElementById("statisticsContent").innerHTML = "<p>データベースに接続されていません</p>"; return; }
            try {
                // 許可区分一覧を取得
                var categories = [];
                var rscat = conn.Execute(buildMasterListQuery("マスター_許可区分", "許可区分ID", "許可区分名"));
                while (!rscat.EOF) {
                    categories.push({id: rscat.Fields("許可区分ID").Value, name: rscat.Fields("許可区分名").Value});
                    rscat.MoveNext();
                }
                rscat.Close();

                var html = "<h3 class='stats-heading'>業数推移（許可区分別・現在有効分）</h3>";

                // 許可区分ごとにグラフを表示
                for (var c = 0; c < categories.length; c++) {
                    var catId = categories[c].id;
                    var catName = categories[c].name;

                    var rs = conn.Execute(buildLoadPermitTrendQuery(catId));
                    var data = [];
                    var maxCount = 0;
                    while (!rs.EOF) {
                        var year = rs.Fields("年").Value;
                        var count = rs.Fields("件数").Value;
                        if (year) {
                            data.push({year: year, count: count});
                            if (count > maxCount) maxCount = count;
                        }
                        rs.MoveNext();
                    }
                    rs.Close();

                    html += "<div class='chart-panel'>";
                    html += "<h4 class='chart-title'>" + escapeHtml(catName) + "</h4>";

                    if (data.length === 0) {
                        html += "<p class='tc-sub' style='font-size:12px;'>データがありません</p>";
                    } else {
                        // 棒グラフを描画
                        html += "<div class='border-light' style='display:flex;align-items:flex-end;height:150px;border-bottom:1px solid;border-left:1px solid;padding:5px 5px 0 5px;'>";
                        var barWidth = Math.max(25, Math.floor(600 / data.length) - 8);
                        for (var i = 0; i < data.length; i++) {
                            var heightPercent = maxCount > 0 ? (data[i].count / maxCount) * 100 : 0;
                            var barHeight = Math.max(15, heightPercent * 1.3);
                            html += "<div style='display:flex;flex-direction:column;align-items:center;margin:0 3px;'>";
                            html += "<div class='tc' style='font-size:10px;margin-bottom:3px;'>" + data[i].count + "</div>";
                            html += "<div class='chart-bar' style='width:" + barWidth + "px;height:" + barHeight + "px;border-radius:2px 2px 0 0;'></div>";
                            html += "</div>";
                        }
                        html += "</div>";
                        // X軸ラベル
                        html += "<div style='display:flex;padding:3px 5px 0 5px;'>";
                        for (var i = 0; i < data.length; i++) {
                            html += "<div class='chart-label' style='width:" + barWidth + "px;text-align:center;margin:0 3px;'>" + data[i].year + "</div>";
                        }
                        html += "</div>";
                    }
                    html += "</div>";
                }

                html += "<button class='btn-back' style='margin-top:15px;' onclick='loadStatistics()'>← 統計に戻る</button>";
                document.getElementById("statisticsContent").innerHTML = html;
            } catch (e) { log("showPermitTrend error: " + e.message); document.getElementById("statisticsContent").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        // 期限切れ間近の許可一覧
        function showExpiringPermits() {
            log("showExpiringPermits: start");
            if (!conn) { document.getElementById("statisticsContent").innerHTML = "<p>データベースに接続されていません</p>"; return; }
            try {
                var rs = conn.Execute(buildLoadExpiringPermitsQuery());
                var html = "<h3 class='stats-heading' style='margin-bottom:15px;'>期限切れ間近の業一覧（1年以内）</h3>";
                html += "<table class='data-table'><tr><th>事業者名</th><th>許可番号</th><th>許可区分</th><th>許可年月日</th><th>許可有効年月日</th><th>操作</th></tr>";
                while (!rs.EOF) {
                    var bizId = rs.Fields("事業者ID").Value || "";
                    html += "<tr>";
                    html += "<td>" + escapeHtml(rs.Fields("事業者名").Value || "") + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("許可番号").Value || "") + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields("許可区分名").Value || "") + "</td>";
                    html += "<td>" + (rs.Fields("許可日文字列").Value || "") + "</td>";
                    html += "<td><span class='badge-expiry soon'>" + (rs.Fields("有効期限文字列").Value || "") + "</span></td>";
                    html += "<td><button class='btn btn-primary btn-md' onclick='loadBusinessDetail(" + bizId + ")'>詳細</button></td>";
                    html += "</tr>";
                    rs.MoveNext();
                }
                rs.Close();
                html += "</table>";
                html += "<button class='btn-back' style='margin-top:15px;' onclick='loadStatistics()'>← 統計に戻る</button>";
                document.getElementById("statisticsContent").innerHTML = html;
            } catch (e) { log("showExpiringPermits error: " + e.message); document.getElementById("statisticsContent").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        // 処理能力集計
        function showCapacityStats() {
            log("showCapacityStats: start");
            if (!conn) { document.getElementById("statisticsContent").innerHTML = "<p>データベースに接続されていません</p>"; return; }
            try {
                var html = "<h3 class='stats-heading'>処理能力集計（施設種別・品目別）</h3>";

                // 施設種別一覧を取得
                var facilityTypes = [];
                var rsft = conn.Execute(buildMasterListQuery("マスター_施設種別", "施設種別ID", "施設種別名"));
                while (!rsft.EOF) {
                    facilityTypes.push({id: rsft.Fields("施設種別ID").Value, name: rsft.Fields("施設種別名").Value});
                    rsft.MoveNext();
                }
                rsft.Close();

                // 品目一覧を取得
                var items = [];
                var rsitem = conn.Execute(buildMasterListQuery("マスター_品目", "品目ID", "品目名", "表示順"));
                while (!rsitem.EOF) {
                    items.push({id: rsitem.Fields("品目ID").Value, name: rsitem.Fields("品目名").Value});
                    rsitem.MoveNext();
                }
                rsitem.Close();

                // 日処理能力単位一覧を取得
                var units = {};
                var rsunit = conn.Execute(buildMasterListQuery("マスター_日処理能力単位", "日処理能力単位ID", "日処理能力単位名"));
                while (!rsunit.EOF) {
                    units[rsunit.Fields("日処理能力単位ID").Value] = rsunit.Fields("日処理能力単位名").Value;
                    rsunit.MoveNext();
                }
                rsunit.Close();

                // 施設種別ごとに集計
                for (var f = 0; f < facilityTypes.length; f++) {
                    var ftId = facilityTypes[f].id;
                    var ftName = facilityTypes[f].name;

                    html += "<div class='chart-panel'>";
                    html += "<h4 class='section-heading-bordered'>" + escapeHtml(ftName) + "</h4>";

                    // この施設種別の品目ごとの処理能力を集計
                    var rs = conn.Execute(buildLoadCapacityStatsQuery(ftId));
                    var hasData = false;
                    var tableHtml = "<table class='inline-table' style='width:100%;'>";
                    tableHtml += "<tr class='bg-table-header'><th class='tc' style='text-align:left;padding:8px;'>品目</th><th class='tc' style='text-align:right;padding:8px;'>日処理能力合計</th><th class='tc' style='text-align:left;padding:8px;'>単位</th></tr>";

                    while (!rs.EOF) {
                        hasData = true;
                        var itemName = rs.Fields("品目名").Value || "";
                        var capacity = rs.Fields("合計日処理能力").Value || 0;
                        var unitId = rs.Fields("日処理能力単位ID").Value;
                        var unitName = units[unitId] || "";

                        tableHtml += "<tr>";
                        tableHtml += "<td class='tc' style='padding:8px;'>" + escapeHtml(itemName) + "</td>";
                        tableHtml += "<td class='tc' style='padding:8px;text-align:right;font-weight:bold;'>" + capacity.toLocaleString() + "</td>";
                        tableHtml += "<td class='tc' style='padding:8px;'>" + escapeHtml(unitName) + "</td>";
                        tableHtml += "</tr>";
                        rs.MoveNext();
                    }
                    rs.Close();
                    tableHtml += "</table>";

                    if (hasData) {
                        html += tableHtml;
                    } else {
                        html += "<p class='tc-sub' style='font-size:12px;'>該当する処理能力データがありません</p>";
                    }
                    html += "</div>";
                }

                html += "<button class='btn-back' style='margin-top:15px;' onclick='loadStatistics()'>← 統計に戻る</button>";
                document.getElementById("statisticsContent").innerHTML = html;
                log("showCapacityStats: done");
            } catch (e) { log("showCapacityStats error: " + e.message); document.getElementById("statisticsContent").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        // ===== マスター設定 =====
        // ===== データメンテナンス =====
        function checkMissingDates() {
            try {
                var statusEl = document.getElementById("migration-status");
                var permitRs = conn.Execute(buildMissingStartDateCountQuery("許可"));
                var permitCount = permitRs.Fields("cnt").Value;
                permitRs.Close();

                var facilityRs = conn.Execute(buildMissingStartDateCountQuery("施設"));
                var facilityCount = facilityRs.Fields("cnt").Value;
                facilityRs.Close();

                if (permitCount === 0 && facilityCount === 0) {
                    statusEl.innerHTML = "<strong class='tc-success'>全レコードに有効開始日時が設定済みです。補完の必要はありません。</strong>";
                } else {
                    statusEl.innerHTML = "<strong class='tc-error'>未設定: 許可 " + permitCount + " 件、施設 " + facilityCount + " 件</strong>";
                }
            } catch (e) { document.getElementById("migration-status").innerHTML = "<span class='tc-error'>エラー: " + e.message + "</span>"; }
        }

        function fixMissingDates() {
            try {
                checkMissingDates();
                var statusEl = document.getElementById("migration-status");

                // 許可: 有効開始日時が未設定 → 許可年月日で補完、許可年月日もなければ作成日時
                var permitSql = buildFixMissingPermitStartDateQuery();
                conn.Execute(permitSql);

                // 施設: 有効開始日時が未設定 → 設置年月日で補完、なければ許可年月日
                var facilitySql = buildFixMissingFacilityStartDateQuery();
                conn.Execute(facilitySql);

                // 再チェック
                var permitRs = conn.Execute(buildMissingStartDateCountQuery("許可"));
                var remainPermit = permitRs.Fields("cnt").Value;
                permitRs.Close();
                var facilityRs = conn.Execute(buildMissingStartDateCountQuery("施設"));
                var remainFacility = facilityRs.Fields("cnt").Value;
                facilityRs.Close();

                if (remainPermit === 0 && remainFacility === 0) {
                    statusEl.innerHTML = "<strong class='tc-success'>補完完了。全レコードに有効開始日時が設定されました。</strong>";
                } else {
                    statusEl.innerHTML = "<strong class='tc-warn'>補完後も未設定: 許可 " + remainPermit + " 件、施設 " + remainFacility + " 件（許可年月日等も未設定のため補完不可）</strong>";
                }
            } catch (e) { document.getElementById("migration-status").innerHTML = "<span class='tc-error'>エラー: " + e.message + "</span>"; }
        }

        // ===== 旧システム インポート機能 =====

        function startLegacyImport() {
            var statusEl = document.getElementById("import-status");
            statusEl.innerHTML = "";

            try {
                // ファイル選択ダイアログ（HTA用 CommonDialog は使えないため UserAccounts.CommonDialogを使用）
                var shell = new ActiveXObject("Shell.Application");
                var folder = shell.BrowseForFolder(0, "旧システム Access DB (.mdb) が含まれるフォルダを選択してください", 0x0040, "C:\\");
                if (!folder) {
                    statusEl.innerHTML = "<span class='tc-warn'>キャンセルされました</span>";
                    return;
                }
                var folderPath = folder.Self.Path;

                // .mdb ファイルを探す
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                var mdbPath = "";
                var folderObj = fso.GetFolder(folderPath);
                var files = new Enumerator(folderObj.Files);
                for (; !files.atEnd(); files.moveNext()) {
                    var f = files.item();
                    if (f.Name.toLowerCase().indexOf(".mdb") > -1 || f.Name.toLowerCase().indexOf(".accdb") > -1) {
                        mdbPath = f.Path;
                        break;
                    }
                }

                if (!mdbPath) {
                    statusEl.innerHTML = "<span class='tc-error'>選択フォルダに .mdb / .accdb ファイルが見つかりません</span>";
                    return;
                }

                statusEl.innerHTML = "<span>ファイル: " + escapeHtml(mdbPath) + " を読み込み中...</span>";

                // 旧DBに接続
                var legacyConn = new ActiveXObject("ADODB.Connection");
                legacyConn.Mode = 1; // adModeRead
                var legProviders = [
                    "Provider=Microsoft.Jet.OLEDB.4.0;Data Source=" + mdbPath + ";",
                    "Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" + mdbPath + ";",
                    "Provider=Microsoft.ACE.OLEDB.16.0;Data Source=" + mdbPath + ";"
                ];
                var legConnected = false;
                for (var pi = 0; pi < legProviders.length; pi++) {
                    try {
                        legacyConn.Open(legProviders[pi]);
                        legConnected = true;
                        break;
                    } catch (pe) {
                        try { legacyConn.Close(); } catch(x) {}
                        legacyConn = new ActiveXObject("ADODB.Connection");
                        legacyConn.Mode = 1;
                    }
                }
                if (!legConnected) {
                    statusEl.innerHTML = "<span class='tc-error'>旧DBに接続できません。OLEDBプロバイダーを確認してください。</span>";
                    return;
                }

                // 旧DB事業者一覧を取得
                var legBizRs = legacyConn.Execute(buildReadLegacyBusinessesQuery());
                var legacyBizList = [];
                while (!legBizRs.EOF) {
                    legacyBizList.push({ ID: legBizRs.Fields("ID").Value, "業者名": legBizRs.Fields("業者名").Value });
                    legBizRs.MoveNext();
                }
                legBizRs.Close();

                // 現行DB事業者一覧を取得
                var curBizRs = conn.Execute(buildLoadBusinessListQuery());
                var currentBizList = [];
                while (!curBizRs.EOF) {
                    currentBizList.push({ "事業者ID": curBizRs.Fields("事業者ID").Value, "事業者名": curBizRs.Fields("事業者名").Value });
                    curBizRs.MoveNext();
                }
                curBizRs.Close();

                // 事業者名マッチング
                var matchResult = buildBusinessNameMap(currentBizList, legacyBizList);
                var matchedCount = 0;
                for (var k in matchResult.map) {
                    if (matchResult.map.hasOwnProperty(k)) matchedCount++;
                }

                // 旧DB役員データを取得
                var legOfficerRs = legacyConn.Execute(buildReadLegacyOfficersQuery());
                var legacyOfficers = [];
                while (!legOfficerRs.EOF) {
                    legacyOfficers.push({
                        "ＩＤ番号": legOfficerRs.Fields("ＩＤ番号").Value,
                        "役職名": legOfficerRs.Fields("役職名").Value,
                        "姓": legOfficerRs.Fields("姓").Value,
                        "名": legOfficerRs.Fields("名").Value
                    });
                    legOfficerRs.MoveNext();
                }
                legOfficerRs.Close();

                // 旧DB車両データを取得（2テーブル統合）
                var legacyVehicles = [];
                var vehicleTables = ["３５．T 収運業（車両登録№）", "４５．T 収運業・特管（車両登録№）"];
                for (var ti = 0; ti < vehicleTables.length; ti++) {
                    try {
                        var legVehRs = legacyConn.Execute(buildReadLegacyVehiclesQuery(vehicleTables[ti]));
                        while (!legVehRs.EOF) {
                            legacyVehicles.push({
                                "ＩＤ番号": legVehRs.Fields("ＩＤ番号").Value,
                                "登録№１": legVehRs.Fields("登録№１").Value,
                                "登録№２": legVehRs.Fields("登録№２").Value,
                                "登録№３": legVehRs.Fields("登録№３").Value,
                                "登録№４": legVehRs.Fields("登録№４").Value,
                                "廃車": legVehRs.Fields("廃車").Value
                            });
                            legVehRs.MoveNext();
                        }
                        legVehRs.Close();
                    } catch (ve) { /* テーブルがない場合はスキップ */ }
                }

                legacyConn.Close();

                // 確認ダイアログ
                var confirmMsg = "旧システム データインポート\n\n";
                confirmMsg += "事業者マッチング: " + matchedCount + "/" + legacyBizList.length + " 社\n";
                confirmMsg += "未マッチ: " + matchResult.unmatched.length + " 社\n\n";
                confirmMsg += "インポート対象:\n";
                confirmMsg += "  役員: " + legacyOfficers.length + " 件\n";
                confirmMsg += "  車両: " + legacyVehicles.length + " 件\n\n";
                confirmMsg += "実行しますか？";

                showConfirmDialog("旧システムからインポート", confirmMsg, {
                    okText: "インポート実行",
                    okClass: "btn-success",
                    onOk: function() {
                        executeLegacyImport(matchResult.map, legacyOfficers, legacyVehicles, statusEl);
                    }
                });

            } catch (e) {
                statusEl.innerHTML = "<span class='tc-error'>エラー: " + escapeHtml(e.message) + "</span>";
            }
        }

        function executeLegacyImport(businessIdMap, legacyOfficers, legacyVehicles, statusEl) {
            try {
                statusEl.innerHTML = "<span>インポート実行中...</span>";

                // 既存の役員・車両データを取得（重複チェック用）
                var existingOfficers = [];
                var eoRs = conn.Execute(buildLoadAllOfficersQuery());
                while (!eoRs.EOF) {
                    existingOfficers.push({
                        "事業者ID": eoRs.Fields("事業者ID").Value,
                        "役職名": eoRs.Fields("役職名").Value,
                        "姓": eoRs.Fields("姓").Value,
                        "名": eoRs.Fields("名").Value
                    });
                    eoRs.MoveNext();
                }
                eoRs.Close();

                var existingVehicles = [];
                var evRs = conn.Execute(buildLoadAllVehiclesQuery());
                while (!evRs.EOF) {
                    existingVehicles.push({
                        "事業者ID": evRs.Fields("事業者ID").Value,
                        "登録番号1": evRs.Fields("登録番号1").Value,
                        "登録番号2": evRs.Fields("登録番号2").Value,
                        "登録番号3": evRs.Fields("登録番号3").Value,
                        "登録番号4": evRs.Fields("登録番号4").Value
                    });
                    evRs.MoveNext();
                }
                evRs.Close();

                // 役員インポート
                var officerResult = buildImportOfficersQueries(legacyOfficers, businessIdMap, existingOfficers);
                for (var oi = 0; oi < officerResult.queries.length; oi++) {
                    conn.Execute(officerResult.queries[oi]);
                }

                // 車両インポート
                var vehicleResult = buildImportVehiclesQueries(legacyVehicles, businessIdMap, existingVehicles);
                for (var vi = 0; vi < vehicleResult.queries.length; vi++) {
                    conn.Execute(vehicleResult.queries[vi]);
                }

                // 結果表示
                var resultHtml = "<div style='background:#e8f5e9;padding:10px;border-radius:5px;color:#333;'>";
                resultHtml += "<strong>インポート完了</strong><br><br>";
                resultHtml += "<strong>役員:</strong> " + officerResult.insertCount + " 件追加";
                if (officerResult.skippedCount > 0) resultHtml += "（重複スキップ: " + officerResult.skippedCount + " 件）";
                if (officerResult.unmatchedBizCount > 0) resultHtml += "（事業者未マッチ: " + officerResult.unmatchedBizCount + " 件）";
                resultHtml += "<br>";
                resultHtml += "<strong>車両:</strong> " + vehicleResult.insertCount + " 件追加";
                if (vehicleResult.scrappedCount > 0) resultHtml += "（うち廃車: " + vehicleResult.scrappedCount + " 件）";
                if (vehicleResult.skippedCount > 0) resultHtml += "（重複スキップ: " + vehicleResult.skippedCount + " 件）";
                if (vehicleResult.unmatchedBizCount > 0) resultHtml += "（事業者未マッチ: " + vehicleResult.unmatchedBizCount + " 件）";
                resultHtml += "</div>";
                statusEl.innerHTML = resultHtml;

                showToast("インポート完了: 役員 " + officerResult.insertCount + " 件、車両 " + vehicleResult.insertCount + " 件", "success", 5000);

            } catch (e) {
                statusEl.innerHTML = "<span class='tc-error'>インポートエラー: " + escapeHtml(e.message) + "</span>";
            }
        }

        var currentMasterType = "";

        // getMasterConfig は app_logic.js に移動済み

        function showMasterSettings(type) {
            currentMasterType = type;
            var config = getMasterConfig(type);
            if (!config) return;
            showPage("master");
            document.getElementById("masterTitle").innerText = config.title + "マスター";
            document.getElementById("masterSubtitle").innerText = config.title + " Master";
            loadMasterList();
        }

        function loadMasterList() {
            if (!conn) { document.getElementById("masterList").innerHTML = "<p>データベースに接続されていません</p>"; return; }
            var config = getMasterConfig(currentMasterType);
            if (!config) return;
            try {
                // FK名前解決マップを構築
                var fkNameMap = {};
                if (config.fkCol) {
                    var fkRs = conn.Execute(buildForeignKeyMapQuery(config.fkCol.refTable, config.fkCol.refIdCol, config.fkCol.refNameCol));
                    while (!fkRs.EOF) {
                        fkNameMap[fkRs.Fields(config.fkCol.refIdCol).Value] = fkRs.Fields(config.fkCol.refNameCol).Value || "";
                        fkRs.MoveNext();
                    }
                    fkRs.Close();
                }

                var rs = conn.Execute(buildLoadMasterListQuery(config));
                var colCount = 2 + (config.extraCol ? 1 : 0) + (config.fkCol ? 1 : 0) + 1; // ID + name + extra? + fk? + 操作
                var isItem = (currentMasterType === "品目");
                var html = "<table class='data-table'><tr><th>ID</th><th>" + config.title + "名</th>";
                if (config.extraCol) html += "<th>" + config.extraCol + "</th>";
                if (config.fkCol) html += "<th>" + config.fkCol.label + "</th>";
                html += "<th>操作</th></tr>";
                var normalInserted = false;
                var specialInserted = false;
                while (!rs.EOF) {
                    var id = rs.Fields(config.idCol).Value;
                    // 品目の場合、グループヘッダーを挿入
                    if (isItem) {
                        if (!normalInserted && id < ITEM_SPECIAL_THRESHOLD) {
                            html += "<tr class='group-header'><td colspan='" + colCount + "'>普通産業廃棄物</td></tr>";
                            normalInserted = true;
                        }
                        if (!specialInserted && id >= ITEM_SPECIAL_THRESHOLD) {
                            html += "<tr class='group-header'><td colspan='" + colCount + "'>特別管理産業廃棄物</td></tr>";
                            specialInserted = true;
                        }
                    }
                    html += "<tr><td>" + id + "</td>";
                    html += "<td>" + escapeHtml(rs.Fields(config.nameCol).Value || "") + "</td>";
                    if (config.extraCol) html += "<td>" + (rs.Fields(config.extraCol).Value || "") + "</td>";
                    if (config.fkCol) {
                        var fkId = rs.Fields(config.fkCol.col).Value;
                        html += "<td>" + escapeHtml(fkNameMap[fkId] || (fkId ? String(fkId) : "-")) + "</td>";
                    }
                    html += "<td><button class='btn btn-secondary' style='padding:5px 10px;font-size:0.9em;margin-right:5px;' onclick='openMasterForm(" + id + ")'>編集</button>";
                    html += "<button class='btn btn-danger btn-md' onclick='deleteMaster(" + id + ")'>削除</button></td></tr>";
                    rs.MoveNext();
                }
                rs.Close();
                html += "</table>";
                document.getElementById("masterList").innerHTML = html;
            } catch (e) { document.getElementById("masterList").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        function openMasterForm(id) {
            formDirty = false;
            var config = getMasterConfig(currentMasterType);
            if (!config) return;
            showPage("master-form");
            document.getElementById("masterFormMessage").innerHTML = "";
            document.getElementById("editMasterId").value = id;
            document.getElementById("editMasterType").value = currentMasterType;

            var isItem = (currentMasterType === "品目");
            var html = "";

            // 品目の場合: 種別セレクター（新規）またはラベル（編集）
            if (isItem) {
                html += "<input type='hidden' id='inputItemCategory' value='normal'>";
                if (id === 0) {
                    html += "<div class='form-group'><label>廃棄物種別 <span class='badge-required'>必須</span></label>";
                    html += "<div class='category-selector' id='categorySelector'>";
                    html += "<label id='catLabelNormal' class='selected' onclick='selectItemCategory(\"normal\")'><input type='radio' name='itemCat' value='normal' checked><span>普通産廃</span></label>";
                    html += "<label id='catLabelSpecial' onclick='selectItemCategory(\"special\")'><input type='radio' name='itemCat' value='special'><span>特管産廃</span></label>";
                    html += "</div></div>";
                } else {
                    html += "<div class='form-group'><label>廃棄物種別</label>";
                    html += "<span id='itemCategoryBadge' class='category-badge'></span></div>";
                }
            }

            html += "<div class='form-group'><label>" + config.title + "名 <span class='badge-required'>必須</span></label>";
            html += "<input type='text' id='inputMasterName' oninput='markFormDirty()'></div>";
            if (config.extraCol) {
                html += "<div class='form-group'><label>" + config.extraCol + " <span class='badge-optional'>任意</span></label>";
                html += "<input type='number' id='inputMasterExtra' oninput='markFormDirty()'></div>";
            }
            // FK列がある場合、参照テーブルからドロップダウンを描画
            if (config.fkCol) {
                html += "<div class='form-group'><label>" + config.fkCol.label + " <span class='badge-optional'>任意</span></label>";
                html += "<select id='inputMasterFk' onchange='markFormDirty()'><option value=''>未設定</option>";
                try {
                    var fkRs = conn.Execute(buildForeignKeyMapQuery(config.fkCol.refTable, config.fkCol.refIdCol, config.fkCol.refNameCol));
                    while (!fkRs.EOF) {
                        html += "<option value='" + fkRs.Fields(config.fkCol.refIdCol).Value + "'>" + escapeHtml(fkRs.Fields(config.fkCol.refNameCol).Value || "") + "</option>";
                        fkRs.MoveNext();
                    }
                    fkRs.Close();
                } catch (e) { /* FK参照テーブル読み込み失敗は無視 */ }
                html += "</select></div>";
            }
            document.getElementById("masterFormFields").innerHTML = html;

            if (id > 0) {
                document.getElementById("masterFormTitle").innerText = config.title + "編集";
                document.getElementById("masterFormSubtitle").innerText = "Edit " + config.title;
                loadMasterForEdit(id);
                // 品目編集時: IDから種別を判定してバッジ表示
                if (isItem) {
                    var isSpecial = (id >= ITEM_SPECIAL_THRESHOLD);
                    var badge = document.getElementById("itemCategoryBadge");
                    badge.innerText = isSpecial ? "特別管理産業廃棄物" : "普通産業廃棄物";
                    badge.className = "category-badge " + (isSpecial ? "category-badge-special" : "category-badge-normal");
                    document.getElementById("inputItemCategory").value = isSpecial ? "special" : "normal";
                }
            } else {
                document.getElementById("masterFormTitle").innerText = config.title + "追加";
                document.getElementById("masterFormSubtitle").innerText = "Add " + config.title;
                document.getElementById("inputMasterName").value = "";
                if (config.extraCol) document.getElementById("inputMasterExtra").value = "";
            }
        }

        function selectItemCategory(cat) {
            document.getElementById("inputItemCategory").value = cat;
            var normalLabel = document.getElementById("catLabelNormal");
            var specialLabel = document.getElementById("catLabelSpecial");
            if (cat === "normal") {
                normalLabel.className = "selected";
                specialLabel.className = "";
            } else {
                normalLabel.className = "";
                specialLabel.className = "selected";
            }
            markFormDirty();
        }

        function loadMasterForEdit(id) {
            var config = getMasterConfig(currentMasterType);
            if (!config || !conn) return;
            try {
                var rs = conn.Execute(buildLoadMasterForEditQuery(config, id));
                if (!rs.EOF) {
                    document.getElementById("inputMasterName").value = rs.Fields(config.nameCol).Value || "";
                    if (config.extraCol) {
                        document.getElementById("inputMasterExtra").value = rs.Fields(config.extraCol).Value || "";
                    }
                    if (config.fkCol) {
                        var fkEl = document.getElementById("inputMasterFk");
                        if (fkEl) {
                            var fkVal = rs.Fields(config.fkCol.col).Value;
                            fkEl.value = (fkVal !== null && fkVal !== undefined) ? fkVal : "";
                        }
                    }
                }
                rs.Close();
            } catch (e) { showMasterMessage("読み込みエラー: " + e.message, true); }
        }

        function saveMaster() {
            var config = getMasterConfig(currentMasterType);
            if (!config || !conn) return;
            var name = document.getElementById("inputMasterName").value.trim();
            if (!name) { showMasterMessage(config.title + "名を入力してください", true); return; }
            var id = parseInt(document.getElementById("editMasterId").value);
            // FK値を取得
            var fkValue;
            if (config.fkCol) {
                var fkEl = document.getElementById("inputMasterFk");
                fkValue = (fkEl && fkEl.value) ? fkEl.value : null;
            }
            try {
                if (id > 0) {
                    var extra = config.extraCol ? (document.getElementById("inputMasterExtra").value || "0") : undefined;
                    conn.Execute(buildSaveMasterQuery(config, { id: id, name: name, extra: extra, fk: fkValue }));
                    formDirty = false;
                    showToast("更新しました", "success");
                } else {
                    var newId;
                    // 品目: 種別に応じたID範囲で採番
                    if (currentMasterType === "品目") {
                        var catElem = document.getElementById("inputItemCategory");
                        var isSpecial = catElem && catElem.value === "special";
                        var maxSql;
                        if (isSpecial) {
                            var maxRs = conn.Execute(buildGetNextMasterIdQuery(config, "special"));
                            newId = (maxRs.Fields("maxId").Value || (ITEM_SPECIAL_THRESHOLD - 1)) + 1;
                            maxRs.Close();
                        } else {
                            var maxRs = conn.Execute(buildGetNextMasterIdQuery(config, "normal"));
                            var maxVal = maxRs.Fields("maxId").Value || 0;
                            maxRs.Close();
                            if (maxVal >= ITEM_SPECIAL_THRESHOLD - 1) {
                                showMasterMessage("普通産廃のID枠（1〜" + (ITEM_SPECIAL_THRESHOLD - 1) + "）が満杯です。", true);
                                return;
                            }
                            newId = maxVal + 1;
                        }
                    } else {
                        var maxRs = conn.Execute(buildGetNextMasterIdQuery(config));
                        newId = (maxRs.Fields("maxId").Value || 0) + 1;
                        maxRs.Close();
                    }
                    var extra = config.extraCol ? (document.getElementById("inputMasterExtra").value || "") : undefined;
                    // 品目: 表示順が空なら新IDと同じ値を自動設定
                    if (currentMasterType === "品目" && config.extraCol && !extra) {
                        extra = String(newId);
                    }
                    if (!extra && config.extraCol) extra = "0";
                    conn.Execute(buildSaveMasterQuery(config, { id: 0, newId: newId, name: name, extra: extra, fk: fkValue }));
                    formDirty = false;
                    showToast("追加しました", "success");
                }
                // 許可区分マスター変更時はキャッシュをクリア
                if (config.fkCol) _wasteTypeMap = null;
                showMasterSettings(currentMasterType);
            } catch (e) { showMasterMessage("保存エラー: " + e.message, true); }
        }

        function deleteMaster(id) {
            var config = getMasterConfig(currentMasterType);
            if (!config || !conn) return;
            showConfirmDialog("マスタ削除", "ID " + id + " を削除しますか？\n\n※ 関連データがある場合は削除できない可能性があります。", {
                okText: "削除する", okClass: "btn-danger",
                onOk: function() {
                    try {
                        conn.Execute(buildDeleteMasterQuery(config, id));
                        showToast("削除しました", "info");
                        loadMasterList();
                    } catch (e) { showToast("削除エラー: " + e.message + "\n\n関連データが存在する可能性があります。", "error"); }
                }
            });
        }

        function cancelMasterForm() {
            goBack();
        }

        function showMasterMessage(msg, isError) {
            var elem = document.getElementById("masterFormMessage");
            elem.innerHTML = "<div class='message " + (isError ? "error" : "success") + "'>" + escapeHtml(msg) + "</div>";
        }

        // escapeHtml, escapeSql, formatDate, padZero, padZero2 は app_logic.js に移動済み
        window.onunload = function() { if (conn) { try { conn.Close(); } catch (e) {} } };
    </script>

    <!-- モーダルダイアログ -->
    <div id="modalOverlay" class="modal-overlay">
        <div class="modal-dialog">
            <div class="modal-title" id="modalTitle">タイトル</div>
            <div class="modal-body">
                <div id="modalMessage"></div>
                <textarea id="modalInput" rows="3" placeholder="理由を入力（任意）"></textarea>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="modalCancel()">キャンセル</button>
                <button class="btn btn-primary" id="modalOkBtn" onclick="modalOk()">OK</button>
            </div>
        </div>
    </div>

    <!-- 確認ダイアログ -->
    <div id="confirmOverlay" class="modal-overlay">
        <div class="modal-dialog">
            <div class="modal-title" id="confirmTitle">確認</div>
            <div class="modal-body">
                <div id="confirmMessage" class="confirm-body"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" id="confirmCancelBtn" onclick="confirmDialogCancel()">キャンセル</button>
                <button class="btn btn-primary" id="confirmOkBtn" onclick="confirmDialogOk()">OK</button>
            </div>
        </div>
    </div>
</body>
</html>
