<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>廃棄物処理業許可管理システム</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <HTA:APPLICATION
        ID="WasteManagementApp"
        APPLICATIONNAME="廃棄物処理業許可管理システム"
        BORDER="thick"
        BORDERSTYLE="normal"
        CAPTION="yes"
        MAXIMIZEBUTTON="yes"
        MINIMIZEBUTTON="yes"
        SINGLEINSTANCE="yes"
        SYSMENU="yes"
        VERSION="5.5"
        WINDOWSTATE="maximize"
    >
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, 'Segoe UI', 'Yu Gothic UI', 'Meiryo UI', 'Helvetica Neue', sans-serif;
            background: linear-gradient(160deg, #0a1930 0%, #1a3558 40%, #1e4070 70%, #142a50 100%);
            min-height: 100vh;
            color: #fff;
            -webkit-font-smoothing: antialiased;
        }
        .container { text-align: center; padding: 20px 40px; max-width: 960px; margin: 0 auto; }
        /* ホーム画面: 垂直中央配置 */
        .home-container { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; padding: 0 40px; text-align: center; }
        .home-header { margin-bottom: 8px; }
        h1 { font-size: 1.8em; font-weight: 200; margin-bottom: 4px; letter-spacing: -0.02em; }
        .subtitle { font-size: 0.8em; opacity: 0.5; margin-bottom: 0; letter-spacing: 0.08em; font-weight: 400; text-transform: uppercase; }
        .page .subtitle { margin-bottom: 24px; }
        .menu-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
        .menu-grid > * { margin: 5px; }
        .menu-grid-4 { grid-template-columns: repeat(4, 1fr); }
        .home-container .menu-grid { max-width: 720px; }
        /* 統計サマリーストリップ */
        .stats-strip { display: none; align-items: center; justify-content: center; background: rgba(255,255,255,0.08); border-radius: 10px; padding: 6px 16px; margin-bottom: 12px; max-width: 720px; }
        .stat-item { display: flex; flex-direction: column; align-items: center; padding: 4px 20px; }
        .stat-item + .stat-item { border-left: 1px solid rgba(255,255,255,0.1); }
        .stat-value { font-size: 1.3em; font-weight: 600; letter-spacing: -0.02em; }
        .stat-label { font-size: 0.65em; opacity: 0.5; letter-spacing: 0.04em; margin-top: 1px; }
        .stat-warn .stat-value { color: #ff9500; }
        /* メニューグループラベル */
        .menu-group { width: 100%; max-width: 720px; }
        .menu-group + .menu-group { margin-top: 10px; }
        .menu-group-label { font-size: 0.7em; opacity: 0.35; text-transform: uppercase; letter-spacing: 0.08em; text-align: left; margin-bottom: 6px; font-weight: 500; }
        /* 通知バッジ */
        .menu-button { position: relative; }
        .notification-badge { position: absolute; top: -4px; right: -4px; background: #ff3b30; color: #fff; font-size: 11px; font-weight: 700; min-width: 18px; height: 18px; border-radius: 9px; display: none; align-items: center; justify-content: center; padding: 0 5px; line-height: 18px; }
        /* アイコン背景カラー */
        .icon-search { background: rgba(0,122,255,0.12); border-radius: 10px; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; }
        .icon-manage { background: rgba(52,199,89,0.12); border-radius: 10px; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; }
        /* スタガードアニメーション初期状態 */
        .menu-button.stagger-init { opacity: 0; transform: translateY(8px); transition: opacity 0.3s ease, transform 0.3s ease; }
        .menu-button.stagger-show { opacity: 1; transform: translateY(0); }
        .menu-button { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 8px 12px; cursor: pointer; color: #fff; text-align: left; display: flex; align-items: center; transition: all 0.3s cubic-bezier(0.25, 0.1, 0.25, 1); }
        .menu-button > * + * { margin-left: 10px; }
        .menu-button:hover { background: rgba(255,255,255,0.12); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.25); }
        .menu-button .icon { font-size: 20px; flex-shrink: 0; position: relative; }
        .menu-button .menu-text { display: flex; flex-direction: column; }
        .menu-button .menu-text span { font-size: 0.9em; font-weight: 500; letter-spacing: 0.02em; }
        .menu-button .menu-text .menu-desc { font-size: 0.7em; font-weight: 400; opacity: 0.45; margin-top: 2px; }
        .status-bar { position: fixed; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.4); padding: 6px 24px; display: flex; justify-content: space-between; font-size: 0.8em; letter-spacing: 0.01em; z-index: 100; }
        .db-status { color: #4CAF50; }
        .db-status.error { color: #f44336; }
        .page { display: none; padding: 20px; padding-top: 45px; }
        .page.active { display: block; }
        #page-home { padding: 0 0 48px 0; height: 100vh; }
        .search-box { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 20px; margin-bottom: 20px; }
        .search-box input[type='text'] { flex: 1; min-width: 200px; padding: 10px 15px; border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; font-size: 1em; background: rgba(255,255,255,0.08); color: inherit; transition: border-color 0.2s ease, background 0.2s ease; }
        .search-box input[type='text']:focus { outline: none; border-color: #007aff; }
        .search-box select { padding: 10px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.08); color: inherit; font-size: 1em; transition: border-color 0.2s ease; }
        .search-box select:focus { outline: none; border-color: #007aff; }
        .search-box button { padding: 10px 25px; border: none; border-radius: 10px; background: #007aff; color: white; cursor: pointer; font-size: 1em; font-weight: 500; transition: background 0.2s ease; white-space: nowrap; }
        .search-box button:hover { background: #0066d6; }
        /* --- 検索バー内レイアウト（8ptグリッド、IE互換: gap → margin） --- */
        .search-row { display: flex; flex-wrap: wrap; align-items: center; }
        .search-row > * + * { margin-left: 16px; }
        .search-sub-row { display: flex; flex-wrap: wrap; align-items: center; margin-top: 16px; }
        .search-sub-row > * + * { margin-left: 16px; }
        .filter-row { display: flex; flex-wrap: wrap; align-items: flex-end; margin-bottom: 16px; }
        .filter-row > * + * { margin-left: 16px; }
        .filter-row .search-label { display: block; margin-bottom: 4px; }
        .filter-section { margin-bottom: 16px; }
        .filter-items-area { display: flex; align-items: flex-start; margin-top: 8px; }
        .filter-items-area > * + * { margin-left: 16px; }
        .filter-col { display: flex; flex-direction: column; }
        .filter-col > * + * { margin-top: 8px; }
        .advanced-filters { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; padding: 16px; margin-top: 16px; }
        .advanced-filters select { padding: 8px 12px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.08); color: inherit; font-size: 0.9em; }
        .advanced-filters select:focus { outline: none; border-color: #007aff; }
        .advanced-filters .filter-btn { padding: 8px 16px; border: 1px solid rgba(255,255,255,0.15); border-radius: 10px; background: none; color: inherit; cursor: pointer; font-size: 0.85em; }
        .advanced-filters .filter-btn:hover { background: rgba(255,255,255,0.08); }
        body.theme-light .advanced-filters { background: rgba(0,0,0,0.02); border-color: rgba(0,0,0,0.06); }
        body.theme-light .advanced-filters select { border-color: rgba(0,0,0,0.12); background: #fff; color: #333; }
        body.theme-light .advanced-filters .filter-btn { border-color: rgba(0,0,0,0.12); color: #333; }
        body.theme-light .advanced-filters .filter-btn:hover { background: rgba(0,0,0,0.04); }
        .search-initial-state { text-align: center; padding: 40px 20px; color: rgba(255,255,255,0.4); }
        .search-initial-state .search-initial-icon { font-size: 2.5em; margin-bottom: 10px; }
        .search-initial-state p { font-size: 0.9em; }
        body.theme-light .search-initial-state { color: rgba(0,0,0,0.3); }
        body.theme-dark .search-initial-state { color: rgba(255,255,255,0.3); }
        body.theme-dark .advanced-filters { background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.06); }
        body.theme-dark .advanced-filters select { border-color: #38444d; background: #22303c; color: #e7e9ea; }
        body.theme-dark .advanced-filters .filter-btn { border-color: #38444d; color: #e7e9ea; }
        body.theme-dark .advanced-filters .filter-btn:hover { background: rgba(255,255,255,0.08); }
        .data-table { width: 100%; border-collapse: collapse; background: rgba(255,255,255,0.95); border-radius: 14px; overflow: hidden; color: #333; }
        .data-table th { background: #2d5a87; color: white; padding: 12px; text-align: left; font-size: 0.85em; letter-spacing: 0.02em; }
        .data-table td { padding: 10px 12px; border-bottom: 1px solid #eee; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 250px; }
        .data-table tr:hover { background: rgba(0,122,255,0.06); cursor: pointer; }
        .btn-back { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: white; padding: 8px 20px; border-radius: 10px; cursor: pointer; margin-bottom: 20px; transition: all 0.2s ease; }
        .btn-back:hover { background: rgba(255,255,255,0.15); }
        .detail-card { background: rgba(255,255,255,0.95); border-radius: 14px; padding: 25px; color: #333; text-align: left; }
        .detail-card h2 { color: #1d1d1f; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid rgba(0,0,0,0.1); font-weight: 600; font-size: 1.2em; }
        .detail-row { display: flex; padding: 8px 0; border-bottom: 1px solid #eee; }
        .detail-label { width: 150px; font-weight: bold; color: #666; }
        .detail-value { flex: 1; }
        .tab-container { margin-top: 20px; }
        .tab-buttons { display: inline-flex; margin-bottom: 15px; background: rgba(0,0,0,0.06); border-radius: 10px; padding: 2px; }
        .tab-buttons > * + * { margin-left: 2px; }
        .tab-btn { padding: 8px 18px; border: none; background: transparent; cursor: pointer; border-radius: 8px; font-size: 0.9em; font-weight: 500; color: #666; transition: all 0.2s ease; }
        .tab-btn.active { background: #fff; color: #1d1d1f; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }
        .tab-content { display: none; background: rgba(255,255,255,0.95); padding: 15px; border-radius: 14px; }
        .tab-content-active { display: block; background: rgba(255,255,255,0.95); padding: 15px; border-radius: 14px; }
        /* 入力フォーム用スタイル */
        .form-card { background: rgba(255,255,255,0.95); border-radius: 14px; padding: 25px; color: #333; text-align: left; max-width: 700px; margin: 0 auto; }
        .form-card h2 { color: #1d1d1f; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid rgba(0,0,0,0.1); font-weight: 600; font-size: 1.2em; }
        /* Danger Zone (GitHub風) */
        .danger-zone { border: 1px solid #d1242f; border-radius: 14px; padding: 24px; margin-top: 24px; max-width: 700px; margin-left: auto; margin-right: auto; }
        .danger-zone-heading { color: #d1242f; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid rgba(209,36,47,0.3); font-weight: 600; font-size: 1.2em; }
        .danger-zone-item { display: flex; align-items: center; justify-content: space-between; }
        .danger-zone-desc { flex: 1; }
        .danger-zone-title { font-weight: 600; margin-bottom: 4px; }
        .danger-zone-text { font-size: 0.85em; opacity: 0.7; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; font-weight: bold; color: #666; margin-bottom: 5px; }
        .form-group input, .form-group textarea { width: 100%; padding: 10px 12px; border: 1px solid #ddd; border-radius: 10px; font-size: 1em; transition: border-color 0.2s ease, background 0.2s ease; }
        .form-group select { width: 100%; padding: 8px 10px; border: 1px solid #ddd; font-size: 1em; }
        .form-group input:focus, .form-group textarea:focus { outline: none; border-color: #007aff; box-shadow: none; }
        .form-group select:focus { outline: none; border-color: #007aff; }
        .badge-required, .badge-optional { display: inline-block; font-size: 0.7em; font-weight: bold; padding: 1px 6px; border-radius: 6px; margin-left: 6px; vertical-align: middle; line-height: 1.4; }
        .badge-required { background: #e53935; color: #fff; }
        .badge-optional { background: #9e9e9e; color: #fff; }
        .primary-star { color: #bbb; margin-right: 4px; }
        .primary-star.active { color: #f5a623; }
        .form-row { display: flex; }
        .form-row > * + * { margin-left: 16px; }
        .form-row .form-group { flex: 1; }
        .form-buttons { margin-top: 25px; text-align: center; }
        .btn { padding: 12px 30px; border: none; border-radius: 10px; font-size: 1em; cursor: pointer; margin: 0 5px; font-weight: 500; transition: all 0.2s ease; }
        .btn-primary { background: #007aff; color: white; }
        .btn-primary:hover { background: #0066d6; }
        .btn-success { background: #34c759; color: white; }
        .btn-success:hover { background: #2db84e; }
        .btn-danger { background: #ff3b30; color: white; }
        .btn-danger:hover { background: #e0352b; }
        .btn-secondary { background: #8e8e93; color: white; }
        .btn-secondary:hover { background: #7c7c82; }
        .btn-add { background: #007aff; color: white; padding: 8px 20px; border: none; border-radius: 10px; cursor: pointer; margin-bottom: 15px; font-weight: 500; transition: all 0.2s ease; }
        .btn-add:hover { background: #0066d6; }
        .message { padding: 10px 15px; border-radius: 10px; margin-bottom: 15px; }
        .message.success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .message.error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
        .action-buttons { display: flex; margin-bottom: 15px; }
        .action-buttons > * + * { margin-left: 10px; }
        /* モーダルダイアログ */
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); z-index: 9999; }
        .modal-dialog { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: #fff; border-radius: 16px; padding: 28px; min-width: 400px; max-width: 500px; box-shadow: 0 12px 40px rgba(0,0,0,0.2); }
        .modal-title { font-size: 1.2em; font-weight: 600; color: #1d1d1f; margin-bottom: 15px; padding-bottom: 10px; border-bottom: 1px solid rgba(0,0,0,0.1); }
        .modal-body { margin-bottom: 20px; color: #333; }
        .modal-body input, .modal-body textarea { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 10px; font-size: 1em; margin-top: 10px; transition: border-color 0.2s ease; }
        .modal-body input:focus, .modal-body textarea:focus { outline: none; border-color: #007aff; }
        .modal-footer { text-align: right; }
        .modal-footer button { padding: 10px 25px; border: none; border-radius: 10px; font-size: 1em; cursor: pointer; margin-left: 10px; transition: all 0.2s ease; }

        /* ============================================================
           テーマ対応ユーティリティクラス
           ※ テーマ色の変更はここだけで完結する
           ============================================================ */
        /* --- テキスト色 --- */
        .tc          { color: #333; }     /* メインテキスト */
        .tc-sub      { color: #666; }     /* サブテキスト */
        .tc-muted    { color: #999; }     /* 控えめテキスト */
        .tc-accent   { color: #2d5a87; }  /* アクセント（ブランド色） */
        .tc-info     { color: #4a90d9; }  /* 情報系ブルー */
        .tc-sun      { color: #e44; }     /* 日曜 */
        .tc-sat      { color: #44e; }     /* 土曜 */
        /* --- 背景色 --- */
        .bg-surface  { background: #fff; }          /* カード/パネル面 */
        .bg-subtle   { background: #f5f5f5; }       /* 控えめ背景 */
        .bg-info     { background: #e8f4ff; }        /* 情報背景 */
        .bg-table-header { background: #f0f0f0; }   /* テーブルヘッダー（サブ） */
        .bg-row-inactive { background: #f5f5f5; }   /* 非活性行 */
        .bg-row-warn { background: #fff8e0; }        /* 警告行 */
        .bg-row-error { background: #ffe0e0; }       /* エラー行 */
        /* --- ボーダー --- */
        .border-light  { border-color: #ccc; }
        .border-subtle { border-color: #ddd; }
        /* --- 検索フォーム部品 --- */
        .search-label { color: #333; font-size: 0.9em; }
        .search-label-bold { color: #333; font-size: 0.9em; font-weight: bold; }
        .search-date-box { display: flex; align-items: center; padding: 8px 12px; border: 1px solid rgba(0,122,255,0.3); border-radius: 10px; background: rgba(0,122,255,0.06); }
        .search-date-box > * + * { margin-left: 10px; }
        .search-items-box { display: flex; flex-wrap: wrap; max-width: 500px; padding: 10px; border: 1px solid #ccc; border-radius: 10px; background: #fff; max-height: 150px; overflow-y: auto; }
        .search-items-box > * { margin: 2px 5px 2px 0; }
        .item-chip { display: inline-flex; align-items: center; padding: 4px 10px; border: 1px solid #ddd; border-radius: 8px; background: #f9f9f9; cursor: pointer; font-size: 0.85em; white-space: nowrap; color: #333; }
        .item-chip > * + * { margin-left: 3px; }
        /* --- タブコンテンツ --- */
        .tab-pane { background: rgba(255,255,255,0.95); padding: 15px; border-radius: 14px; }
        /* --- 説明テキスト --- */
        .text-desc   { font-size: 13px; color: #666; }
        .text-note   { font-size: 0.9em; color: #666; }
        /* --- マスター設定ボタン --- */
        .master-btn  { background: rgba(255,255,255,0.06); color: inherit; border: 1px solid rgba(255,255,255,0.08); }
        /* --- カレンダー --- */
        .cal-popup   { background: #fff; border: 2px solid #4a90d9; border-radius: 5px; padding: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.2); }
        .cal-title   { font-weight: bold; color: #333; }
        .cal-header  { background: #4a90d9; color: #fff; }
        .cal-day     { color: #333; cursor: pointer; }
        .cal-day-today { background: #ffe0e0; font-weight: bold; }
        .cal-day-selected { background: #4a90d9; color: #fff; }
        .cal-nav-btn { background: none; border: 1px solid #ccc; cursor: pointer; color: #333; }
        /* --- フォームパネル --- */
        .form-panel  { background: #fff; padding: 15px; border-radius: 14px; }
        .form-panel .form-group { margin-bottom: 12px; }
        .form-panel .form-group label { display: block; font-weight: bold; color: #666; margin-bottom: 4px; }
        .form-panel .form-group input,
        .form-panel .form-group select,
        .form-panel .form-group textarea { padding: 8px 10px; border: 1px solid #ddd; border-radius: 10px; font-size: 1em; transition: border-color 0.2s ease; }
        .form-panel .form-group input:focus,
        .form-panel .form-group select:focus { outline: none; border-color: #007aff; box-shadow: none; }
        body.theme-dark .form-panel .form-group label { color: #aaa; }
        body.theme-dark .form-panel .form-group input,
        body.theme-dark .form-panel .form-group select,
        body.theme-dark .form-panel .form-group textarea { background: #2f3b44; color: #e7e9ea; border-color: #38444d; }
        body.theme-dark .form-panel .form-group input:focus,
        body.theme-dark .form-panel .form-group select:focus { border-color: #5c9fd4; box-shadow: 0 0 4px rgba(92,159,212,0.3); }
        /* --- ステータステキスト --- */
        .tc-success  { color: green; }
        .tc-error    { color: #e53935; }
        .tc-warn     { color: #f57c00; }
        /* --- 品目マーク（デフォルト色はデフォルトテーマ用、テーマ別はtheme-light/darkで上書き） --- */
        .mark-transfer { color: #1565c0; }
        .mark-handling { color: #2e7d32; }
        .mark-none     { color: #bdbdbd; }
        /* --- 品目チップ（読み取り専用グリッド表示用） --- */
        .item-badge          { display: inline-flex; align-items: center; padding: 4px 8px; border-radius: 4px; font-size: 12px; margin: 2px 5px 2px 0; }
        .item-badge > * + * { margin-left: 3px; }
        .item-badge.transfer { background: #e8f5e9; border: 1px solid #a5d6a7; color: #2e7d32; }
        .item-badge.handling { background: #e3f2fd; border: 1px solid #90caf9; color: #1565c0; }
        .item-badge.none     { background: #f5f5f5; border: 1px solid #e0e0e0; color: #999; }
        /* --- 品目編集テーブル --- */
        .item-edit-th  { padding: 3px 5px; font-size: 11px; text-align: center; border: 1px solid #ddd; writing-mode: vertical-rl; height: 60px; }
        .item-edit-td  { text-align: center; padding: 5px 3px; border: 1px solid #ddd; cursor: pointer; }
        .item-edit-th-hz { padding: 6px 4px; font-size: 0.75em; text-align: center; border: 1px solid #ddd; vertical-align: top; }
        .item-edit-td-hz { text-align: center; padding: 8px 4px; border: 1px solid #ddd; cursor: pointer; }
        /* --- 自動設定フィールド --- */
        .prev-row    { background: #f8f8f8; padding: 8px; border-radius: 4px; margin-bottom: 10px; }
        .auto-label  { font-size: 11px; color: #888; }
        .readonly-input { background: #e9e9e9; color: #666; }
        .admin-link  { font-size: 11px; color: #999; }
        /* --- タイムライン --- */
        .timeline-hint { font-weight: normal; font-size: 12px; color: #888; }
        .timeline-warn { color: #e53935; font-size: 12px; margin-bottom: 10px; }
        /* --- 設定グループ --- */
        .settings-group { margin-bottom: 15px; }
        .settings-group-title { font-size: 0.85em; font-weight: bold; color: #999; margin-bottom: 8px; padding-bottom: 4px; border-bottom: 1px solid rgba(255,255,255,0.15); text-transform: uppercase; letter-spacing: 0.05em; }
        body.theme-light .settings-group-title { color: #666; border-bottom-color: #ddd; }
        body.theme-dark .settings-group-title { color: #888; border-bottom-color: #2f3b44; }
        /* --- セクション見出し --- */
        .section-heading { color: #2d5a87; font-size: 14px; margin-bottom: 10px; }
        .section-heading-bordered { color: #2d5a87; margin: 0 0 15px 0; border-bottom: 2px solid #2d5a87; padding-bottom: 5px; }
        /* --- 小ボタン --- */
        .btn-close-sm { background: #999; color: #fff; border: none; padding: 4px 12px; border-radius: 3px; cursor: pointer; font-size: 12px; }
        /* --- 境界ピッカー月タイトル --- */
        .bp-month-title { text-align: center; font-weight: bold; color: #f57c00; font-size: 14px; }
        /* --- 情報ボックス --- */
        .info-box    { background: #e8f4ff; padding: 10px; border-radius: 5px; border: 1px solid #4a90d9; }
        /* --- 優良認定 --- */
        .excellent-star { color: gold; }
        /* --- 統計見出し --- */
        .stats-heading { color: #fff; margin-bottom: 20px; }
        /* --- 統計チャート --- */
        .chart-panel { background: rgba(255,255,255,0.95); border-radius: 14px; padding: 20px; margin-bottom: 15px; }
        .chart-title { color: #2d5a87; margin: 0 0 10px 0; font-size: 14px; }
        .chart-label { font-size: 10px; color: #666; }
        .chart-bar   { background: linear-gradient(to top, #2d5a87, #3d7ab5); }
        /* --- ダークモード上書き --- */
        body.theme-dark .tc          { color: #e7e9ea; }
        body.theme-dark .tc-sub      { color: #8b98a5; }
        body.theme-dark .tc-muted    { color: #6e767d; }
        body.theme-dark .tc-accent   { color: #7bb3e0; }
        body.theme-dark .tc-info     { color: #90caf9; }
        body.theme-dark .tc-sun      { color: #ff6b6b; }
        body.theme-dark .tc-sat      { color: #6b8bff; }
        body.theme-dark .bg-surface  { background: #192734; }
        body.theme-dark .bg-subtle   { background: #192734; }
        body.theme-dark .bg-info     { background: #1a2a3e; }
        body.theme-dark .bg-table-header { background: #1e2d3d; }
        body.theme-dark .bg-row-inactive { background: #22303c; }
        body.theme-dark .bg-row-warn { background: #2e2a1a; }
        body.theme-dark .bg-row-error { background: #2e1a1e; }
        body.theme-dark .border-light  { border-color: #38444d; }
        body.theme-dark .border-subtle { border-color: #2f3b44; }
        body.theme-dark .search-label      { color: #ccc; }
        body.theme-dark .search-label-bold { color: #ccc; }
        body.theme-dark .search-date-box   { border-color: rgba(29,155,240,0.3); background: rgba(29,155,240,0.08); }
        body.theme-dark .search-items-box  { border-color: #38444d; background: #192734; }
        body.theme-dark .item-chip   { border-color: #38444d; background: #192734; color: #e7e9ea; }
        body.theme-dark .tab-pane    { background: #192734; border-radius: 14px; }
        body.theme-dark .text-desc   { color: #999; }
        body.theme-dark .text-note   { color: #999; }
        body.theme-dark .master-btn  { background: rgba(255,255,255,0.05); color: #e7e9ea; border: 1px solid rgba(255,255,255,0.08); }
        body.theme-dark .cal-popup   { background: #192734; border-color: #5c9fd4; }
        body.theme-dark .cal-title   { color: #90caf9; }
        body.theme-dark .cal-header  { background: #1a3a5e; }
        body.theme-dark .cal-day     { color: #e7e9ea; }
        body.theme-dark .cal-day-today { background: #3a2020; }
        body.theme-dark .cal-day-selected { background: #2d5a87; color: #fff; }
        body.theme-dark .cal-nav-btn { border-color: #38444d; color: #e7e9ea; }
        body.theme-dark .form-panel  { background: #192734; }
        body.theme-dark .tc-success  { color: #66bb6a; }
        body.theme-dark .tc-error    { color: #ef5350; }
        body.theme-dark .tc-warn     { color: #ffb74d; }
        body.theme-dark .mark-transfer { color: #64b5f6; }
        body.theme-dark .mark-handling { color: #66bb6a; }
        body.theme-dark .mark-none   { color: #555; }
        body.theme-dark .item-badge.transfer { background: #1a3a2a; border-color: #2e5a3e; color: #66bb6a; }
        body.theme-dark .item-badge.handling { background: #1a2a3e; border-color: #2a4a6e; color: #64b5f6; }
        body.theme-dark .item-badge.none     { background: #22303c; border-color: #2f3b44; color: #666; }
        body.theme-dark .item-edit-th  { border-color: #38444d; }
        body.theme-dark .item-edit-td  { border-color: #38444d; }
        body.theme-dark .prev-row    { background: #1e2d3d; }
        body.theme-dark .auto-label  { color: #777; }
        body.theme-dark .readonly-input { background: #1e2d3d; color: #888; }
        body.theme-dark .admin-link  { color: #777; }
        body.theme-dark .timeline-hint { color: #777; }
        body.theme-dark .timeline-warn { color: #ef5350; }
        body.theme-dark .section-heading { color: #7bb3e0; }
        body.theme-dark .section-heading-bordered { color: #7bb3e0; border-bottom-color: #5c9fd4; }
        body.theme-dark .btn-close-sm { background: #555; }
        body.theme-dark .bp-month-title { color: #ffb74d; }
        body.theme-dark .info-box    { background: #1a2a3e; border-color: #5c9fd4; }
        body.theme-dark .excellent-star { color: #ffd54f; }
        body.theme-dark .stats-heading { color: #e7e9ea; }
        body.theme-dark .chart-panel { background: #192734; }
        body.theme-dark .chart-title { color: #90caf9; }
        body.theme-dark .chart-label { color: #aaa; }
        body.theme-dark .chart-bar   { background: linear-gradient(to top, #1a3a5e, #3d7ab5); }
        /* ライトモード上書き（デフォルト色と同じだが明示的に定義） */
        body.theme-light .tc          { color: #333; }
        body.theme-light .tc-sub      { color: #666; }
        body.theme-light .tc-muted    { color: #999; }
        body.theme-light .tc-accent   { color: #2d5a87; }
        body.theme-light .tc-info     { color: #4a90d9; }
        body.theme-light .search-label { color: #333; }
        body.theme-light .search-label-bold { color: #333; }
        body.theme-light .search-items-box  { border-color: #ccc; background: #fff; }
        body.theme-light .item-chip   { border-color: #ddd; background: #f9f9f9; color: #333; }
        body.theme-light .mark-transfer { color: #1565c0; }
        body.theme-light .mark-handling { color: #2e7d32; }
        body.theme-light .mark-none   { color: #bdbdbd; }
        body.theme-light .item-badge.transfer { background: #e8f5e9; border-color: #a5d6a7; color: #2e7d32; }
        body.theme-light .item-badge.handling { background: #e3f2fd; border-color: #90caf9; color: #1565c0; }
        body.theme-light .item-badge.none     { background: #f5f5f5; border-color: #e7e9ea; color: #999; }

        /* テーマ: ライトモード */
        body.theme-light {
            background: #f5f5f7;
            color: #1d1d1f;
        }
        body.theme-light .menu-button {
            background: #fff;
            border: 1px solid rgba(0,0,0,0.04);
            color: #1d1d1f;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        }
        body.theme-light .menu-button:hover {
            background: #fff;
            box-shadow: 0 8px 28px rgba(0,0,0,0.12);
        }
        body.theme-light .menu-button .menu-desc { color: #86868b; }
        body.theme-light h1, body.theme-light h2, body.theme-light h3 {
            color: #1d1d1f;
        }
        body.theme-light .search-box {
            background: #fff;
            border: 1px solid rgba(0,0,0,0.06);
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        }
        /* quickSearchKeyword: テーマ対応は .home-search-input クラスで管理 */
        body.theme-light .search-box input[type='text'] {
            border: 1px solid rgba(0,0,0,0.1);
            background: rgba(0,0,0,0.03);
            color: #1d1d1f;
        }
        body.theme-light .search-box select {
            border: 1px solid rgba(0,0,0,0.1);
            background: #fff;
            color: #1d1d1f;
        }
        body.theme-light .data-table { box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        body.theme-light .btn-back {
            background: rgba(0,0,0,0.04);
            border: 1px solid rgba(0,0,0,0.06);
            color: #1d1d1f;
        }
        body.theme-light .btn-back:hover {
            background: rgba(0,0,0,0.08);
        }
        body.theme-light .status-bar {
            background: rgba(255,255,255,0.85);
            color: #86868b;
            border-top: 1px solid rgba(0,0,0,0.06);
        }
        body.theme-light .search-box label {
            color: #1d1d1f;
        }
        body.theme-light .subtitle {
            color: #86868b;
        }
        body.theme-light .stats-strip { background: #fff; box-shadow: 0 1px 6px rgba(0,0,0,0.06); }
        body.theme-light .stat-item + .stat-item { border-left-color: rgba(0,0,0,0.08); }
        body.theme-light .stat-value { color: #1d1d1f; }
        body.theme-light .stat-label { color: #86868b; }
        body.theme-light .stat-warn .stat-value { color: #ff9500; }
        body.theme-light .menu-group-label { color: #86868b; opacity: 1; }
        body.theme-light .icon-search { background: rgba(0,122,255,0.08); }
        body.theme-light .icon-manage { background: rgba(52,199,89,0.08); }
        body.theme-light .detail-card, body.theme-light .form-card { background: #fff; color: #333; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        body.theme-light .detail-card h2, body.theme-light .form-card h2 { color: #1d1d1f; border-bottom-color: rgba(0,0,0,0.08); }
        body.theme-light .tab-buttons { background: rgba(0,0,0,0.06); }
        body.theme-light .tab-btn { color: #86868b; }
        body.theme-light .tab-btn.active { background: #fff; color: #1d1d1f; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }
        body.theme-light .master-btn { background: #fff; color: #1d1d1f; border: 1px solid rgba(0,0,0,0.04); box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        body.theme-light .modal-title { color: #1d1d1f; border-bottom-color: rgba(0,0,0,0.08); }
        /* テーマ: ダークモード */
        body.theme-dark {
            background: #15202b;
            color: #e7e9ea;
        }
        body.theme-dark .menu-button {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
            color: #e7e9ea;
        }
        body.theme-dark .menu-button:hover {
            background: rgba(255,255,255,0.1);
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
        }
        body.theme-dark .menu-button .menu-desc { color: #86868b; }
        body.theme-dark .search-box {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.08);
        }
        body.theme-dark .btn-back {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.1);
            color: #e7e9ea;
        }
        body.theme-dark .status-bar {
            background: #101a23;
            border-top: 1px solid #2f3b44;
        }
        body.theme-dark .detail-card, body.theme-dark .form-card {
            background: #192734;
            color: #e7e9ea;
        }
        body.theme-dark .detail-card h2, body.theme-dark .form-card h2 {
            color: #e7e9ea;
            border-bottom-color: rgba(255,255,255,0.1);
        }
        body.theme-dark .danger-zone { background: rgba(209,36,47,0.06); border-color: rgba(209,36,47,0.5); }
        body.theme-dark .danger-zone-heading { color: #f85149; border-bottom-color: rgba(248,81,73,0.3); }
        body.theme-dark .danger-zone-title { color: #e7e9ea; }
        body.theme-dark .danger-zone-text { color: #8b949e; }
        body.theme-dark .data-table {
            background: #192734;
            color: #e7e9ea;
        }
        body.theme-dark .data-table th {
            background: #1e2d3d;
        }
        body.theme-dark .data-table td {
            border-bottom-color: #2f3b44;
        }
        body.theme-dark .data-table tr:hover {
            background: #2f3b44;
        }
        body.theme-dark .tab-buttons { background: rgba(255,255,255,0.08); }
        body.theme-dark .tab-btn {
            background: transparent;
            color: #999;
        }
        body.theme-dark .tab-btn.active {
            background: rgba(255,255,255,0.12);
            color: #e7e9ea;
            box-shadow: 0 1px 4px rgba(0,0,0,0.3);
        }
        body.theme-dark .tab-content, body.theme-dark .tab-content-active {
            background: #192734;
        }
        body.theme-dark .form-group input, body.theme-dark .form-group select, body.theme-dark .form-group textarea {
            background: #2f3b44;
            color: #e7e9ea;
            border-color: #38444d;
        }
        body.theme-dark .stats-strip { background: rgba(255,255,255,0.06); }
        body.theme-dark .stat-item + .stat-item { border-left-color: rgba(255,255,255,0.08); }
        body.theme-dark .stat-value { color: #e7e9ea; }
        body.theme-dark .stat-label { color: #86868b; }
        body.theme-dark .stat-warn .stat-value { color: #ff9f0a; }
        body.theme-dark .menu-group-label { color: #86868b; opacity: 1; }
        body.theme-dark .icon-search { background: rgba(10,132,255,0.15); }
        body.theme-dark .icon-manage { background: rgba(48,209,88,0.15); }
        /* 検索結果件数 */
        .result-count { padding: 10px 16px; border-radius: 10px; margin-bottom: 10px; font-weight: 600; font-size: 0.9em; }
        .result-count.has-results { background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; }
        .result-count.no-results { background: #fff3e0; color: #e65100; border: 1px solid #ffe0b2; }
        body.theme-dark .result-count.has-results { background: #1b3a2a; color: #66bb6a; border-color: #2e5a3e; }
        body.theme-dark .result-count.no-results { background: #3a2a1a; color: #ffb74d; border-color: #5a3a2a; }
        body.theme-light .result-count.has-results { background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; }
        body.theme-light .result-count.no-results { background: #fff3e0; color: #e65100; border: 1px solid #ffe0b2; }
        /* ローディングオーバーレイ */
        .loading-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.35); z-index: 99999; }
        .loading-overlay.active { display: flex; align-items: center; justify-content: center; }
        .loading-spinner { text-align: center; background: rgba(0,0,0,0.6); padding: 28px 36px; border-radius: 18px; }
        .loading-spinner-circle { width: 40px; height: 40px; border: 3px solid rgba(255,255,255,0.2); border-top: 3px solid #fff; border-radius: 50%; margin: 0 auto 14px; }
        .loading-spinner p { color: rgba(255,255,255,0.9); font-size: 13px; font-weight: 500; }
        /* トースト通知 */
        .toast-container { position: fixed; top: 20px; right: 20px; z-index: 100000; }
        .toast { padding: 14px 22px; border-radius: 14px; color: #fff; font-size: 0.9em; box-shadow: 0 8px 24px rgba(0,0,0,0.2); margin-bottom: 10px; max-width: 350px; cursor: pointer; }
        .toast-success { background: #34c759; }
        .toast-error { background: #ff3b30; }
        .toast-info { background: #007aff; }
        /* パンくずリスト */
        .breadcrumb-bar { position: fixed; top: 0; left: 0; right: 0; background: rgba(0,0,0,0.4); padding: 8px 20px; font-size: 0.85em; z-index: 100; color: rgba(255,255,255,0.8); }
        .breadcrumb-bar a { color: rgba(255,255,255,0.6); text-decoration: none; cursor: pointer; }
        .breadcrumb-bar a:hover { color: #fff; text-decoration: underline; }
        .breadcrumb-separator { margin: 0 8px; color: rgba(255,255,255,0.4); }
        .breadcrumb-current { color: #fff; font-weight: bold; }
        /* タブ件数バッジ */
        .tab-badge { display: inline-block; background: rgba(0,0,0,0.15); color: inherit; font-size: 0.75em; padding: 1px 6px; border-radius: 10px; margin-left: 4px; min-width: 18px; text-align: center; }
        .tab-btn.active .tab-badge { background: rgba(255,255,255,0.25); }
        body.theme-dark .tab-badge { background: rgba(255,255,255,0.1); }
        body.theme-light .tab-badge { background: rgba(0,0,0,0.1); }
        body.theme-light #btnAdvancedFilters { border-color: #ccc; color: #333; }
        body.theme-dark #btnAdvancedFilters { border-color: rgba(255,255,255,0.2); color: #e7e9ea; }
        body.theme-light .breadcrumb-bar { background: rgba(255,255,255,0.85); color: #86868b; border-bottom: 1px solid rgba(0,0,0,0.06); }
        body.theme-light .breadcrumb-bar a { color: #007aff; }
        body.theme-light .breadcrumb-bar a:hover { color: #0056b3; }
        body.theme-light .breadcrumb-separator { color: #c7c7cc; }
        body.theme-light .breadcrumb-current { color: #1d1d1f; }
        body.theme-dark .breadcrumb-bar { background: #101a23; border-bottom: 1px solid #2f3b44; }
        /* 期限バッジ */
        .badge-expiry { display: inline-block; font-size: 0.75em; font-weight: bold; padding: 2px 8px; border-radius: 3px; }
        .badge-expiry.expired { background: #ffebee; color: #c62828; border: 1px solid #ef9a9a; }
        .badge-expiry.soon { background: #fff3e0; color: #e65100; border: 1px solid #ffcc80; }
        .badge-expiry.valid { background: #e8f5e9; color: #2e7d32; border: 1px solid #a5d6a7; }
        body.theme-dark .badge-expiry.expired { background: #3a1a1e; color: #ef5350; border-color: #5a2a2e; }
        body.theme-dark .badge-expiry.soon { background: #3a2a1a; color: #ffb74d; border-color: #5a3a2a; }
        body.theme-dark .badge-expiry.valid { background: #1b3a2a; color: #66bb6a; border-color: #2e5a3e; }
        /* ステータスバッジ（統一） */
        .badge-status { display: inline-block; font-weight: bold; padding: 2px 8px; border-radius: 3px; font-size: 0.85em; }
        .badge-status.cancelled { background: #ffebee; color: #c62828; border: 1px solid #ef9a9a; }
        .badge-status.abolished, .badge-status.scrapped, .badge-status.retired, .badge-status.lapsed { background: #f5f5f5; color: #757575; border: 1px solid #bdbdbd; }
        .badge-status.active, .badge-status.operating, .badge-status.serving { background: #e8f5e9; color: #2e7d32; border: 1px solid #a5d6a7; }
        .badge-status-lg { font-size: 1.1em; }
        body.theme-dark .badge-status.cancelled { background: #3a1a1e; color: #ef5350; border-color: #5a2a2e; }
        body.theme-dark .badge-status.abolished, body.theme-dark .badge-status.scrapped, body.theme-dark .badge-status.retired, body.theme-dark .badge-status.lapsed { background: #22303c; color: #999; border-color: #38444d; }
        body.theme-dark .badge-status.active, body.theme-dark .badge-status.operating, body.theme-dark .badge-status.serving { background: #1b3a2a; color: #66bb6a; border-color: #2e5a3e; }
        body.theme-light .badge-status.cancelled { background: #ffebee; color: #c62828; border-color: #ef9a9a; }
        body.theme-light .badge-status.abolished, body.theme-light .badge-status.scrapped, body.theme-light .badge-status.retired, body.theme-light .badge-status.lapsed { background: #f5f5f5; color: #757575; border-color: #bdbdbd; }
        body.theme-light .badge-status.active, body.theme-light .badge-status.operating, body.theme-light .badge-status.serving { background: #e8f5e9; color: #2e7d32; border-color: #a5d6a7; }

        body.theme-dark .search-box input[type='text'] {
            background: #2f3b44;
            color: #e7e9ea;
            border: 1px solid #38444d;
        }
        body.theme-dark .search-box select {
            background: #2f3b44;
            color: #e7e9ea;
            border: 1px solid #38444d;
        }
        body.theme-dark .search-box button {
            background: #0a84ff;
        }
        body.theme-dark .search-box button:hover {
            background: #0070e0;
        }
        body.theme-dark .modal-dialog {
            background: #192734;
            color: #e7e9ea;
        }
        body.theme-dark .modal-title {
            color: #f5f5f7;
            border-bottom-color: rgba(255,255,255,0.1);
        }
        body.theme-dark .modal-body { color: #e7e9ea; }
        body.theme-dark .modal-body input, body.theme-dark .modal-body textarea {
            background: #2f3b44;
            color: #e7e9ea;
            border-color: #38444d;
        }
        body.theme-dark .message.success {
            background: #1a3a2e;
            color: #4CAF50;
            border-color: #2a5a3e;
        }
        body.theme-dark .message.error {
            background: #3a1a1e;
            color: #f44336;
            border-color: #5a2a2e;
        }
        body.theme-dark .detail-row {
            border-bottom-color: #2f3b44;
        }
        body.theme-dark .detail-label {
            color: #999;
        }
        body.theme-dark .menu-grid .menu-button span {
            color: inherit;
        }

        /* 日付ピッカー */
        .datepicker-wrapper { position: relative; display: inline-block; }
        .cal-trigger-btn { background: none; border: 1px solid rgba(0,0,0,0.1); border-radius: 8px; padding: 4px 8px; cursor: pointer; font-size: 0.85em; color: #007aff; margin-left: 4px; vertical-align: middle; }
        .cal-trigger-btn:hover { background: rgba(0,122,255,0.08); }
        .datepicker-input { cursor: pointer; background: #fff !important; }
        .datepicker-popup {
            position: absolute; top: 100%; left: 0; z-index: 10000;
            background: #fff; border: 2px solid #2d5a87; border-radius: 5px;
            padding: 10px; width: 250px;
        }
        body.theme-dark .datepicker-input { background: #2f3b44 !important; color: #e7e9ea; }
        body.theme-dark .datepicker-popup { background: #192734; border-color: #5c9fd4; }

        /* トグルスイッチ */
        .toggle-switch { position: relative; display: inline-block; width: 40px; height: 22px; vertical-align: middle; }
        .toggle-switch input { display: none; }
        .toggle-slider {
            position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
            background-color: #ccc; border-radius: 22px; transition: 0.3s;
        }
        .toggle-slider:before {
            position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px;
            background-color: white; border-radius: 50%; transition: 0.3s;
        }
        .toggle-switch input:checked + .toggle-slider { background-color: #007aff; }
        .toggle-switch input:checked + .toggle-slider:before { transform: translateX(18px); }
        body.theme-dark .toggle-switch input:checked + .toggle-slider { background-color: #0a84ff; }

        /* タイムライン */
        .timeline-section { background: rgba(255,255,255,0.95); border-radius: 8px; padding: 15px 20px; margin-bottom: 15px; color: #333; }
        body.theme-dark .timeline-section { background: #192734; color: #e7e9ea; }
        .timeline-section h4 { color: #2d5a87; margin: 0 0 12px 0; font-size: 14px; }
        body.theme-dark .timeline-section h4 { color: #90caf9; }
        .timeline-bar-area { position: relative; height: 48px; background: #e8eef4; border-radius: 4px; margin-top: 28px; margin-bottom: 4px; }
        body.theme-dark .timeline-bar-area { background: #22303c; }
        .timeline-bar {
            position: absolute; top: 4px; height: 40px; border-radius: 3px;
            display: flex; align-items: center; justify-content: center;
            font-size: 11px; color: #fff; font-weight: bold; overflow: hidden;
            text-overflow: ellipsis; white-space: nowrap; padding: 0 4px;
            min-width: 2px;
        }
        .timeline-bar.active { background: #4CAF50; }
        .timeline-bar.expired { background: #90CAF9; color: #1a3a5c; }
        .timeline-bar.cancelled { background: #ef5350; }
        .timeline-bar.abolished { background: #9e9e9e; }
        .timeline-dates { display: flex; justify-content: space-between; font-size: 11px; color: #888; margin-bottom: 10px; }
        body.theme-dark .timeline-dates { color: #777; }
        .timeline-boundary {
            position: absolute; top: 0; width: 20px; height: 48px; margin-left: -10px;
            cursor: pointer; z-index: 10;
        }
        .timeline-boundary:hover .boundary-line { background: #f57c00; }
        .timeline-boundary:hover .boundary-label { color: #f57c00; border-color: #f57c00; }
        .boundary-line {
            position: absolute; left: 9px; top: 0; width: 2px; height: 48px;
            background: #2d5a87; transition: background 0.15s;
        }
        .boundary-label {
            position: absolute; bottom: 50px; left: 50%; transform: translateX(-50%);
            background: #fff; border: 1px solid #2d5a87; border-radius: 4px;
            padding: 2px 8px; font-size: 11px; color: #2d5a87; font-weight: bold;
            white-space: nowrap; cursor: pointer; transition: all 0.15s;
        }
        body.theme-dark .boundary-label { background: #22303c; border-color: #5c9fd4; color: #90caf9; }
        .boundary-label:hover { background: #fff3e0; }
        body.theme-dark .boundary-label:hover { background: #3d3020; }
        .boundary-picker-popup {
            position: absolute; bottom: 52px; left: 50%; transform: translateX(-50%);
            z-index: 10000; background: #fff; border: 2px solid #f57c00; border-radius: 6px;
            padding: 10px; width: 260px; box-shadow: 0 -4px 16px rgba(0,0,0,0.2);
        }
        body.theme-dark .boundary-picker-popup { background: #192734; border-color: #f57c00; }
        .boundary-picker-popup td { color: #333; }
        body.theme-dark .boundary-picker-popup td { color: #e7e9ea; }
        .bp-day { text-align: center; padding: 5px; cursor: pointer; font-size: 13px; }
        .bp-day:hover { background: #fff3e0; }
        body.theme-dark .bp-day:hover { background: #3d3020; }
        .bp-day.disabled { color: #ccc !important; cursor: default; }
        body.theme-dark .bp-day.disabled { color: #555 !important; }
        .bp-day.disabled:hover { background: none; }
        .bp-day.selected { background: #f57c00; color: #fff !important; border-radius: 3px; }
        .bp-day.today { border: 1px solid #f57c00; font-weight: bold; }

        /* 許可詳細ビュー - マークダウン的デザイン */
        .permit-detail { max-width: 720px; margin: 0 auto; line-height: 1.7; color: #333; }
        /* ステップインジケーター */
        .step-nav { display: flex; align-items: center; margin-bottom: 20px; }
        .step-nav-steps { display: flex; align-items: center; }
        .step-nav-right { margin-left: auto; }
        .step-nav-right a { color: #4a90d9; cursor: pointer; text-decoration: none; font-size: 13px; }
        .step-nav-right a:hover { text-decoration: underline; }
        .step-nav-step { display: flex; align-items: center; cursor: default; }
        a.step-nav-step { cursor: pointer; text-decoration: none; }
        a.step-nav-step:hover .step-dot.past { background: #0055cc; }
        a.step-nav-step:hover .step-label.past { color: #0055cc; }
        .step-dot {
            width: 22px; height: 22px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: 600;
            flex-shrink: 0;
        }
        .step-dot.past { background: #007aff; color: #fff; }
        .step-dot.current { background: #007aff; color: #fff; box-shadow: 0 0 0 3px rgba(0,122,255,0.2); }
        .step-dot.future { background: #e0e0e0; color: #999; }
        .step-label { font-size: 12px; margin-left: 5px; font-weight: 500; }
        .step-label.past { color: #007aff; }
        .step-label.current { color: #1a1a1a; font-weight: 600; }
        .step-label.future { color: #999; }
        .step-line { width: 32px; height: 2px; margin: 0 8px; flex-shrink: 0; }
        .step-line.done { background: #007aff; }
        .step-line.pending { background: #e0e0e0; }
        .permit-detail-title {
            font-size: 22px; font-weight: 700; color: #1a1a1a; margin: 0 0 4px 0;
            display: flex; align-items: center;
        }
        .permit-detail-title > * + * { margin-left: 10px; }
        .permit-detail-subtitle { font-size: 13px; color: #888; margin-bottom: 4px; }
        .permit-detail hr { border: none; border-top: 1px solid #ddd; margin: 18px 0; }
        .permit-section-heading {
            font-size: 15px; font-weight: 700; color: #2d5a87;
            margin: 0 0 10px 0; display: flex; align-items: center;
        }
        .permit-section-heading .heading-actions { margin-left: auto; }
        .permit-dl { margin: 0; padding: 0; }
        .permit-dl-row { display: flex; padding: 5px 0; font-size: 14px; }
        .permit-dl-label { flex: 0 0 140px; color: #888; font-weight: 400; }
        .permit-dl-value { flex: 1; font-weight: 500; color: #222; }
        .permit-section-toggle { cursor: pointer; user-select: none; }
        .permit-section-toggle:hover .permit-section-heading { color: #4a90d9; }
        .permit-lifecycle-actions { display: flex; margin-top: 8px; }
        .permit-lifecycle-actions > * + * { margin-left: 8px; }
        .btn-sm { padding: 4px 12px; font-size: 0.8em; }
        .data-table td > .btn + .btn { margin-left: 4px; }
        /* group-header: マスター一覧のセクション区切り（品目: 普通産廃/特管産廃） */
        .data-table .group-header td { background: #f0f4f8; color: #2d5a87; font-weight: 700; font-size: 0.85em; letter-spacing: 0.04em; padding: 8px 12px; border-bottom: 2px solid #2d5a87; }
        .data-table .group-header:hover { background: transparent; cursor: default; }
        body.theme-dark .data-table .group-header td { background: #1e2a36; color: #90caf9; border-bottom-color: #3a6a9b; }
        body.theme-light .data-table .group-header td { background: #e8eef5; color: #2d5a87; border-bottom-color: #2d5a87; }
        /* category-selector: 品目マスター新規追加時の種別選択 */
        .category-selector { display: flex; margin-bottom: 8px; border: 1px solid #ddd; border-radius: 10px; overflow: hidden; }
        .category-selector > * + * { border-left: 1px solid #ddd; }
        .category-selector label { flex: 1; text-align: center; padding: 10px 16px; cursor: pointer; font-weight: 600; font-size: 0.95em; color: #666; transition: background 0.2s, color 0.2s; }
        .category-selector label:hover { background: rgba(0,122,255,0.06); }
        .category-selector input[type="radio"] { display: none; }
        .category-selector input[type="radio"]:checked + span { color: #fff; }
        .category-selector label.selected { background: #2d5a87; color: #fff; }
        body.theme-dark .category-selector { border-color: #38444d; }
        body.theme-dark .category-selector > * + * { border-left-color: #38444d; }
        body.theme-dark .category-selector label { color: #aaa; }
        body.theme-dark .category-selector label:hover { background: rgba(92,159,212,0.1); }
        body.theme-dark .category-selector label.selected { background: #3a6a9b; color: #fff; }
        .category-badge { display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 0.8em; font-weight: 600; }
        .category-badge-normal { background: #e3f2fd; color: #1565c0; }
        .category-badge-special { background: #fce4ec; color: #c62828; }
        body.theme-dark .category-badge-normal { background: #1a3a5c; color: #90caf9; }
        body.theme-dark .category-badge-special { background: #3c1a1e; color: #ef9a9a; }
        /* inline-table: JS生成テーブル用（許可履歴タイムライン、処理能力統計） */
        .inline-table { border-collapse: collapse; font-size: 13px; }
        .inline-table th, .inline-table td { padding: 6px 8px; border: 1px solid #ddd; }
        body.theme-dark .inline-table th, body.theme-dark .inline-table td { border-color: #38444d; }
        /* action-box: ライフサイクル操作コンテナ（廃止・取消） */
        .action-box { border: 1px solid #ddd; border-radius: 8px; padding: 15px; }
        body.theme-dark .action-box { border-color: #38444d; }
        /* search-result-item: クイック検索結果の行 */
        .search-result-item { padding: 8px 12px; cursor: pointer; border-bottom: 1px solid #eee; }
        .search-result-item:hover { background: #e8f4ff; }
        body.theme-dark .search-result-item { border-bottom-color: #2f3b44; }
        body.theme-dark .search-result-item:hover { background: #1a2a3e; }
        .btn-md { padding: 5px 14px; font-size: 0.9em; }
        .btn-warning { background: #ff9800; color: white; }
        .btn-warning:hover { background: #f57c00; }
        body.theme-dark .btn-warning { background: #e68900; }
        /* dark theme */
        body.theme-dark .permit-detail { color: #e7e9ea; }
        body.theme-dark .permit-detail-title { color: #e7e9ea; }
        body.theme-dark .permit-detail-subtitle { color: #777; }
        body.theme-dark .permit-detail hr { border-top-color: rgba(200,200,200,0.15); }
        body.theme-dark .permit-section-heading { color: #90caf9; }
        body.theme-dark .permit-dl-label { color: #777; }
        body.theme-dark .permit-dl-value { color: #e7e9ea; }
        body.theme-dark .step-dot.past { background: #0a84ff; }
        body.theme-dark .step-dot.current { background: #0a84ff; box-shadow: 0 0 0 3px rgba(10,132,255,0.25); }
        body.theme-dark .step-dot.future { background: #444; color: #777; }
        body.theme-dark .step-label.past { color: #90caf9; }
        body.theme-dark .step-label.current { color: #e7e9ea; }
        body.theme-dark .step-label.future { color: #666; }
        body.theme-dark .step-line.done { background: #0a84ff; }
        body.theme-dark .step-line.pending { background: #444; }
        body.theme-dark .step-nav-right a { color: #90caf9; }
        /* light theme */
        body.theme-light .permit-section-heading { color: #2d5a87; }
        body.theme-light .permit-detail-title { color: #1a1a1a; }

        /* ===== ダッシュボード メトリクスカード ===== */
        .dashboard-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-bottom: 14px; }
        .dashboard-grid > * { margin: 6px; }
        .dash-card {
            background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px; padding: 14px 10px; text-align: center;
            transition: all 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
        }
        .dash-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-1px); }
        .dash-card-label { font-size: 0.72em; opacity: 0.6; margin-bottom: 4px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; }
        .dash-card-value { font-size: 1.6em; font-weight: 300; letter-spacing: -0.02em; }
        .dash-card-warn { background: rgba(255,160,0,0.12); border-color: rgba(255,160,0,0.2); cursor: pointer; }
        .dash-card-warn:hover { background: rgba(255,160,0,0.2); }
        body.theme-light .dash-card { background: #fff; border: 1px solid rgba(0,0,0,0.06); color: #333; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        body.theme-light .dash-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.1); }
        body.theme-light .dash-card-warn { background: #fff8f0; border-color: rgba(255,160,0,0.2); }
        body.theme-light .dash-card-warn:hover { background: #fff3e0; }
        body.theme-dark .dash-card { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.08); }
        body.theme-dark .dash-card:hover { background: rgba(255,255,255,0.08); }
        body.theme-dark .dash-card-warn { background: rgba(255,152,0,0.1); border-color: rgba(255,152,0,0.2); }
        body.theme-dark .dash-card-warn:hover { background: rgba(255,152,0,0.18); }

        /* ===== ホーム クイック検索 タイプ切替 ===== */
        .home-search-types { display: inline-flex; justify-content: center; margin-bottom: 8px; background: rgba(255,255,255,0.08); border-radius: 8px; padding: 2px; }
        .home-search-types > * + * { margin-left: 2px; }
        .search-type-btn {
            padding: 4px 16px; border-radius: 6px; border: none;
            background: transparent; color: rgba(255,255,255,0.6); cursor: pointer; font-size: 0.8em;
            transition: all 0.2s ease; font-weight: 500;
        }
        .search-type-btn.active { background: rgba(255,255,255,0.18); color: #fff; box-shadow: 0 1px 4px rgba(0,0,0,0.15); }
        body.theme-light .home-search-types { background: rgba(0,0,0,0.05); }
        body.theme-light .search-type-btn { color: #888; }
        body.theme-light .search-type-btn.active { background: #fff; color: #333; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }
        body.theme-dark .home-search-types { background: rgba(255,255,255,0.06); }
        body.theme-dark .search-type-btn { color: rgba(255,255,255,0.5); }
        body.theme-dark .search-type-btn.active { background: rgba(255,255,255,0.12); color: #fff; }

        /* ===== ホーム検索バー ===== */
        .home-search-input {
            width: 400px; padding: 10px 18px; border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px; font-size: 0.9em; background: rgba(255,255,255,0.08);
            color: #fff; transition: all 0.2s ease; outline: none;
        }
        .home-search-input:focus { background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.2); }
        .home-search-input::placeholder { color: rgba(255,255,255,0.4); }
        .home-search-btn {
            padding: 10px 24px; border: none; border-radius: 12px;
            background: rgba(255,255,255,0.15); color: white; cursor: pointer;
            font-size: 0.9em; font-weight: 500; transition: all 0.2s ease;
        }
        .home-search-btn:hover { background: rgba(255,255,255,0.22); }
        body.theme-light .home-search-input {
            background: rgba(0,0,0,0.04); color: #1d1d1f; border-color: transparent;
        }
        body.theme-light .home-search-input:focus { background: rgba(0,0,0,0.06); border-color: rgba(0,0,0,0.1); }
        body.theme-light .home-search-input::placeholder { color: #86868b; }
        body.theme-light .home-search-btn { background: #007aff; color: #fff; }
        body.theme-light .home-search-btn:hover { background: #0066d6; }
        body.theme-dark .home-search-input {
            background: rgba(255,255,255,0.06); color: #f5f5f7; border-color: rgba(255,255,255,0.08);
        }
        body.theme-dark .home-search-input:focus { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.15); }
        body.theme-dark .home-search-input::placeholder { color: rgba(255,255,255,0.35); }
        body.theme-dark .home-search-btn { background: rgba(255,255,255,0.1); }
        body.theme-dark .home-search-btn:hover { background: rgba(255,255,255,0.16); }

        /* ===== 確認ダイアログ（既存モーダルスタイル流用） ===== */
        .confirm-body { color: #333; white-space: pre-wrap; line-height: 1.6; font-size: 0.95em; }
        body.theme-dark .confirm-body { color: #e7e9ea; }

        /* ===== 施設カード形式 ===== */
        .facility-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px; margin-bottom: 12px; cursor: pointer; transition: all 0.2s ease; }
        .facility-card:hover { border-color: #007aff; box-shadow: 0 2px 8px rgba(0,122,255,0.1); }
        .facility-card.abolished { opacity: 0.6; }
        .facility-card-header { display: flex; align-items: center; margin-bottom: 8px; }
        .facility-card-header > * + * { margin-left: 12px; }
        .facility-card-title { font-weight: 600; font-size: 1em; color: #1d1d1f; }
        .facility-card-sub { font-size: 0.85em; color: #888; }
        .facility-card-col-label { font-size: 0.75em; color: #999; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 4px; font-weight: 600; text-align: left; }
        body.theme-dark .facility-card { background: #1a2a40; border-color: #2a3a50; }
        body.theme-dark .facility-card:hover { border-color: #4a9eff; box-shadow: 0 2px 8px rgba(74,158,255,0.15); }
        body.theme-dark .facility-card-title { color: #e7e9ea; }
        body.theme-dark .facility-card-sub { color: #8899aa; }
        body.theme-dark .facility-card-col-label { color: #7799bb; }

        /* 処理能力テーブル（カード内） */
        .capacity-table { margin: 0; border-collapse: collapse; }
        .capacity-table td { padding: 2px 10px 2px 0; font-size: 0.85em; color: #555; border: none; }
        .capacity-table .cap-name { color: #2d5a87; font-weight: 500; }
        .capacity-table .cap-value { text-align: right; font-family: 'Segoe UI', monospace; }
        body.theme-dark .capacity-table td { color: #aabbcc; }
        body.theme-dark .capacity-table .cap-name { color: #7bb3e0; }

        /* インラインフォーム要素（処理能力編集テーブル内） */
        .inline-input { padding: 4px 8px; border-radius: 8px; border: 1px solid #ddd; font-size: 0.9em; }
        .inline-input:focus { outline: none; border-color: #007aff; }
        .inline-select { padding: 4px 8px; border-radius: 8px; border: 1px solid #ddd; font-size: 0.9em; }
        .btn-delete-row { background: none; border: none; color: #ccc; cursor: pointer; font-size: 1em; padding: 2px 8px; }
        .btn-delete-row:hover { color: #ff3b30; }
        .section-divider { border-top: 1px solid #eee; padding-top: 16px; margin-top: 16px; }
        body.theme-dark .inline-input { background: #1a2a40; color: #e7e9ea; border-color: #3a4a5a; }
        body.theme-dark .inline-select { background: #1a2a40; color: #e7e9ea; border-color: #3a4a5a; }
        body.theme-dark .section-divider { border-top-color: #2a3a50; }

        /* ===== 施設詳細: B2 Apple HIG Grouped Detail ===== */
        .b2-header { margin-bottom: 24px; }
        .b2-title { font-size: 1.6em; font-weight: 700; letter-spacing: -0.025em; color: #1d1d1f; line-height: 1.2; }
        .b2-location { font-size: 0.9em; font-weight: 400; color: #86868b; margin-top: 4px; line-height: 1.4; }
        .b2-badges { display: flex; margin-top: 12px; }
        .b2-badges > * + * { margin-left: 8px; }
        .b2-pill { display: inline-block; padding: 4px 12px; border-radius: 50px; font-size: 0.78em; font-weight: 600; letter-spacing: 0.01em; }
        .b2-pill-green { background: #e8f5e9; color: #1b7a2b; }
        .b2-pill-gray { background: #f2f2f7; color: #6e6e73; }
        .b2-pill-blue { background: #e3f2fd; color: #0a5dc2; }
        .b2-pill-orange { background: #fff3e0; color: #c75000; }
        .b2-pill-red { background: #fce4ec; color: #c62828; }
        .b2-pill-amber { background: #fff8e1; color: #e65100; }
        body.theme-dark .b2-title { color: #f5f5f7; }
        body.theme-dark .b2-location { color: #86868b; }
        body.theme-dark .b2-pill-green { background: #1a3328; color: #4ade80; }
        body.theme-dark .b2-pill-gray { background: #2c2c2e; color: #98989d; }
        body.theme-dark .b2-pill-blue { background: #1a2a3e; color: #64b5f6; }
        body.theme-dark .b2-pill-orange { background: #3a2a1a; color: #ffb74d; }
        body.theme-dark .b2-pill-red { background: #3a1a1e; color: #ef5350; }
        body.theme-dark .b2-pill-amber { background: #3a2a1a; color: #ffb74d; }
        .b2-group { background: #fff; border-radius: 14px; box-shadow: 0 0.5px 1px rgba(0,0,0,0.05), 0 1px 3px rgba(0,0,0,0.06); margin-bottom: 24px; overflow: hidden; }
        .b2-group-title { font-size: 0.78em; font-weight: 600; color: #86868b; text-transform: uppercase; letter-spacing: 0.04em; padding: 0 0 8px 4px; }
        .b2-row { display: flex; align-items: center; padding: 13px 16px; border-bottom: 1px solid rgba(0,0,0,0.06); }
        .b2-row:last-child { border-bottom: none; }
        .b2-row-label { font-size: 0.9em; color: #1d1d1f; flex: 0 0 110px; }
        .b2-row-value { font-size: 0.9em; font-weight: 500; color: #1d1d1f; flex: 1; text-align: right; }
        body.theme-dark .b2-group { background: #1c1c1e; box-shadow: 0 0.5px 1px rgba(0,0,0,0.2), 0 1px 3px rgba(0,0,0,0.25); }
        body.theme-dark .b2-group-title { color: #86868b; }
        body.theme-dark .b2-row { border-bottom-color: rgba(255,255,255,0.06); }
        body.theme-dark .b2-row-label { color: #e5e5e7; }
        body.theme-dark .b2-row-value { color: #e5e5e7; }
        .b2-cap-row { display: flex; align-items: center; padding: 12px 16px; border-bottom: 1px solid rgba(0,0,0,0.06); }
        .b2-cap-row:last-child { border-bottom: none; }
        .b2-cap-name { font-size: 0.9em; font-weight: 600; color: #007aff; flex: 0 0 140px; }
        .b2-cap-vals { display: flex; flex: 1; justify-content: flex-end; }
        .b2-cap-vals > * + * { margin-left: 24px; }
        .b2-cap-unit { font-size: 0.78em; color: #86868b; }
        .b2-cap-num { font-size: 0.9em; font-weight: 600; font-family: -apple-system, 'SF Mono', 'Segoe UI', monospace; color: #1d1d1f; }
        .b2-cap-hours { font-size: 0.78em; color: #aeaeb2; }
        body.theme-dark .b2-cap-row { border-bottom-color: rgba(255,255,255,0.06); }
        body.theme-dark .b2-cap-name { color: #64b5f6; }
        body.theme-dark .b2-cap-num { color: #f5f5f7; }
        body.theme-dark .b2-cap-unit { color: #86868b; }
        body.theme-dark .b2-cap-hours { color: #636366; }
        .b2-cap-transfer { display: inline-block; font-size: 0.7em; font-weight: 600; background: #e3f2fd; color: #0a5dc2; padding: 1px 6px; border-radius: 4px; margin-left: 6px; vertical-align: middle; }
        body.theme-dark .b2-cap-transfer { background: #1a2a3e; color: #64b5f6; }
        .b2-abolish-row { display: flex; align-items: center; padding: 10px 16px; border-bottom: 1px solid rgba(0,0,0,0.06); }
        .b2-abolish-row:last-child { border-bottom: none; }
        .b2-abolish-label { font-size: 0.9em; font-weight: 400; color: #ff3b30; flex: 0 0 auto; }
        .b2-abolish-input { margin-left: auto; padding: 6px 12px; border-radius: 8px; border: 1px solid rgba(0,0,0,0.1); font-size: 0.85em; color: #1d1d1f; background: rgba(0,0,0,0.03); width: 140px; text-align: center; }
        .b2-abolish-btn { margin-left: 8px; padding: 6px 14px; border-radius: 8px; border: none; background: #ff3b30; color: #fff; font-size: 0.85em; font-weight: 500; cursor: pointer; }
        .b2-abolish-btn:hover { background: #e0342b; }
        body.theme-dark .b2-abolish-label { color: #ff453a; }
        body.theme-dark .b2-abolish-input { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.1); color: #e5e5e7; }
        .b2-action-row { display: block; padding: 13px 16px; text-align: center; font-size: 0.95em; font-weight: 500; color: #007aff; cursor: pointer; }
        .b2-action-row:hover { background: rgba(0,122,255,0.04); }
        body.theme-dark .b2-action-row { color: #0a84ff; }
        body.theme-dark .b2-action-row:hover { background: rgba(10,132,255,0.08); }
        /* カード型アクションボタン */
        .action-card { flex: 1; padding: 16px; border-radius: 14px; text-align: center; cursor: pointer; }
        .action-card-icon { font-size: 1.5em; color: #fff; margin-bottom: 4px; }
        .action-card-label { font-size: 0.9em; font-weight: 600; color: #fff; }
        .action-card-desc { font-size: 0.7em; color: rgba(255,255,255,0.7); margin-top: 2px; }
        .action-card-blue { background: #007aff; }
        .action-card-blue:hover { background: #0066d6; }
        .action-card-amber { background: #ff9500; }
        .action-card-amber:hover { background: #e08600; }
        .action-card-orange { background: #e65100; }
        .action-card-orange:hover { background: #cc4700; }
        .action-card-disabled { background: #8e8e93; opacity: 0.4; cursor: default; }
        body.theme-dark .action-card-blue { background: #0a84ff; }
        body.theme-dark .action-card-amber { background: #ff9f0a; }
        body.theme-dark .action-card-orange { background: #ff6d2e; }
        body.theme-dark .action-card-disabled { background: #636366; }
        .b2-restore-row { display: block; padding: 13px 16px; text-align: center; font-size: 0.95em; font-weight: 500; color: #34c759; cursor: pointer; }
        .b2-restore-row:hover { background: rgba(52,199,89,0.04); }
        body.theme-dark .b2-restore-row { color: #30d158; }
        body.theme-dark .b2-restore-row:hover { background: rgba(48,209,88,0.08); }
        .b2-destructive-row { display: block; padding: 13px 16px; text-align: center; font-size: 0.95em; font-weight: 400; color: #ff3b30; cursor: pointer; border-bottom: 1px solid rgba(0,0,0,0.06); }
        .b2-destructive-row:last-child { border-bottom: none; }
        .b2-destructive-row:hover { background: rgba(255,59,48,0.04); }
        .b2-destructive-sub { font-size: 0.75em; color: #86868b; margin-top: 2px; font-weight: 400; }
        body.theme-dark .b2-destructive-row { color: #ff453a; }
        body.theme-dark .b2-destructive-row:hover { background: rgba(255,69,58,0.08); }
        /* 縦タイムライン */
        .vtl { position: relative; padding-left: 32px; margin-bottom: 24px; }
        .vtl-line { position: absolute; left: 13px; top: 0; bottom: 0; width: 2px; background: #dde4ec; }
        body.theme-dark .vtl-line { background: #2a3a50; }
        .vtl-item { position: relative; padding-bottom: 24px; padding-right: 100px; }
        .vtl-item:last-child { padding-bottom: 0; }
        .vtl-actions { position: absolute; right: 0; top: 2px; font-size: 0.82em; }
        .vtl-actions > * + * { margin-left: 12px; }
        .vtl-edit { font-weight: 400; color: #007aff; cursor: pointer; text-decoration: none; }
        .vtl-edit:hover { text-decoration: underline; }
        .vtl-delete { font-weight: 400; color: #ff3b30; cursor: pointer; text-decoration: none; }
        .vtl-delete:hover { text-decoration: underline; }
        body.theme-dark .vtl-edit { color: #0a84ff; }
        body.theme-dark .vtl-delete { color: #ff453a; }
        .vtl-dot { position: absolute; left: -25px; top: 4px; width: 12px; height: 12px; border-radius: 50%; border: 2px solid #fff; }
        .vtl-dot.active { background: #4CAF50; }
        .vtl-dot.expired { background: #90CAF9; }
        .vtl-dot.abolished { background: #9e9e9e; }
        .vtl-dot.cancelled { background: #ef5350; }
        .vtl-dot.suspended { background: #ffb74d; }
        body.theme-dark .vtl-dot { border-color: #192734; }
        .vtl-date { font-size: 0.78em; font-weight: 600; color: #86868b; margin-bottom: 2px; }
        .vtl-content { font-size: 0.88em; color: #1d1d1f; line-height: 1.5; }
        body.theme-dark .vtl-content { color: #e5e5e7; }
        .vtl-change { font-size: 0.82em; color: #86868b; margin-top: 2px; }
        .vtl-change-old { color: #c62828; text-decoration: line-through; }
        .vtl-change-new { color: #1b7a2b; font-weight: 500; }
        body.theme-dark .vtl-change-old { color: #ef5350; }
        body.theme-dark .vtl-change-new { color: #4ade80; }
    </style>
    <script src="app_logic.js" charset="UTF-8"></script>
</head>
<body>
    <!-- タイトル画面 -->
    <div id="page-home" class="page active">
        <div class="home-container">
            <div class="home-header">
                <h1>廃棄物処理業許可管理</h1>
                <p class="subtitle">Waste Management Permit System</p>
            </div>
            <div id="statsStrip" class="stats-strip">
                <div class="stat-item"><div class="stat-value" id="strip-biz">-</div><div class="stat-label">事業者</div></div>
                <div class="stat-item"><div class="stat-value" id="strip-permit">-</div><div class="stat-label">有効許可</div></div>
                <div class="stat-item"><div class="stat-value" id="strip-facility">-</div><div class="stat-label">稼働施設</div></div>
                <div class="stat-item" id="strip-expiring-item"><div class="stat-value" id="strip-expiring">-</div><div class="stat-label">期限1年以内</div></div>
            </div>
            <div class="menu-group">
                <div class="menu-group-label">検索</div>
                <div class="menu-grid menu-grid-4">
                    <div class="menu-button" id="btnPermitSearch" onclick="showPage('search-permit')"><div class="icon icon-search">&#128196;<span class="notification-badge" id="permitBadge"></span></div><div class="menu-text"><span>業検索</span><span class="menu-desc">業の検索・絞り込み</span></div></div>
                    <div class="menu-button" onclick="showPage('search-facility')"><div class="icon icon-search">&#127981;</div><div class="menu-text"><span>施設検索</span><span class="menu-desc">施設情報の検索</span></div></div>
                    <div class="menu-button" onclick="showPage('search-vehicle')"><div class="icon icon-search">&#128666;</div><div class="menu-text"><span>車両検索</span><span class="menu-desc">車両情報の検索</span></div></div>
                    <div class="menu-button" onclick="showPage('search-officer')"><div class="icon icon-search">&#128100;</div><div class="menu-text"><span>役員検索</span><span class="menu-desc">役員情報の検索</span></div></div>
                </div>
            </div>
            <div class="menu-group">
                <div class="menu-group-label">管理</div>
                <div class="menu-grid">
                    <div class="menu-button" onclick="loadBusinessList()"><div class="icon icon-manage">&#128203;</div><div class="menu-text"><span>事業者一覧</span><span class="menu-desc">登録事業者の一覧表示</span></div></div>
                    <div class="menu-button" onclick="openBusinessForm(0)"><div class="icon icon-manage">&#10133;</div><div class="menu-text"><span>事業者登録</span><span class="menu-desc">新規事業者の登録</span></div></div>
                    <div class="menu-button" onclick="showPage('settings')"><div class="icon icon-manage">&#9881;</div><div class="menu-text"><span>設定</span><span class="menu-desc">マスタ・テーマ設定</span></div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 事業者検索画面 -->
    <div id="page-search" class="page">
        <div class="container">
            <button class="btn-back" onclick="goBack()">← 戻る</button>
            <h1>事業者検索</h1>
            <p class="subtitle">Business Search</p>
            <div class="search-box">
                <div class="search-row">
                    <input type="text" id="searchKeyword" placeholder="事業者名、電話番号、住所で検索..." onkeydown="if(event.keyCode==13)searchBusiness()">
                    <button onclick="searchBusiness()">検索</button>
                </div>
            </div>
            <div id="searchResults"><div class="search-initial-state"><div class="search-initial-icon">&#128203;</div><p>事業者名、電話番号、住所で検索できます</p></div></div>
        </div>
    </div>

    <!-- 許可検索画面 -->
    <div id="page-search-permit" class="page">
        <div class="container">
            <button class="btn-back" onclick="goBack()">← 戻る</button>
            <h1>業検索</h1>
            <p class="subtitle">Permit Search</p>
            <div class="search-box" style="padding:20px;">
                <div class="search-row">
                    <input type="text" id="searchPermitKeyword" placeholder="許可番号、事業者名で検索..." style="flex:1;min-width:200px;" onkeydown="if(event.keyCode==13)searchPermit()">
                    <button onclick="searchPermit()">検索</button>
                </div>
                <div class="search-sub-row">
                    <div class="search-date-box">
                        <label class="search-label-bold">検索基準日:</label>
                        <input type="text" id="searchPermitAsOfDateValue" class="tc" style="padding:6px 10px;border-radius:8px;border:1px solid rgba(0,0,0,0.12);width:110px;cursor:pointer;" readonly onclick="showDatePicker(this)">
                        <button type="button" onclick="showDatePicker(document.getElementById('searchPermitAsOfDateValue'))" style="padding:6px 10px;border-radius:8px;font-size:0.9em;">選択</button>
                    </div>
                    <button type="button" id="btnAdvancedFilters" onclick="toggleAdvancedFilters()" style="background:none;border:1px solid rgba(255,255,255,0.15);color:inherit;padding:8px 15px;border-radius:10px;cursor:pointer;font-size:0.9em;">詳細フィルター ▼</button>
                </div>
                <!-- カレンダーポップアップ -->
                <div id="datePickerPopup" class="cal-popup" style="display:none;position:absolute;z-index:1000;">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                        <button type="button" onclick="changeMonth(-1);event.stopPropagation();return false;" style="padding:3px 8px;">&lt;</button>
                        <span id="datePickerTitle" class="cal-title"></span>
                        <button type="button" onclick="changeMonth(1);event.stopPropagation();return false;" style="padding:3px 8px;">&gt;</button>
                    </div>
                    <table id="datePickerCalendar" style="border-collapse:collapse;"></table>
                    <div style="margin-top:10px;text-align:center;">
                        <button type="button" onclick="selectToday()" style="padding:3px 10px;margin-right:5px;">今日</button>
                        <button type="button" onclick="closeDatePicker()" style="padding:3px 10px;">閉じる</button>
                    </div>
                </div>
                <div id="advancedFilters" class="advanced-filters" style="display:none;">
                <div class="filter-row">
                    <div>
                        <label class="search-label">許可区分:</label>
                        <select id="searchPermitCategory">
                            <option value="">全て</option>
                        </select>
                    </div>
                    <div>
                        <label class="search-label">有効期限:</label>
                        <select id="searchPermitExpiry">
                            <option value="valid">有効期限内</option>
                            <option value="">全て</option>
                            <option value="expired">期限切れ</option>
                            <option value="30days">30日以内に期限切れ</option>
                            <option value="90days">90日以内に期限切れ</option>
                            <option value="1year">1年以内に期限切れ</option>
                        </select>
                    </div>
                    <div>
                        <label class="search-label">状態:</label>
                        <select id="searchPermitStatus">
                            <option value="">全て</option>
                            <option value="active">有効</option>
                            <option value="abolished">廃止</option>
                            <option value="cancelled">取消</option>
                        </select>
                    </div>
                    <div>
                        <label class="search-label" for="searchPermitExcellent" style="display:inline-block;cursor:pointer;"><span class="toggle-switch"><input type="checkbox" id="searchPermitExcellent"><span class="toggle-slider"></span></span> 優良認定のみ</label>
                    </div>
                </div>
                <div class="filter-section">
                    <label class="search-label">取扱品目（複数選択可）:</label>
                    <div class="filter-items-area">
                        <div id="searchPermitItemsContainer" class="search-items-box"></div>
                        <div class="filter-col">
                            <label class="search-label"><input type="radio" name="searchPermitItemMode" value="OR" checked> OR検索（いずれか含む）</label>
                            <label class="search-label"><input type="radio" name="searchPermitItemMode" value="AND"> AND検索（すべて含む）</label>
                            <button type="button" class="filter-btn" onclick="clearPermitItemSelection()">選択解除</button>
                            <button type="button" class="filter-btn" onclick="selectAllPermitItems()">全て選択</button>
                        </div>
                    </div>
                </div>
                </div>
            </div>
            <div id="searchPermitResults"><div class="search-initial-state"><div class="search-initial-icon">&#128196;</div><p>許可番号、事業者名で検索できます</p></div></div>
        </div>
    </div>

    <!-- 施設検索画面 -->
    <div id="page-search-facility" class="page">
        <div class="container">
            <button class="btn-back" onclick="goBack()">← 戻る</button>
            <h1>施設検索</h1>
            <p class="subtitle">Facility Search</p>
            <div class="search-box" style="padding:20px;">
                <div class="search-row">
                    <input type="text" id="searchFacilityKeyword" placeholder="設置場所、許可番号、事業者名で検索..." style="flex:1;min-width:200px;" onkeydown="if(event.keyCode==13)searchFacility()">
                    <button onclick="searchFacility()">検索</button>
                </div>
                <div class="search-sub-row">
                    <button type="button" id="btnFacilityAdvancedFilters" onclick="toggleFacilityAdvancedFilters()" style="background:none;border:1px solid rgba(255,255,255,0.15);color:inherit;padding:8px 15px;border-radius:10px;cursor:pointer;font-size:0.9em;">詳細フィルター ▼</button>
                </div>
                <div id="facilityAdvancedFilters" class="advanced-filters" style="display:none;">
                <div class="filter-row">
                    <div>
                        <label class="search-label">施設種別:</label>
                        <select id="searchFacilityType">
                            <option value="">全て</option>
                        </select>
                    </div>
                    <div>
                        <label class="search-label">状態:</label>
                        <select id="searchFacilityStatus">
                            <option value="active">稼働中</option>
                            <option value="">全て</option>
                            <option value="abolished">廃止</option>
                        </select>
                    </div>
                </div>
                <div class="filter-row" style="margin-top:8px;">
                    <div>
                        <label class="search-label">処理方法:</label>
                        <select id="searchFacilityMethod">
                            <option value="">全て</option>
                        </select>
                    </div>
                    <div>
                        <label class="search-label">許可対象:</label>
                        <select id="searchFacilityPermitTarget">
                            <option value="">全て</option>
                        </select>
                    </div>
                </div>
                <div class="filter-row" style="margin-top:8px;">
                    <div>
                        <label class="search-label">日処理能力(t/日以上):</label>
                        <input type="text" id="searchFacilityMinCapacity" placeholder="例: 5" style="width:100px;" oninput="this.value=normalizeToHankaku(this.value)">
                    </div>
                    <div>
                        <label class="search-label" for="searchFacilityExcludeSelf" style="display:inline-block;cursor:pointer;"><span class="toggle-switch"><input type="checkbox" id="searchFacilityExcludeSelf"><span class="toggle-slider"></span></span> 自己処理を除外</label>
                    </div>
                </div>
                <div class="filter-row" style="margin-top:8px;">
                    <div style="width:100%;">
                        <label class="search-label">品目フィルター:</label>
                        <div id="searchFacilityItemCheckboxes" style="display:flex;flex-wrap:wrap;margin-top:4px;"></div>
                        <div style="margin-top:4px;">
                            <label style="font-weight:normal;margin-right:12px;font-size:0.85em;"><input type="radio" name="facItemMode" value="or" checked> いずれかを含む(OR)</label>
                            <label style="font-weight:normal;font-size:0.85em;"><input type="radio" name="facItemMode" value="and"> 全てを含む(AND)</label>
                        </div>
                    </div>
                </div>
                </div>
            </div>
            <div id="searchFacilityResults"><div class="search-initial-state"><div class="search-initial-icon">&#127981;</div><p>設置場所、許可番号、事業者名で検索できます</p></div></div>
        </div>
    </div>

    <!-- 車両検索画面 -->
    <div id="page-search-vehicle" class="page">
        <div class="container">
            <button class="btn-back" onclick="goBack()">← 戻る</button>
            <h1>車両検索</h1>
            <p class="subtitle">Vehicle Search</p>
            <div class="search-box">
                <div class="search-row">
                    <input type="text" id="searchVehicleKeyword" placeholder="登録番号、事業者名で検索..." onkeydown="if(event.keyCode==13)searchVehicle()">
                    <label style="color:inherit;white-space:nowrap;font-size:0.9em;" for="searchVehicleIncludeScrapped"><span class="toggle-switch"><input type="checkbox" id="searchVehicleIncludeScrapped"><span class="toggle-slider"></span></span> 廃車を含む</label>
                    <button onclick="searchVehicle()">検索</button>
                </div>
            </div>
            <div id="searchVehicleResults"><div class="search-initial-state"><div class="search-initial-icon">&#128666;</div><p>登録番号、事業者名で検索できます</p></div></div>
        </div>
    </div>

    <!-- 役員検索画面 -->
    <div id="page-search-officer" class="page">
        <div class="container">
            <button class="btn-back" onclick="goBack()">← 戻る</button>
            <h1>役員検索</h1>
            <p class="subtitle">Officer Search</p>
            <div class="search-box">
                <div class="search-row">
                    <input type="text" id="searchOfficerKeyword" placeholder="氏名、役職名、事業者名で検索..." onkeydown="if(event.keyCode==13)searchOfficer()">
                    <label style="color:inherit;white-space:nowrap;font-size:0.9em;" for="searchOfficerIncludeRetired"><span class="toggle-switch"><input type="checkbox" id="searchOfficerIncludeRetired"><span class="toggle-slider"></span></span> 退任者を含む</label>
                    <button onclick="searchOfficer()">検索</button>
                </div>
            </div>
            <div id="searchOfficerResults"><div class="search-initial-state"><div class="search-initial-icon">&#128100;</div><p>氏名、役職名、事業者名で検索できます</p></div></div>
        </div>
