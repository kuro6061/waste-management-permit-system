                        <button class="btn btn-secondary" style="margin-left:8px;" onclick="cancelDbSettingsEdit()">キャンセル</button>
                        <button class="btn btn-secondary" style="margin-left:auto;" onclick="resetDbPath()">デフォルトに戻す</button>
                    </div>
                </div>
            </div>
