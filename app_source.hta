    <!-- ローディングオーバーレイ -->
    <div id="loadingOverlay" class="loading-overlay">
        <div class="loading-spinner">
            <div class="loading-spinner-circle" id="loadingSpinnerCircle"></div>
            <p>読み込み中...</p>
        </div>
    </div>

    <!-- パンくずリスト -->
    <div id="breadcrumb-bar" class="breadcrumb-bar" style="display:none;">
        <span id="breadcrumb-content"></span>
    </div>

    <!-- トースト通知コンテナ -->
    <div id="toast-container" class="toast-container"></div>

    <!-- ステータスバー -->
    <div class="status-bar">
        <div id="dateTime"></div>
        <div id="dbStatus" class="db-status">データベース: 接続中...</div>
        <div><button onclick="toggleTheme()" style="background:none;border:1px solid rgba(255,255,255,0.15);color:inherit;padding:4px 12px;border-radius:8px;cursor:pointer;margin-right:10px;font-size:0.85em;transition:all 0.2s ease;" id="themeToggleBtn">ライト</button>Ver 5.5</div>
    </div>

    <script type="text/javascript">
        var conn = null;
        var dbPath = "";
        var navStack = [];
        var currentDetailBusinessId = 0;
        var NAV_STACK_MAX = 20;
        var PAGE_TITLES = {
            "home": "\u30db\u30fc\u30e0", "search": "\u4e8b\u696d\u8005\u691c\u7d22",
            "search-permit": "\u8a31\u53ef\u691c\u7d22", "search-facility": "\u65bd\u8a2d\u691c\u7d22",
            "search-vehicle": "\u8eca\u4e21\u691c\u7d22", "search-officer": "\u5f79\u54e1\u691c\u7d22",
            "list": "\u4e8b\u696d\u8005\u4e00\u89a7", "detail": "\u4e8b\u696d\u8005\u8a73\u7d30",
            "business-form": "\u4e8b\u696d\u8005\u767b\u9332", "facility": "\u65bd\u8a2d\u7ba1\u7406",
            "statistics": "\u7d71\u8a08\u60c5\u5831", "settings": "\u8a2d\u5b9a",
            "master": "\u30de\u30b9\u30bf\u30fc\u8a2d\u5b9a", "master-form": "\u30de\u30b9\u30bf\u30fc\u7de8\u96c6"
        };
        var PAGE_HIERARCHY = {
            "home": [],
            "search": ["home"],
            "search-permit": ["home"], "search-facility": ["home"],
            "search-vehicle": ["home"], "search-officer": ["home"],
            "list": ["home"], "detail": ["home"], "business-form": ["home"],
            "facility": ["home"], "statistics": ["home"], "settings": ["home"],
            "master": ["home", "settings"], "master-form": ["home", "settings", "master"]
        };
        var formDirty = false;
        var savedScrollPositions = {};
        var logFso = null;
        var logPath = "";

        // ステータスバッジ生成ヘルパー
        function statusBadge(type, text, large) {
            var cls = 'badge-status ' + type;
            if (large) cls += ' badge-status-lg';
            return "<span class='" + cls + "'>" + escapeHtml(text) + "</span>";
        }
        // ステップインジケーターナビ
        // steps: [{label, onclick},...], currentIdx: 現在ステップ, rightHtml: 右端HTML(任意)
        function buildStepNav(steps, currentIdx, rightHtml) {
            var html = "<div class='step-nav'><div class='step-nav-steps'>";
            for (var i = 0; i < steps.length; i++) {
                var s = steps[i];
                var phase = (i < currentIdx) ? "past" : (i === currentIdx) ? "current" : "future";
                var clickable = (phase === "past" && s.onclick);
                if (clickable) {
                    html += "<a class='step-nav-step' onclick='" + s.onclick + "'>";
                } else {
                    html += "<span class='step-nav-step'>";
                }
                html += "<span class='step-dot " + phase + "'>" + (i + 1) + "</span>";
                html += "<span class='step-label " + phase + "'>" + escapeHtml(s.label) + "</span>";
                html += clickable ? "</a>" : "</span>";
                if (i < steps.length - 1) {
                    html += "<span class='step-line " + (i < currentIdx ? "done" : "pending") + "'></span>";
                }
            }
            html += "</div>";
            if (rightHtml) html += "<div class='step-nav-right'>" + rightHtml + "</div>";
            html += "</div>";
            return html;
        }
        // ログ出力関数
        function log(msg) {
            try {
                if (!logFso) logFso = new ActiveXObject("Scripting.FileSystemObject");
                if (!logPath) {
                    var htaPath = document.location.pathname;
                    if (htaPath.indexOf("/") === 0) htaPath = htaPath.substring(1);
                    htaPath = htaPath.replace(/\//g, "\\");
                    htaPath = decodeURIComponent(htaPath);
                    logPath = logFso.GetParentFolderName(htaPath) + "\\debug.log";
                }
                var file = logFso.OpenTextFile(logPath, 8, true);
                var now = new Date();
                var ts = now.getFullYear() + "/" + (now.getMonth()+1) + "/" + now.getDate() + " " + now.getHours() + ":" + now.getMinutes() + ":" + now.getSeconds();
                file.WriteLine(ts + " " + msg);
                file.Close();
            } catch(e) { /* ignore */ }
        }

        // グローバルエラーハンドラ
        window.onerror = function(msg, url, line) {
            log("GLOBAL ERROR: " + msg + " at line " + line);
            return false;
        };

        // ===== ローディングインジケーター =====
        var _loadingAngle = 0;
        var _loadingTimer = null;
        function showLoading() {
            var overlay = document.getElementById("loadingOverlay");
            overlay.className = "loading-overlay active";
            _loadingAngle = 0;
            _loadingTimer = setInterval(function() {
                _loadingAngle = (_loadingAngle + 30) % 360;
                var circle = document.getElementById("loadingSpinnerCircle");
                if (circle) circle.style.transform = "rotate(" + _loadingAngle + "deg)";
            }, 50);
        }
        function hideLoading() {
            var overlay = document.getElementById("loadingOverlay");
            overlay.className = "loading-overlay";
            if (_loadingTimer) { clearInterval(_loadingTimer); _loadingTimer = null; }
        }

        // ===== トースト通知 =====
        function showToast(message, type, duration) {
            type = type || "success";
            duration = duration || 3000;
            var container = document.getElementById("toast-container");
            var toast = document.createElement("div");
            toast.className = "toast toast-" + type;
            toast.innerText = message;
            toast.onclick = function() {
                if (toast.parentNode) toast.parentNode.removeChild(toast);
            };
            container.appendChild(toast);
            setTimeout(function() {
                // IE互換フェードアウト
                var opacity = 10;
                var timer = setInterval(function() {
                    opacity--;
                    toast.style.filter = "alpha(opacity=" + (opacity * 10) + ")";
                    toast.style.opacity = opacity / 10;
                    if (opacity <= 0) {
                        clearInterval(timer);
                        if (toast.parentNode) toast.parentNode.removeChild(toast);
                    }
                }, 50);
            }, duration);
        }

        // ===== 確認ダイアログ =====
        var _confirmCallback = null;
        function showConfirmDialog(title, message, options) {
            options = options || {};
            document.getElementById("confirmTitle").innerText = title;
            document.getElementById("confirmMessage").innerText = message;
            var okBtn = document.getElementById("confirmOkBtn");
            okBtn.innerText = options.okText || "OK";
            okBtn.className = "btn " + (options.okClass || "btn-primary");
            _confirmCallback = options.onOk || null;
            document.getElementById("confirmOverlay").style.display = "block";
        }
        function confirmDialogOk() {
            document.getElementById("confirmOverlay").style.display = "none";
            if (_confirmCallback) { var cb = _confirmCallback; _confirmCallback = null; cb(); }
        }
        function confirmDialogCancel() {
            document.getElementById("confirmOverlay").style.display = "none";
            _confirmCallback = null;
        }

        // Escキーでダイアログを閉じる
        document.onkeydown = function(e) {
            if (e.keyCode === 27) {
                var overlay = document.getElementById("confirmOverlay");
                if (overlay && overlay.style.display === "block") {
                    confirmDialogCancel();
                }
                closeFloatingDatePicker();
            }
        };

        // ===== インラインエラー表示 =====
        function showInlineError(containerId, message) {
            var el = document.getElementById(containerId);
            if (!el) return;
            el.innerHTML = "<div class='message error'>" + escapeHtml(message) + "</div>";
            el.scrollIntoView(false);
        }

        // ===== 検索結果件数表示ヘルパー =====
        function buildResultCountHtml(count, keyword, options) {
            options = options || {};
            if (count === 0) {
                return "<div class='result-count no-results'>検索条件に一致するデータが見つかりませんでした" + (keyword ? "（キーワード: " + escapeHtml(keyword) + "）" : "") + "</div>";
            }
            var text = "";
            if (options.prefix) text += options.prefix;
            text += count + " 件見つかりました";
            return "<div class='result-count has-results'>" + text + "</div>";
        }

        window.onload = function() {
            document.body.className = "theme-dark";
            log("=== HTA起動 ===");
            updateDateTime();
            setInterval(updateDateTime, 1000);
            initDatabase();
            loadDashboard();
            animateHomeEntrance();
        };

        var appFolder = "";
        var settingsPath = "";

        function getAppFolder() {
            if (appFolder) return appFolder;
            var htaPath = document.location.pathname;
            if (htaPath.indexOf("/") === 0) htaPath = htaPath.substring(1);
            htaPath = htaPath.replace(/\//g, "\\");
            htaPath = decodeURIComponent(htaPath);
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            appFolder = fso.GetParentFolderName(htaPath);
            settingsPath = appFolder + "\\settings.json";
            return appFolder;
        }

        function getDefaultDbPath() {
            return getAppFolder() + "\\Database_sample.accdb";
        }

        function loadSettings() {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                getAppFolder();
                if (fso.FileExists(settingsPath)) {
                    var file = fso.OpenTextFile(settingsPath, 1);
                    var text = file.ReadAll();
                    file.Close();
                    return eval("(" + text + ")");
                }
            } catch (e) { /* 設定ファイル読み込み失敗は無視 */ }
            return {};
        }

        function saveSettings(settings) {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                getAppFolder();
                var file = fso.CreateTextFile(settingsPath, true);
                var json = '{\n';
                var keys = [];
                for (var k in settings) { if (settings.hasOwnProperty(k)) keys.push(k); }
                for (var i = 0; i < keys.length; i++) {
                    var val = settings[keys[i]];
                    json += '  "' + keys[i] + '": ';
                    if (typeof val === "string") {
                        json += '"' + val.replace(/\\/g, "\\\\").replace(/"/g, '\\"') + '"';
                    } else {
                        json += String(val);
                    }
                    if (i < keys.length - 1) json += ',';
                    json += '\n';
                }
                json += '}';
                file.Write(json);
                file.Close();
            } catch (e) { /* 設定ファイル書き込み失敗は無視 */ }
        }

        function connectToDb(path) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            if (!fso.FileExists(path)) {
                throw new Error("ファイルが見つかりません: " + path);
            }
            var newConn = new ActiveXObject("ADODB.Connection");
            newConn.Mode = 16; // adModeShareDenyNone
            var providers = [
                "Provider=Microsoft.ACE.OLEDB.16.0;Data Source=" + path + ";",
                "Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" + path + ";",
                "Provider=Microsoft.Jet.OLEDB.4.0;Data Source=" + path + ";"
            ];
            var connected = false;
            var lastError = "";
            for (var i = 0; i < providers.length; i++) {
                try {
                    newConn.Open(providers[i]);
                    connected = true;
                    break;
                } catch (provErr) {
                    lastError = provErr.message;
                    newConn = new ActiveXObject("ADODB.Connection");
                    newConn.Mode = 16;
                }
            }
            if (!connected) {
                throw new Error("接続できません: " + lastError);
            }
            return newConn;
        }

        function initDatabase() {
            try {
                var settings = loadSettings();
                dbPath = settings.dbPath || getDefaultDbPath();
                document.getElementById("dbPathDisplay").innerText = dbPath;
                conn = connectToDb(dbPath);
                migrateDatabase();
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                setDbStatus("接続済み: " + fso.GetFileName(dbPath), false);
                document.getElementById("dbStatusDisplay").innerText = "接続成功";
            } catch (e) {
                setDbStatus("接続エラー: " + e.message, true);
                document.getElementById("dbStatusDisplay").innerText = "エラー: " + e.message;
            }
        }

        // DBスキーマのマイグレーション（起動時に自動実行）
        function migrateDatabase() {
            try {
                // 施設.許可番号: LONG → VARCHAR(255) に変更
                var rs = conn.Execute("SELECT TOP 1 施設ID, 許可番号 FROM 施設");
                if (!rs.EOF) {
                    // フィールドのTypeプロパティで型を判定（3=LONG, 202=nvarchar/text）
                    if (rs.Fields("許可番号").Type === 3) {
                        rs.Close();
                        conn.Execute("ALTER TABLE 施設 ALTER COLUMN 許可番号 VARCHAR(255)");
                        log("[Migration] 施設.許可番号: LONG → VARCHAR(255)");
                        return;
                    }
                }
                rs.Close();
            } catch (e) {
                log("[Migration] スキップまたはエラー: " + e.message);
            }

            // 役員.代表者フラグ カラム追加
            try {
                var rs = conn.Execute("SELECT TOP 1 * FROM 役員");
                var hasCol = false;
                for (var i = 0; i < rs.Fields.Count; i++) {
                    if (rs.Fields(i).Name === "代表者フラグ") { hasCol = true; break; }
                }
                rs.Close();
                if (!hasCol) {
                    conn.Execute("ALTER TABLE 役員 ADD COLUMN 代表者フラグ YESNO");
                    conn.Execute("UPDATE 役員 SET 代表者フラグ = False");
                    log("[Migration] 役員.代表者フラグ カラム追加");
                }
            } catch (e) {
                log("[Migration] 役員.代表者フラグ: " + e.message);
            }

            // 車両.普通フラグ / 車両.特管フラグ カラム追加
            try {
                var rs = conn.Execute("SELECT TOP 1 * FROM 車両");
                var hasNormal = false, hasSpecial = false;
                for (var i = 0; i < rs.Fields.Count; i++) {
                    if (rs.Fields(i).Name === "普通フラグ") hasNormal = true;
                    if (rs.Fields(i).Name === "特管フラグ") hasSpecial = true;
                }
                rs.Close();
                if (!hasNormal) {
                    conn.Execute("ALTER TABLE 車両 ADD COLUMN 普通フラグ YESNO");
                    conn.Execute("UPDATE 車両 SET 普通フラグ = False");
                    // 許可区分IDから移行: ID=3は普通収集運搬
                    try { conn.Execute("UPDATE 車両 SET 普通フラグ = True WHERE 許可区分ID = 3"); } catch(ignore){}
                    log("[Migration] 車両.普通フラグ カラム追加");
                }
                if (!hasSpecial) {
                    conn.Execute("ALTER TABLE 車両 ADD COLUMN 特管フラグ YESNO");
                    conn.Execute("UPDATE 車両 SET 特管フラグ = False");
                    // 許可区分IDから移行: ID=2,4は特管
                    try { conn.Execute("UPDATE 車両 SET 特管フラグ = True WHERE 許可区分ID IN (2, 4)"); } catch(ignore){}
                    log("[Migration] 車両.特管フラグ カラム追加");
                }
            } catch (e) {
                log("[Migration] 車両フラグ: " + e.message);
            }

            // 施設テーブル: 追加カラムのマイグレーション
            try {
                var rs = conn.Execute("SELECT TOP 1 * FROM 施設");
                var facilityColMap = {};
                for (var i = 0; i < rs.Fields.Count; i++) {
                    facilityColMap[rs.Fields(i).Name] = true;
                }
                rs.Close();
                var facilityMigrations = [
                    {name: "取消理由", type: "VARCHAR(200)"},
                    {name: "廃止確認日", type: "DATETIME"},
                    {name: "埋立終了年月日", type: "DATETIME"},
                    {name: "保管施設面積m2", type: "LONG"},
                    {name: "保管量上限m3", type: "LONG"},
                    {name: "保管高さm", type: "LONG"}
                ];
                for (var mi = 0; mi < facilityMigrations.length; mi++) {
                    var col = facilityMigrations[mi];
                    if (!facilityColMap[col.name]) {
                        conn.Execute("ALTER TABLE 施設 ADD COLUMN [" + col.name + "] " + col.type);
                        log("[Migration] 施設." + col.name + " カラム追加");
                    }
                }
            } catch (e) {
                log("[Migration] 施設カラム追加: " + e.message);
            }

            // 許可.変更許可フラグ カラム追加
            try {
                var rs = conn.Execute("SELECT TOP 1 * FROM 許可");
                var hasChangeFlag = false;
                for (var i = 0; i < rs.Fields.Count; i++) {
                    if (rs.Fields(i).Name === "変更許可フラグ") { hasChangeFlag = true; break; }
                }
                rs.Close();
                if (!hasChangeFlag) {
                    conn.Execute("ALTER TABLE 許可 ADD COLUMN 変更許可フラグ YESNO");
                    conn.Execute("UPDATE 許可 SET 変更許可フラグ = False");
                    log("[Migration] 許可.変更許可フラグ カラム追加");
                }
            } catch (e) {
                log("[Migration] 許可.変更許可フラグ: " + e.message);
            }

            // 施設.廃止理由 カラム追加
            try {
                var rs = conn.Execute("SELECT TOP 1 * FROM 施設");
                var hasAbolishReason = false;
                for (var i = 0; i < rs.Fields.Count; i++) {
                    if (rs.Fields(i).Name === "廃止理由") { hasAbolishReason = true; break; }
                }
                rs.Close();
                if (!hasAbolishReason) {
                    conn.Execute("ALTER TABLE 施設 ADD COLUMN 廃止理由 VARCHAR(200)");
                    log("[Migration] 施設.廃止理由 カラム追加");
                }
            } catch (e) {
                log("[Migration] 施設.廃止理由: " + e.message);
            }

            // マスター_役職テーブル作成
            try {
                conn.Execute("SELECT TOP 1 * FROM マスター_役職");
            } catch (e) {
                try {
                    conn.Execute("CREATE TABLE マスター_役職 (役職ID AUTOINCREMENT PRIMARY KEY, 役職名 VARCHAR(100))");
                    var defaultPositions = ['代表取締役', '専務取締役', '常務取締役', '取締役', '監査役', '部長', '課長', 'その他'];
                    for (var pi = 0; pi < defaultPositions.length; pi++) {
                        conn.Execute("INSERT INTO マスター_役職 (役職名) VALUES ('" + defaultPositions[pi] + "')");
                    }
                    log("[Migration] マスター_役職 テーブル作成 + 初期データ");
                } catch (e2) {
                    log("[Migration] マスター_役職: " + e2.message);
                }
            }

            // 全角英数字→半角の一括補正（事業者住所・電話番号、許可番号、施設許可番号）
            try {
                var updated = 0;
                var rs = conn.Execute("SELECT 事業者ID, 市区町村町名番地, 電話番号 FROM 事業者");
                while (!rs.EOF) {
                    var id = rs.Fields("事業者ID").Value;
                    var addr = rs.Fields("市区町村町名番地").Value || "";
                    var tel = rs.Fields("電話番号").Value || "";
                    var newAddr = normalizeToHankaku(addr);
                    var newTel = normalizeToHankaku(tel);
                    if (newAddr !== addr || newTel !== tel) {
                        conn.Execute("UPDATE 事業者 SET 市区町村町名番地 = '" + escapeSql(newAddr) + "', 電話番号 = '" + escapeSql(newTel) + "' WHERE 事業者ID = " + id);
                        updated++;
                    }
                    rs.MoveNext();
                }
                rs.Close();
                if (updated > 0) log("[Migration] 事業者 全角→半角補正: " + updated + "件");
            } catch (e) {
                log("[Migration] 事業者 全角→半角補正エラー: " + e.message);
            }

            // 施設休止履歴テーブル作成
            try {
                conn.Execute("SELECT TOP 1 * FROM 施設休止履歴");
            } catch (e) {
                try {
                    conn.Execute("CREATE TABLE 施設休止履歴 (休止履歴ID AUTOINCREMENT PRIMARY KEY, 施設ID LONG, 休止年月日 DATETIME, 再開年月日 DATETIME, 休止理由 MEMO)");
                    log("[Migration] 施設休止履歴 テーブル作成");
                } catch (e2) {
                    log("[Migration] 施設休止履歴: " + e2.message);
                }
            }

            // 施設.休止理由 カラム追加
            try {
                conn.Execute("SELECT TOP 1 休止理由 FROM 施設");
            } catch (e) {
                try {
                    conn.Execute("ALTER TABLE 施設 ADD COLUMN 休止理由 MEMO");
                    log("[Migration] 施設.休止理由 カラム追加");
                } catch (e2) {
                    log("[Migration] 施設.休止理由: " + e2.message);
                }
            }

            // 許可.失効新規フラグ カラム追加
            try {
                conn.Execute("SELECT TOP 1 失効新規フラグ FROM 許可");
            } catch (e) {
                try {
                    conn.Execute("ALTER TABLE 許可 ADD COLUMN 失効新規フラグ YESNO");
                    conn.Execute("UPDATE 許可 SET 失効新規フラグ = False");
                    log("[Migration] 許可.失効新規フラグ カラム追加");
                } catch (e2) {
                    log("[Migration] 許可.失効新規フラグ: " + e2.message);
                }
            }
        }

        function setDbStatus(message, isError) {
            var elem = document.getElementById("dbStatus");
            elem.innerText = "DB: " + message;
            elem.className = isError ? "db-status error" : "db-status";
        }

        // ===== データベース設定UI =====
        function showDbSettingsEdit() {
            document.getElementById("inputDbPath").value = dbPath;
            document.getElementById("dbSettingsView").style.display = "none";
            document.getElementById("dbSettingsEdit").style.display = "block";
        }

        function cancelDbSettingsEdit() {
            document.getElementById("dbSettingsEdit").style.display = "none";
            document.getElementById("dbSettingsView").style.display = "block";
        }

        function browseDbFile() {
            try {
                var shell = new ActiveXObject("Shell.Application");
                var folder = shell.BrowseForFolder(0, "データベースファイルのあるフォルダを選択してください", 0x0010, getAppFolder());
                if (folder) {
                    var folderPath = folder.Self.Path;
                    var fso = new ActiveXObject("Scripting.FileSystemObject");
                    var folderObj = fso.GetFolder(folderPath);
                    var files = new Enumerator(folderObj.Files);
                    var accdbFiles = [];
                    while (!files.atEnd()) {
                        var f = files.item();
                        var ext = fso.GetExtensionName(f.Name).toLowerCase();
                        if (ext === "accdb" || ext === "mdb") {
                            accdbFiles.push(f.Path);
                        }
                        files.moveNext();
                    }
                    if (accdbFiles.length === 0) {
                        showToast("選択したフォルダにデータベースファイル (.accdb/.mdb) が見つかりません", "error");
                    } else if (accdbFiles.length === 1) {
                        document.getElementById("inputDbPath").value = accdbFiles[0];
                    } else {
                        // 複数ファイルがある場合は最初の .accdb を優先
                        var chosen = accdbFiles[0];
                        for (var i = 0; i < accdbFiles.length; i++) {
                            if (fso.GetExtensionName(accdbFiles[i]).toLowerCase() === "accdb") {
                                chosen = accdbFiles[i];
                                break;
                            }
                        }
                        document.getElementById("inputDbPath").value = chosen;
                        showToast(accdbFiles.length + " 件のDBファイルが見つかりました。先頭のファイルを選択しました。", "info");
                    }
                }
            } catch (e) {
                showToast("フォルダ参照エラー: " + e.message, "error");
            }
        }

        function applyDbPath() {
            var newPath = document.getElementById("inputDbPath").value.replace(/^\s+|\s+$/g, "");
            if (!newPath) { showToast("パスを入力してください", "error"); return; }
            showLoading();
            try {
                // 既存接続を閉じる
                if (conn) {
                    try { conn.Close(); } catch (e) { /* ignore */ }
                    conn = null;
                }
                conn = connectToDb(newPath);
                dbPath = newPath;
                // 設定を保存
                var settings = loadSettings();
                settings.dbPath = newPath;
                saveSettings(settings);
                // UI更新
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                document.getElementById("dbPathDisplay").innerText = dbPath;
                setDbStatus("接続済み: " + fso.GetFileName(dbPath), false);
                document.getElementById("dbStatusDisplay").innerText = "接続成功";
                cancelDbSettingsEdit();
                hideLoading();
                showToast("データベースを変更しました", "success");
                loadDashboard();
            } catch (e) {
                hideLoading();
                setDbStatus("接続エラー: " + e.message, true);
                document.getElementById("dbStatusDisplay").innerText = "エラー: " + e.message;
                showToast("接続エラー: " + e.message, "error");
            }
        }

        function resetDbPath() {
            document.getElementById("inputDbPath").value = getDefaultDbPath();
        }

        function showPage(pageId, skipHistory) {
            var currentPage = getCurrentPage();
            // スクロール位置を保存
            savedScrollPositions[currentPage] = document.documentElement.scrollTop || document.body.scrollTop;
            if (!skipHistory && currentPage !== pageId) {
                navStack.push(currentPage);
                if (navStack.length > NAV_STACK_MAX) { navStack.shift(); }
            }
            var pages = document.getElementsByClassName("page");
            for (var i = 0; i < pages.length; i++) pages[i].className = "page";
            document.getElementById("page-" + pageId).className = "page active";
            // ページ固有の初期化
            if (pageId === "home") { loadDashboard(); animateHomeEntrance(); }
            if (pageId === "search-permit") { initPermitSearch(); }
            if (pageId === "search-facility") { initFacilitySearch(); }
            // パンくずリスト更新
            updateBreadcrumb(pageId);
            // スクロール位置を復元（戻る時）または先頭へ
            if (skipHistory && savedScrollPositions[pageId] !== undefined) {
                setTimeout(function() { window.scrollTo(0, savedScrollPositions[pageId]); }, 0);
            } else {
                window.scrollTo(0, 0);
            }
        }

        function goBack() {
            var currentPage = getCurrentPage();
            if (currentPage === "business-form" || currentPage === "master-form") {
                if (formDirty) {
                    showConfirmDialog("確認", "変更が保存されていません。このページを離れますか？", {
                        okText: "離れる", okClass: "btn-warning",
                        onOk: function() {
                            formDirty = false;
                            if (navStack.length > 0) { showPage(navStack.pop(), true); }
                            else { showPage("home", true); }
                        }
                    });
                    return;
                }
            }
            if (navStack.length > 0) {
                var prevPage = navStack.pop();
                showPage(prevPage, true);
            } else {
                showPage("home", true);
            }
        }

        function markFormDirty() { formDirty = true; }

        function updateBreadcrumb(pageId) {
            var bar = document.getElementById("breadcrumb-bar");
            var content = document.getElementById("breadcrumb-content");
            if (!bar || !content) return;
            if (pageId === "home") {
                bar.style.display = "none";
                return;
            }
            bar.style.display = "block";
            // 詳細ページはnavStackから動的にパンくずを生成
            if (pageId === "detail" || pageId === "business-form") {
                var html = "<a onclick='showPage(\"home\")'>ホーム</a>";
                html += "<span class='breadcrumb-separator'>&gt;</span>";
                if (navStack.length > 0) {
                    var prevPage = navStack[navStack.length - 1];
                    if (prevPage !== "home" && PAGE_TITLES[prevPage]) {
                        html += "<a onclick='goBack()'>" + PAGE_TITLES[prevPage] + "</a>";
                        html += "<span class='breadcrumb-separator'>&gt;</span>";
                    }
                }
                html += "<span class='breadcrumb-current'>" + (PAGE_TITLES[pageId] || pageId) + "</span>";
                content.innerHTML = html;
                return;
            }
            var ancestors = PAGE_HIERARCHY[pageId] || [];
            var html = "";
            for (var i = 0; i < ancestors.length; i++) {
                var aId = ancestors[i];
                html += "<a onclick='showPage(\"" + aId + "\")'>" + PAGE_TITLES[aId] + "</a>";
                html += "<span class='breadcrumb-separator'>&gt;</span>";
            }
            html += "<span class='breadcrumb-current'>" + (PAGE_TITLES[pageId] || pageId) + "</span>";
            content.innerHTML = html;
        }

        // ===== ダッシュボード =====
        function loadDashboard() {
            if (!conn) return;
            try {
                var el;
                var statsQueries = buildStatisticsQueries();
                var rs1 = conn.Execute(statsQueries.businessCount);
                var bizCount = rs1.Fields("cnt").Value;
                el = document.getElementById("dash-biz"); if (el) el.innerText = bizCount;
                el = document.getElementById("strip-biz"); if (el) el.innerText = bizCount;
                rs1.Close();
                var rs2 = conn.Execute(statsQueries.permitCount);
                var permitCount = rs2.Fields("cnt").Value;
                el = document.getElementById("dash-permit"); if (el) el.innerText = permitCount;
                el = document.getElementById("strip-permit"); if (el) el.innerText = permitCount;
                rs2.Close();
                var rs3 = conn.Execute(statsQueries.facilityCount);
                var facilityCount = rs3.Fields("cnt").Value;
                el = document.getElementById("dash-facility"); if (el) el.innerText = facilityCount;
                el = document.getElementById("strip-facility"); if (el) el.innerText = facilityCount;
                rs3.Close();
                var expiringCountSql = buildExpiringPermitsCountQuery();
                var rs4 = conn.Execute(expiringCountSql);
                var expiringCount = rs4.Fields("cnt").Value;
                el = document.getElementById("dash-expiring"); if (el) el.innerText = expiringCount;
                el = document.getElementById("strip-expiring"); if (el) el.innerText = expiringCount;
                rs4.Close();
                // 統計ストリップ表示
                var strip = document.getElementById("statsStrip");
                if (strip) { strip.style.display = "inline-flex"; }
                // 期限1年以内の警告色
                var expiringItem = document.getElementById("strip-expiring-item");
                if (expiringItem) {
                    if (expiringCount > 0) { expiringItem.className = "stat-item stat-warn"; }
                    else { expiringItem.className = "stat-item"; }
                }
                // 通知バッジ
                var badge = document.getElementById("permitBadge");
                if (badge) {
                    if (expiringCount > 0) {
                        badge.innerText = expiringCount > 99 ? "99+" : expiringCount;
                        badge.style.display = "flex";
                    } else {
                        badge.style.display = "none";
                    }
                }
            } catch (e) { log("loadDashboard error: " + e.message); }
        }

        // ===== ホーム画面スタガードアニメーション =====
        function animateHomeEntrance() {
            var buttons = document.getElementById("page-home").getElementsByClassName("menu-button");
            for (var i = 0; i < buttons.length; i++) {
                buttons[i].className = buttons[i].className.replace(/ ?stagger-show/g, "");
                if (buttons[i].className.indexOf("stagger-init") === -1) {
                    buttons[i].className += " stagger-init";
                }
            }
            var baseDelay = 80;
            var stepDelay = 50;
            for (var j = 0; j < buttons.length; j++) {
                (function(btn, delay) {
                    setTimeout(function() {
                        btn.className += " stagger-show";
                    }, delay);
                })(buttons[j], baseDelay + j * stepDelay);
            }
        }

        // ===== クイック検索 タイプ切替（トップページから削除済み、関数は維持） =====
        var quickSearchType = "business";
        function switchSearchType(type, btn) {
            quickSearchType = type;
            var btns = document.getElementsByClassName("search-type-btn");
            for (var i = 0; i < btns.length; i++) btns[i].className = "search-type-btn";
            btn.className = "search-type-btn active";
            var input = document.getElementById("quickSearchKeyword");
            if (!input) return;
            if (type === "permit") {
                input.placeholder = "許可番号で検索してジャンプ...";
            } else {
                input.placeholder = "事業者名で検索してジャンプ...";
            }
            var rd = document.getElementById("quickSearchResult");
            if (rd) rd.innerHTML = "";
        }

        // ===== ホーム画面クイック検索（トップページから削除済み、関数は維持） =====
        function quickSearch() {
            var keyword = document.getElementById("quickSearchKeyword");
            if (!keyword) return;
            keyword = keyword.value;
            var resultDiv = document.getElementById("quickSearchResult");
            if (!resultDiv) return;
            if (!keyword) { resultDiv.innerHTML = ""; return; }
            if (!conn) { resultDiv.innerHTML = "<p class='tc-muted'>データベースに接続されていません</p>"; return; }

            if (quickSearchType === "permit") {
                // 許可番号検索モード
                try {
                    var sql = buildSearchPermitQuery({ keyword: keyword });
                    var rs = conn.Execute(sql);
                    var results = [];
                    while (!rs.EOF && results.length < 10) {
                        results.push({
                            bizId: rs.Fields("事業者ID").Value,
                            permitNo: rs.Fields("許可番号").Value || "",
                            bizName: rs.Fields("事業者名").Value || "",
                            catName: rs.Fields("許可区分名").Value || ""
                        });
                        rs.MoveNext();
                    }
                    rs.Close();
                    if (results.length === 0) {
                        resultDiv.innerHTML = "<p class='tc-warn'>見つかりませんでした</p>";
                    } else {
                        var html = "<div class='bg-surface' style='border-radius:8px;padding:10px;max-height:200px;overflow-y:auto;'>";
                        html += "<p class='tc-sub' style='font-size:0.85em;margin-bottom:8px;'>" + results.length + "件見つかりました:</p>";
                        for (var i = 0; i < results.length; i++) {
                            html += "<div class='tc search-result-item' onclick='document.getElementById(\"quickSearchResult\").innerHTML=\"\";loadBusinessDetail(" + results[i].bizId + ")'>";
                            html += escapeHtml(results[i].permitNo) + " <span class='tc-sub' style='font-size:0.85em;'>(" + escapeHtml(results[i].catName) + " / " + escapeHtml(results[i].bizName) + ")</span></div>";
                        }
                        html += "</div>";
                        resultDiv.innerHTML = html;
                    }
                } catch (e) { resultDiv.innerHTML = "<p class='tc-error'>エラー: " + e.message + "</p>"; }
                return;
            }

            // 事業者検索モード（既存ロジック）
            try {
                var sql = buildSearchBusinessQuery(keyword);
                var rs = conn.Execute(sql);
                var results = [];
                while (!rs.EOF) {
                    results.push({ id: rs.Fields("事業者ID").Value, name: rs.Fields("事業者名").Value || "" });
                    rs.MoveNext();
                }
                rs.Close();
                if (results.length === 0) {
                    resultDiv.innerHTML = "<p class='tc-warn'>見つかりませんでした</p>";
                } else if (results.length === 1) {
                    resultDiv.innerHTML = "";
                    loadBusinessDetail(results[0].id);
                } else {
                    var html = "<div class='bg-surface' style='border-radius:8px;padding:10px;max-height:200px;overflow-y:auto;'>";
                    html += "<p class='tc-sub' style='font-size:0.85em;margin-bottom:8px;'>" + results.length + "件見つかりました - 選択してください:</p>";
                    for (var i = 0; i < results.length; i++) {
                        html += "<div class='tc search-result-item' onclick='document.getElementById(\"quickSearchResult\").innerHTML=\"\";loadBusinessDetail(" + results[i].id + ")'>";
                        html += escapeHtml(results[i].name) + "</div>";
                    }
                    html += "</div>";
                    resultDiv.innerHTML = html;
                }
            } catch (e) { resultDiv.innerHTML = "<p class='tc-error'>エラー: " + e.message + "</p>"; }
        }

        function toggleAdvancedFilters() {
            var div = document.getElementById("advancedFilters");
            var btn = document.getElementById("btnAdvancedFilters");
            if (div.style.display === "none") {
                div.style.display = "block";
                updateFilterBadge();
            } else {
                div.style.display = "none";
                updateFilterBadge();
            }
        }

        function getActiveFilterCount() {
            var count = 0;
            if (document.getElementById("searchPermitCategory").value) count++;
            if (document.getElementById("searchPermitExpiry").value) count++;
            if (document.getElementById("searchPermitStatus").value) count++;
            if (document.getElementById("searchPermitExcellent").checked) count++;
            var chips = document.getElementById("searchPermitItemsContainer");
            if (chips) {
                var inputs = chips.getElementsByTagName("input");
                for (var i = 0; i < inputs.length; i++) {
                    if (inputs[i].checked) { count++; break; }
                }
            }
            return count;
        }

        // 施設検索フィルター
        function toggleFacilityAdvancedFilters() {
            var div = document.getElementById("facilityAdvancedFilters");
            var btn = document.getElementById("btnFacilityAdvancedFilters");
            if (div.style.display === "none") {
                div.style.display = "block";
                updateFacilityFilterBadge();
            } else {
                div.style.display = "none";
                updateFacilityFilterBadge();
            }
        }

        function getFacilityActiveFilterCount() {
            var count = 0;
            if (document.getElementById("searchFacilityType").value) count++;
            var status = document.getElementById("searchFacilityStatus").value;
            if (status && status !== "active") count++;
            var methodEl = document.getElementById("searchFacilityMethod");
            if (methodEl && methodEl.value) count++;
            var ptEl = document.getElementById("searchFacilityPermitTarget");
            if (ptEl && ptEl.value) count++;
            var capEl = document.getElementById("searchFacilityMinCapacity");
            if (capEl && capEl.value) count++;
            var selfEl = document.getElementById("searchFacilityExcludeSelf");
            if (selfEl && selfEl.checked) count++;
            return count;
        }

        function updateFacilityFilterBadge() {
            var btn = document.getElementById("btnFacilityAdvancedFilters");
            var div = document.getElementById("facilityAdvancedFilters");
            var count = getFacilityActiveFilterCount();
            var text = "詳細フィルター";
            if (count > 0) text += " (" + count + ")";
            text += (div.style.display === "none") ? " ▼" : " ▲";
            btn.innerHTML = text;
        }

        function updateFilterBadge() {
            var btn = document.getElementById("btnAdvancedFilters");
            var div = document.getElementById("advancedFilters");
            var count = getActiveFilterCount();
            var text = "詳細フィルター";
            if (count > 0) text += " (" + count + ")";
            text += (div.style.display === "none") ? " ▼" : " ▲";
            btn.innerHTML = text;
        }

        function initPermitSearch() {
            // 検索基準日を今日に設定（未設定の場合）
            var dateInput = document.getElementById("searchPermitAsOfDateValue");
            if (!dateInput.value) {
                var today = new Date();
                dateInput.value = today.getFullYear() + "/" + padZero2(today.getMonth() + 1) + "/" + padZero2(today.getDate());
            }
            if (!conn) return;
            try {
                // 許可区分
                var select = document.getElementById("searchPermitCategory");
                if (select.options.length <= 1) {
                    var rs = conn.Execute(buildMasterListQuery("マスター_許可区分", "許可区分ID", "許可区分名"));
                    while (!rs.EOF) {
                        var opt = document.createElement("option");
                        opt.value = rs.Fields("許可区分ID").Value;
                        opt.text = rs.Fields("許可区分名").Value;
                        select.add(opt);
                        rs.MoveNext();
                    }
                    rs.Close();
                }
                // 品目（チェックボックス）
                var container = document.getElementById("searchPermitItemsContainer");
                if (container && container.innerHTML === "") {
                    var rs = conn.Execute(buildMasterListQuery("マスター_品目", "品目ID", "品目名", "表示順"));
                    var html = "";
                    while (!rs.EOF) {
                        html += "<label class='item-chip'>";
                        html += "<input type='checkbox' class='permitItemCheckbox' value='" + rs.Fields("品目ID").Value + "'>";
                        html += escapeHtml(rs.Fields("品目名").Value) + "</label>";
                        rs.MoveNext();
                    }
                    rs.Close();
                    container.innerHTML = html;
                }
            } catch (e) { log("initPermitSearch error: " + e.message); }
        }

        function clearPermitItemSelection() {
            var checkboxes = document.getElementsByClassName("permitItemCheckbox");
            for (var i = 0; i < checkboxes.length; i++) {
                checkboxes[i].checked = false;
            }
        }

        function selectAllPermitItems() {
            var checkboxes = document.getElementsByClassName("permitItemCheckbox");
            for (var i = 0; i < checkboxes.length; i++) {
                checkboxes[i].checked = true;
            }
        }

        // padZero2 は app_logic.js に移動済み

        // カレンダー関連
        var datePickerTarget = null;
        var datePickerYear = 0;
        var datePickerMonth = 0;

        function showDatePicker(inputEl) {
            datePickerTarget = inputEl;
            var popup = document.getElementById("datePickerPopup");
            // 現在の値から年月を取得、なければ今日
            var today = new Date();
            if (inputEl.value) {
                var parts = inputEl.value.split("/");
                datePickerYear = parseInt(parts[0], 10);
                datePickerMonth = parseInt(parts[1], 10) - 1;
            } else {
                datePickerYear = today.getFullYear();
                datePickerMonth = today.getMonth();
            }
            renderCalendar();
            // 入力欄の下に表示
            var rect = inputEl.getBoundingClientRect();
            var scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
            var scrollLeft = document.documentElement.scrollLeft || document.body.scrollLeft;
            popup.style.top = (rect.bottom + scrollTop + 5) + "px";
            popup.style.left = (rect.left + scrollLeft) + "px";
            popup.style.display = "block";
        }

        function closeDatePicker() {
            document.getElementById("datePickerPopup").style.display = "none";
        }

        function changeMonth(delta) {
            datePickerMonth += delta;
            if (datePickerMonth < 0) { datePickerMonth = 11; datePickerYear--; }
            if (datePickerMonth > 11) { datePickerMonth = 0; datePickerYear++; }
            renderCalendar();
        }

        function renderCalendar() {
            var title = document.getElementById("datePickerTitle");
            title.innerText = datePickerYear + "年 " + (datePickerMonth + 1) + "月";
            var table = document.getElementById("datePickerCalendar");
            var html = "<tr class='cal-header'><th style='padding:5px;width:30px;'>日</th><th style='padding:5px;width:30px;'>月</th><th style='padding:5px;width:30px;'>火</th><th style='padding:5px;width:30px;'>水</th><th style='padding:5px;width:30px;'>木</th><th style='padding:5px;width:30px;'>金</th><th style='padding:5px;width:30px;'>土</th></tr>";
            var firstDay = new Date(datePickerYear, datePickerMonth, 1).getDay();
            var lastDate = new Date(datePickerYear, datePickerMonth + 1, 0).getDate();
            var today = new Date();
            var todayStr = today.getFullYear() + "/" + padZero2(today.getMonth() + 1) + "/" + padZero2(today.getDate());
            var selectedStr = datePickerTarget ? datePickerTarget.value : "";
            var day = 1;
            for (var row = 0; row < 6; row++) {
                html += "<tr>";
                for (var col = 0; col < 7; col++) {
                    if (row === 0 && col < firstDay) {
                        html += "<td></td>";
                    } else if (day > lastDate) {
                        html += "<td></td>";
                    } else {
                        var dateStr = datePickerYear + "/" + padZero2(datePickerMonth + 1) + "/" + padZero2(day);
                        var cls = "cal-day";
                        if (col === 0) cls += " tc-sun";
                        else if (col === 6) cls += " tc-sat";
                        if (dateStr === todayStr) cls += " cal-day-today";
                        if (dateStr === selectedStr) cls += " cal-day-selected";
                        html += "<td class='" + cls + "' style='padding:5px;text-align:center;' onclick='selectDate(" + day + ");event.stopPropagation();'>" + day + "</td>";
                        day++;
                    }
                }
                html += "</tr>";
                if (day > lastDate) break;
            }
            table.innerHTML = html;
        }

        function selectDate(day) {
            var dateStr = datePickerYear + "/" + padZero2(datePickerMonth + 1) + "/" + padZero2(day);
            if (datePickerTarget) {
                datePickerTarget.value = dateStr;
            }
            closeDatePicker();
        }

        function selectToday() {
            var today = new Date();
            datePickerYear = today.getFullYear();
            datePickerMonth = today.getMonth();
            selectDate(today.getDate());
        }

        // ===== フローティング日付ピッカー（編集フォーム用） =====
        var _dpTarget = null;
        var _dpYear = 0;
        var _dpMonth = 0;

        // 日付フォーマット正規化: onblurで呼ばれ、手入力値をyyyy/mm/ddに補正
        function normalizeDateInput(input) {
            var val = (typeof input === "string") ? input : input.value;
            if (!val) return;
            // 全角→半角
            val = val.replace(/[０-９]/g, function(c) { return String.fromCharCode(c.charCodeAt(0) - 0xFEE0); });
            val = val.replace(/[ー−―]/g, "-").replace(/[．。]/g, "/");
            // yyyy-mm-dd or yyyy/mm/dd or yyyymmdd
            var m;
            if ((m = val.match(/^(\d{4})[\/-](\d{1,2})[\/-](\d{1,2})$/))) {
                val = m[1] + "/" + padZero2(parseInt(m[2],10)) + "/" + padZero2(parseInt(m[3],10));
            } else if ((m = val.match(/^(\d{4})(\d{2})(\d{2})$/))) {
                val = m[1] + "/" + m[2] + "/" + m[3];
            } else {
                return; // パースできない場合はそのまま
            }
            // 日付妥当性チェック
            var parts = val.split("/");
            var d = new Date(parseInt(parts[0],10), parseInt(parts[1],10)-1, parseInt(parts[2],10));
            if (d.getFullYear() === parseInt(parts[0],10) && d.getMonth() === parseInt(parts[1],10)-1 && d.getDate() === parseInt(parts[2],10)) {
                if (typeof input !== "string") input.value = val;
                return val;
            }
        }

        function openDatePicker(inputId) {
            closeFloatingDatePicker();
            _dpTarget = document.getElementById(inputId);
            var wrapper = _dpTarget.parentNode;
            // datepicker-wrapperでない場合はwrapperを自動生成
            if (!wrapper.className || wrapper.className.indexOf("datepicker-wrapper") < 0) {
                var newWrapper = document.createElement("div");
                newWrapper.className = "datepicker-wrapper";
                newWrapper.style.cssText = "position:relative; display:inline-block;";
                wrapper.insertBefore(newWrapper, _dpTarget);
                newWrapper.appendChild(_dpTarget);
                wrapper = newWrapper;
            }
            var val = _dpTarget.value;
            var now = new Date();
            if (val && val.match(/\d{4}[\/-]\d{1,2}[\/-]\d{1,2}/)) {
                var parts = val.replace(/-/g, "/").split("/");
                _dpYear = parseInt(parts[0], 10);
                _dpMonth = parseInt(parts[1], 10) - 1;
            } else {
                _dpYear = now.getFullYear();
                _dpMonth = now.getMonth();
            }
            var popup = document.createElement("div");
            popup.id = "datepicker-popup";
            popup.className = "datepicker-popup";
            renderDatePicker(popup);
            wrapper.appendChild(popup);
        }

        function closeFloatingDatePicker() {
            var old = document.getElementById("datepicker-popup");
            if (old) old.parentNode.removeChild(old);
        }

        function renderDatePicker(popup) {
            if (!popup) popup = document.getElementById("datepicker-popup");
            if (!popup) return;
            var html = "<table style='width:100%;border-collapse:collapse;'><tr>";
            html += "<td style='text-align:left;'><button onclick='dpPrevYear();event.stopPropagation();return false;' class='cal-nav-btn' style='padding:2px 6px;'>&laquo;</button> <button onclick='dpPrev();event.stopPropagation();return false;' class='cal-nav-btn' style='padding:2px 8px;'>&lt;</button></td>";
            html += "<td style='text-align:center;font-weight:bold;font-size:14px;' class='tc-accent'>" + _dpYear + "年 " + (_dpMonth + 1) + "月</td>";
            html += "<td style='text-align:right;'><button onclick='dpNext();event.stopPropagation();return false;' class='cal-nav-btn' style='padding:2px 8px;'>&gt;</button> <button onclick='dpNextYear();event.stopPropagation();return false;' class='cal-nav-btn' style='padding:2px 6px;'>&raquo;</button></td>";
            html += "</tr></table>";
            html += "<table style='width:100%;border-collapse:collapse;margin-top:5px;'>";
            var dows = ["日","月","火","水","木","金","土"];
            html += "<tr>";
            for (var d = 0; d < 7; d++) {
                var dowCls = d === 0 ? "tc-sun" : (d === 6 ? "tc-sat" : "tc-muted");
                html += "<td class='" + dowCls + "' style='text-align:center;font-size:11px;padding:3px;'>" + dows[d] + "</td>";
            }
            html += "</tr>";
            var firstDay = new Date(_dpYear, _dpMonth, 1).getDay();
            var daysInMonth = new Date(_dpYear, _dpMonth + 1, 0).getDate();
            var today = new Date();
            var cellCount = 0;
            html += "<tr>";
            for (var i = 0; i < firstDay; i++) { html += "<td></td>"; cellCount++; }
            for (var day = 1; day <= daysInMonth; day++) {
                var dateStr = _dpYear + "/" + padZero2(_dpMonth + 1) + "/" + padZero2(day);
                var isToday = (_dpYear === today.getFullYear() && _dpMonth === today.getMonth() && day === today.getDate());
                var cls = "cal-day";
                var dow = (firstDay + day - 1) % 7;
                if (dow === 0) cls += " tc-sun";
                else if (dow === 6) cls += " tc-sat";
                if (isToday) cls += " cal-day-today";
                html += "<td class='" + cls + "' style='text-align:center;padding:5px;font-size:13px;' onclick='dpSelect(\"" + dateStr + "\");event.stopPropagation();'>" + day + "</td>";
                cellCount++;
                if (cellCount % 7 === 0 && day < daysInMonth) html += "</tr><tr>";
            }
            while (cellCount % 7 !== 0) { html += "<td></td>"; cellCount++; }
            html += "</tr></table>";
            popup.innerHTML = html;
        }

        function dpPrevYear() { _dpYear--; renderDatePicker(); }
        function dpNextYear() { _dpYear++; renderDatePicker(); }
        function dpPrev() { _dpMonth--; if (_dpMonth < 0) { _dpMonth = 11; _dpYear--; } renderDatePicker(); }
        function dpNext() { _dpMonth++; if (_dpMonth > 11) { _dpMonth = 0; _dpYear++; } renderDatePicker(); }
        function dpSelect(dateStr) {
            if (_dpTarget) _dpTarget.value = dateStr;
            closeFloatingDatePicker();
        }

        // テーマ切り替え
        var currentTheme = "dark";
        function toggleTheme() {
            if (currentTheme === "light") {
                currentTheme = "dark";
                document.body.className = "theme-dark";
                document.getElementById("themeToggleBtn").innerHTML = "ライト";
            } else {
                currentTheme = "light";
                document.body.className = "theme-light";
                document.getElementById("themeToggleBtn").innerHTML = "ダーク";
            }
        }

        document.onclick = function(e) {
            var popup = document.getElementById("datepicker-popup");
            if (popup) {
                var target = e.srcElement || e.target;
                var isInside = false;
                var node = target;
                while (node) {
                    if (node === popup || (node.className && node.className.indexOf && node.className.indexOf("datepicker-input") >= 0)) { isInside = true; break; }
                    node = node.parentNode;
                }
                if (!isInside) closeFloatingDatePicker();
            }
            // 境界ピッカーも外クリックで閉じる
            var bpPopup = document.getElementById("boundary-picker-popup");
            if (bpPopup) {
                var target2 = e.srcElement || e.target;
                var isInside2 = false;
                var node2 = target2;
                while (node2) {
                    if (node2 === bpPopup || (node2.className && node2.className.indexOf && node2.className.indexOf("timeline-boundary") >= 0)) { isInside2 = true; break; }
                    node2 = node2.parentNode;
                }
                if (!isInside2) closeBoundaryPicker();
            }
        };

        function initFacilitySearch() {
            if (!conn) return;
            try {
                var select = document.getElementById("searchFacilityType");
                if (select.options.length <= 1) {
                    var rs = conn.Execute(buildMasterListQuery("マスター_施設種別", "施設種別ID", "施設種別名"));
                    while (!rs.EOF) {
                        var opt = document.createElement("option");
                        opt.value = rs.Fields("施設種別ID").Value;
                        opt.text = rs.Fields("施設種別名").Value;
                        select.add(opt);
                        rs.MoveNext();
                    }
                    rs.Close();
                }
                // 処理方法マスター
                var methodSelect = document.getElementById("searchFacilityMethod");
                if (methodSelect && methodSelect.options.length <= 1) {
                    var rs2 = conn.Execute(buildMasterListQuery("マスター_処理方法", "処理方法ID", "処理方法名"));
                    while (!rs2.EOF) {
                        var opt2 = document.createElement("option");
                        opt2.value = rs2.Fields("処理方法ID").Value;
                        opt2.text = rs2.Fields("処理方法名").Value;
                        methodSelect.add(opt2);
                        rs2.MoveNext();
                    }
                    rs2.Close();
                }
                // 許可対象区分マスター
                var ptSelect = document.getElementById("searchFacilityPermitTarget");
                if (ptSelect && ptSelect.options.length <= 1) {
                    var rs3 = conn.Execute(buildMasterListQuery("マスター_許可対象区分", "許可対象区分ID", "許可対象区分名"));
                    while (!rs3.EOF) {
                        var opt3 = document.createElement("option");
                        opt3.value = rs3.Fields("許可対象区分ID").Value;
                        opt3.text = rs3.Fields("許可対象区分名").Value;
                        ptSelect.add(opt3);
                        rs3.MoveNext();
                    }
                    rs3.Close();
                }
                // 品目マスター（チェックボックスフィルタ用）
                var itemContainer = document.getElementById("searchFacilityItemCheckboxes");
                if (itemContainer && itemContainer.children.length === 0) {
                    var rs4 = conn.Execute(buildMasterListQuery("マスター_品目", "品目ID", "品目名", "表示順"));
                    while (!rs4.EOF) {
                        var lbl = document.createElement("label");
                        lbl.style.cssText = "font-weight:normal;margin-right:12px;font-size:0.85em;white-space:nowrap;";
                        var cb = document.createElement("input");
                        cb.type = "checkbox";
                        cb.value = rs4.Fields("品目ID").Value;
                        cb.style.cssText = "margin-right:3px;";
                        lbl.appendChild(cb);
                        lbl.appendChild(document.createTextNode(rs4.Fields("品目名").Value));
                        itemContainer.appendChild(lbl);
                        rs4.MoveNext();
                    }
                    rs4.Close();
                }
            } catch (e) { }
        }

        function updateDateTime() {
            var now = new Date();
            var weekdays = ["日", "月", "火", "水", "木", "金", "土"];
            var str = now.getFullYear() + "/" + padZero(now.getMonth() + 1) + "/" + padZero(now.getDate()) + " (" + weekdays[now.getDay()] + ") " + padZero(now.getHours()) + ":" + padZero(now.getMinutes());
            document.getElementById("dateTime").innerText = str;
        }

        // padZero は app_logic.js に移動済み

        // ===== 事業者一覧 =====
        var businessListSortCol = "事業者名";
        var businessListSortDir = "ASC";

        function loadBusinessList(skipNav) {
            if (!skipNav) showPage("list");
            if (!conn) { document.getElementById("businessList").innerHTML = "<p>データベースに接続されていません</p>"; return; }
            showLoading();
            try {
                var rs = conn.Execute(buildLoadBusinessListQuery(businessListSortCol, businessListSortDir));
                var count = 0;
                var rows = "";
                while (!rs.EOF) {
                    count++;
                    var id = rs.Fields("事業者ID").Value;
                    rows += "<tr>";
                    rows += "<td>" + escapeHtml(rs.Fields("事業者名").Value || "") + "</td>";
                    rows += "<td>" + escapeHtml((rs.Fields("都道府県").Value || "") + (rs.Fields("市区町村町名番地").Value || "")) + "</td>";
                    rows += "<td>" + escapeHtml(rs.Fields("電話番号").Value || "") + "</td>";
                    rows += "<td><button class='btn btn-primary btn-md' onclick='loadBusinessDetail(" + id + ")'>詳細</button></td>";
                    rows += "</tr>";
                    rs.MoveNext();
                }
                rs.Close();
                var html = "<p class='text-note' style='margin-bottom:8px;'>" + count + " 件</p>";
                if (count === 0) {
                    html += "<p class='text-note'>事業者の登録はまだありません。</p>";
                } else {
                    html += "<table class='data-table'><tr>";
                    html += sortableHeader("事業者名", "事業者名") + sortableHeader("住所", "都道府県") + sortableHeader("電話番号", "電話番号") + "<th>操作</th>";
                    html += "</tr>" + rows + "</table>";
                }
                hideLoading();
                document.getElementById("businessList").innerHTML = html;
            } catch (e) { hideLoading(); document.getElementById("businessList").innerHTML = "<p>エラー: " + e.message + "</p>"; }
        }

        function sortableHeader(label, colName) {
            var arrow = "";
            if (businessListSortCol === colName) {
                arrow = businessListSortDir === "ASC" ? " &#9650;" : " &#9660;";
            }
            return "<th style='cursor:pointer;' onclick='sortBusinessList(\"" + colName + "\")'>" + label + arrow + "</th>";
        }

        function sortBusinessList(col) {
            if (businessListSortCol === col) {
                businessListSortDir = (businessListSortDir === "ASC") ? "DESC" : "ASC";
            } else {
                businessListSortCol = col;
                businessListSortDir = "ASC";
            }
            loadBusinessList(true);
        }

        // ===== 事業者検索 =====
