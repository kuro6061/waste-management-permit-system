                <div id="import-status" style="margin-bottom:10px;"></div>
                <button class="btn btn-primary" onclick="startLegacyImport()">旧システムからインポート</button>
            </div>
            <div class="detail-card">
                <h2>マスター設定</h2>
                <div class="settings-group" style="margin-top:15px;">
                    <div class="settings-group-title">許可・事業者</div>
                    <div class="menu-grid">
                        <div class="menu-button master-btn" onclick="showMasterSettings('許可区分')"><div class="icon">&#128196;</div><span>許可区分</span></div>
                        <div class="menu-button master-btn" onclick="showMasterSettings('許可対象区分')"><div class="icon">&#128203;</div><span>許可対象区分</span></div>
                        <div class="menu-button master-btn" onclick="showMasterSettings('許可番号形式')"><div class="icon">&#128290;</div><span>許可番号形式</span></div>
                        <div class="menu-button master-btn" onclick="showMasterSettings('事業者区分')"><div class="icon">&#128101;</div><span>事業者区分</span></div>
                        <div class="menu-button master-btn" onclick="showMasterSettings('認定区分')"><div class="icon">&#127942;</div><span>認定区分</span></div>
                        <div class="menu-button master-btn" onclick="showMasterSettings('役職')"><div class="icon">&#128100;</div><span>役職</span></div>
