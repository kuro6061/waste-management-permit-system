            { "label": "取消理由", "condition": "取消理由が空でない" }
          ],
          "buttons": [
            { "label": "復活する", "action": "restoreFacilityFromDetail()" }
          ]
        },
        {
          "id": "state_change",
          "type": "b2_group",
          "label": "状態変更",
          "condition": "isActive",
          "subsections": [
            {
              "label": "この施設を休止する",
              "layout": "compact_horizontal",
              "style": "warning",
              "fields": [
                { "id": "detail-fac-suspend-date", "label": "休止日", "type": "date_picker" },
                { "id": "detail-fac-suspend-reason", "label": "休止理由", "type": "text" }
              ],
              "buttons": [
                { "label": "休止", "action": "suspendFacilityFromDetail()", "style": "warning" }
              ]
            },
