  "detail_views": {
    "permit_detail": {
      "location": "tab-permits内（インライン）",
      "breadcrumb": ["業一覧", "許可詳細"],
      "sections": [
        {
          "id": "header",
          "type": "b2_header",
          "display": [
            { "label": "タイトル", "value": "許可区分名" },
            { "label": "サブタイトル", "value": "許可番号" },
            { "label": "ステータスピル", "logic": "取消>廃止>期限切れ>期限間近>有効" },
            { "label": "優良ピル", "condition": "優良認定 === true" }
          ]
        },
        {
          "id": "basic_info",
          "type": "b2_group",
          "label": "基本情報",
          "display": [
            { "label": "許可区分" },
            { "label": "許可番号" },
            { "label": "許可年月日" },
            { "label": "許可有効年月日" },
            { "label": "優良認定" }
          ]
        },
        {
          "id": "items",
          "type": "b2_group",
          "label": "取扱品目",
          "content": "品目バッジ一覧",
          "clickAction": "showPermitItemsView(permitId, businessId, 'detail')"
        },
        {
          "id": "renewal_actions",
          "type": "action_card_group",
          "layout": "card",
          "condition": "!isCancelled && !isAbolished",
          "buttons": [
            { "label": "更新", "icon": "↻", "color": "blue", "action": "showPermitRenewalForm(logicalId, businessId)", "disabledWhen": null },
            { "label": "変更", "icon": "✎", "color": "amber", "action": "showPermitChangeForm(logicalId, businessId)", "disabledWhen": "isExpired" },
            { "label": "失効新規", "icon": "＋", "color": "orange", "action": "showPermitExpiredNewForm(logicalId, businessId)", "disabledWhen": "!isExpired" }
          ]
        },
        {
          "id": "status_cancelled",
          "type": "b2_group",
          "label": "ステータス",
          "condition": "isCancelled",
          "display": [
            { "label": "状態", "value": "取消（赤ピル）" },
            { "label": "取消日" },
            { "label": "取消理由", "condition": "取消理由が空でない" }
          ],
          "buttons": [
            { "label": "復活する", "action": "restorePermitFromDetail()" }
          ]
        },
        {
          "id": "status_abolished",
          "type": "b2_group",
          "label": "ステータス",
          "condition": "isAbolished",
          "display": [
            { "label": "状態", "value": "廃止（灰ピル）" },
            { "label": "廃止日" },
            { "label": "廃止理由", "condition": "廃止理由が空でない" }
          ],
          "buttons": [
            { "label": "復活する", "action": "restorePermitFromDetail()" }
          ]
        },
        {
          "id": "state_change",
          "type": "b2_group",
          "label": "状態変更",
          "condition": "!isCancelled && !isAbolished",
          "subsections": [
            {
              "label": "この許可を廃止する",
              "fields": [
                { "id": "detail-abolish-date", "label": "廃止日", "type": "date_picker" },
                { "id": "detail-abolish-reason", "label": "廃止理由", "type": "text" }
              ],
              "buttons": [
                { "label": "廃止", "action": "abolishPermitFromDetail()", "style": "warning" }
              ]
            },
            {
              "label": "この許可を取消する",
              "style": "danger",
              "fields": [
                { "id": "detail-cancel-date", "label": "取消日", "type": "date_picker" },
                { "id": "detail-cancel-reason", "label": "取消理由", "type": "text" }
              ],
              "buttons": [
                { "label": "取消", "action": "cancelPermitFromDetail()", "style": "danger" }
              ]
            }
          ]
        },
        {
          "id": "history",
          "type": "vtl_timeline",
          "label": "履歴",
          "content": "loadPermitHistoryVtl(logicalId, businessId)",
          "nodeActions": [
            { "label": "修正", "action": "showPermitEditForm(permitId, logicalId, businessId, 'edit')" },
            { "label": "削除", "action": "deletePermitVersion(permitId, logicalId, businessId)" }
          ]
        }
      ]
    },

