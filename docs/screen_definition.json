              ],
              "buttons": [
                { "label": "取消", "action": "cancelFacilityFromDetail()", "style": "danger" }
              ]
            },
            {
              "label": "この施設を削除する",
              "style": "destructive",
              "note": "処理能力データと全ての履歴も削除されます",
