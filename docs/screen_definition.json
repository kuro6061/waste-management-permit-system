            { "label": "休止日", "condition": "isSuspended" }
          ]
        },
        {
          "id": "status_abolished",
          "type": "b2_group",
          "label": "ステータス",
          "condition": "isAbolished",
          "display": [
            { "label": "状態", "value": "廃止（灰ピル）" },
