            { "label": "廃止確認日", "condition": "廃止確認日が空でない" }
          ],
          "buttons": [
            { "label": "復活する", "action": "restoreFacilityFromDetail()" }
          ]
        },
        {
          "id": "status_cancelled",
          "type": "b2_group",
          "label": "ステータス",
          "condition": "isCancelled",
          "display": [
            { "label": "状態", "value": "取消（赤ピル）" },
