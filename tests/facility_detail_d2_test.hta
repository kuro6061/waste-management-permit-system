<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>施設詳細 B2レイアウト テスト</title>
<HTA:APPLICATION
  APPLICATIONNAME="FacilityDetailB2Test"
  BORDER="thick"
  BORDERSTYLE="normal"
  SCROLL="yes"
  SINGLEINSTANCE="yes"
  WINDOWSTATE="maximize"
/>
<style>
/* === 基盤スタイル (app_source.htaから抜粋) === */
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
    font-family: -apple-system, 'Segoe UI', 'Yu Gothic UI', 'Meiryo UI', 'Helvetica Neue', sans-serif;
    background: #f0f2f5;
    min-height: 100vh;
    color: #1d1d1f;
    -webkit-font-smoothing: antialiased;
}
body.theme-dark {
    background: #15202b;
    color: #e7e9ea;
}
.tab-pane {
    background: #fff;
    border-radius: 14px;
    padding: 24px;
    margin: 24px 40px;
    max-width: 960px;
}
body.theme-dark .tab-pane { background: #192734; }

/* --- permit-detail 基盤 --- */
.permit-detail { max-width: 720px; line-height: 1.7; color: #333; }
body.theme-dark .permit-detail { color: #e7e9ea; }

/* --- step-nav --- */
.step-nav { display: flex; align-items: center; margin-bottom: 16px; padding: 10px 0; }
.step-nav-steps { display: flex; align-items: center; }
.step-nav-steps > * + * { margin-left: 8px; }
.step-nav-step { display: flex; align-items: center; text-decoration: none; color: inherit; cursor: pointer; }
.step-nav-step > * + * { margin-left: 6px; }
.step-dot { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; font-size: 0.75em; font-weight: 700; }
.step-dot.past { background: #e8e8ed; color: #888; }
.step-dot.current { background: #007aff; color: #fff; }
.step-label { font-size: 0.85em; }
.step-label.past { color: #888; }
.step-label.current { color: #007aff; font-weight: 600; }
.step-sep { color: #aaa; font-size: 1.2em; margin: 0 4px; }
.step-nav-right { margin-left: auto; }
.step-nav-right a { color: #007aff; cursor: pointer; font-weight: 500; font-size: 0.9em; }
body.theme-dark .step-dot.past { background: #2a3a4a; color: #888; }
body.theme-dark .step-label.past { color: #888; }
body.theme-dark .step-label.current { color: #4a9eff; }
body.theme-dark .step-sep { color: #555; }
body.theme-dark .step-nav-right a { color: #4a9eff; }

/* ===== B2: Apple HIG準拠 — Grouped Detail ===== */

.b2-header { margin-bottom: 24px; }
.b2-title { font-size: 1.6em; font-weight: 700; letter-spacing: -0.025em; color: #1d1d1f; line-height: 1.2; }
.b2-location { font-size: 0.9em; font-weight: 400; color: #86868b; margin-top: 4px; line-height: 1.4; }
.b2-badges { display: flex; margin-top: 12px; }
.b2-badges > * + * { margin-left: 8px; }
.b2-pill { display: inline-block; padding: 4px 12px; border-radius: 50px; font-size: 0.78em; font-weight: 600; letter-spacing: 0.01em; }
.b2-pill-green { background: #e8f5e9; color: #1b7a2b; }
.b2-pill-gray { background: #f2f2f7; color: #6e6e73; }
.b2-pill-blue { background: #e3f2fd; color: #0a5dc2; }
.b2-pill-orange { background: #fff3e0; color: #c75000; }
.b2-pill-red { background: #fce4ec; color: #c62828; }
.b2-pill-amber { background: #fff8e1; color: #e65100; }
body.theme-dark .b2-title { color: #f5f5f7; }
body.theme-dark .b2-location { color: #86868b; }
body.theme-dark .b2-pill-green { background: #1a3328; color: #4ade80; }
body.theme-dark .b2-pill-gray { background: #2c2c2e; color: #98989d; }
body.theme-dark .b2-pill-blue { background: #1a2a3e; color: #64b5f6; }
body.theme-dark .b2-pill-orange { background: #3a2a1a; color: #ffb74d; }
body.theme-dark .b2-pill-red { background: #3a1a1e; color: #ef5350; }
body.theme-dark .b2-pill-amber { background: #3a2a1a; color: #ffb74d; }

/* Grouped List */
.b2-group { background: #fff; border-radius: 14px; box-shadow: 0 0.5px 1px rgba(0,0,0,0.05), 0 1px 3px rgba(0,0,0,0.06); margin-bottom: 24px; overflow: hidden; }
.b2-group-title { font-size: 0.78em; font-weight: 600; color: #86868b; text-transform: uppercase; letter-spacing: 0.04em; padding: 0 0 8px 4px; }
.b2-row { display: flex; align-items: center; padding: 13px 16px; border-bottom: 1px solid rgba(0,0,0,0.06); }
.b2-row:last-child { border-bottom: none; }
.b2-row-label { font-size: 0.9em; color: #1d1d1f; flex: 0 0 110px; }
.b2-row-value { font-size: 0.9em; font-weight: 500; color: #1d1d1f; flex: 1; text-align: right; }
body.theme-dark .b2-group { background: #1c1c1e; box-shadow: 0 0.5px 1px rgba(0,0,0,0.2), 0 1px 3px rgba(0,0,0,0.25); }
body.theme-dark .b2-group-title { color: #86868b; }
body.theme-dark .b2-row { border-bottom-color: rgba(255,255,255,0.06); }
body.theme-dark .b2-row-label { color: #e5e5e7; }
body.theme-dark .b2-row-value { color: #e5e5e7; }

/* 品目行 */
.b2-cap-row { display: flex; align-items: center; padding: 12px 16px; border-bottom: 1px solid rgba(0,0,0,0.06); }
.b2-cap-row:last-child { border-bottom: none; }
.b2-cap-name { font-size: 0.9em; font-weight: 600; color: #007aff; flex: 0 0 140px; }
.b2-cap-vals { display: flex; flex: 1; justify-content: flex-end; }
.b2-cap-vals > * + * { margin-left: 24px; }
.b2-cap-unit { font-size: 0.78em; color: #86868b; }
.b2-cap-num { font-size: 0.9em; font-weight: 600; font-family: -apple-system, 'SF Mono', 'Segoe UI', monospace; color: #1d1d1f; }
.b2-cap-hours { font-size: 0.78em; color: #aeaeb2; }
body.theme-dark .b2-cap-row { border-bottom-color: rgba(255,255,255,0.06); }
body.theme-dark .b2-cap-name { color: #64b5f6; }
body.theme-dark .b2-cap-num { color: #f5f5f7; }
body.theme-dark .b2-cap-unit { color: #86868b; }
body.theme-dark .b2-cap-hours { color: #636366; }

/* アクション行 */
.b2-action-row { display: block; padding: 13px 16px; text-align: center; font-size: 0.95em; font-weight: 500; color: #007aff; cursor: pointer; border-bottom: 1px solid rgba(0,0,0,0.06); }
.b2-action-row:last-child { border-bottom: none; }
.b2-action-row:hover { background: rgba(0,122,255,0.04); }
body.theme-dark .b2-action-row { color: #0a84ff; }
body.theme-dark .b2-action-row:hover { background: rgba(10,132,255,0.08); }

/* 破壊的行 */
.b2-destructive-row { display: block; padding: 13px 16px; text-align: center; font-size: 0.95em; font-weight: 400; color: #ff3b30; cursor: pointer; border-bottom: 1px solid rgba(0,0,0,0.06); }
.b2-destructive-row:last-child { border-bottom: none; }
.b2-destructive-row:hover { background: rgba(255,59,48,0.04); }
.b2-destructive-sub { font-size: 0.75em; color: #86868b; margin-top: 2px; font-weight: 400; }
body.theme-dark .b2-destructive-row { color: #ff453a; }
body.theme-dark .b2-destructive-row:hover { background: rgba(255,69,58,0.08); }

/* 状態変更行（ラベル+日付入力の横並び） */
.b2-abolish-row { display: flex; align-items: center; padding: 10px 16px; border-bottom: 1px solid rgba(0,0,0,0.06); }
.b2-abolish-row:last-child { border-bottom: none; }
.b2-abolish-label { font-size: 0.9em; font-weight: 400; color: #ff3b30; flex: 0 0 auto; }
.b2-abolish-input { margin-left: auto; padding: 6px 12px; border-radius: 8px; border: 1px solid rgba(0,0,0,0.1); font-size: 0.85em; color: #1d1d1f; background: rgba(0,0,0,0.03); width: 140px; text-align: center; }
.b2-abolish-btn { margin-left: 8px; padding: 6px 14px; border-radius: 8px; border: none; background: #ff3b30; color: #fff; font-size: 0.85em; font-weight: 500; cursor: pointer; }
.b2-abolish-btn:hover { background: #e0342b; }
body.theme-dark .b2-abolish-label { color: #ff453a; }
body.theme-dark .b2-abolish-input { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.1); color: #e5e5e7; }

/* 復活行 */
.b2-restore-row { display: block; padding: 13px 16px; text-align: center; font-size: 0.95em; font-weight: 500; color: #34c759; cursor: pointer; }
.b2-restore-row:hover { background: rgba(52,199,89,0.04); }
body.theme-dark .b2-restore-row { color: #30d158; }
body.theme-dark .b2-restore-row:hover { background: rgba(48,209,88,0.08); }

/* 積替保管マーク */
.b2-cap-transfer { display: inline-block; font-size: 0.7em; font-weight: 600; background: #e3f2fd; color: #0a5dc2; padding: 1px 6px; border-radius: 4px; margin-left: 6px; vertical-align: middle; }
body.theme-dark .b2-cap-transfer { background: #1a2a3e; color: #64b5f6; }

/* --- テスト用コントロール --- */
.test-controls { position: fixed; top: 16px; right: 24px; z-index: 100; display: flex; }
.test-controls > * + * { margin-left: 8px; }
.test-ctrl-btn { padding: 6px 14px; border-radius: 8px; border: 1px solid #ddd; background: #fff; cursor: pointer; font-size: 0.85em; font-weight: 500; }
.test-ctrl-btn:hover { background: #f0f0f0; }
body.theme-dark .test-ctrl-btn { background: #2a3a4a; color: #e7e9ea; border-color: #3a4a5a; }
body.theme-dark .test-ctrl-btn:hover { background: #3a4a5a; }

/* --- タブ切替 --- */
.scenario-tabs { display: flex; margin: 24px 40px 0; flex-wrap: wrap; }
.scenario-tabs > * + * { margin-left: 2px; }
.scenario-tab { padding: 8px 16px; border: none; background: #e0e0e0; cursor: pointer; border-radius: 10px 10px 0 0; font-size: 0.85em; font-weight: 500; color: #666; }
.scenario-tab.active { background: #fff; color: #1d1d1f; font-weight: 600; }
body.theme-dark .scenario-tab { background: #1a2a40; color: #888; }
body.theme-dark .scenario-tab.active { background: #192734; color: #e7e9ea; }

.auto-label { font-size: 0.85em; color: #999; }
body.theme-dark .auto-label { color: #777; }

/* --- 縦タイムライン --- */
.vtl { position: relative; padding-left: 32px; margin-bottom: 24px; }
.vtl-line { position: absolute; left: 13px; top: 0; bottom: 0; width: 2px; background: #dde4ec; }
body.theme-dark .vtl-line { background: #2a3a50; }
.vtl-item { position: relative; padding-bottom: 24px; padding-right: 48px; }
.vtl-item:last-child { padding-bottom: 0; }
.vtl-actions { position: absolute; right: 0; top: 2px; font-size: 0.82em; }
.vtl-actions > * + * { margin-left: 12px; }
.vtl-edit { font-weight: 400; color: #007aff; cursor: pointer; text-decoration: none; }
.vtl-edit:hover { text-decoration: underline; }
.vtl-delete { font-weight: 400; color: #ff3b30; cursor: pointer; text-decoration: none; }
.vtl-delete:hover { text-decoration: underline; }
body.theme-dark .vtl-edit { color: #0a84ff; }
body.theme-dark .vtl-delete { color: #ff453a; }
.vtl-dot { position: absolute; left: -25px; top: 4px; width: 12px; height: 12px; border-radius: 50%; border: 2px solid #fff; }
.vtl-dot.active { background: #4CAF50; }
.vtl-dot.expired { background: #90CAF9; }
.vtl-dot.abolished { background: #9e9e9e; }
.vtl-dot.cancelled { background: #ef5350; }
.vtl-dot.suspended { background: #ffb74d; }
body.theme-dark .vtl-dot { border-color: #192734; }
.vtl-date { font-size: 0.78em; font-weight: 600; color: #86868b; margin-bottom: 2px; }
.vtl-content { font-size: 0.88em; color: #1d1d1f; line-height: 1.5; }
body.theme-dark .vtl-content { color: #e5e5e7; }
.vtl-change { font-size: 0.82em; color: #86868b; margin-top: 2px; }
.vtl-change-old { color: #c62828; text-decoration: line-through; }
.vtl-change-new { color: #1b7a2b; font-weight: 500; }
body.theme-dark .vtl-change-old { color: #ef5350; }
body.theme-dark .vtl-change-new { color: #4ade80; }
</style>
<script>
function toggleTheme() {
    var body = document.body;
    if (body.className.indexOf('theme-dark') >= 0) {
        body.className = '';
    } else {
        body.className = 'theme-dark';
    }
}

function showScenario(id) {
    var pages = document.getElementsByClassName('scenario-page');
    for (var i = 0; i < pages.length; i++) pages[i].style.display = 'none';
    document.getElementById(id).style.display = 'block';

    var tabs = document.getElementsByClassName('scenario-tab');
    for (var i = 0; i < tabs.length; i++) tabs[i].className = 'scenario-tab';
    event.srcElement.className = 'scenario-tab active';
}
</script>
</head>
<body>

<!-- テストコントロール -->
<div class="test-controls">
    <button class="test-ctrl-btn" onclick="toggleTheme()">Dark / Light</button>
</div>

<!-- シナリオタブ -->
<div class="scenario-tabs">
    <button class="scenario-tab active" onclick="showScenario('s1')">A: 中間処理（有効）</button>
    <button class="scenario-tab" onclick="showScenario('s2')">B: 最終処分（有効）</button>
    <button class="scenario-tab" onclick="showScenario('s3')">C: 中間処理（廃止）</button>
    <button class="scenario-tab" onclick="showScenario('s4')">D: 品目なし</button>
    <button class="scenario-tab" onclick="showScenario('s5')">E: 品目多数</button>
    <button class="scenario-tab" onclick="showScenario('s6')">F: 積替保管</button>
    <button class="scenario-tab" onclick="showScenario('s7')">G: 取消</button>
    <button class="scenario-tab" onclick="showScenario('s8')">H: 休止</button>
    <button class="scenario-tab" onclick="showScenario('s9')">I: 再開</button>
</div>

<!-- ============================================ -->
<!-- シナリオA: 中間処理施設（有効・通常） -->
<!-- ============================================ -->
<div class="tab-pane scenario-page" id="s1" style="display:block;">
<div class="permit-detail">

    <div class="step-nav">
        <div class="step-nav-steps">
            <a class="step-nav-step"><span class="step-dot past">1</span><span class="step-label past">施設一覧</span></a>
            <span class="step-sep">&#8250;</span>
            <span class="step-nav-step"><span class="step-dot current">2</span><span class="step-label current">施設詳細</span></span>
        </div>
    </div>

    <div class="b2-header">
        <div class="b2-title">中間処理施設（破砕）</div>
        <div class="b2-location">秋田市外旭川字水口155-1</div>
        <div class="b2-badges">
            <span class="b2-pill b2-pill-green">有効</span>
            <span class="b2-pill b2-pill-blue">固定式</span>
        </div>
    </div>
    <div class="b2-group-title">基本情報</div>
    <div class="b2-group">
        <div class="b2-row"><div class="b2-row-label">許可番号</div><div class="b2-row-value">00510120013</div></div>
        <div class="b2-row"><div class="b2-row-label">許可年月日</div><div class="b2-row-value">2020/04/01</div></div>
        <div class="b2-row"><div class="b2-row-label">設置年月日</div><div class="b2-row-value">2018/06/15</div></div>
        <div class="b2-row"><div class="b2-row-label">許可対象</div><div class="b2-row-value">許可対象</div></div>
    </div>
    <div class="b2-group-title">品目 / 処理能力</div>
    <div class="b2-group">
        <div class="b2-cap-row">
            <div class="b2-cap-name">がれき類</div>
            <div class="b2-cap-vals">
                <div><span class="b2-cap-unit">時間 </span><span class="b2-cap-num">15 t</span></div>
                <div><span class="b2-cap-unit">日 </span><span class="b2-cap-num">120 t</span></div>
                <div class="b2-cap-hours">8h</div>
            </div>
        </div>
        <div class="b2-cap-row">
            <div class="b2-cap-name">木くず</div>
            <div class="b2-cap-vals">
                <div><span class="b2-cap-unit">時間 </span><span class="b2-cap-num">10 t</span></div>
                <div><span class="b2-cap-unit">日 </span><span class="b2-cap-num">80 t</span></div>
                <div class="b2-cap-hours">8h</div>
            </div>
        </div>
        <div class="b2-cap-row">
            <div class="b2-cap-name">ガラス陶磁器くず</div>
            <div class="b2-cap-vals">
                <div><span class="b2-cap-unit">時間 </span><span class="b2-cap-num">5 t</span></div>
                <div><span class="b2-cap-unit">日 </span><span class="b2-cap-num">40 t</span></div>
                <div class="b2-cap-hours">8h</div>
            </div>
        </div>
    </div>

    <div class="b2-group" style="margin-top:16px;">
        <div class="b2-action-row">変更</div>
    </div>

    <div class="b2-group-title" style="margin-top:24px; color:#86868b;">状態変更</div>
    <div class="b2-group">
        <div class="b2-abolish-row">
            <div class="b2-abolish-label" style="color:#e65100;">この施設を休止する</div>
            <input type="text" class="b2-abolish-input" value="" placeholder="休止日" readonly>
            <button class="b2-abolish-btn" style="background:#e65100;">休止</button>
        </div>
        <div class="b2-abolish-row">
            <div class="b2-abolish-label">この施設を廃止する</div>
            <input type="text" class="b2-abolish-input" value="" placeholder="廃止日" readonly>
            <button class="b2-abolish-btn">廃止</button>
        </div>
        <div class="b2-abolish-row">
            <div class="b2-abolish-label" style="color:#c62828;">この施設の許可を取消する</div>
            <input type="text" class="b2-abolish-input" value="" placeholder="取消日" readonly>
            <button class="b2-abolish-btn" style="background:#c62828;">取消</button>
        </div>
        <div class="b2-destructive-row">
            この施設を削除する
            <div class="b2-destructive-sub">処理能力データと全ての履歴も削除されます</div>
        </div>
    </div>

    <div class="b2-group-title" style="margin-top:24px;">履歴</div>
    <div class="vtl">
        <div class="vtl-line"></div>
        <div class="vtl-item">
            <div class="vtl-dot active"></div>
            <div class="vtl-actions"><a class="vtl-edit">修正</a><a class="vtl-delete">削除</a></div>
            <div class="vtl-date">2023/04/01 ～ 現在 <span class="b2-pill b2-pill-green" style="margin-left:8px;">有効</span></div>
            <div class="vtl-content">v3 — 許可更新</div>
            <div class="vtl-change">許可年月日: <span class="vtl-change-old">2021/04/01</span> → <span class="vtl-change-new">2023/04/01</span></div>
        </div>
        <div class="vtl-item">
            <div class="vtl-dot expired"></div>
            <div class="vtl-actions"><a class="vtl-edit">修正</a><a class="vtl-delete">削除</a></div>
            <div class="vtl-date">2021/04/01 ～ 2023/04/01</div>
            <div class="vtl-content">v2 — 住所変更</div>
            <div class="vtl-change">設置場所: <span class="vtl-change-old">秋田市泉中央2丁目8-1</span> → <span class="vtl-change-new">秋田市外旭川字水口155-1</span></div>
        </div>
        <div class="vtl-item">
            <div class="vtl-dot expired"></div>
            <div class="vtl-actions"><a class="vtl-edit">修正</a><a class="vtl-delete">削除</a></div>
            <div class="vtl-date">2018/06/15 ～ 2021/04/01</div>
            <div class="vtl-content">v1 — 新規登録</div>
            <div class="vtl-change">許可番号 00510120013 / 秋田市泉中央2丁目8-1</div>
        </div>
    </div>

</div>
</div>

<!-- ============================================ -->
<!-- シナリオB: 最終処分場（有効） -->
<!-- ============================================ -->
<div class="tab-pane scenario-page" id="s2" style="display:none;">
<div class="permit-detail">

    <div class="step-nav">
        <div class="step-nav-steps">
            <a class="step-nav-step"><span class="step-dot past">1</span><span class="step-label past">施設一覧</span></a>
            <span class="step-sep">&#8250;</span>
            <span class="step-nav-step"><span class="step-dot current">2</span><span class="step-label current">施設詳細</span></span>
        </div>
    </div>

    <div class="b2-header">
        <div class="b2-title">最終処分場</div>
        <div class="b2-location">秋田市河辺豊成字虚空蔵大台滝1-1</div>
        <div class="b2-badges">
            <span class="b2-pill b2-pill-green">有効</span>
            <span class="b2-pill b2-pill-orange">管理型</span>
        </div>
    </div>
